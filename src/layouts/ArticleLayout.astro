---
import type { Article } from "~/data/articles";

import ContentArea from "~/components/ContentArea.astro";
import Hero from "~/components/hero/Hero.astro";
import HeroContentsStandard, {
	type Props as HeroContentsStandardProps,
} from "~/components/hero/HeroContentsStandard.astro";

import PageLayout from "./PageLayout.astro";
import "./prose.css";

interface Props {
	article: Article;
	eyebrow?: string;
	introWidth?: "normal" | "thin";
	squiggly?: HeroContentsStandardProps["squiggly"];
}

const inArticles = Astro.url.pathname.startsWith("/articles/");

const {
	article: { description, title },
	eyebrow = inArticles ? "Articles" : undefined,
	introWidth = "thin",
	squiggly = "none",
} = Astro.props;
---

<PageLayout description={description} title={title}>
	<Hero slot="hero" width={introWidth}>
		<HeroContentsStandard
			eyebrow={eyebrow}
			eyebrowHref={inArticles ? "/articles" : undefined}
			heading={title}
			squiggly={squiggly}
		>
			{description}
		</HeroContentsStandard>
	</Hero>

	{Astro.slots.has("lead") && (
		<ContentArea class="prose" width={introWidth}>
			<p class="article-lead">
				<slot name="lead" />
			</p>
			<slot name="intro" />
		</ContentArea>
	)}

	<slot />
</PageLayout>

<style>
	.article-lead {
		margin: 5rem auto 1.5rem;
	}
</style>

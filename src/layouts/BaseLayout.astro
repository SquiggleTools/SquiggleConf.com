---
import Head, { type Props as HeadProps } from "~/components/Head.astro";

import "./base.css";
import "./fonts.css";
import "./normalize.css";

type Props = HeadProps;
---

<html class="dark" lang="en">
	<Head {...Astro.props} />
	<body data-theme-lazy>
		<slot />
	</body>
</html>

<script>
	addEventListener(
		"load",
		() => {
			setTimeout(() => {
				void import("konami-emoji-blast").then(
					({ initializeKonamiEmojiBlast }) => {
						initializeKonamiEmojiBlast();
					},
				);
			});
		},
		{ once: true },
	);
</script>

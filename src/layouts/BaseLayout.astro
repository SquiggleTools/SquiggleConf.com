---
import Head, { type Props as HeadProps } from "~/components/Head.astro";

import "./base.css";
import "./fonts.css";
import "./normalize.css";

type Props = HeadProps;
---

<html class="dark" lang="en">
	<Head {...Astro.props} />
	<body data-theme-lazy>
		<slot />
	</body>
</html>

<script>
	import { reducedMotionQuery } from "~/utils/motion";

	addEventListener(
		"load",
		() => {
			setTimeout(() => {
				void import("konami-emoji-blast").then(
					({ initializeKonamiEmojiBlast }) => {
						let stop: (() => void) | undefined;
						const update = () => {
							if (reducedMotionQuery.matches) {
								stop?.();
								stop = undefined;
							} else {
								stop ??= initializeKonamiEmojiBlast();
							}
						};

						update();
						reducedMotionQuery.addEventListener("change", update);
					},
				);
			});
		},
		{ once: true },
	);
</script>

---
import { Props as HeadProps } from "~/components/Head.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import NextYearNotice from "~/components/historical/NextYearNotice.astro";
import { currentYear } from "~/data/years";
import BaseLayout from "./BaseLayout.astro";

type Props = HeadProps & {
	hideHeaderLogo?: boolean;
};

const { hideHeaderLogo, year = currentYear, ...props } = Astro.props;
const historical = year !== currentYear;
---

<BaseLayout {...props} year={year}>
	<Header hideLogo={hideHeaderLogo} year={year} />
	{historical && <NextYearNotice year={year} />}
	<div class:list={["body-area", { "page-layout-historical": historical }]}>
		<slot />
	</div>
	<Footer year={year} />
</BaseLayout>

<style>
	.body-area {
		background: linear-gradient(
			180deg,
			var(--colorBlueBright2) 50%,
			var(--colorBlueBright1) 100%
		);
		height: 100%;
		position: relative;
		transition: var(--transitionBackground) background;
	}

	.page-layout-historical {
		--fontFamilyBody: "Urbanist Variable", sans-serif;

		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1.5rem 0 3.5rem;
	}
</style>

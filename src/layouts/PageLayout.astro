---
import { Props as HeadProps } from "~/components/Head.astro";
import Header from "~/components/Header.astro";
import BodyArea from "~/components/BodyArea.astro";
import Footer from "~/components/Footer.astro";
import BaseLayout from "./BaseLayout.astro";
import { currentYear } from "~/data/years";

type Props = HeadProps & {
	hideHeaderLinks?: string[];
	hideHeaderLogo?: boolean;
};

const year = Astro.props.year ?? currentYear;
---

<BaseLayout {...Astro.props} year={year}>
	<Header
		hideLogo={Astro.props.hideHeaderLogo}
		hideTopLinks={Astro.props.hideHeaderLinks}
		year={year}
	/>
	<BodyArea>
		<slot />
	</BodyArea>
	<Footer year={year} />
</BaseLayout>

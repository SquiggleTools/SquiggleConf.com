---
import type { Props as HeadProps } from "~/components/Head.astro";

import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import NextYearNotice from "~/components/historical/NextYearNotice.astro";
import { currentYear } from "~/data/years";

import BaseLayout from "./BaseLayout.astro";

type Props = HeadProps & {
	hideHeaderLogo?: boolean;
	historicalHeading?: boolean;
};

const {
	hideHeaderLogo,
	historicalHeading,
	year = currentYear,
	...props
} = Astro.props;
const historical = year !== currentYear;
---

<BaseLayout {...props} year={year}>
	<a class="skip-link" href="#main">
		Skip to content
	</a>
	<Header hideLogo={hideHeaderLogo} year={year} />
	{historical ? (
		<main id="main">
			<NextYearNotice heading={historicalHeading} year={year} />
			<div class="body-area page-layout-historical" data-theme-lazy>
				<slot />
			</div>
		</main>
	) : (
		<main class="body-area" data-theme-lazy id="main">
			<slot />
		</main>
	)}
	<Footer year={year} />
</BaseLayout>

<style>
	.skip-link {
		background: var(--colorBackground);
		border-radius: var(--radiusMedium);
		box-shadow: 0 0 1rem var(--colorTextShadow);
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		left: 1rem;
		padding: 0.75rem 1rem;
		position: absolute;
		top: 1rem;
		transform: translateY(-200%);
		z-index: 10;
	}

	.skip-link:focus {
		transform: none;
	}

	.body-area {
		background: linear-gradient(
			180deg,
			var(--colorBlueBright2) 50%,
			var(--colorBlueBright1) 100%
		);
		height: 100%;
		position: relative;
	}

	.page-layout-historical {
		--fontFamilyBody: var(--fontFamilyHeading), sans-serif;

		display: flex;
		font-family: var(--fontFamilyBody);
		flex-direction: column;
		align-items: safe center;
		overflow-wrap: anywhere;
		padding: 1.5rem 0 3.5rem;
	}

	.page-layout-historical > :global(*) {
		max-width: 100%;
	}
</style>

---
import "@fontsource-variable/urbanist";

import NextYearNotice from "~/components/historical/NextYearNotice.astro";
import { Props as HeadProps } from "~/components/Head.astro";
import Header from "~/components/Header.astro";
import BodyArea from "~/components/BodyArea.astro";
import Footer from "~/components/Footer.astro";

import BaseLayout from "./BaseLayout.astro";

interface Props extends HeadProps {
	year: number;
}

const { year } = Astro.props;
---

<BaseLayout {...Astro.props} year={year}>
	<Header year={year} />
	<NextYearNotice year={year} />
	<BodyArea class="page-layout-historical">
		<slot />
	</BodyArea>
	<Footer year={year} />
</BaseLayout>

<style>
	.page-layout-historical {
		--fontFamilyBody: "Urbanist Variable", sans-serif;

		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1.5rem 0 3.5rem;
	}
</style>

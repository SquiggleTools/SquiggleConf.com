---
interface Props {
	class?: string;
	id?: string;
	level: "h1" | "h2" | "h3" | "h4";
	link?: boolean;
}

const { level: As, link, ...rest } = Astro.props;
---

<As class:list={[Astro.props.class, "heading"]} {...rest}>
	{link ? (
		<a href={`#${Astro.props.id}`}>
			<slot />
		</a>
	) : (
		<slot />
	)}
</As>

<style>
	.heading {
		scroll-margin-top: 2rem;
	}

	.heading a {
		text-decoration: none;
	}
</style>

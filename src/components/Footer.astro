---
import { currentYear, years } from "~/data/years";
import { socials } from "~/data/socials";
import ContentArea from "./ContentArea.astro";
import IconLinks from "./IconLinks.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	year: number;
}

const yearPairs =
	Astro.props.year === currentYear
		? years
				.filter((year) => year !== currentYear)
				.map((year) => [`/${year}`, year] as const)
		: ([["/", currentYear]] as const);
---

<footer>
	<ContentArea class="footer-content-area" width="wide">
		<div class="left">
			<Logo />
			<div class="footer-date-location">
				<span>May 7th, 2027 ·</span>
				<span>Boston, Massachusetts</span>
			</div>
		</div>
		<div class="right">
			<div class="footer-links">
				<a href="/about">About</a>
				<a href="/code-of-conduct">Code of Conduct</a>
				<a href="https://shop.squiggle.tools" target="_blank">Shop</a>
				{
					yearPairs.map(([yearHref, yearText]) => (
						<a href={yearHref}>{yearText}</a>
					))
				}
				<ThemeToggle />
			</div>
			<IconLinks class="footer-socials" links={socials} />
		</div>
	</ContentArea>
</footer>

<style>
	footer {
		color: var(--colorForegroundEmphasized);
		font-family: var(--fontFamilyHeading);
		padding: 3.5rem 0;
		width: 100%;
	}

	.footer-content-area {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		justify-content: space-between;
	}

	.left {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-date-location {
		line-height: 1.3;
	}

	.footer-date-location span {
		display: inline-block;
	}

	.right {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.footer-links {
		align-items: center;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-links a {
		text-decoration: none;
	}

	.footer-socials {
		--iconLinkPadding: 0rem;
		--iconLinkSize: 2rem;
		--iconLinksGap: 2rem;
		margin-top: 2rem;
		max-width: 15rem;
	}

	html:not(.dark) .footer-socials {
		opacity: 0.9;
	}

	@media (width >= 490px) {
		.footer-socials {
			--iconLinksGap: 1rem;
			margin-top: 0;
			max-width: none;
		}
	}

	@media (width >= 819px) {
		.footer-content-area {
			flex-direction: row;
		}

		.right {
			align-items: flex-end;
		}
	}
</style>

---
import { links } from "~/data/links";
import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Logo from "./Logo.astro";
import { currentYear } from "~/data/years";
import ThemeToggle from "./ThemeToggle.astro";

function hrefProps(pathname: string) {
	return {
		class: Astro.url.pathname === pathname ? "" : "header-link-inactive",
		href: pathname,
		target: pathname.startsWith("https") ? "_blank" : undefined,
	};
}

interface Props {
	hideLogo?: boolean;
	hideTopLinks?: string[];
	year?: number;
}

const { hideLogo = false, hideTopLinks = [], year } = Astro.props;
const logoHref = year === currentYear ? "/" : `/${year}`;
const shouldShowAbout = !hideTopLinks.includes("about");
const shouldShowShop = !hideTopLinks.includes("shop");
---

<header>
	<ContentArea class="header-content-area-mobile">
		{
			!hideLogo && (
				<a class="logo" href={logoHref}>
					<Logo year={year} />
				</a>
			)
		}

		<ThemeToggle placement="inline" />
		<details id="details">
			<summary aria-label="Toggle header">≡</summary>
			<div class="header-contents-mobile">
				{shouldShowAbout && <a {...hrefProps("/about")}>About</a>}
				<a {...hrefProps("/articles")}>Articles</a>
				{year === currentYear && <a {...hrefProps("/sessions")}>Sessions</a>}
				{year === currentYear && <a {...hrefProps("/speakers")}>Speakers</a>}
				{shouldShowShop && <a {...hrefProps(links.shop)}>Shop</a>}
				{year !== currentYear && <a {...hrefProps("/")}>{currentYear}</a>}
				<Button
					as="a"
					class="header-button"
					href={links.tickets}
					target="_blank"
					variant="accent">2027 Tickets</Button
				>
			</div>
		</details>
	</ContentArea>

	<ContentArea class="header-content-area-wide" width="wide">
		{
			!hideLogo && (
				<a class="logo" href={logoHref}>
					<Logo year={year} />
				</a>
			)
		}
		<div class="header-links">
			<ThemeToggle placement="inline" />
			<div class="header-links-inner">
				{shouldShowAbout && <a {...hrefProps("/about")}>About</a>}
				<a {...hrefProps("/articles")}>Articles</a>
				{year === currentYear && <a {...hrefProps("/sessions")}>Sessions</a>}
				{year === currentYear && <a {...hrefProps("/speakers")}>Speakers</a>}
				{shouldShowShop && <a {...hrefProps(links.shop)}>Shop</a>}
				{year !== currentYear && <a {...hrefProps("/")}>{currentYear}</a>}
				<Button
					as="a"
					class="header-button"
					href={links.tickets}
					target="_blank"
					variant="accent">2027 Tickets</Button
				>
			</div>
		</div>
	</ContentArea>
</header>

<script>
	const details = document.querySelector(
		"details#details",
	) as HTMLDetailsElement;
	details.addEventListener("click", (event) => {
		if ((event.target as Partial<HTMLElement>).tagName === "A") {
			details.removeAttribute("open");
		}
	});
</script>

<style>
	header {
		--header-background: #f5f9ff;
		--header-foreground: var(--colorBlue5);
		--header-logo-text: var(--colorBlue5);
		--header-logo-year: var(--colorBlue3);
		--header-button-background: rgba(255, 255, 255, 0.08);
		--header-button-border: rgba(4, 25, 48, 0.22);
		--header-button-foreground: var(--colorBlue5);
		--header-button-hover-background: rgba(4, 25, 48, 0.14);
		--header-button-hover-border: rgba(4, 25, 48, 0.3);
		--header-button-hover-foreground: var(--colorBlue5);
		--header-button-glow: 0 0.1rem 0.1rem rgba(4, 25, 48, 0.12);
		--header-button-ring: 0 0 0 1px rgba(4, 25, 48, 0.08);
		border-bottom: 0;
		color: var(--header-foreground);
		background: var(--header-background);
		font-size: var(--fontSizeSmaller);
		padding: 1.5rem 0;
		width: 100%;
	}

	:global(html.dark) header {
		--header-background: #04142d;
		--header-foreground: var(--colorWhiteIsh);
		--header-logo-text: var(--colorWhiteIsh);
		--header-logo-year: var(--colorBlue2);
		--header-button-background: transparent;
		--header-button-border: rgba(125, 207, 226, 0.34);
		--header-button-foreground: var(--colorWhiteIsh);
		--header-button-hover-background: color-mix(
			in srgb,
			var(--colorBlue2) 78%,
			transparent
		);
		--header-button-hover-border: rgba(125, 207, 226, 0.46);
		--header-button-hover-foreground: var(--colorWhiteIsh);
		--header-button-glow: 0 0.25rem 1rem rgba(56, 206, 214, 0.18);
		--header-button-ring: 0 0 0 1px rgba(125, 207, 226, 0.18);
	}

	.logo {
		text-decoration: none;
	}

	a.logo :global(.logo.regular) {
		--colorLogoText: var(--header-logo-text);
		--colorLogoYear: var(--header-logo-year);
		text-shadow: none;
	}

	.header-content-area-mobile {
		align-items: center;
		display: flex;
		justify-content: space-between;
		min-height: 2.5rem;
		position: relative;
	}

	details {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		z-index: 2;
		text-align: right;
	}

	summary {
		color: inherit;
		display: inline-block;
		cursor: pointer;
		font-size: 4rem;
		list-style: none;
		line-height: 0;
		padding: 1rem 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.header-contents-mobile {
		--offsetTop: 4.5rem;
		background: var(--header-background);
		box-shadow: 0 0 1rem var(--colorTextShadow);
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightSemibold);
		font-weight: bold;
		gap: 0.5rem;
		line-height: 1.5;
		margin-top: 0;
		min-width: 20rem;
		padding: var(--offsetTop) 1rem 1.5rem;
		position: absolute;
		right: 0;
		text-align: right;
		width: 50%;
		z-index: 1;
	}

	.header-contents-mobile .header-button {
		align-self: end;
		margin-top: 0.5rem;
	}

	.header-content-area-wide {
		display: none;
	}

	.header-links {
		align-items: center;
		display: flex;
		width: 100%;
	}

	.header-links-inner {
		align-items: center;
		display: flex;
		font-weight: var(--fontWeightLight);
		gap: clamp(0.55rem, 1.25vw, 2rem);
		justify-content: flex-end;
		width: 100%;
	}

	.header-links a,
	.header-contents-mobile a {
		color: inherit;
	}

	.header-link-inactive {
		text-decoration: none;
	}

	.header-button {
		--colorButtonBackground: var(--header-button-background);
		--colorButtonBorderHover: var(--header-button-hover-border);
		--colorButtonBackgroundHover: var(--header-button-hover-background);
		--colorButtonColor: var(--header-button-foreground);
		--colorButtonColorHover: var(--header-button-hover-foreground);
		border: 2px solid var(--header-button-border);
		border-radius: 0.85rem;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.16),
			var(--header-button-glow),
			var(--header-button-ring);
		font-weight: var(--fontWeightBold);
		justify-content: center;
		margin-left: 0.35rem;
		text-wrap: nowrap;
		transition:
			background var(--transitionBackground) ease,
			border-color var(--transitionFast) ease,
			box-shadow var(--transitionFast) ease,
			transform var(--transitionFast) ease;
	}

	.header-button:hover,
	.header-button:focus-visible {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.22),
			0 0.25rem 0.5rem rgba(4, 25, 48, 0.16),
			0 0 0 1px var(--header-button-hover-border);
		transform: translateY(-1px);
	}

	:global(html.dark) .header-button:hover,
	:global(html.dark) .header-button:focus-visible {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.18),
			0 0.25rem 0.5rem rgba(56, 206, 214, 0.22),
			0 0 0 1px var(--header-button-hover-border);
	}

	@media (width >= 1117px) {
		.header-content-area-mobile {
			display: none;
		}

		.header-content-area-wide {
			align-items: center;
			display: flex;
			justify-content: flex-end;
		}
	}
</style>

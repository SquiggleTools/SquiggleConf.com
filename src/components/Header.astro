---
import { links } from "~/data/links";
import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Logo from "./Logo.astro";
import { currentYear } from "~/data/years";

interface Props {
	hideLogo?: boolean;
	year?: number;
}

const { hideLogo, year } = Astro.props;

const navLinks = [
	{ href: "/articles", text: "Articles" },
	{ href: "https://shop.squiggle.tools", text: "Shop" },
	...(year === currentYear ? [] : [{ href: "/", text: currentYear }]),
].map(({ href, text }) => ({
	class: Astro.url.pathname === href ? "" : "header-link-inactive",
	href,
	target: href.startsWith("https") ? "_blank" : undefined,
	text,
}));

const ticketsButton = {
	as: "a",
	class: "header-button",
	href: links.tickets,
	target: "_blank",
	variant: "accent",
} as const;
---

<header>
	<ContentArea class="header-content-area" width="wide">
		{
			hideLogo ? (
				<Button {...ticketsButton}>{currentYear} Tickets</Button>
			) : (
				<a class="logo" href="/">
					<Logo />
				</a>
			)
		}
		<details id="details">
			<summary aria-label="Toggle header">≡</summary>
			<div class="header-contents-mobile">
				{navLinks.map(({ text, ...props }) => <a {...props}>{text}</a>)}
			</div>
		</details>
		<div class="header-links">
			{navLinks.map(({ text, ...props }) => <a {...props}>{text}</a>)}
			{!hideLogo && <Button {...ticketsButton}>{currentYear} Tickets</Button>}
		</div>
	</ContentArea>
</header>

<script>
	const details = document.getElementById("details");
	details?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			details.removeAttribute("open");
		}
	});
</script>

<style>
	header {
		--header-background: var(--colorBlueBright2);
		--header-foreground: var(--colorBlue5);
		--header-button-background: rgba(255, 255, 255, 0.08);
		--header-button-border: rgb(from var(--colorBlue5) r g b / 22%);
		--header-button-hover-background: rgb(from var(--colorBlue5) r g b / 14%);
		--header-button-hover-border: rgb(from var(--colorBlue5) r g b / 30%);
		--header-button-shadow:
			0 0.1rem 0.1rem rgb(from var(--colorBlue5) r g b / 12%),
			0 0 0 1px rgb(from var(--colorBlue5) r g b / 8%);
		--header-button-hover-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.22),
			0 0.25rem 0.5rem rgb(from var(--colorBlue5) r g b / 16%);
		color: var(--header-foreground);
		background: var(--header-background);
		font-size: var(--fontSizeSmaller);
		padding: 1.5rem 0;
	}

	:global(html.dark) header {
		--header-background: var(--colorBlue6);
		--header-foreground: var(--colorWhiteIsh);
		--header-button-background: transparent;
		--header-button-border: rgba(125, 207, 226, 0.34);
		--header-button-hover-background: rgb(from var(--colorBlue2) r g b / 78%);
		--header-button-hover-border: rgba(125, 207, 226, 0.46);
		--header-button-shadow:
			0 0.25rem 1rem rgb(from var(--colorBlue2) r g b / 18%),
			0 0 0 1px rgba(125, 207, 226, 0.18);
		--header-button-hover-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.18),
			0 0.25rem 0.5rem rgb(from var(--colorBlue2) r g b / 22%);
	}

	.logo {
		text-decoration: none;
	}

	.header-content-area {
		align-items: center;
		display: flex;
		gap: 1rem;
		min-height: 2.5rem;
		position: relative;
	}

	details {
		inset: 0 0 auto;
		position: absolute;
		z-index: 2;
		text-align: right;
	}

	summary {
		display: inline-block;
		cursor: pointer;
		font-size: 4rem;
		list-style: none;
		line-height: 0;
		padding: 1rem 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.header-contents-mobile {
		background: var(--header-background);
		box-shadow: 0 0 1rem var(--colorTextShadow);
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightHeavy);
		gap: 0.5rem;
		line-height: 1.5;
		min-width: 20rem;
		padding: 4.5rem 1rem 1.5rem;
		position: absolute;
		right: 0;
		width: 50%;
		z-index: 1;
	}

	.header-links {
		align-items: center;
		display: none;
		font-weight: var(--fontWeightLight);
		gap: clamp(0.55rem, 1.25vw, 2rem);
		justify-content: flex-end;
		width: 100%;
	}

	.header-link-inactive {
		text-decoration: none;
	}

	.header-button {
		--colorButtonBackground: var(--header-button-background);
		--colorButtonBorderHover: var(--header-button-hover-border);
		--colorButtonBackgroundHover: var(--header-button-hover-background);
		--colorButtonColor: var(--header-foreground);
		--colorButtonColorHover: var(--header-foreground);
		border: 2px solid var(--header-button-border);
		border-radius: var(--radiusLarge);
		font-weight: var(--fontWeightBold);
		margin-left: 0.35rem;
		text-wrap: nowrap;
		transition:
			background var(--transitionBackground) ease,
			border-color var(--transitionFast) ease,
			box-shadow var(--transitionFast) ease,
			transform var(--transitionFast) ease;
	}

	.header-button:hover,
	.header-button:focus-visible {
		box-shadow:
			var(--header-button-hover-shadow),
			0 0 0 1px var(--header-button-hover-border);
		transform: translateY(-1px);
	}

	@media (width >= 1117px) {
		details {
			display: none;
		}

		.header-links {
			display: flex;
		}

		.header-button:not(:hover, :focus-visible) {
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.16),
				var(--header-button-shadow);
		}
	}
</style>

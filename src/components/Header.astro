---
import { links } from "~/data/links";
import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Logo from "./Logo.astro";
import { currentYear } from "~/data/years";

interface Props {
	hideLogo?: boolean;
	year?: number;
}

const { hideLogo, year } = Astro.props;

const navLinks = [
	{ href: "/articles", text: "Articles" },
	{ href: "https://shop.squiggle.tools", text: "Shop" },
	...(year === currentYear ? [] : [{ href: "/", text: currentYear }]),
].map(({ href, text }) => ({
	class: Astro.url.pathname === href ? "" : "header-link-inactive",
	href,
	target: href.startsWith("https") ? "_blank" : undefined,
	text,
}));

const ticketsButton = {
	as: "a",
	class: "header-button",
	href: links.tickets,
	target: "_blank",
	variant: "ghost",
} as const;
---

<header>
	<ContentArea class="header-content-area" width="wide">
		{
			hideLogo ? (
				<Button {...ticketsButton}>{currentYear} Tickets</Button>
			) : (
				<a class="logo" href="/">
					<Logo />
				</a>
			)
		}
		<details id="details">
			<summary aria-label="Toggle header">≡</summary>
			<div class="header-contents-mobile">
				{navLinks.map(({ text, ...props }) => <a {...props}>{text}</a>)}
			</div>
		</details>
		<div class="header-links">
			{navLinks.map(({ text, ...props }) => <a {...props}>{text}</a>)}
			{!hideLogo && <Button {...ticketsButton}>{currentYear} Tickets</Button>}
		</div>
	</ContentArea>
</header>

<script>
	const details = document.getElementById("details");
	details?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			details.removeAttribute("open");
		}
	});
</script>

<style>
	header {
		--header-background: light-dark(var(--colorBlueBright2), var(--colorBlue6));
		--header-foreground: light-dark(var(--colorBlue5), var(--colorWhiteIsh));
		color: var(--header-foreground);
		background: var(--header-background);
		font-size: var(--fontSizeSmaller);
		padding: 1.5rem 0;
	}

	.logo {
		text-decoration: none;
	}

	.header-content-area {
		align-items: center;
		display: flex;
		gap: 1rem;
		min-height: 2.5rem;
		position: relative;
	}

	details {
		inset: 0 0 auto;
		position: absolute;
		z-index: 2;
		text-align: right;
	}

	summary {
		display: inline-block;
		cursor: pointer;
		font-size: 4rem;
		list-style: none;
		line-height: 0;
		padding: 1rem 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.header-contents-mobile {
		background: var(--header-background);
		box-shadow: 0 0 1rem var(--colorTextShadow);
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightHeavy);
		gap: 0.5rem;
		line-height: 1.5;
		min-width: 20rem;
		padding: 4.5rem 1rem 1.5rem;
		position: absolute;
		right: 0;
		width: 50%;
		z-index: 1;
	}

	.header-links {
		align-items: center;
		display: none;
		font-weight: var(--fontWeightLight);
		gap: clamp(0.55rem, 1.25vw, 2rem);
		justify-content: flex-end;
		width: 100%;
	}

	.header-link-inactive {
		text-decoration: none;
	}

	.header-button {
		margin-left: 0.35rem;
	}

	@media (width >= 1117px) {
		details {
			display: none;
		}

		.header-links {
			display: flex;
		}
	}
</style>

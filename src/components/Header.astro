---
import { links } from "~/data/links";
import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Logo from "./Logo.astro";
import { currentYear } from "~/data/years";

interface Props {
	hideLogo?: boolean;
	year?: number;
}

const { hideLogo, year } = Astro.props;

const navLinks = [
	{ href: "/articles", text: "Articles" },
	{ href: "https://shop.squiggle.tools", text: "Shop" },
	...(year === currentYear ? [] : [{ href: "/", text: currentYear }]),
].map(({ href, text }) => ({
	"aria-current": Astro.url.pathname === href ? ("page" as const) : undefined,
	href,
	target: href.startsWith("https") ? "_blank" : undefined,
	text,
}));

const ticketsButton = {
	as: "a",
	class: "header-button",
	href: links.tickets,
	target: "_blank",
	variant: "ghost",
} as const;
---

<header>
	<ContentArea class="header-content-area" width="wide">
		{
			hideLogo ? (
				<Button {...ticketsButton}>{currentYear} Tickets</Button>
			) : (
				<a class="logo" href="/">
					<Logo />
				</a>
			)
		}
		<button
			aria-label="Toggle header"
			class="header-menu-toggle"
			popovertarget="header-links"
			type="button">≡</button
		>
		<nav class="header-links" id="header-links" popover>
			<button
				aria-label="Toggle header"
				class="header-menu-toggle"
				popovertarget="header-links"
				popovertargetaction="hide"
				type="button">≡</button
			>
			{navLinks.map(({ text, ...props }) => <a {...props}>{text}</a>)}
			{!hideLogo && <Button {...ticketsButton}>{currentYear} Tickets</Button>}
		</nav>
	</ContentArea>
</header>

<script>
	const menu = document.getElementById("header-links");
	menu?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			menu.hidePopover();
		}
	});
</script>

<style>
	header {
		--header-background: light-dark(var(--colorBlueBright2), var(--colorBlue6));
		--header-foreground: light-dark(var(--colorBlue5), var(--colorWhiteIsh));

		color: var(--header-foreground);
		background: var(--header-background);
		font-size: var(--fontSizeSmaller);
		padding: 1.5rem 0;
	}

	.logo {
		text-decoration: none;
	}

	.header-content-area {
		align-items: center;
		display: flex;
		gap: 1rem;
		min-height: 2.5rem;
		position: relative;
	}

	.header-menu-toggle {
		background: none;
		border: none;
		color: inherit;
		cursor: pointer;
		font: 4rem/0 var(--fontFamilyBody);
		padding: 1rem 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	.header-links {
		display: none;
	}

	.header-links:popover-open {
		background: var(--header-background);
		border: none;
		box-shadow: 0 0 1rem var(--colorTextShadow);
		color: inherit;
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightBold);
		gap: 0.5rem;
		height: auto;
		inset: 1.5rem 5vw auto auto;
		line-height: 1.5;
		margin: 0;
		min-width: 20rem;
		overflow: visible;
		padding: 4.5rem 1rem 1.5rem;
		position: absolute;
		text-align: right;
		width: 45vw;
	}

	.header-links:popover-open .header-button {
		display: none;
	}

	.header-links a:not([aria-current]) {
		text-decoration: none;
	}

	.header-button {
		margin-left: 0.35rem;
	}

	@media (--widthXLarge) {
		.header-menu-toggle {
			display: none;
		}

		.header-links {
			align-items: center;
			background: none;
			border: none;
			color: inherit;
			display: flex;
			font-weight: var(--fontWeightExtraLight);
			gap: clamp(0.55rem, 1.25vw, 2rem);
			justify-content: flex-end;
			margin: 0;
			overflow: visible;
			padding: 0;
			position: static;
			width: 100%;
		}
	}
</style>

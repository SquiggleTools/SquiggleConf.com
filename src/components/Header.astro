---
import { links } from "~/data/links";
import { currentYear } from "~/data/years";
import { pagePathname } from "~/utils/pathname";

import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Logo from "./Logo.astro";

interface Props {
	hideLogo?: boolean;
	year?: number;
}

const { hideLogo, year } = Astro.props;
const pathname = pagePathname(Astro.url);

function getAriaCurrent(href: string) {
	if (pathname === href) {
		return "page" as const;
	}

	if (pathname.startsWith(`${href}/`)) {
		return "true" as const;
	}

	return undefined;
}

const navLinks = [
	{ href: "/articles", text: "Articles" },
	{ href: "https://shop.squiggle.tools", text: "Shop" },
	...(year === currentYear ? [] : [{ href: "/", text: currentYear }]),
].map(({ href, text }) => ({
	"aria-current": getAriaCurrent(href),
	href,
	target: href.startsWith("https") ? "_blank" : undefined,
	text,
}));

const ticketsButton = {
	as: "a",
	class: "header-button",
	href: links.tickets,
	target: "_blank",
	variant: "ghost",
} as const;
---

<header class:list={[hideLogo && "header-floating"]}>
	<ContentArea class="header-content-area" width="wide">
		{!hideLogo && (
			<a class="logo" href="/">
				<Logo />
			</a>
		)}
		<button
			aria-label="Open menu"
			class="header-menu-toggle"
			popovertarget="header-links"
			type="button"
		>
			≡
		</button>
		<nav class="header-links" id="header-links" popover>
			<button
				aria-label="Close menu"
				class="header-menu-toggle"
				popovertarget="header-links"
				popovertargetaction="hide"
				type="button"
			>
				×
			</button>
			{navLinks.map(({ text, ...props }) => (
				<a {...props}>{text}</a>
			))}
			{!hideLogo && <Button {...ticketsButton}>{currentYear} Tickets</Button>}
		</nav>
	</ContentArea>
</header>

<script>
	const menu = document.getElementById("header-links");
	menu?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			menu.hidePopover();
		}
	});
</script>

<style>
	header {
		--header-background: var(--colorBlueBright2);
		--header-foreground: color-mix(
			in srgb,
			var(--colorBlue5),
			var(--colorWhiteIsh) var(--themeDarkness)
		);

		color: var(--header-foreground);
		background: var(--header-background);
		font-size: var(--fontSizeSmaller);
		padding: 1.5rem 0;
	}

	.header-floating {
		background: transparent;
		left: 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	.logo {
		text-decoration: none;
	}

	.header-content-area {
		align-items: center;
		display: flex;
		gap: 1rem;
		min-height: 2.5rem;
		position: relative;
	}

	.header-menu-toggle {
		background: none;
		border: none;
		color: inherit;
		cursor: pointer;
		font: 4rem/0 var(--fontFamilyBody);
		padding: 1rem 0;
		position: absolute;
		right: 0;
		top: 0;
		z-index: 2;
	}

	.header-floating .header-menu-toggle {
		font-size: 3.6rem;
		top: calc(5vw - 2.1rem);
	}

	.header-menu-toggle:has(+ .header-links:popover-open) {
		visibility: hidden;
	}

	.header-links .header-menu-toggle {
		top: 0;
	}

	.header-links {
		display: none;
	}

	.header-links:popover-open {
		background: color-mix(
			in srgb,
			var(--colorWhite),
			var(--colorBlue4) var(--themeDarkness)
		);
		border: 1px solid
			color-mix(
				in srgb,
				rgb(from var(--colorBlue4) r g b / 18%),
				var(--colorBlue3) var(--themeDarkness)
			);
		border-radius: var(--radiusLarge);
		box-shadow: 0 0.5rem 1.5rem var(--colorTextShadow);
		color: inherit;
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightBold);
		gap: 0.5rem;
		height: auto;
		inset: 1.5rem 5vw auto auto;
		line-height: 1.5;
		margin: 0;
		min-width: min(20rem, 100vw - 2rem);
		overflow: visible;
		padding: 4.5rem 1rem 1.5rem;
		position: absolute;
		text-align: right;
		width: 45vw;
	}

	.header-floating .header-links:popover-open {
		top: calc(5vw - 0.6rem);
	}

	.header-links:popover-open .header-button {
		align-self: flex-end;
	}

	.header-links a:not([aria-current]) {
		text-decoration: none;
	}

	.header-button {
		margin-left: 0.35rem;
	}

	@media (--widthXLarge) {
		.header-floating {
			padding-top: 4rem;
		}

		.header-floating .header-content-area {
			align-items: flex-start;
			min-height: 0;
		}

		.header-menu-toggle {
			display: none;
		}

		.header-links {
			align-items: center;
			background: none;
			border: none;
			color: inherit;
			display: flex;
			font-weight: var(--fontWeightExtraLight);
			gap: clamp(0.55rem, 1.25vw, 2rem);
			justify-content: flex-end;
			margin: 0;
			overflow: visible;
			padding: 0;
			position: static;
			width: 100%;
		}
	}
</style>

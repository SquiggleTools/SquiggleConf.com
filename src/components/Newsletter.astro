---
import OceanFloorLeft from "~/assets/design/ocean-floor-left.svg";
import OceanFloorRight from "~/assets/design/ocean-floor-right.svg";

import Bubbles from "./Bubbles.astro";
import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import Heading from "./Heading.astro";
---

<div class="newsletter" data-pause-offscreen id="newsletter">
	<OceanFloorLeft aria-hidden="true" class="ocean-floor ocean-floor-left" />
	<OceanFloorRight aria-hidden="true" class="ocean-floor ocean-floor-right" />
	<Bubbles class="newsletter-bubbles" count={56} />
	<ContentArea as="section" class="newsletter-contents">
		<Heading level="h2">
			Sign up to receive announcements and important SquiggleConf info.
		</Heading>

		<form action="/api/newsletter" id="newsletter-form" method="POST">
			<label class="email-label" for="email">
				Email Address
			</label>
			<input
				aria-describedby="newsletter-message"
				autocomplete="email"
				class="email-input"
				id="email"
				name="email"
				placeholder="cool.dev@awesome.com"
				required
				type="email"
			/>
			<Button as="button" size="large" type="submit" variant="light">
				Subscribe
			</Button>
		</form>

		<p id="newsletter-message" role="status"></p>
	</ContentArea>
</div>

<script>
	import { pauseOffscreen } from "~/utils/pauseOffscreen";

	pauseOffscreen();

	const form = document.querySelector<HTMLFormElement>("#newsletter-form");
	const email = form?.querySelector("input");
	const message = document.querySelector("#newsletter-message");
	const submit = form?.querySelector("button");
	let submitting = false;

	function setMessage(text: string, unhappy: boolean) {
		if (message) {
			message.textContent = text;
			message.classList.toggle("unhappy", unhappy);
		}

		if (unhappy) {
			email?.setAttribute("aria-invalid", "true");
		} else {
			email?.removeAttribute("aria-invalid");
		}
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (submitting) {
			return;
		}

		submitting = true;
		submit?.setAttribute("aria-disabled", "true");

		try {
			const response = await fetch(form.action, {
				body: new FormData(form),
				method: "POST",
			});

			if (response.ok) {
				setMessage("Thanks for signing up!", false);
				form.reset();
			} else {
				setMessage(
					response.status === 400
						? "Please enter a valid email address."
						: "We couldn't sign you up right now. Please try again later.",
					true,
				);
			}
		} catch {
			setMessage(
				"We couldn't reach the server. Please check your connection and try again.",
				true,
			);
		} finally {
			submitting = false;
			submit?.removeAttribute("aria-disabled");
		}
	});
</script>

<style>
	.newsletter {
		--newsletter-floor-height: 22rem;

		padding: 0 0 3rem;
		overflow-x: clip;
		position: relative;
		text-align: center;
	}

	.newsletter-contents {
		align-items: center;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		position: relative;
		z-index: 1;
	}

	h2 {
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
		font-weight: var(--fontWeightLight);
		line-height: 1;
		max-width: 25rem;
	}

	form {
		align-items: center;
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
	}

	.email-label {
		align-self: flex-start;
	}

	.email-input {
		background: var(--colorWhiteIsh);
		border: 1px solid
			color-mix(in srgb, var(--colorBlue3), transparent var(--themeDarkness));
		border-radius: var(--radiusSmall);
		color: var(--colorBlue5);
		font-family: var(--fontFamilyHeading);
		font-weight: var(--fontWeightSemiLight);
		font-size: var(--fontSizeSmaller);
		margin: 0.5rem 0 1rem;
		max-width: 80vw;
		padding: 1rem 0.5rem;
		width: 25rem;
	}

	.email-input::placeholder {
		color: rgb(from var(--colorBlue5) r g b / 65%);
		font-weight: var(--fontWeightLight);
	}

	#newsletter-message {
		margin: auto;
	}

	#newsletter-message.unhappy {
		color: color-mix(
			in srgb,
			var(--colorUnhappyStrong),
			var(--colorUnhappy) var(--themeDarkness)
		);
	}

	.newsletter :global(.newsletter-bubbles) {
		--bubbles-fade: 3rem;
		--bubbles-mask: linear-gradient(
			to right,
			var(--colorBlue5) calc(50% - 22rem),
			transparent calc(50% - 13rem),
			transparent calc(50% + 13rem),
			var(--colorBlue5) calc(50% + 22rem)
		);

		top: -5.5rem;
	}

	.ocean-floor {
		bottom: 0;
		height: var(--newsletter-floor-height);
		max-width: none;
		pointer-events: none;
		position: absolute;
		user-select: none;
		width: auto;
	}

	.ocean-floor :global(.ocean-plant) {
		animation-direction: alternate;
		animation-iteration-count: infinite;
		animation-name: ocean-plant-sway;
		animation-timing-function: ease-in-out;
		transform-box: fill-box;
		transform-origin: bottom center;
	}

	.ocean-floor :global(.ocean-plant-green) {
		animation-duration: 8s;
	}

	.ocean-floor :global(.ocean-plant-slow) {
		animation-duration: 19s;
	}

	.ocean-floor :global(.ocean-plant:nth-of-type(5n + 1)) {
		animation-delay: -2.7s;
	}

	.ocean-floor :global(.ocean-plant:nth-of-type(5n + 2)) {
		animation-delay: -5.3s;
	}

	.ocean-floor :global(.ocean-plant:nth-of-type(5n + 3)) {
		animation-delay: -9.1s;
	}

	.ocean-floor :global(.ocean-plant:nth-of-type(5n + 4)) {
		animation-delay: -12.4s;
	}

	@keyframes ocean-plant-sway {
		from {
			rotate: -1.4deg;
		}

		to {
			rotate: 1.4deg;
		}
	}

	.ocean-floor :global(.crab-claw) {
		animation-delay: var(--claw-delay);
		animation-duration: var(--claw-duration);
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
		transform-box: view-box;
		transform-origin: var(--claw-pivot);
	}

	.ocean-floor :global(.crab-claw-left) {
		animation-name: crab-claw-wave-left;
	}

	.ocean-floor :global(.crab-claw-right) {
		animation-name: crab-claw-wave-right;
	}

	@keyframes crab-claw-wave-left {
		0%,
		100% {
			rotate: 0deg;
		}

		14% {
			rotate: -12deg;
		}

		28% {
			rotate: -3deg;
		}

		42% {
			rotate: -10deg;
		}

		56% {
			rotate: 0deg;
		}

		68%,
		72% {
			rotate: -7deg;
		}

		70%,
		74% {
			rotate: 0deg;
		}
	}

	@keyframes crab-claw-wave-right {
		0%,
		100% {
			rotate: 0deg;
		}

		14% {
			rotate: 12deg;
		}

		28% {
			rotate: 3deg;
		}

		42% {
			rotate: 10deg;
		}

		56% {
			rotate: 0deg;
		}

		68%,
		72% {
			rotate: 7deg;
		}

		70%,
		74% {
			rotate: 0deg;
		}
	}

	.ocean-floor-left {
		left: min(
			0rem,
			calc(50% - 2rem - var(--newsletter-floor-height) * 1480 / 604)
		);
	}

	.ocean-floor-right {
		left: max(
			calc(50% + 8rem),
			calc(100% - var(--newsletter-floor-height) * 1025 / 604)
		);
	}
</style>

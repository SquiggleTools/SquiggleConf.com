---
import type { LocalImageProps } from "astro:assets";

import Img from "./Img.astro";

type Props = Omit<LocalImageProps, "alt">;

const { class: className, ...rest } = Astro.props as LocalImageProps;
---

<Img class:list={[className, "decorative-image"]} {...rest} alt="" />

<style>
	.decorative-image {
		pointer-events: none;
		position: absolute;
		user-select: none;
	}
</style>

---
import { Image } from "astro:assets";

interface Props {
	image: ImageMetadata;
	name: string;
	size?: number;
}

const { image, name, size = 128 } = Astro.props;
---

<Image
	alt={`${name} Avatar`}
	class="speaker-image"
	src={image}
	width={size}
	height={size}
/>

<style>
	.speaker-image {
		border-radius: 100%;
		user-select: none;
	}
</style>

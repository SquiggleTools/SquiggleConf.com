---
import { Image } from "astro:assets";

import squiggleFlankingLean from "~/assets/2024/squiggle-flanking-lean.svg";
import { SponsorInfo } from "~/data/historical/types";
import BodyText from "../BodyText.astro";
import Heading from "../Heading.astro";
import SectionWrapper from "./SectionWrapper.astro";
import SponsorLogos from "./SponsorLogos.astro";

interface Props {
	sponsors: SponsorInfo[];
}

const { sponsors } = Astro.props;
---

<SectionWrapper>
	<div class="squiggle-flanked">
		<Image alt="" class="squiggle" src={squiggleFlankingLean} />
		<Heading class="heading" id="sponsors" level="h2" link>Sponsors</Heading>
		<Image alt="" class="squiggle squiggle-right" src={squiggleFlankingLean} />
	</div>
	<BodyText class="sponsors-blurb" historical>
		The support of our generous sponsors help make SquiggleConf possible. They
		have our sincere appreciation and thanks.
	</BodyText>

	<SponsorLogos sponsors={sponsors} />
</SectionWrapper>

<style>
	.squiggle-flanked {
		align-items: center;
		display: flex;
		gap: clamp(0.25rem, 2.5vw, 2.5rem);
		justify-content: center;
		line-height: 1.2;
		margin: 0 auto 3rem;
		max-width: var(--sizeContentAreaThin);
		width: 100%;
	}

	.squiggle {
		max-width: 11vw;
		object-fit: cover;
		object-position: right;
		user-select: none;
	}

	.squiggle-right {
		transform: scaleX(-1);
	}

	@media (--widthXLarge) {
		.squiggle {
			max-width: none;
		}
	}

	.heading {
		font-size: var(--fontSizeLarge);
		text-align: center;
	}

	.sponsors-blurb {
		margin: auto;
		padding-bottom: 3.5rem;
	}
</style>

---
import { SponsorInfo } from "~/data/historical/types";

import ThemedImage from "../ThemedImage.astro";

interface Props {
	sponsors: SponsorInfo[];
}

const { sponsors } = Astro.props;
const sponsorGroups = Object.groupBy(sponsors, (sponsor) => sponsor.placement);
---

<div class="sponsor-logos">
	{
		Object.entries(sponsorGroups).map(([placement, sponsors], index) => (
			<div
				class:list={[
					"sponsor-group",
					`sponsor-group-${index}`,
					`sponsor-group-${placement}`,
				]}
			>
				{sponsors?.map((sponsor) => (
					<a
						class="sponsor"
						href={sponsor.href}
						rel="noreferrer"
						target="_blank"
						title={sponsor.title}
					>
						<ThemedImage alt="" height={128} sources={sponsor.logos} />
					</a>
				))}
			</div>
		))
	}
</div>

<style>
	.sponsor-logos {
		margin: auto;
		max-width: 70rem;
		--sponsorSize0: 14rem;
		--sponsorSize1: 7rem;
		--sponsorSize2: 5.6rem;
		--sponsorSpacing0: 5rem;
		--sponsorSpacing1: 10rem;
		--sponsorSpacing2: 12.5rem;
		--sponsorSpacingVertical: 1.5rem;
	}

	.sponsor-group {
		align-items: center;
		display: flex;
		flex-direction: column;
		padding: 0 2rem;
		justify-content: center;
		margin: auto;
	}

	.sponsor-group-0 {
		--sponsorSize: var(--sponsorSize0);
		--sponsorSpacing: var(--sponsorSpacing0);
	}

	.sponsor-group-1 {
		--sponsorSize: var(--sponsorSize1);
		--sponsorSpacing: var(--sponsorSpacing1);
	}

	.sponsor-group-2 {
		--sponsorSize: var(--sponsorSize2);
		--sponsorSpacing: var(--sponsorSpacing2);
	}

	.sponsor-group img {
		max-width: var(--sponsorSize);
	}

	@media (--widthMedium) {
		.sponsor-group {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0;
		}

		.sponsor-group a {
			padding: var(--sponsorSpacingVertical) 0;
		}

		.sponsor {
			max-width: calc(49% - var(--sponsorSpacing));
			width: 100%;
		}
	}
</style>

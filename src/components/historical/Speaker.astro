---
import type { PersonInfo, SessionInfo } from "~/data/historical/types";

import Avatar from "../Avatar.astro";
import BioLinks from "../BioLinks.astro";
import SafeMarkdown from "../SafeMarkdown.astro";
import SubtleCard from "./SubtleCard.astro";

import "~/layouts/anchor-title.css";

interface Props {
	class?: string;
	speaker: PersonInfo;
	talks: SessionInfo[];
	year: number;
}

const {
	class: className,
	speaker: { image, links, name, qualification, slug },
	talks,
	year,
	...rest
} = Astro.props;
---

<li
	class:list={["speaker", "anchor-title-card", className]}
	id={slug}
	{...rest}
>
	<SubtleCard>
		<div class="speaker-top">
			<div class="speaker-top-content">
				<Avatar alt="" size={128} src={image} />
				<div class="speaker-headline">
					<div class="speaker-headline-text">
						<h2 class="title">
							<a class="anchor-title" href={`#${slug}`}>
								{name}
							</a>
						</h2>
						<div>
							<SafeMarkdown of={qualification} />
						</div>
					</div>
					<ul class="speaker-talks">
						{talks.map((talk) => (
							<li>
								<a class="talk-title" href={`/${year}/sessions#${talk.slug}`}>
									{talk.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
		<slot name="center" />
		<div class="speaker-links">
			<BioLinks links={links} name={name} size="large" />
		</div>
	</SubtleCard>
</li>

<style>
	.speaker {
		text-align: left;
	}

	.speaker-top {
		display: flex;
		align-items: flex-start;
	}

	.speaker-top-content {
		align-items: flex-start;
		display: flex;
		flex-direction: row;
		gap: 1rem;
		position: relative;
		width: 100%;
	}

	.speaker-top-content :global(.avatar) {
		aspect-ratio: 1;
		flex: none;
		height: auto;
	}

	.speaker-headline {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	@media not (--widthXSmall) {
		.speaker-top-content {
			flex-direction: column;
		}
	}

	.title {
		display: block;
		color: var(--colorCopy);
		font-size: var(--fontSizeMedium);
		font-weight: var(--fontWeightMedium);
		margin-bottom: 0.25rem;
	}

	.title a {
		text-decoration: none;
	}

	.speaker-headline-text {
		margin-bottom: 0.5rem;
	}

	.speaker-talks {
		list-style: none;
		padding-top: 0.5rem;
		padding-left: 0;
		font-size: var(--fontSizeSmall);
	}

	.talk-title {
		font-size: var(--fontSizeSmall);
		text-decoration: none;
	}

	.speaker-links {
		justify-content: space-between;
		display: flex;
		flex-direction: row;
		margin-top: 1rem;
	}
</style>

---
import BioLinks from "../BioLinks.astro";
import SafeMarkdown from "../SafeMarkdown.astro";
import SpeakerImage from "./SpeakerImage.astro";
import SubtleCard from "./SubtleCard.astro";
import { PersonInfo, SessionInfo } from "~/data/historical/types";

interface Props {
	class?: string;
	speaker: PersonInfo;
	talks: SessionInfo[];
	year: number;
}

const {
	class: className,
	speaker: { image, links, name, qualification, slug },
	talks,
	year,
	...rest
} = Astro.props;
---

<li class:list={["speaker", className]} id={slug} {...rest}>
	<SubtleCard>
		<div class="speaker-top">
			<div class="speaker-top-content">
				<div class="speaker-image-container">
					<SpeakerImage image={image} name={name} />
				</div>
				<div class="speaker-headline">
					<div class="speaker-headline-text">
						<a class="title" href={`#${slug}`}>{name}</a>
						{
							qualification && (
								<div>
									<SafeMarkdown of={qualification} />
								</div>
							)
						}
					</div>
					<ul class="speaker-talks">
						{
							talks.map((talk) => (
								<li>
									<a class="talk-title" href={`/${year}/sessions#${talk.slug}`}>
										{talk.title}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
		<slot name="center" />
		<div class="speaker-links">
			<BioLinks
				class="speaker-bio-links"
				historical
				links={links}
				name={name}
				size="large"
			/>
		</div>
	</SubtleCard>
</li>

<style>
	.speaker {
		text-align: left;
	}

	.speaker-top {
		display: flex;
		align-items: flex-start;
	}

	.speaker-top-content {
		display: flex;
		flex-direction: row;
		gap: 1rem;
		position: relative;
		width: 100%;
	}

	.title {
		display: block;
		color: var(--colorForegroundBody);
		font-size: var(--fontSizeH3);
		font-weight: var(--fontWeightBold);
		margin-bottom: 0.25rem;
		text-decoration: none;
	}

	.title::after {
		content: " #";
		opacity: 0;
		transition: var(--transitionMedium) opacity;
	}

	:is(.speaker:hover, .speaker:focus-within) .title::after {
		opacity: 1;
	}

	.speaker-headline-text {
		margin-bottom: 0.5rem;
	}

	.speaker-talks {
		list-style: none;
		padding-top: 0.5rem;
		padding-left: 0;
		font-size: var(--fontSizeBody);
	}

	.talk-title {
		font-size: var(--fontSizeH4);
		text-decoration: none;
	}

	.speaker-links {
		justify-content: space-between;
		display: flex;
		flex-direction: row;
		margin-top: 1rem;
	}
</style>

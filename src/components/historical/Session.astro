---
import type { SessionInfo } from "~/data/historical/types";

import SafeMarkdown from "../SafeMarkdown.astro";
import SessionTags from "./SessionTags.astro";
import SpeakerSmall from "./SpeakerSmall.astro";
import SubtleCard from "./SubtleCard.astro";

import "~/layouts/anchor-title.css";

interface Props {
	class?: string;
	session: SessionInfo;
	year: number;
}

const {
	class: className,
	session: { description, people, slug, tags, title },
	year,
	...rest
} = Astro.props;
---

<li class:list={["talk", "anchor-title-card", className]} id={slug} {...rest}>
	<SubtleCard>
		<div class="talk-top">
			<a class="title anchor-title" href={`#${slug}`}>
				{title}
			</a>
			<div class="talk-description">
				<SafeMarkdown of={description} />
			</div>
			<SessionTags tags={tags} />
		</div>

		<div class="talk-details">
			<ul class="speakers">
				{people.map((person) => (
					<SpeakerSmall
						as="li"
						href={`/${year}/speakers#${person.slug}`}
						person={person}
					/>
				))}
			</ul>
		</div>
	</SubtleCard>
</li>

<style>
	.talk {
		display: flex;
		flex-basis: 0;
		flex-direction: column;
		justify-content: space-between;
		scroll-margin-top: 1rem;
	}

	.talk-top {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
	}

	.title {
		color: var(--colorCopy);
		font-size: var(--fontSizeMedium);
		font-weight: var(--fontWeightMedium);
		text-align: left;
		margin-bottom: 0.5rem;
		text-decoration: none;
	}

	.talk-description {
		color: var(--colorCopy);
		line-height: 1.4;
		overflow: hidden;
		text-align: left;
		transition: var(--transitionNormal) line-height;
	}

	html.dark .talk-description {
		line-height: 1.6;
	}

	.talk-details {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		justify-content: space-between;
		width: 100%;
	}

	.speakers {
		align-items: flex-start;
		display: flex;
		gap: 1rem 4rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		padding-left: 0;
	}

	@media (--widthSmall) {
		.talk-details {
			align-items: flex-end;
			flex-direction: row;
		}
	}

	@media (--widthXLarge) {
		.talk {
			max-width: var(--sizeContentAreaNormal);
		}
	}
</style>

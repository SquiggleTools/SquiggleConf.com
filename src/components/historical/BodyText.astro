---
interface Props {
	as?: string;
	class?: string;
}

const { as: As = "div", class: className, ...rest } = Astro.props;
---

<As class:list={["body-text", className]} {...rest}>
	<slot />
</As>

<style>
	.body-text {
		color: var(--colorForegroundBody);
		font-family: var(--fontFamilyBody);
		font-weight: var(--fontWeightBody);
		line-height: var(--lineHeightBody);
		text-align: center;
		padding: 0 var(--widthBodyPadding);
		transition: var(--transitionMedium) line-height;
		font-size: var(--fontSizeBodyLarge);
		max-width: var(--widthBodyLean);
	}
</style>

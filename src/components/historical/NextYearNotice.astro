---
import LinkOut from "~/assets/glyphs/link-out.svg";
import { currentYear } from "~/data/years";

import Hero from "../hero/Hero.astro";

interface Props {
	heading?: boolean;
	year: number;
}

const { heading, year } = Astro.props;
const NoticeHeading = heading ? "h1" : "p";
---

<Hero aria-label={`SquiggleConf ${year}`} class="next-year-notice">
	<NoticeHeading class="notice-heading">
		Thank you to everyone who made SquiggleConf {year} wonderful!
	</NoticeHeading>

	<p class="byline">
		<strong class="next-year">
			<a href="/">
				SquiggleConf {currentYear}
				<LinkOut aria-hidden="true" />
			</a>
		</strong>
	</p>
</Hero>

<style>
	.next-year-notice {
		margin-bottom: 1rem;
		text-align: center;
	}

	.notice-heading {
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeSmall);
		padding: 1rem var(--widthBodyPadding) 2rem;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.byline {
		font-family: var(--fontFamilyBody);
		font-weight: var(--fontWeightLight);
		line-height: var(--lineHeightBody);
	}

	.next-year {
		font-weight: var(--fontWeightSemibold);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeLarge);
	}
</style>

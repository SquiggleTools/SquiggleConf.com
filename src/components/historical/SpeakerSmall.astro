---
import type { Polymorphic } from "astro/types";

import type { PersonInfo } from "~/data/historical/types";

import Avatar from "../Avatar.astro";
import SafeMarkdown from "../SafeMarkdown.astro";

type Props<Tag extends "div" | "li"> = Polymorphic<{
	as: Tag;
	class?: string;
	href?: string;
	person: PersonInfo;
}>;

const {
	as: As = "div",
	class: className,
	href,
	person: speaker,
	...rest
} = Astro.props;
---

<As class:list={["speaker-small", className]} {...rest}>
	<Avatar alt="" size={96} src={speaker.image} />
	<div class="speaker-text">
		<div class="name">
			{href ? (
				<a class="speaker-text-links" href={href}>
					{speaker.name}
				</a>
			) : (
				speaker.name
			)}
		</div>
		<div class="details">
			<div>
				<SafeMarkdown of={speaker.qualification} />
			</div>
		</div>
		<slot />
	</div>
</As>

<style>
	.speaker-small {
		position: relative;
		align-items: center;
		display: flex;
		gap: 1rem;
		text-align: left;
	}

	.speaker-small :global(.avatar) {
		flex: none;
	}

	.speaker-text {
		display: flex;
		flex-basis: fit-content;
		flex-direction: column;
		gap: 0.5rem;
	}

	.speaker-text-links {
		color: inherit;
		outline: none;
		text-decoration: none;
	}

	.speaker-text-links::before {
		border-radius: var(--radiusMedium);
		inset: calc(-1.1 * var(--cardPadding));
		content: "";
		position: absolute;
	}

	.speaker-text-links:focus-visible::before {
		outline: 2px solid currentcolor;
		outline-offset: -2px;
	}

	.speaker-text :global(.icon-links) {
		position: relative;
		z-index: 1;
	}

	.name {
		color: var(--colorCopy);
		font-size: var(--fontSizeSmall);
		display: flex;
		line-height: 0.9em;
	}

	.details {
		font-size: var(--fontSizeSmaller);
		font-weight: var(--fontWeightExtraLight);
		display: flex;
		gap: 0.25rem;
		flex-direction: column;
	}

	.details :global(a) {
		position: relative;
	}
</style>

---
import BioLinks from "../BioLinks.astro";
import BodyText from "../BodyText.astro";
import SectionWrapper from "./SectionWrapper.astro";
import SpeakerSmall from "./SpeakerSmall.astro";
import SubtleCard from "./SubtleCard.astro";
import { PersonInfo, SessionInfo } from "~/data/historical/types";

interface Props {
	talks: SessionInfo[];
	year: number;
}

const { talks, year } = Astro.props;

const seen = new Set<PersonInfo>();
---

<SectionWrapper>
	<BodyText class="speakers-body-text" historical>
		See {year}'s full details on <a href={`/${year}/sessions`}
			>{year} Sessions</a
		> and
		<a href={`/${year}/speakers`}>{year} Speakers</a>.
	</BodyText>

	<ul class="speakers-list">
		{
			talks.map((talk) =>
				talk.people
					.filter((person) => {
						if (seen.has(person)) {
							return false;
						}

						seen.add(person);
						return true;
					})
					.map((person) => (
						<SubtleCard as="li" class="speaker-card">
							<SpeakerSmall
								href={`/${year}/sessions#${talk.slug}`}
								person={person}
							>
								<BioLinks
									class="speaker-bio-links"
									name={person.name}
									links={person.links}
								/>
							</SpeakerSmall>
						</SubtleCard>
					)),
			)
		}
	</ul>
</SectionWrapper>

<style>
	.speakers-body-text {
		margin: 1rem auto;
	}

	.speakers-list {
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyBody);
		gap: 2rem;
		margin: auto;
		max-width: 30rem;
		justify-content: center;
		padding: 2rem var(--widthBodyPadding);
	}

	@media (width >= 700px) {
		.speakers-list {
			align-items: center;
			flex-direction: row;
			flex-wrap: wrap;
			max-width: calc(var(--sizeContentAreaThin) + 4rem);
		}

		.speaker-card {
			width: 47%;
		}
	}

	@media (width >= 1117px) {
		.speakers-list {
			padding: 2rem 0;
			max-width: calc(var(--sizeContentAreaNormal) + 2rem);
		}

		.speaker-card {
			width: 31%;
		}
	}
</style>

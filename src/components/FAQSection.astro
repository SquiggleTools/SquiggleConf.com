---
import Dropdown from "~/assets/glyphs/dropdown.svg";
import { renderMarkdown } from "~/utils/markdown";

import Heading from "./Heading.astro";

export interface Props {
	level?: "h2" | "h3";
	pairs: [string, string][];
	title: string;
}

const { level = "h3", title } = Astro.props;

const pairs = Astro.props.pairs.map(
	([question, answer]) => [question, renderMarkdown(answer)] as const,
);
---

<div>
	<Heading class="faq-heading" level={level}>
		{title}
	</Heading>
	{pairs.map(([question, answer]) => (
		<details>
			<summary>
				<Dropdown
					aria-hidden="true"
					class="faq-dropdown"
					preserveAspectRatio="none"
				/>
				<span>{question}</span>
			</summary>
			<div class="faq-answer" set:html={answer} />
		</details>
	))}
</div>

<style>
	.faq-heading {
		font-size: var(--fontSizeMedium);
		font-weight: var(--fontWeightLight);
	}

	details {
		font-weight: var(--fontWeightExtraLight);
		margin-bottom: 2rem;
		text-align: left;
		width: 100%;
	}

	details[open] {
		margin-bottom: 2.5rem;
	}

	summary {
		align-items: center;
		cursor: pointer;
		display: flex;
		font-weight: var(--fontWeightSemiLight);
		justify-content: flex-start;
		gap: 0.5rem;
		list-style: none;
		margin-top: 1.75rem;
		position: relative;
	}

	details[open] summary {
		margin-bottom: 1rem;
	}

	.faq-dropdown {
		transition: var(--transitionNormal) transform;
		user-select: none;
		height: 0.75rem;
	}

	details[open] .faq-dropdown {
		transform: rotate(180deg);
	}

	.faq-answer :global(p + p) {
		margin-top: 0.75rem;
	}

	@media (--widthMedium) {
		.faq-answer {
			padding: 0 2rem 0 2.5rem;
		}
	}
</style>

<style is:global>
	details ul {
		margin: 0.75rem 0 0.75rem 1rem;
	}

	details li {
		list-style: initial;
	}
</style>

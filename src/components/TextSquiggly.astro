---
import squigglyMedium from "~/assets/design/squiggly-medium.svg";
import squigglyWide from "~/assets/design/squiggly-wide.svg";
import Img from "~/components/Img.astro";

interface Props {
	color?: "blue" | "red";
	width: "medium" | "wide";
}

const images = {
	medium: squigglyMedium,
	wide: squigglyWide,
};

const { color = "red", width, ...props } = Astro.props;
const image = images[width];
---

<em class:list={["text-squiggly", `text-squiggly-${width}`]} {...props}>
	<span class="text">
		<slot name="inside" />
	</span>
	{color === "red" ? (
		<Img alt="" class="squiggly" loading="eager" src={image} />
	) : (
		<span
			class="squiggly squiggly-blue"
			style={`aspect-ratio: ${image.width} / ${image.height}; mask-image: url(${image.src})`}
		/>
	)}
</em>
<slot name="after" />

<style>
	.text-squiggly {
		display: inline-block;
		font-style: inherit;
		position: relative;
	}

	.text {
		z-index: 1;
		position: relative;
	}

	.squiggly {
		position: absolute;
		left: 0;
		user-select: none;
		width: 100%;
	}

	.squiggly-blue {
		background: color-mix(
			in srgb,
			var(--colorBlue3),
			var(--colorBlue2) var(--themeDarkness)
		);
		mask-size: 100% 100%;
	}

	.text-squiggly-medium .squiggly {
		bottom: -0.1em;
	}

	.text-squiggly-wide .squiggly {
		bottom: -0.2em;
	}
</style>

---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	alt: string;
	class?: string;
	size?: number;
	src: ImageMetadata;
}

const { class: className, size, ...rest } = Astro.props;
---

<Image
	class:list={["avatar", className]}
	height={size}
	width={size}
	{...rest}
/>

<style>
	.avatar {
		border-radius: var(--radiusPill);
		user-select: none;
	}
</style>

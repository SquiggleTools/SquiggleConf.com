---
import { Font } from "astro:assets";

import { eventDate } from "~/data/event";
import { currentYear } from "~/data/years";
import { pagePathname } from "~/utils/pathname";

import MotionSetting from "./MotionSetting.astro";
import ThemeSetting from "./ThemeSetting.astro";

export interface Props {
	description: string;
	noIndex?: boolean;
	title?: string;
	year?: number;
}

const { description, noIndex, year = currentYear } = Astro.props;

const banner = new URL("banner.png", Astro.site).toString();
const pageUrl = new URL(pagePathname(Astro.url), Astro.site).toString();

const pageTitle =
	year === currentYear
		? Astro.props.title
		: (Astro.props.title && `${year} ${Astro.props.title}`) ||
			`SquiggleConf ${year}`;

const title = !pageTitle
	? `SquiggleConf | ${eventDate} ${currentYear}: Your Boston devtools field trip.`
	: pageTitle.includes("SquiggleConf")
		? pageTitle
		: `${pageTitle} | SquiggleConf`;

const metaPairs = [
	{
		content: description,
		name: `description`,
	},
	{
		content: `SquiggleConf`,
		property: `og:site_name`,
	},
	{
		content: title,
		property: `og:title`,
	},
	{
		content: description,
		property: `og:description`,
	},
	{
		content: banner,
		property: `og:image`,
	},
	{
		content: `1018`,
		property: `og:image:width`,
	},
	{
		content: `544`,
		property: `og:image:height`,
	},
	{
		content: `SquiggleConf: the devtools conference in Boston`,
		property: `og:image:alt`,
	},
	{
		content: `website`,
		property: `og:type`,
	},
	{
		content: pageUrl,
		property: `og:url`,
	},
	{
		content: `summary_large_image`,
		name: `twitter:card`,
	},
	{
		content: description,
		name: `twitter:description`,
	},
	{
		content: title,
		name: `twitter:title`,
	},
	{
		content: banner,
		name: `twitter:image`,
	},
	{
		content: `@SquiggleConf`,
		name: `twitter:site`,
	},
];
---

<head>
	<meta charset="utf-8" />
	<meta content="width=device-width, initial-scale=1" name="viewport" />
	<Font cssVariable="--fontFamilyBody" preload={[{ subset: "latin" }]} />
	<Font
		cssVariable="--fontFamilyHeading"
		preload={[{ style: "normal", subset: "latin" }]}
	/>
	<Font cssVariable="--fontFamilyLogo" preload={[{ subset: "latin" }]} />
	<Font cssVariable="--fontFamilyMonospace" />
	<ThemeSetting />
	<MotionSetting />
	{noIndex ? (
		<meta content="noindex" name="robots" />
	) : (
		<link href={pageUrl} rel="canonical" />
	)}
	<link href="/favicon.png" rel="icon" type="image/png" />
	<link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
	{metaPairs.map((meta) => (
		<meta {...meta} />
	))}
	<meta content={Astro.generator} name="generator" />
	<meta content=`SquiggleConf ${year}` name="apple-mobile-web-app-title" />
	<title>{title}</title>
</head>

---
import themeMoon from "~/assets/design/theme-moon.svg";
import themeSun from "~/assets/design/theme-sun.svg";
---

<button
	aria-label="Theme toggle (enable JavaScript to use)"
	class="theme-toggle"
>
	<img alt="" class="moon" src={themeMoon.src} />
	<img alt="" class="sun" src={themeSun.src} />
</button>

<style>
	.theme-toggle {
		background: none;
		border: transparent;
		cursor: pointer;
		font-size: 1.5rem;
		height: 2rem;
		opacity: 0.7;
		position: relative;
		transition: var(--transitionFast) opacity;
		width: 2.25rem;
	}

	.theme-toggle:focus-within,
	.theme-toggle:hover {
		opacity: 1;
	}

	img {
		height: 1.75rem;
		position: absolute;
		right: 0;
		top: 0;
	}

	html.dark .sun,
	html:not(.dark) .moon {
		display: none;
	}
</style>

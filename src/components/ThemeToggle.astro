---
import ThemeMoon from "~/assets/design/theme-moon.svg";
import ThemeSun from "~/assets/design/theme-sun.svg";
---

<button aria-label="Dark mode" class="theme-toggle" disabled type="button">
	<ThemeMoon aria-hidden="true" class="moon" />
	<ThemeSun aria-hidden="true" class="sun" />
</button>

<style>
	.theme-toggle {
		background: none;
		border: transparent;
		color: inherit;
		cursor: pointer;
		display: grid;
		opacity: 0.8;
		padding: 0.125rem;
		transition: var(--transitionFast) opacity;
	}

	.theme-toggle:disabled {
		visibility: hidden;
	}

	.theme-toggle:focus-within,
	.theme-toggle:hover {
		opacity: 1;
	}

	svg {
		grid-area: 1 / 1;
		height: 1.25rem;
		width: 1.25rem;
	}

	.moon {
		opacity: var(--themeDarkStep);
	}

	.sun {
		opacity: calc(1 - var(--themeDarkStep));
	}
</style>

<script>
	import { changeTheme, getTheme, themeChangeEvent } from "~/utils/theme";

	for (const toggle of document.querySelectorAll<HTMLButtonElement>(
		".theme-toggle",
	)) {
		const updatePressed = () => {
			toggle.setAttribute("aria-pressed", `${getTheme() === "dark"}`);
		};

		toggle.disabled = false;
		updatePressed();
		document.addEventListener(themeChangeEvent, updatePressed);

		toggle.addEventListener("click", () => {
			changeTheme();
		});
	}
</script>

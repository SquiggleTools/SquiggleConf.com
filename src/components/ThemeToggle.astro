---
import ThemeMoon from "~/assets/design/theme-moon.svg";
import ThemeSun from "~/assets/design/theme-sun.svg";
---

<button
	aria-label="Dark mode (enable JavaScript to use)"
	class="theme-toggle"
	type="button"
>
	<ThemeMoon aria-hidden="true" class="moon" />
	<ThemeSun aria-hidden="true" class="sun" />
</button>

<style>
	.theme-toggle {
		background: none;
		border: transparent;
		color: inherit;
		cursor: pointer;
		display: flex;
		opacity: 0.8;
		padding: 0;
		transition: var(--transitionFast) opacity;
	}

	.theme-toggle:focus-within,
	.theme-toggle:hover {
		opacity: 1;
	}

	svg {
		height: 1.25rem;
		width: 1.25rem;
	}

	html.dark .sun,
	html:not(.dark) .moon {
		display: none;
	}
</style>

<script>
	import { changeTheme, getTheme, themeChangeEvent } from "~/utils/theme";

	for (const toggle of document.querySelectorAll(".theme-toggle")) {
		const updatePressed = () => {
			toggle.setAttribute("aria-pressed", `${getTheme() === "dark"}`);
		};

		toggle.setAttribute("aria-label", "Dark mode");
		updatePressed();
		document.addEventListener(themeChangeEvent, updatePressed);

		toggle.addEventListener("click", () => {
			changeTheme();
		});
	}
</script>

---
import ThemeMoon from "~/assets/design/theme-moon.svg";
import ThemeSun from "~/assets/design/theme-sun.svg";
---

<button
	aria-label="Theme toggle (enable JavaScript to use)"
	class="theme-toggle"
>
	<ThemeMoon aria-hidden="true" class="moon" />
	<ThemeSun aria-hidden="true" class="sun" />
</button>

<style>
	.theme-toggle {
		background: none;
		border: transparent;
		color: light-dark(var(--colorBlue3), var(--colorBlue1));
		cursor: pointer;
		font-size: 1.5rem;
		height: 1.5rem;
		opacity: 0.7;
		position: relative;
		transition: var(--transitionFast) opacity;
		width: 2.25rem;
	}

	.theme-toggle:focus-within,
	.theme-toggle:hover {
		opacity: 1;
	}

	svg {
		height: 1.75rem;
		position: absolute;
		right: 0;
		top: 0;
		width: auto;
	}

	html.dark .sun,
	html:not(.dark) .moon {
		display: none;
	}
</style>

<script>
	const html = document.documentElement;
	const reducedMotionQuery = matchMedia("(prefers-reduced-motion: reduce)");

	for (const toggle of document.querySelectorAll(".theme-toggle")) {
		const updateLabel = () => {
			const theme = html.classList.contains("dark") ? "dark" : "light";
			toggle.setAttribute("aria-label", `Theme toggle (current: ${theme})`);
		};

		const toggleTheme = () => {
			const dark = html.classList.toggle("dark");
			localStorage.setItem("theme", dark ? "dark" : "light");
			updateLabel();
		};

		updateLabel();

		toggle.addEventListener("click", () => {
			if (reducedMotionQuery.matches || !document.startViewTransition) {
				toggleTheme();
			} else {
				document.startViewTransition(toggleTheme);
			}
		});
	}
</script>

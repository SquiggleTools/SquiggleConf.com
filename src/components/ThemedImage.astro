---
import type { ImageMetadata } from "astro";

import Img from "~/components/Img.astro";

interface Props {
	alt: string;
	class?: string;
	height?: number;
	/** One image per theme; only the current theme's is displayed. */
	sources: Record<"dark" | "light", ImageMetadata>;
}

const { class: className, sources, ...rest } = Astro.props;
---

{(["dark", "light"] as const).map((theme) => (
	<Img
		class:list={[className, `themed-image-${theme}`]}
		src={sources[theme]}
		{...rest}
	/>
))}

<style>
	html.dark .themed-image-light,
	html:not(.dark) .themed-image-dark {
		display: none;
	}
</style>

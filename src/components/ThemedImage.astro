---
import type { ImageMetadata } from "astro";

import Img from "~/components/Img.astro";

interface Props {
	alt: string;
	class?: string;
	height?: number;
	/** One image per theme; only the current theme's is displayed. */
	sources: Record<"dark" | "light", ImageMetadata>;
}

const { alt, class: className, sources, ...rest } = Astro.props;
---

<span class="themed-image">
	<Img
		alt=""
		aria-hidden="true"
		class:list={[className, "themed-image-dark"]}
		src={sources.dark}
		{...rest}
	/>
	<Img
		alt={alt}
		class:list={[className, "themed-image-light"]}
		src={sources.light}
		{...rest}
	/>
</span>

<style>
	.themed-image {
		display: inline-grid;
	}

	.themed-image-dark,
	.themed-image-light {
		grid-area: 1 / 1;
	}

	.themed-image-dark {
		opacity: var(--themeDarkStep);
	}

	.themed-image-light {
		opacity: calc(1 - var(--themeDarkStep));
	}
</style>

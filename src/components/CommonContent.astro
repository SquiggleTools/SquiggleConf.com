---
import { slugify } from "~/utils/id";
import ContentArea from "./ContentArea.astro";
import Heading from "./Heading.astro";

interface Props {
	class?: string;
	heading?: string;
}

const { class: className, heading, ...props } = Astro.props;
---

<ContentArea class:list={["common-content", className]} width="thin" {...props}>
	{
		heading && (
			<Heading id={slugify(heading)} level="h2">
				{heading}
			</Heading>
		)
	}
	<slot />
</ContentArea>

<style>
	.common-content {
		display: flex;
		flex-direction: column;
		margin: 0 auto;
		padding: 5rem 0;
	}

	.common-content + .common-content {
		margin-top: 0;
		padding-top: 0;
	}

	h2 {
		color: var(--colorForegroundEmphasized);
		font-family: var(--fontFamilyLogo);
		font-size: var(--fontSizeLarge);
		padding-bottom: 2rem;
		text-align: center;
	}
</style>

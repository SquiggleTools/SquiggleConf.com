---
import Bio, { Props as BioProps } from "~/components/Bio.astro";

interface Props {
	bios: BioProps[];
	class?: string;
}

const { bios, class: className, ...rest } = Astro.props;
---

<ul class:list={["bios", className]} {...rest}>
	{bios.map((bio) => <Bio {...bio} />)}
</ul>

<style>
	.bios {
		display: flex;
		flex-wrap: wrap;
		font-family: var(--fontFamilyHeading);
		justify-content: center;
		margin: 2rem auto;
		row-gap: 2rem;
		text-align: center;
		width: 100%;
		max-width: 35rem;
	}
</style>

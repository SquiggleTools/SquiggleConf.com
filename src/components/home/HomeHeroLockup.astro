---
import { eventDate, eventLocation } from "~/data/event";

import Logo from "../Logo.astro";
---

<div class="hero-intro">
	<Logo as="h1" bold />
	<p class="hero-subtitle">
		{eventDate} · {eventLocation}
	</p>
</div>

<style>
	.hero-intro {
		align-items: center;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		justify-content: center;
		padding: clamp(0.35rem, 1vw, 1.75rem) 0;
		text-align: center;
	}

	.hero-subtitle {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(0.95rem, 2vw, 1.45rem);
		font-style: italic;
		font-weight: var(--fontWeightLight);
		letter-spacing: 0.05em;
		margin: 0 0 0.35rem;
	}

	@media (--widthLarge) {
		.hero-intro {
			align-items: flex-start;
			gap: 0.75rem;
			padding: 0;
			text-align: left;
		}

		.hero-intro :global(.logo-bold) {
			font-size: clamp(3.2rem, 5.6vw, 4.4rem);
			letter-spacing: -3px;
		}

		.hero-subtitle {
			margin: 0;
		}
	}
</style>

---
import type { PersonCardData, TalkCardData } from "~/components/home/types";
import TimelineHeading from "./timeline/TimelineHeading.astro";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	/** With a talk title, the title leads and the name moves under it. */
	person: PersonCardData | TalkCardData;
}

const { person } = Astro.props;
const title = "title" in person ? person.title : undefined;
---

<article class:list={["person-card", title && "person-card-talk"]}>
	<TimelineImage
		alt={person.name}
		effect="zoom"
		placeholder={person.placeholder}
		src={person.image}
	/>
	<div class="person-card-copy">
		{
			title ? (
				<>
					<TimelineHeading class="person-card-title" level="h3">
						{title}
					</TimelineHeading>
					<p class="person-card-name">{person.name}</p>
				</>
			) : (
				<TimelineHeading class="person-card-title" level="h3">
					{person.name}
				</TimelineHeading>
			)
		}
		<p class="person-card-role">{person.qualification}</p>
	</div>
</article>

<style>
	.person-card {
		align-items: center;
		display: grid;
		gap: 0.8rem;
		grid-template-columns: 5rem 1fr;
	}

	.person-card-talk {
		align-items: stretch;
	}

	.person-card-copy {
		display: grid;
		gap: 0.28rem;
		min-height: 5rem;
		place-content: center start;
	}

	.person-card-talk .person-card-copy {
		gap: normal;
		grid-template-rows: 2fr 1fr 1fr;
		min-height: 5.75rem;
		place-content: normal;
	}

	.person-card-title {
		font-size: var(--fontSizeSmaller);
		line-height: 1.15;
		margin: 0;
	}

	.person-card-talk .person-card-title {
		align-self: center;
		line-height: 1.25;
	}

	.person-card-name {
		color: var(--colorMuted);
		font-size: var(--fontSizeSmaller);
		font-weight: var(--fontWeightSemibold);
	}

	.person-card-role {
		color: var(--colorMuted);
		font-size: var(--fontSizeCaption);
		font-weight: var(--fontWeightLight);
		line-height: 1.25;
		margin: 0;
	}
</style>

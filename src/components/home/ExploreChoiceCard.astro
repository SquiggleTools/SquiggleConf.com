---
import type { ExploreChoiceData } from "~/components/home/types";
import TimelineHeading from "./timeline/TimelineHeading.astro";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	choice: ExploreChoiceData;
}

const { choice } = Astro.props;
---

<article class="explore-card">
	<div class="explore-choice" aria-hidden="true">
		<span class="explore-radio"><span class="explore-radio-dot"></span></span>
	</div>
	<div class="explore-card-body">
		<TimelineImage
			alt={choice.alt}
			class="explore-photo"
			effect="grow"
			objectPosition={choice.objectPosition}
			src={choice.image}
		/>
		<div class="explore-copy">
			<TimelineHeading class="explore-title" level="h3">
				{choice.title}
			</TimelineHeading>
			<p>{choice.description}</p>
		</div>
		{
			choice.badgeLabel && (
				<div class="explore-spots-left">{choice.badgeLabel}</div>
			)
		}
	</div>
</article>

<style>
	.explore-card {
		background: rgb(from white r g b / 8%);
		border: 1px solid var(--colorBlue3);
		border-radius: var(--radiusMedium);
		box-shadow: inset 0 0 0 0 rgb(from white r g b / 14%);
		display: grid;
		grid-template-columns: 3.5rem 1fr;
		position: relative;
		transition:
			background-color var(--transitionNormal),
			border-color var(--transitionNormal),
			box-shadow var(--transitionNormal),
			transform var(--transitionNormal);
	}

	.explore-card:hover {
		background: light-dark(
			rgb(from var(--colorBlue5) r g b / 4%),
			rgb(from white r g b / 14%)
		);
		border-color: light-dark(var(--colorBlue3), rgb(from white r g b / 38%));
		box-shadow: inset 0 0 0 1px
			light-dark(
				rgb(from var(--colorBlue4) r g b / 6%),
				rgb(from white r g b / 12%)
			);
		transform: translateX(0.08rem);
	}

	.explore-choice {
		align-items: center;
		border-right: 1px solid var(--colorBlue3);
		display: flex;
		justify-content: center;
		padding: 0.75rem 0.25rem;
	}

	.explore-radio {
		align-items: center;
		background: light-dark(
			rgb(from var(--colorBlue5) r g b / 4%),
			rgb(from white r g b / 8%)
		);
		border: 2px solid
			light-dark(
				rgb(from var(--colorBlue4) r g b / 45%),
				rgb(from white r g b / 74%)
			);
		border-radius: var(--radiusPill);
		display: inline-flex;
		height: 1.45rem;
		justify-content: center;
		transition:
			background-color var(--transitionNormal),
			border-color var(--transitionNormal),
			box-shadow var(--transitionNormal);
		width: 1.45rem;
	}

	.explore-card:hover .explore-radio {
		background: light-dark(
			rgb(from var(--colorBlue5) r g b / 8%),
			rgb(from white r g b / 12%)
		);
		border-color: light-dark(
			rgb(from var(--colorBlue4) r g b / 85%),
			rgb(from white r g b / 95%)
		);
		box-shadow: 0 0 0 0.18rem
			light-dark(
				rgb(from var(--colorBlue5) r g b / 8%),
				rgb(from white r g b / 12%)
			);
	}

	.explore-radio-dot {
		background: var(--colorLink);
		border-radius: var(--radiusPill);
		display: block;
		height: 0.46rem;
		opacity: 0;
		transform: scale(0.2);
		transition:
			opacity var(--transitionNormal),
			transform var(--transitionNormal);
		width: 0.46rem;
	}

	.explore-card:hover .explore-radio-dot {
		opacity: 1;
		transform: scale(1);
	}

	.explore-card-body {
		align-items: start;
		display: grid;
		column-gap: 1rem;
		grid-template-columns: 4.8rem minmax(0, 1fr);
		min-width: 0;
		padding: 0.85rem 1rem;
	}

	.explore-photo {
		height: 4.8rem;
		min-width: 4.8rem;
		width: 4.8rem;
	}

	.explore-copy {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.explore-title {
		font-size: clamp(1.2rem, 1.7vw, 1.45rem);
		line-height: 1.05;
		margin: 0;
	}

	.explore-copy p {
		color: var(--colorCopy);
		font-size: var(--fontSizeCopySmall);
		line-height: 1.4;
		margin: 0;
		max-width: 48ch;
	}

	.explore-spots-left {
		background: light-dark(var(--colorBlueBright1), var(--colorBlue3));
		border: 1px solid var(--colorImageBorder);
		border-radius: var(--radiusSmall);
		color: light-dark(var(--colorBlue4), var(--colorCopy));
		font-size: 0.8em;
		font-variant: tabular-nums;
		padding: 8px 10px;
		position: absolute;
		right: -1em;
		text-transform: uppercase;
		top: -1em;
	}

	@media not (--widthLarge) {
		.explore-card {
			grid-template-columns: 3rem minmax(0, 1fr);
		}

		.explore-choice {
			padding: 0.65rem 0.2rem;
		}

		.explore-card-body {
			column-gap: 0.7rem;
			grid-template-columns: 4rem minmax(0, 1fr);
			padding: 0.7rem 0.8rem;
			align-items: center;
		}

		.explore-photo {
			height: 4rem;
			min-width: 4rem;
			width: 4rem;
		}

		.explore-title {
			font-size: 1.15rem;
		}
	}
</style>

---
import type { ExploreChoiceData } from "~/components/home/types";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	choice: ExploreChoiceData;
}

const { choice } = Astro.props;
---

<article class="explore-card">
	<div class="explore-choice" aria-hidden="true">
		<span class="explore-radio"><span class="explore-radio-dot"></span></span>
	</div>
	<div class="explore-card-body">
		<TimelineImage
			alt={choice.alt}
			class="explore-photo"
			effect="grow"
			objectPosition={choice.objectPosition}
			src={choice.image}
		/>
		<div class="explore-copy">
			<h3>{choice.title}</h3>
			<p>{choice.description}</p>
		</div>
		{
			choice.badgeLabel && (
				<div class="explore-spots-left">{choice.badgeLabel}</div>
			)
		}
	</div>
</article>

<style>
	.explore-card {
		--explore-card-hover-background: rgb(from var(--colorBlue5) r g b / 4%);
		--explore-card-hover-border: var(--colorBlue3);
		--explore-card-hover-ring: rgb(from var(--colorBlue4) r g b / 6%);
		--explore-radio-background: rgb(from var(--colorBlue5) r g b / 4%);
		--explore-radio-border: rgb(from var(--colorBlue4) r g b / 45%);
		--explore-radio-hover-background: rgb(from var(--colorBlue5) r g b / 8%);
		--explore-radio-hover-border: rgb(from var(--colorBlue4) r g b / 85%);
		--explore-radio-hover-ring: rgb(from var(--colorBlue5) r g b / 8%);
		--explore-spots-background: var(--colorBlueBright1);
		--explore-spots-color: var(--colorBlue4);
		background: rgb(from white r g b / 8%);
		border: 1px solid var(--colorBlue3);
		border-radius: var(--radiusMedium);
		box-shadow: inset 0 0 0 0 rgb(from white r g b / 14%);
		display: grid;
		grid-template-columns: 3.5rem 1fr;
		position: relative;
		transition:
			background-color var(--transitionNormal) ease,
			border-color var(--transitionNormal) ease,
			box-shadow var(--transitionNormal) ease,
			transform var(--transitionNormal) ease;
	}

	:global(html.dark) .explore-card {
		--explore-card-hover-background: rgb(from white r g b / 14%);
		--explore-card-hover-border: rgb(from white r g b / 38%);
		--explore-card-hover-ring: rgb(from white r g b / 12%);
		--explore-radio-background: rgb(from white r g b / 8%);
		--explore-radio-border: rgb(from white r g b / 74%);
		--explore-radio-hover-background: rgb(from white r g b / 12%);
		--explore-radio-hover-border: rgb(from white r g b / 95%);
		--explore-radio-hover-ring: rgb(from white r g b / 12%);
		--explore-spots-background: var(--colorBlue3);
		--explore-spots-color: var(--colorCopy);
	}

	.explore-card:hover {
		background: var(--explore-card-hover-background);
		border-color: var(--explore-card-hover-border);
		box-shadow: inset 0 0 0 1px var(--explore-card-hover-ring);
		transform: translateX(0.08rem);
	}

	.explore-choice {
		align-items: center;
		border-right: 1px solid var(--colorBlue3);
		display: flex;
		justify-content: center;
		padding: 0.75rem 0.25rem;
	}

	.explore-radio {
		align-items: center;
		background: var(--explore-radio-background);
		border: 2px solid var(--explore-radio-border);
		border-radius: var(--radiusPill);
		display: inline-flex;
		height: 1.45rem;
		justify-content: center;
		transition:
			background-color var(--transitionNormal) ease,
			border-color var(--transitionNormal) ease,
			box-shadow var(--transitionNormal) ease;
		width: 1.45rem;
	}

	.explore-card:hover .explore-radio {
		background: var(--explore-radio-hover-background);
		border-color: var(--explore-radio-hover-border);
		box-shadow: 0 0 0 0.18rem var(--explore-radio-hover-ring);
	}

	.explore-radio-dot {
		background: var(--colorLink);
		border-radius: var(--radiusPill);
		display: block;
		height: 0.46rem;
		opacity: 0;
		transform: scale(0.2);
		transition:
			opacity var(--transitionNormal) ease,
			transform var(--transitionNormal) ease;
		width: 0.46rem;
	}

	.explore-card:hover .explore-radio-dot {
		opacity: 1;
		transform: scale(1);
	}

	.explore-card-body {
		align-items: start;
		display: grid;
		column-gap: 1rem;
		grid-template-columns: 4.8rem minmax(0, 1fr);
		min-width: 0;
		padding: 0.85rem 1rem;
	}

	.explore-photo {
		height: 4.8rem;
		min-width: 4.8rem;
		width: 4.8rem;
	}

	.explore-copy {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.explore-copy h3 {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.2rem, 1.7vw, 1.45rem);
		font-weight: var(--fontWeightHeavy);
		line-height: 1.05;
		margin: 0;
	}

	.explore-copy p {
		color: var(--colorCopy);
		font-size: clamp(0.95rem, 1.25vw, 1rem);
		line-height: 1.4;
		margin: 0;
		max-width: 48ch;
	}

	.explore-spots-left {
		background: var(--explore-spots-background);
		border: 1px solid var(--colorImageBorder);
		border-radius: var(--radiusSmall);
		color: var(--explore-spots-color);
		font-size: 0.8em;
		font-variant: tabular-nums;
		padding: 8px 10px;
		position: absolute;
		right: -1em;
		text-transform: uppercase;
		top: -1em;
	}

	@media (width < 900px) {
		.explore-card {
			grid-template-columns: 3rem minmax(0, 1fr);
		}

		.explore-choice {
			padding: 0.65rem 0.2rem;
		}

		.explore-card-body {
			column-gap: 0.7rem;
			grid-template-columns: 4rem minmax(0, 1fr);
			padding: 0.7rem 0.8rem;
			align-items: center;
		}

		.explore-photo {
			height: 4rem;
			min-width: 4rem;
			width: 4rem;
		}

		.explore-copy h3 {
			font-size: 1.15rem;
		}
	}
</style>

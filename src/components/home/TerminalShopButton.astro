---
import { Image } from "astro:assets";

import terminalShop from "~/assets/2027/terminal.shop.svg";
import Button from "../Button.astro";
---

<Button
	as="a"
	class="timeline-checkin-button"
	href="https://terminal.shop"
	rel="noreferrer"
	target="_blank"
	variant="terminal"
>
	<Image
		alt=""
		aria-hidden="true"
		class="timeline-checkin-button-icon"
		src={terminalShop}
	/>
	<span class="timeline-checkin-button-label">terminal.shop coffee</span>
</Button>

<style>
	.timeline-checkin-button {
		height: fit-content;
		justify-self: start;
		margin-top: 1rem;
		text-wrap: balance;
		width: fit-content;
	}

	.timeline-checkin-button-icon {
		display: block;
		height: 1.5rem;
		width: auto;
	}

	.timeline-checkin-button-label {
		font-family: var(--fontFamilyMonospace);
		font-size: 0.95rem;
		font-weight: var(--fontWeightSemiLight);
		letter-spacing: 0.03em;
		line-height: 1;
	}
</style>

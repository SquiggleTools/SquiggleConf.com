---
import { Image } from "astro:assets";

import { terminalShop } from "~/components/home/data";
---

<a
	class="timeline-checkin-button"
	href="https://terminal.shop"
	rel="noreferrer"
	target="_blank"
>
	<Image
		alt=""
		aria-hidden="true"
		class="timeline-checkin-button-icon"
		src={terminalShop}
	/>
	<span>terminal.shop coffee</span>
</a>

<style>
	.timeline-checkin-button {
		align-items: center;
		backdrop-filter: blur(16px) saturate(155%);
		background: linear-gradient(
			140deg,
			rgba(255, 94, 0, 0.34) 0%,
			rgba(255, 124, 24, 0.28) 38%,
			rgba(255, 153, 51, 0.22) 68%,
			rgba(255, 94, 0, 0.3) 100%
		);
		border: 1px solid #ff5e00;
		border-radius: 0.9rem;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.2),
			0 1rem 2rem rgba(255, 94, 0, 0.16),
			0 0 0 1px rgba(255, 94, 0, 0.12);
		color: var(--colorBlue5);
		display: inline-flex;
		gap: 0.7rem;
		height: fit-content;
		justify-self: start;
		margin-top: 1rem;
		padding: 0.75rem 1.1rem 0.75rem 0.9rem;
		text-decoration: none;
		text-wrap: balance;
		transition:
			background 180ms ease,
			box-shadow 180ms ease,
			opacity 180ms ease,
			transform 180ms ease;
		width: fit-content;
	}

	.timeline-checkin-button:hover,
	.timeline-checkin-button:focus-visible {
		background: linear-gradient(
			140deg,
			rgba(255, 94, 0, 0.56) 0%,
			rgba(255, 124, 24, 0.48) 38%,
			rgba(255, 153, 51, 0.42) 68%,
			rgba(255, 94, 0, 0.52) 100%
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.22),
			0 1rem 2rem rgba(255, 94, 0, 0.22),
			0 0 0 1px rgba(255, 94, 0, 0.18);
		outline: none;
		transform: translateY(-1px);
	}

	.timeline-checkin-button-icon {
		display: block;
		height: 1.5rem;
		width: auto;
	}

	.timeline-checkin-button span {
		font-family: var(--fontFamilyMonospace);
		font-size: 0.95rem;
		font-weight: var(--fontWeightSemibold);
		letter-spacing: 0.03em;
		line-height: 1;
	}

	:global(html.dark) .timeline-checkin-button {
		color: #f7fbff;
	}
</style>

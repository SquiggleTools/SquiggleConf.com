---
import { Image } from "astro:assets";

import { terminalShop } from "~/components/home/data";
---

<a
	class="timeline-checkin-button"
	href="https://terminal.shop"
	rel="noreferrer"
	target="_blank"
>
	<Image
		alt=""
		aria-hidden="true"
		class="timeline-checkin-button-icon"
		src={terminalShop}
	/>
	<span>terminal.shop coffee</span>
</a>

<style>
	.timeline-checkin-button {
		--terminal-orange: #ff5e00;
		align-items: center;
		backdrop-filter: var(--backdropFrosted);
		background: linear-gradient(
			140deg,
			rgb(from var(--terminal-orange) r g b / 34%) 0%,
			rgba(255, 124, 24, 0.28) 38%,
			rgba(255, 153, 51, 0.22) 68%,
			rgb(from var(--terminal-orange) r g b / 30%) 100%
		);
		border: 1px solid var(--terminal-orange);
		border-radius: var(--radiusLarge);
		box-shadow:
			inset 0 1px 0 rgb(from white r g b / 20%),
			0 1rem 2rem rgb(from var(--terminal-orange) r g b / 16%),
			0 0 0 1px rgb(from var(--terminal-orange) r g b / 12%);
		color: var(--colorHeading);
		display: inline-flex;
		gap: 0.7rem;
		height: fit-content;
		justify-self: start;
		margin-top: 1rem;
		padding: 0.75rem 1.1rem 0.75rem 0.9rem;
		text-decoration: none;
		text-wrap: balance;
		transition:
			background var(--transitionNormal) ease,
			box-shadow var(--transitionNormal) ease,
			transform var(--transitionNormal) ease;
		width: fit-content;
	}

	.timeline-checkin-button:hover,
	.timeline-checkin-button:focus-visible {
		background: linear-gradient(
			140deg,
			rgb(from var(--terminal-orange) r g b / 56%) 0%,
			rgba(255, 124, 24, 0.48) 38%,
			rgba(255, 153, 51, 0.42) 68%,
			rgb(from var(--terminal-orange) r g b / 52%) 100%
		);
		box-shadow:
			inset 0 1px 0 rgb(from white r g b / 22%),
			0 1rem 2rem rgb(from var(--terminal-orange) r g b / 22%),
			0 0 0 1px rgb(from var(--terminal-orange) r g b / 18%);
		outline: none;
		transform: translateY(-1px);
	}

	.timeline-checkin-button-icon {
		display: block;
		height: 1.5rem;
		width: auto;
	}

	.timeline-checkin-button span {
		font-family: var(--fontFamilyMonospace);
		font-size: 0.95rem;
		font-weight: var(--fontWeightSemibold);
		letter-spacing: 0.03em;
		line-height: 1;
	}
</style>

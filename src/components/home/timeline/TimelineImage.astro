---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import Img from "~/components/Img.astro";
import { getCoverImageProps } from "~/utils/images";

import PlaceholderMark from "../PlaceholderMark.astro";

type Props = TimelineImageProps &
	(
		| { size: number; src: ImageMetadata }
		/** Without a src, the frame wraps its slotted content instead. */
		| { size?: undefined; src?: undefined }
	);

interface TimelineImageProps extends HTMLAttributes<"div"> {
	alt?: string;
	columnWidth?: number;
	/** How the image responds while its timeline entry is active. */
	effect?: "grow" | "zoom";
	loading?: "eager" | "lazy";
	objectPosition?: string;
	placeholder?: boolean;
	radius?: string;
	scale?: number;
	zoomOrigin?: string;
}

const {
	alt = "",
	class: className,
	columnWidth,
	effect,
	loading,
	objectPosition,
	placeholder,
	radius,
	scale = 1,
	size,
	src,
	zoomOrigin,
	...rest
} = Astro.props;

const imageStyle = [
	objectPosition && `object-position: ${objectPosition}`,
	zoomOrigin && `transform-origin: ${zoomOrigin}`,
]
	.filter(Boolean)
	.join("; ");

const effectScale = { grow: 1.25, zoom: 1.1 } as const;
---

<div
	class:list={[
		"timeline-image",
		effect && `timeline-image-${effect}`,
		className,
	]}
	style={radius && `border-radius: ${radius}`}
	{...rest}
>
	{src ? (
		<Img
			alt={alt}
			aria-hidden={alt ? undefined : "true"}
			class:list={[placeholder && "timeline-image-placeholder"]}
			loading={loading}
			src={src}
			style={imageStyle || undefined}
			{...getCoverImageProps(
				src,
				size,
				scale * (effect ? effectScale[effect] : 1),
				columnWidth,
			)}
		/>
	) : (
		<slot />
	)}
	{placeholder && <PlaceholderMark />}
</div>

<style>
	.timeline-image {
		background: var(--colorWhite);
		border: var(--sizeImageBorder) solid var(--colorImageBorder);
		border-radius: var(--radiusMedium);
		box-shadow: var(--timeline-image-shadow);
		box-sizing: border-box;
		overflow: hidden;
		position: relative;
		transform-origin: center;
		transition:
			border-width var(--transitionNormal),
			box-shadow var(--transitionNormal),
			scale var(--transitionNormal);
	}

	.timeline-image-grow {
		border-width: var(--timeline-image-grow-border-width);
		scale: var(--timeline-image-scale);
	}

	img {
		border-radius: inherit;
		display: block;
		height: 100%;
		object-fit: cover;
		transform-origin: center;
		transition:
			filter var(--transitionNormal),
			transform var(--transitionNormal);
		user-select: none;
		width: 100%;
	}

	.timeline-image-zoom img {
		transform: scale(var(--timeline-image-zoom));
	}

	.timeline-image-placeholder {
		filter: blur(2px);
	}
</style>

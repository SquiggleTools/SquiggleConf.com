<section class="timeline-section" aria-label="Timeline preview">
	<slot />
</section>

<style>
	.timeline-section {
		--timeline-heading-color: var(--colorBlue5);
		--timeline-heading-hover-color: var(--colorBlue5);
		--timeline-heading-hover-shadow: none;
		--timeline-copy-color: rgb(from var(--colorBlue5) r g b / 84%);
		--timeline-copy-hover-color: rgb(from var(--colorBlue5) r g b / 92%);
		--timeline-muted-color: rgb(from var(--colorBlue4) r g b / 76%);
		--timeline-muted-hover-color: rgb(from var(--colorBlue4) r g b / 86%);
		--timeline-link-color: var(--colorBlue4);
		--timeline-rail-background: rgb(from white r g b / 42%);
		--timeline-rail-border-color: rgb(from var(--colorBlue4) r g b / 18%);
		--timeline-cap-background: rgb(from var(--colorBlueBright1) r g b / 62%);
		--timeline-cap-color: var(--colorBlue5);
		--timeline-time-color: var(--colorBlue5);
		--timeline-time-shadow: 0 1px 0 rgb(from white r g b / 46%);
		--timeline-venue-color: rgb(from var(--colorBlue5) r g b / 90%);
		--timeline-venue-at-color: rgb(from var(--colorBlue3) r g b / 68%);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem
			rgb(from var(--colorBlue5) r g b / 10%);
		--timeline-card-hover-background: linear-gradient(
			135deg,
			rgb(from var(--colorBlue5) r g b / 5%),
			rgb(from var(--colorBlue5) r g b / 2%)
		);
		--timeline-card-hover-shadow:
			inset 0 0 0 1px rgb(from var(--colorBlue4) r g b / 10%),
			0 1rem 2rem rgb(from var(--colorBlue5) r g b / 8%);
		--timeline-card-glow-inner: rgb(from var(--colorBlue4) r g b / 55%);
		--timeline-card-glow-outer: rgb(from var(--colorBlue4) r g b / 25%);
		--timeline-image-border-color: rgb(from var(--colorBlue5) r g b / 18%);
		--timeline-image-border-width: 2px;
		--timeline-image-shadow-rest: 0 0.25rem 0.7rem
			rgb(from var(--colorBlue5) r g b / 12%);
		--timeline-image-shadow-active: 0 0.55rem 1rem
			rgb(from var(--colorBlue5) r g b / 18%);
		--timeline-image-shadow: var(--timeline-image-shadow-rest);
		--timeline-image-scale: 1;
		--timeline-image-zoom: 1;
		--timeline-hover-duration: 220ms;
		isolation: isolate;
		padding: 2rem clamp(0.15rem, 0.5vw, 1rem) clamp(3rem, 7vw, 5rem);
		position: relative;
	}

	:global(html.dark) .timeline-section {
		--timeline-heading-color: var(--colorWhiteIsh);
		--timeline-heading-hover-color: white;
		--timeline-heading-hover-shadow: 0 0.3rem 1rem
			rgb(from var(--colorBlue5) r g b / 24%);
		--timeline-copy-color: rgb(from var(--colorWhiteIsh) r g b / 84%);
		--timeline-copy-hover-color: rgb(from white r g b / 90%);
		--timeline-muted-color: rgb(from var(--colorBlue1) r g b / 82%);
		--timeline-muted-hover-color: rgb(from white r g b / 88%);
		--timeline-link-color: white;
		--timeline-rail-background: var(--colorBlueBright1);
		--timeline-rail-border-color: var(--colorBlue3);
		--timeline-cap-background: rgb(from var(--colorBlue2) r g b / 60%);
		--timeline-cap-color: rgb(from var(--colorBackground) r g b / 85%);
		--timeline-time-color: var(--colorBackground);
		--timeline-time-shadow: 0 1px 0 rgb(from white r g b / 22%);
		--timeline-venue-color: var(--timeline-heading-color);
		--timeline-venue-at-color: rgb(from var(--colorBlue2) r g b / 70%);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem
			rgb(from var(--colorBlue5) r g b / 18%);
		--timeline-card-hover-background: linear-gradient(
			135deg,
			rgb(from white r g b / 13%),
			rgb(from white r g b / 3%)
		);
		--timeline-card-hover-shadow:
			inset 0 0 0 1px rgb(from white r g b / 8%),
			0 1rem 2rem rgb(from var(--colorBlue5) r g b / 14%);
		--timeline-card-glow-inner: color-mix(in srgb, var(--colorBlue2), white 8%);
		--timeline-card-glow-outer: rgb(from var(--colorBlue2) r g b / 52%);
	}

	/* Shared frame for timeline images; :where() lets components override it. */
	:global(:where(.timeline-image)) {
		background: white;
		border: var(--timeline-image-border-width) solid
			var(--timeline-image-border-color);
		border-radius: 0.35rem;
		box-shadow: var(--timeline-image-shadow);
		box-sizing: border-box;
		overflow: hidden;
		transform-origin: center;
		transition:
			border-width var(--timeline-hover-duration) ease,
			box-shadow var(--timeline-hover-duration) ease,
			scale var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease;
	}

	:global(:where(.timeline-image) :is(picture, img)) {
		display: block;
		height: 100%;
		width: 100%;
	}

	:global(:where(.timeline-image) img) {
		border-radius: inherit;
		object-fit: cover;
		transform-origin: center;
		transition:
			filter var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease;
		user-select: none;
	}

	/* Frames that grow, or whose images zoom, while their entry is active. */
	:global(:where(.timeline-image-grow)) {
		scale: var(--timeline-image-scale);
	}

	:global(:where(.timeline-image-zoom) img) {
		transform: scale(var(--timeline-image-zoom));
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline-section,
		.timeline-section :global(*),
		.timeline-section :global(*::before),
		.timeline-section :global(*::after) {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	import { onScrollFrame } from "./onScrollFrame";

	const cards = [
		...document.querySelectorAll<HTMLElement>(".timeline-content"),
	];
	const headings = cards.map((card) => card.querySelector("h2") ?? card);
	const postcard = document.querySelector<HTMLElement>(".postcard-stack-flip");
	const mobileQuery = matchMedia("(max-width: 899px)");

	onScrollFrame(() => {
		const mobile = mobileQuery.matches;
		const threshold = innerHeight / 2;
		const activeCard = mobile
			? cards.findLast(
					(_, index) =>
						headings[index].getBoundingClientRect().top <= threshold,
				)
			: undefined;

		for (const card of cards) {
			card.toggleAttribute("data-mobile-active", card === activeCard);
		}

		if (postcard) {
			const { height, top } = postcard.getBoundingClientRect();
			postcard.toggleAttribute(
				"data-mobile-flipped",
				mobile && top + height / 2 <= threshold,
			);
		}
	}, mobileQuery);

	const toPercent = (fraction: number) =>
		`${(Math.min(Math.max(fraction, 0), 1) * 100).toFixed(2)}%`;

	for (const card of cards) {
		card.addEventListener("pointermove", (event) => {
			if (!mobileQuery.matches) {
				const rect = card.getBoundingClientRect();
				card.style.setProperty(
					"--timeline-card-pointer-x",
					toPercent((event.clientX - rect.left) / rect.width),
				);
				card.style.setProperty(
					"--timeline-card-pointer-y",
					toPercent((event.clientY - rect.top) / rect.height),
				);
			}
		});

		card.addEventListener("pointerleave", () => {
			card.style.removeProperty("--timeline-card-pointer-x");
			card.style.removeProperty("--timeline-card-pointer-y");
		});
	}
</script>

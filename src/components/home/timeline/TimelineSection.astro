<section class="timeline-section" aria-label="Timeline preview">
	<slot />
</section>

<style>
	.timeline-section {
		--timeline-heading-color: var(--colorBlue5);
		--timeline-heading-hover-color: var(--colorBlue5);
		--timeline-copy-color: rgba(4, 25, 48, 0.84);
		--timeline-copy-hover-color: rgba(4, 25, 48, 0.92);
		--timeline-muted-color: rgba(6, 48, 82, 0.76);
		--timeline-muted-hover-color: rgba(6, 48, 82, 0.86);
		--timeline-link-color: var(--colorBlue4);
		--timeline-rail-background: rgba(255, 255, 255, 0.42);
		--timeline-rail-border-color: rgba(6, 48, 82, 0.18);
		--timeline-cap-background: rgba(216, 243, 255, 0.62);
		--timeline-cap-color: var(--colorBlue5);
		--timeline-time-color: var(--colorBlue5);
		--timeline-time-shadow: 0 1px 0 rgba(255, 255, 255, 0.46);
		--timeline-venue-color: rgba(4, 25, 48, 0.9);
		--timeline-venue-at-color: rgba(17, 109, 154, 0.68);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem rgba(4, 25, 48, 0.1);
		--timeline-image-border-color: rgba(4, 25, 48, 0.18);
		--timeline-image-border-width: 2px;
		--timeline-hover-duration: 220ms;
		isolation: isolate;
		padding: 2rem clamp(0.15rem, 0.5vw, 1rem) clamp(3rem, 7vw, 5rem);
		position: relative;
	}

	:global(html.dark) .timeline-section {
		--timeline-heading-color: #eef6ff;
		--timeline-heading-hover-color: white;
		--timeline-copy-color: rgba(233, 244, 255, 0.84);
		--timeline-copy-hover-color: rgba(255, 255, 255, 0.9);
		--timeline-muted-color: rgba(198, 225, 244, 0.82);
		--timeline-muted-hover-color: rgba(255, 255, 255, 0.88);
		--timeline-link-color: #f7fbff;
		--timeline-rail-background: var(--colorBlueBright1);
		--timeline-rail-border-color: var(--colorBlue3);
		--timeline-cap-background: color-mix(
			in srgb,
			var(--colorBlue2) 60%,
			transparent
		);
		--timeline-cap-color: color-mix(
			in srgb,
			var(--colorBackground) 85%,
			transparent
		);
		--timeline-time-color: var(--colorBackground);
		--timeline-time-shadow: 0 1px 0 rgba(255, 255, 255, 0.22);
		--timeline-venue-color: var(--timeline-heading-color);
		--timeline-venue-at-color: rgba(125, 207, 226, 0.7);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem rgba(4, 25, 48, 0.18);
	}
</style>

<script>
	// @ts-nocheck
	const timelineCards = Array.from(
		document.querySelectorAll(".timeline-content"),
	).filter((element) => element instanceof HTMLElement);
	const postcardStack = document.querySelector(".postcard-stack-flip");
	const mobileTimelineQuery = window.matchMedia("(max-width: 899px)");
	const timelineCardHeaders = timelineCards.map((card) => {
		const heading = card.querySelector("h2");

		return {
			card,
			heading: heading instanceof HTMLElement ? heading : card,
		};
	});

	{
		let mobileActivationFrameRequested = false;

		const clearMobileTimelineState = () => {
			for (const card of timelineCards) {
				card.removeAttribute("data-mobile-active");
			}

			if (postcardStack instanceof HTMLElement) {
				postcardStack.removeAttribute("data-mobile-flipped");
			}
		};

		const updateMobileTimelineState = () => {
			mobileActivationFrameRequested = false;

			if (!mobileTimelineQuery.matches) {
				clearMobileTimelineState();
				return;
			}

			const viewportThreshold = window.innerHeight * 0.5;
			let activeCard = null;

			for (const { card, heading } of timelineCardHeaders) {
				if (heading.getBoundingClientRect().top <= viewportThreshold) {
					activeCard = card;
				}
			}

			for (const card of timelineCards) {
				if (card === activeCard) {
					card.setAttribute("data-mobile-active", "true");
				} else {
					card.removeAttribute("data-mobile-active");
				}
			}

			if (postcardStack instanceof HTMLElement) {
				const postcardRect = postcardStack.getBoundingClientRect();
				const postcardMidpoint = postcardRect.top + postcardRect.height * 0.5;

				if (postcardMidpoint <= viewportThreshold) {
					postcardStack.setAttribute("data-mobile-flipped", "true");
				} else {
					postcardStack.removeAttribute("data-mobile-flipped");
				}
			}
		};

		const requestMobileTimelineStateUpdate = () => {
			if (mobileActivationFrameRequested) {
				return;
			}

			mobileActivationFrameRequested = true;
			window.requestAnimationFrame(updateMobileTimelineState);
		};

		requestMobileTimelineStateUpdate();
		window.addEventListener("scroll", requestMobileTimelineStateUpdate, {
			passive: true,
		});
		window.addEventListener("resize", requestMobileTimelineStateUpdate);

		if (typeof mobileTimelineQuery.addEventListener === "function") {
			mobileTimelineQuery.addEventListener(
				"change",
				requestMobileTimelineStateUpdate,
			);
		}
	}

	for (const card of timelineCards) {
		card.addEventListener("pointermove", (event) => {
			if (mobileTimelineQuery.matches) {
				return;
			}

			const rect = card.getBoundingClientRect();
			const x = ((event.clientX - rect.left) / rect.width) * 100;
			const y = ((event.clientY - rect.top) / rect.height) * 100;

			card.style.setProperty(
				"--timeline-card-pointer-x",
				`${Math.min(Math.max(x, 0), 100).toFixed(2)}%`,
			);
			card.style.setProperty(
				"--timeline-card-pointer-y",
				`${Math.min(Math.max(y, 0), 100).toFixed(2)}%`,
			);
		});

		card.addEventListener("pointerleave", () => {
			card.style.setProperty("--timeline-card-pointer-x", "50%");
			card.style.setProperty("--timeline-card-pointer-y", "50%");
		});
	}
</script>

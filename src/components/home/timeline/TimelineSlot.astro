---
interface Props {
	time: string;
}

const { time } = Astro.props;
---

<div class="timeline-slot">
	<div class="timeline-rail">
		<p class="timeline-time">{time}</p>
	</div>
	<div class="timeline-slot-entries">
		<slot />
	</div>
</div>

<style>
	.timeline-slot {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	.timeline-slot-entries {
		display: grid;
	}

	.timeline-rail {
		background: var(--timeline-rail-background);
		border: 1px solid var(--timeline-rail-border-color);
		display: flex;
		flex-direction: column;
		margin-bottom: -1px;
		overflow: hidden;
		position: relative;
	}

	:global(.timeline-venue:last-child) .timeline-slot:last-child .timeline-rail {
		border-bottom-left-radius: var(--radiusMedium);
		border-bottom-right-radius: var(--radiusMedium);
	}

	.timeline-time {
		color: var(--timeline-time-color);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.3rem, 2vw, 1.6rem);
		font-weight: var(--fontWeightBold);
		margin: 1rem 0 0;
		padding-top: 1.15rem;
		text-align: center;
		text-shadow: var(--timeline-time-shadow);
	}

	@media (width < 900px) {
		.timeline-slot,
		.timeline-slot-entries {
			display: contents;
		}

		.timeline-rail {
			display: none;
		}
	}
</style>

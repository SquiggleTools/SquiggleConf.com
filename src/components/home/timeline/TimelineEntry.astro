---
import { venues } from "~/components/home/data";
import type {
	TimelineEntryId,
	TimelineEntryVariant,
	TimelineTimeMode,
	VenueId,
} from "~/components/home/types";
import Heading from "~/components/Heading.astro";

interface Props {
	entryId: TimelineEntryId;
	heading: string;
	/** Plain-text location, for entries not at a venue. */
	location?: string;
	subtitle?: string;
	time: string;
	timeMode?: TimelineTimeMode;
	variant?: TimelineEntryVariant;
	venue?: VenueId;
}

const {
	entryId,
	heading,
	location,
	subtitle,
	time,
	timeMode = "point",
	variant,
	venue,
} = Astro.props;

const mobileLocation = venue ? venues[venue].name : location;
const mobileLocationHref = venue && venues[venue].mapUrl;
---

<div
	class:list={["timeline-content", variant && `timeline-content-${variant}`]}
	data-timeline-entry={entryId}
>
	<div class="timeline-heading-line">
		<Heading class="timeline-heading" id={entryId} level="h2" link
			>{heading}</Heading
		>
	</div>
	<div
		class:list={[
			"timeline-subtitle",
			"timeline-inline-time",
			timeMode === "point" && "timeline-inline-time-point",
		]}
	>
		<div>
			{time}
		</div>
		{
			mobileLocation && (
				<div class="timeline-mobile-meta">
					{mobileLocationHref ? (
						<a
							class="timeline-mobile-location"
							href={mobileLocationHref}
							rel="noreferrer"
							target="_blank"
						>
							{mobileLocation}
						</a>
					) : (
						<p class="timeline-mobile-location">{mobileLocation}</p>
					)}
				</div>
			)
		}
	</div>
	{subtitle && <p class="timeline-subtitle">{subtitle}</p>}
	<slot />
</div>

<style>
	/* Active-state variables that images and copy inside the entry read. */
	.timeline-content {
		--timeline-card-pointer-x: 50%;
		--timeline-card-pointer-y: 50%;
		--timeline-collage-duo-1: translate3d(0, 0, 0);
		--timeline-collage-duo-2: translate3d(0, 0, 0);
		--timeline-entry-copy-color: var(--colorCopy);
		--timeline-image-grow-border-width: var(--sizeImageBorder);
		--timeline-image-scale: 1;
		--timeline-image-shadow: var(--shadowImage);
		--timeline-image-zoom: 1;
		container: timeline-entry / inline-size;
		isolation: isolate;
		margin: 1rem 0;
		padding: 1.35rem 0.5rem 1.5rem 2rem;
		position: relative;
		transition: transform var(--transitionNormal);
	}

	.timeline-content > * {
		position: relative;
		z-index: 1;
	}

	.timeline-content::before,
	.timeline-content::after {
		border-radius: var(--radiusLarge);
		content: "";
		inset: 0.35rem -0.8rem 0.45rem 0.85rem;
		pointer-events: none;
		position: absolute;
		z-index: 0;
	}

	.timeline-content::before {
		border: 1px solid rgb(from white r g b / 4%);
		opacity: 0.22;
		transform: scale(0.985);
		transition:
			opacity var(--transitionNormal),
			transform var(--transitionNormal),
			border-color var(--transitionNormal),
			box-shadow var(--transitionNormal);
	}

	.timeline-content::after {
		background: radial-gradient(
			circle 25rem at var(--timeline-card-pointer-x)
				var(--timeline-card-pointer-y),
			var(--timeline-card-glow-inner) 0,
			var(--timeline-card-glow-outer) 28%,
			transparent 60%
		);
		opacity: 0;
		padding: 3px;
		transition: opacity var(--transitionNormal);
		mask:
			linear-gradient(#fff 0 0) content-box exclude,
			linear-gradient(#fff 0 0);
	}

	.timeline-content:hover,
	.timeline-content:focus-within {
		transform: translateX(0.3rem);
	}

	.timeline-content-fun-run {
		min-height: 10rem;
	}

	.timeline-content-break {
		min-height: 14rem;
	}

	.timeline-heading {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeDisplay);
		font-weight: var(--fontWeightBold);
		line-height: 1;
		margin: 0;
		transition:
			color var(--transitionNormal),
			text-shadow var(--transitionNormal),
			transform var(--transitionNormal);
	}

	.timeline-heading-line {
		align-items: baseline;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.7rem;
		margin-bottom: 1.1rem;
	}

	.timeline-subtitle {
		color: var(--colorMuted);
		display: block;
		font-size: var(--fontSizeCopySmall);
		font-weight: var(--fontWeightMedium);
		margin: -0.5rem 0 0.5rem;
		transition: color var(--transitionNormal);
	}

	.timeline-inline-time {
		display: inline-block;
	}

	.timeline-inline-time-point,
	.timeline-mobile-meta {
		display: none;
	}

	.timeline-mobile-meta :is(p, a) {
		margin: 0;
	}

	.timeline-mobile-location {
		color: var(--colorMuted);
		font-size: var(--fontSizeCopySmall);
		font-weight: var(--fontWeightMedium);
		line-height: 1.2;
		transition: color var(--transitionNormal);
	}

	/* Active entries: hovered or focused on desktop, scrolled to on mobile */
	@media (width >= 900px) {
		.timeline-content:is(:hover, :focus-within) {
			--timeline-collage-duo-1: translate3d(1rem, -1rem, 0) scale(1.18);
			--timeline-collage-duo-2: translate3d(-0.25rem, -2rem, 0) scale(1.18);
			--timeline-entry-copy-color: var(--colorCopyHover);
			--timeline-image-grow-border-width: 1px;
			--timeline-image-scale: 1.25;
			--timeline-image-shadow: var(--shadowImageActive);
			--timeline-image-zoom: 1.1;
		}

		.timeline-content:is(:hover, :focus-within)::before {
			background: var(--timeline-card-hover-background);
			box-shadow: var(--timeline-card-hover-shadow);
			opacity: 1;
			transform: scale(1);
		}

		.timeline-content:is(:hover, :focus-within)::after {
			opacity: 1;
		}

		.timeline-content:is(:hover, :focus-within) .timeline-heading {
			color: var(--colorHeadingHover);
			text-shadow: var(--shadowHeadingHover);
			transform: translateX(0.08rem);
		}

		.timeline-content:is(:hover, :focus-within)
			:is(.timeline-subtitle, .timeline-mobile-location) {
			color: var(--colorMutedHover);
		}
	}

	@keyframes timeline-card-outline-flash {
		0% {
			opacity: 0;
			transform: scale(0.992);
		}

		22% {
			opacity: 0.48;
		}

		68% {
			opacity: 0.22;
		}

		100% {
			opacity: 0;
			transform: scale(1.004);
		}
	}

	@media (width < 900px) {
		.timeline-content {
			margin: 0.85rem 0;
			padding-bottom: 1rem;
			padding-left: 0.85rem;
			padding-right: 0.75rem;
		}

		.timeline-mobile-meta {
			display: flex;
		}

		.timeline-inline-time {
			display: flex;
			flex-direction: row;
			gap: 0.25rem;
		}

		.timeline-inline-time > :first-child::after {
			content: " • ";
			margin: 0 0.15rem;
			display: inline-block;
		}

		.timeline-content::before,
		.timeline-content::after {
			inset: 0.15rem -0.02rem 0.28rem;
		}

		.timeline-content[data-mobile-active] {
			--timeline-collage-duo-1: translate3d(0.28rem, -0.3rem, 0) scale(1.06);
			--timeline-collage-duo-2: translate3d(-0.08rem, -0.42rem, 0) scale(1.06);
			--timeline-entry-copy-color: var(--colorCopyHover);
			--timeline-image-scale: 1.12;
			--timeline-image-shadow: var(--shadowImageActive);
			--timeline-image-zoom: 1.07;
		}

		.timeline-content[data-mobile-active]::after {
			animation: timeline-card-outline-flash 1600ms var(--transitionEaseOut) 1;
			padding: 1.5px;
			transform-origin: center;
		}

		html.dark .timeline-content[data-mobile-active]::after {
			background: linear-gradient(
				135deg,
				rgb(from var(--colorBlue1) r g b / 50%),
				rgb(from white r g b / 42%)
			);
		}

		.timeline-content[data-mobile-active] .timeline-heading {
			color: var(--colorHeadingHover);
			text-shadow: var(--shadowHeadingHover);
		}

		.timeline-content[data-mobile-active]
			:is(.timeline-subtitle, .timeline-mobile-location) {
			color: var(--colorMutedHover);
		}
	}
</style>

<script>
	import { timelineCollapsedQuery } from "~/utils/breakpoints";

	const cards = [
		...document.querySelectorAll<HTMLElement>(".timeline-content"),
	];
	const headings = cards.map(
		(card) => card.querySelector(".timeline-heading") ?? card,
	);
	const mobileQuery = matchMedia(timelineCollapsedQuery);

	const headingsAboveMiddle = new Set<Element>();

	const updateActiveCard = () => {
		const activeCard =
			mobileQuery.matches &&
			cards.findLast((_, index) => headingsAboveMiddle.has(headings[index]));

		for (const card of cards) {
			card.toggleAttribute("data-mobile-active", card === activeCard);
		}
	};

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					headingsAboveMiddle.add(entry.target);
				} else {
					headingsAboveMiddle.delete(entry.target);
				}
			}

			updateActiveCard();
		},
		{ rootMargin: "100000px 0px -50% 0px" },
	);

	for (const heading of headings) {
		observer.observe(heading);
	}

	mobileQuery.addEventListener("change", updateActiveCard);

	const toPercent = (fraction: number) =>
		`${(Math.min(Math.max(fraction, 0), 1) * 100).toFixed(2)}%`;

	for (const card of cards) {
		card.addEventListener("pointermove", (event) => {
			if (!mobileQuery.matches) {
				const rect = card.getBoundingClientRect();
				card.style.setProperty(
					"--timeline-card-pointer-x",
					toPercent((event.clientX - rect.left) / rect.width),
				);
				card.style.setProperty(
					"--timeline-card-pointer-y",
					toPercent((event.clientY - rect.top) / rect.height),
				);
			}
		});

		card.addEventListener("pointerleave", () => {
			card.style.removeProperty("--timeline-card-pointer-x");
			card.style.removeProperty("--timeline-card-pointer-y");
		});
	}
</script>

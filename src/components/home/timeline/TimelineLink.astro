---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...rest } = Astro.props;
---

<a class:list={["timeline-link", className]} {...rest}><slot /></a>

<style>
	.timeline-link {
		color: var(--colorLink);
		font-weight: var(--fontWeightBold);
	}
</style>

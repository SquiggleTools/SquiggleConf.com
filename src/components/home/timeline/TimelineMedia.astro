---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	/** Fixed width for the media column, instead of sizing to its content. */
	mediaWidth?: string;
}

const { class: className, mediaWidth, ...rest } = Astro.props;
---

<div
	class:list={["timeline-media", className]}
	style={mediaWidth &&
		`grid-template-columns: minmax(0, ${mediaWidth}) minmax(0, 1fr)`}
	{...rest}
>
	<slot />
</div>

<style>
	.timeline-media {
		display: grid;
		gap: 1rem;
		grid-template-columns: auto minmax(0, 1fr);
		margin-top: 0.85rem;
		max-width: 48rem;
	}

	@container timeline-entry (width < 38rem) {
		.timeline-media {
			align-items: flex-start;
			display: flex;
			flex-direction: column;
		}
	}
</style>

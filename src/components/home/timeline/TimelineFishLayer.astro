---
import { timelineFish } from "~/components/home/data";
---

<div class="timeline-fish-layer" aria-hidden="true">
	{
		timelineFish.map((fish, index) => (
			<div class={`timeline-fish-shell timeline-fish-shell-${index + 1}`}>
				<div class="timeline-fish-body">
					<span class="timeline-fish-image" set:html={fish} />
				</div>
			</div>
		))
	}
</div>

<style>
	.timeline-fish-layer {
		--timeline-fish-body: #116d9a;
		--timeline-fish-body-alt: #1f7fab;
		--timeline-fish-detail: #38ced6;
		--timeline-fish-eye: #041930;
		--timeline-fish-fin: #063052;
		--timeline-fish-opacity: 0.78;
		inset: clamp(0.65rem, 2vw, 1.65rem) 0 auto;
		pointer-events: none;
		position: absolute;
		z-index: 1;
		top: 50px;
	}

	:global(html.dark) .timeline-fish-layer {
		--timeline-fish-body: #f5f4f2;
		--timeline-fish-body-alt: #c5e2d6;
		--timeline-fish-detail: #8ac0cc;
		--timeline-fish-eye: #274238;
		--timeline-fish-fin: #6a8b91;
		--timeline-fish-opacity: 1;
	}

	.timeline-fish-shell {
		top: 10px;
		left: 0;
		opacity: 0;
		filter: drop-shadow(0 0.7rem 1.3rem rgba(6, 17, 33, 0.18));
		pointer-events: none;
		position: absolute;
		transform: translate3d(-3rem, 0, 0);
		transform-origin: center;
		user-select: none;
		will-change: opacity, transform;
	}

	.timeline-fish-body {
		animation: timeline-fish-swim 2480ms cubic-bezier(0.45, 0.05, 0.55, 0.95)
			infinite;
		transform-origin: var(--fish-origin-x, 26%) 50%;
		will-change: transform;
	}

	.timeline-fish-image {
		display: block;
		height: 100%;
		max-width: none;
		opacity: var(--timeline-fish-opacity);
		width: max-content;
	}

	.timeline-fish-image :global(svg) {
		display: block;
		height: 100%;
		overflow: visible;
		width: auto;
	}

	.timeline-fish-image :global([fill="#F5F4F2"]) {
		fill: var(--timeline-fish-body);
	}

	.timeline-fish-image :global([fill="#C5E2D6"]) {
		fill: var(--timeline-fish-body-alt);
	}

	.timeline-fish-image :global([fill="#6A8B91"]) {
		fill: var(--timeline-fish-fin);
	}

	.timeline-fish-image :global([fill="#8AC0CC"]) {
		fill: var(--timeline-fish-detail);
	}

	.timeline-fish-image :global([fill="#274238"]) {
		fill: var(--timeline-fish-eye);
	}

	.timeline-fish-shell-1 {
		--fish-origin-x: 24%;
		height: clamp(0.42rem, 0.68vw, 0.6rem);
		left: 0.05rem;
		top: 0.03rem;
	}

	.timeline-fish-shell-2 {
		--fish-origin-x: 28%;
		height: clamp(0.38rem, 0.6vw, 0.5rem);
		left: 0.05rem;
		top: 0.4rem;
	}

	.timeline-fish-shell-3 {
		--fish-origin-x: 25%;
		height: clamp(0.4rem, 0.63vw, 0.53rem);
		left: 0.05rem;
		top: 0.65rem;
	}

	.timeline-fish-shell-4 {
		--fish-origin-x: 23%;
		height: clamp(0.5rem, 0.79vw, 0.69rem);
		left: 0.08rem;
		top: 0.19rem;
	}

	.timeline-fish-shell-5 {
		--fish-origin-x: 27%;
		height: clamp(0.52rem, 0.8vw, 0.72rem);
		left: 0;
		top: 0.55rem;
	}

	.timeline-fish-shell-2 .timeline-fish-body,
	.timeline-fish-shell-5 .timeline-fish-body {
		animation-delay: -1.1s;
		animation-duration: 2760ms;
		animation-name: timeline-fish-swim-wide;
	}

	.timeline-fish-shell-3 .timeline-fish-body {
		animation-delay: -0.65s;
		animation-duration: 2310ms;
	}

	.timeline-fish-shell-4 .timeline-fish-body {
		animation-delay: -1.45s;
		animation-duration: 2920ms;
		animation-direction: reverse;
	}

	@keyframes timeline-fish-swim {
		0% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}

		18% {
			transform: translate3d(0.2rem, -0.08rem, 0) rotate(1deg) skewY(2deg)
				scaleX(1.035) scaleY(0.98);
		}

		37% {
			transform: translate3d(0, 0, 0) rotate(6deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		62% {
			transform: translate3d(-0.14rem, 0.09rem, 0) rotate(0deg) skewY(-2deg)
				scaleX(1.03) scaleY(0.982);
		}

		82% {
			transform: translate3d(0.14rem, -0.05rem, 0) rotate(-6deg) skewY(1.5deg)
				scaleX(0.99) scaleY(1.02);
		}

		100% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}
	}

	@keyframes timeline-fish-swim-wide {
		0% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}

		22% {
			transform: translate3d(0.24rem, -0.11rem, 0) rotate(2deg) skewY(3deg)
				scaleX(1.045) scaleY(0.975);
		}

		48% {
			transform: translate3d(0, 0, 0) rotate(8deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		72% {
			transform: translate3d(-0.18rem, 0.12rem, 0) rotate(-1deg) skewY(-2.5deg)
				scaleX(1.04) scaleY(0.975);
		}

		100% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}
	}

	@media (width < 900px) {
		.timeline-fish-layer {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline-fish-body {
			transition: none;
			animation: none;
		}
	}
</style>

<script>
	// @ts-nocheck
	const timelineSection = document.querySelector(".timeline-section");
	const timelineFish = Array.from(
		document.querySelectorAll(".timeline-fish-shell"),
	).filter((element) => element instanceof HTMLElement);
	const morningTalksEntry = document.querySelector(
		'[data-timeline-entry="talks-morning"]',
	);
	const reducedMotionQuery = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	);

	if (
		timelineSection instanceof HTMLElement &&
		timelineFish.length > 0 &&
		morningTalksEntry instanceof HTMLElement
	) {
		let frameRequested = false;
		const fishConfigs = [
			{
				baseRotate: -8,
				bobAmplitude: 6,
				bobFrequency: 1.12,
				driftY: -6,
				end: 1.1,
				exitOffset: 26,
				finAmplitude: 4,
				phase: 0.2,
				rotateAmplitude: 5,
				scale: 0.48,
				start: -0.18,
			},
			{
				baseRotate: 4,
				bobAmplitude: 9,
				bobFrequency: 1.5,
				driftY: 5,
				end: 1.16,
				exitOffset: 22,
				finAmplitude: 5,
				phase: 1.1,
				rotateAmplitude: 7,
				scale: 0.41,
				start: -0.08,
			},
			{
				baseRotate: -3,
				bobAmplitude: 10,
				bobFrequency: 1.35,
				driftY: -2,
				end: 1.22,
				exitOffset: 20,
				finAmplitude: 6,
				phase: 2.2,
				rotateAmplitude: 5,
				scale: 0.43,
				start: -0.02,
			},
			{
				baseRotate: 7,
				bobAmplitude: 8,
				bobFrequency: 0.95,
				driftY: 7,
				end: 1.12,
				exitOffset: 24,
				finAmplitude: 4,
				phase: 0.8,
				rotateAmplitude: 6,
				scale: 0.46,
				start: -0.22,
			},
			{
				baseRotate: 2,
				bobAmplitude: 11,
				bobFrequency: 1.25,
				driftY: -8,
				end: 1.28,
				exitOffset: 18,
				finAmplitude: 6,
				phase: 2.75,
				rotateAmplitude: 8,
				scale: 0.44,
				start: -0.14,
			},
		];

		const getPageTop = (element) =>
			element.getBoundingClientRect().top + window.scrollY;

		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		const easeInOutSine = (value) => 0.5 - Math.cos(value * Math.PI) / 2;

		const updateTimelineFish = () => {
			frameRequested = false;
			const viewportTravel = timelineSection.offsetWidth;

			if (reducedMotionQuery.matches) {
				for (const [index, fish] of timelineFish.entries()) {
					const config = fishConfigs[index];
					const visibleX = 1.8 + index * 8.25;
					fish.style.opacity = "1";
					fish.style.transform = `translate3d(${visibleX}rem, 0, 0) rotate(${config.baseRotate}deg) scale(${config.scale})`;
				}

				return;
			}

			const start = getPageTop(timelineSection) - window.innerHeight * 0.34;
			const end =
				getPageTop(morningTalksEntry) +
				morningTalksEntry.offsetHeight +
				window.innerHeight * 0.75;
			const scrollAnchor = window.scrollY + window.innerHeight * 0.28;
			const rawProgress = (scrollAnchor - start) / Math.max(end - start, 1);
			const clampedProgress = clamp(rawProgress, 0, 1);

			for (const [index, fish] of timelineFish.entries()) {
				const config = fishConfigs[index];
				const entryOffset = fish.offsetWidth + 10;
				const exitOffset = fish.offsetWidth + config.exitOffset;
				const localProgress = clamp(
					(clampedProgress - config.start) / (config.end - config.start),
					0,
					1,
				);
				const easedProgress = easeInOutSine(localProgress);
				const bodyWave = Math.sin(
					localProgress * Math.PI * 2 * config.bobFrequency + config.phase,
				);
				const finWave = Math.sin(
					localProgress * Math.PI * 4.2 + config.phase * 1.7,
				);
				const translateX =
					-entryOffset +
					easedProgress * (viewportTravel + entryOffset + exitOffset);
				const translateY =
					bodyWave * config.bobAmplitude +
					finWave * config.finAmplitude +
					easedProgress * config.driftY;
				const rotate =
					config.baseRotate +
					bodyWave * config.rotateAmplitude +
					finWave * (config.rotateAmplitude * 0.4);

				fish.style.opacity = "1";
				fish.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) rotate(${rotate}deg) scale(${config.scale})`;
			}
		};

		const requestTimelineFishUpdate = () => {
			if (frameRequested) {
				return;
			}

			frameRequested = true;
			window.requestAnimationFrame(updateTimelineFish);
		};

		updateTimelineFish();
		window.addEventListener("scroll", requestTimelineFishUpdate, {
			passive: true,
		});
		window.addEventListener("resize", requestTimelineFishUpdate);
		if (typeof reducedMotionQuery.addEventListener === "function") {
			reducedMotionQuery.addEventListener("change", requestTimelineFishUpdate);
		}
	}
</script>

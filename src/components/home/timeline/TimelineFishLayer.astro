---
import { timelineFish } from "~/components/home/data";
import type { TimelineEntryId } from "~/components/home/types";

interface Props {
	/** The fish finish swimming once this entry scrolls past. */
	swimUntil: TimelineEntryId;
}

const { swimUntil } = Astro.props;
---

<div class="timeline-fish-layer" aria-hidden="true" data-swim-until={swimUntil}>
	{
		timelineFish.map((fish, index) => (
			<div class={`timeline-fish-shell timeline-fish-shell-${index + 1}`}>
				<div class="timeline-fish-body">
					<span class="timeline-fish-image" set:html={fish} />
				</div>
			</div>
		))
	}
</div>

<style>
	.timeline-fish-layer {
		inset: 50px 0 auto;
		pointer-events: none;
		position: absolute;
		z-index: 1;
	}

	.timeline-fish-shell {
		opacity: 0;
		filter: drop-shadow(
			0 0.7rem 1.3rem rgb(from var(--colorBlue5) r g b / 18%)
		);
		pointer-events: none;
		position: absolute;
		transform: translate3d(-3rem, 0, 0);
		transform-origin: center;
		user-select: none;
		will-change: opacity, transform;
	}

	.timeline-fish-body {
		animation: timeline-fish-swim 2480ms cubic-bezier(0.45, 0.05, 0.55, 0.95)
			infinite;
		transform-origin: var(--fish-origin-x, 26%) 50%;
		will-change: transform;
	}

	.timeline-fish-image {
		display: block;
		height: 100%;
		max-width: none;
		width: max-content;
	}

	.timeline-fish-image :global(svg) {
		display: block;
		height: 100%;
		overflow: visible;
		width: auto;
	}

	/* The fish SVGs' own fills are their dark theme colors. */
	html:not(.dark) .timeline-fish-image {
		opacity: 0.78;
	}

	.timeline-fish-image :global([fill="#F5F4F2"]) {
		fill: light-dark(var(--colorBlue3), #f5f4f2);
	}

	.timeline-fish-image :global([fill="#C5E2D6"]) {
		fill: light-dark(#1f7fab, #c5e2d6);
	}

	.timeline-fish-image :global([fill="#6A8B91"]) {
		fill: light-dark(var(--colorBlue4), #6a8b91);
	}

	.timeline-fish-image :global([fill="#8AC0CC"]) {
		fill: light-dark(var(--colorBlue2), #8ac0cc);
	}

	.timeline-fish-image :global([fill="#274238"]) {
		fill: light-dark(var(--colorBlue5), #274238);
	}

	.timeline-fish-shell-1 {
		--fish-origin-x: 24%;
		height: clamp(0.42rem, 0.68vw, 0.6rem);
		left: 0.05rem;
		top: 0.03rem;
	}

	.timeline-fish-shell-2 {
		--fish-origin-x: 28%;
		height: clamp(0.38rem, 0.6vw, 0.5rem);
		left: 0.05rem;
		top: 0.4rem;
	}

	.timeline-fish-shell-3 {
		--fish-origin-x: 25%;
		height: clamp(0.4rem, 0.63vw, 0.53rem);
		left: 0.05rem;
		top: 0.65rem;
	}

	.timeline-fish-shell-4 {
		--fish-origin-x: 23%;
		height: clamp(0.5rem, 0.79vw, 0.69rem);
		left: 0.08rem;
		top: 0.19rem;
	}

	.timeline-fish-shell-5 {
		--fish-origin-x: 27%;
		height: clamp(0.52rem, 0.8vw, 0.72rem);
		left: 0;
		top: 0.55rem;
	}

	.timeline-fish-shell-2 .timeline-fish-body,
	.timeline-fish-shell-5 .timeline-fish-body {
		animation-delay: -1.1s;
		animation-duration: 2760ms;
		animation-name: timeline-fish-swim-wide;
	}

	.timeline-fish-shell-3 .timeline-fish-body {
		animation-delay: -0.65s;
		animation-duration: 2310ms;
	}

	.timeline-fish-shell-4 .timeline-fish-body {
		animation-delay: -1.45s;
		animation-duration: 2920ms;
		animation-direction: reverse;
	}

	@keyframes timeline-fish-swim {
		0% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}

		18% {
			transform: translate3d(0.2rem, -0.08rem, 0) rotate(1deg) skewY(2deg)
				scaleX(1.035) scaleY(0.98);
		}

		37% {
			transform: translate3d(0, 0, 0) rotate(6deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		62% {
			transform: translate3d(-0.14rem, 0.09rem, 0) rotate(0deg) skewY(-2deg)
				scaleX(1.03) scaleY(0.982);
		}

		82% {
			transform: translate3d(0.14rem, -0.05rem, 0) rotate(-6deg) skewY(1.5deg)
				scaleX(0.99) scaleY(1.02);
		}

		100% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}
	}

	@keyframes timeline-fish-swim-wide {
		0% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}

		22% {
			transform: translate3d(0.24rem, -0.11rem, 0) rotate(2deg) skewY(3deg)
				scaleX(1.045) scaleY(0.975);
		}

		48% {
			transform: translate3d(0, 0, 0) rotate(8deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		72% {
			transform: translate3d(-0.18rem, 0.12rem, 0) rotate(-1deg) skewY(-2.5deg)
				scaleX(1.04) scaleY(0.975);
		}

		100% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}
	}

	@media not (--widthLarge) {
		.timeline-fish-layer {
			display: none;
		}
	}
</style>

<script>
	import { onScrollFrame } from "./onScrollFrame";

	const layer = document.querySelector<HTMLElement>(".timeline-fish-layer");
	const section = layer?.offsetParent;
	const talks = document.querySelector<HTMLElement>(
		`[data-timeline-entry="${layer?.dataset.swimUntil}"]`,
	);
	const fishes = [
		...(layer?.querySelectorAll<HTMLElement>(".timeline-fish-shell") ?? []),
	];
	const reducedMotionQuery = matchMedia("(prefers-reduced-motion: reduce)");

	// [start, end, scale, baseRotate, rotateAmplitude, bobAmplitude,
	//  bobFrequency, finAmplitude, driftY, exitOffset, phase]
	const fishConfigs = [
		[-0.18, 1.1, 0.48, -8, 5, 6, 1.12, 4, -6, 26, 0.2],
		[-0.08, 1.16, 0.41, 4, 7, 9, 1.5, 5, 5, 22, 1.1],
		[-0.02, 1.22, 0.43, -3, 5, 10, 1.35, 6, -2, 20, 2.2],
		[-0.22, 1.12, 0.46, 7, 6, 8, 0.95, 4, 7, 24, 0.8],
		[-0.14, 1.28, 0.44, 2, 8, 11, 1.25, 6, -8, 18, 2.75],
	] as const;

	const clamp01 = (value: number) => Math.min(Math.max(value, 0), 1);
	const pageTop = (element: HTMLElement) =>
		element.getBoundingClientRect().top + scrollY;

	if (section instanceof HTMLElement && talks) {
		onScrollFrame(() => {
			const start = pageTop(section) - innerHeight * 0.34;
			const end = pageTop(talks) + talks.offsetHeight + innerHeight * 0.75;
			const progress = clamp01(
				(scrollY + innerHeight * 0.28 - start) / Math.max(end - start, 1),
			);

			for (const [index, fish] of fishes.entries()) {
				const [
					fishStart,
					fishEnd,
					scale,
					baseRotate,
					rotateAmplitude,
					bobAmplitude,
					bobFrequency,
					finAmplitude,
					driftY,
					exitOffset,
					phase,
				] = fishConfigs[index];

				fish.style.opacity = "1";

				if (reducedMotionQuery.matches) {
					fish.style.transform = `translate3d(${1.8 + index * 8.25}rem, 0, 0) rotate(${baseRotate}deg) scale(${scale})`;
					continue;
				}

				const local = clamp01((progress - fishStart) / (fishEnd - fishStart));
				const eased = 0.5 - Math.cos(local * Math.PI) / 2;
				const bodyWave = Math.sin(local * Math.PI * 2 * bobFrequency + phase);
				const finWave = Math.sin(local * Math.PI * 4.2 + phase * 1.7);
				const entryOffset = fish.offsetWidth + 10;
				const x =
					-entryOffset +
					eased *
						(section.offsetWidth + entryOffset + fish.offsetWidth + exitOffset);
				const y =
					bodyWave * bobAmplitude + finWave * finAmplitude + eased * driftY;
				const rotate =
					baseRotate + (bodyWave + finWave * 0.4) * rotateAmplitude;

				fish.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rotate}deg) scale(${scale})`;
			}
		}, reducedMotionQuery);
	}
</script>

---
interface Props {
	date: string;
	day: string;
}

const { date, day } = Astro.props;
---

<div class="timeline-day">
	<div class="timeline-cap">
		<p>{day}</p>
		<p>{date}</p>
	</div>
	<slot name="intro" />
	<slot />
</div>

<style>
	.timeline-day {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	.timeline-cap {
		background: var(--timeline-cap-background);
		border: 1px solid var(--timeline-rail-border-color);
		border-top-left-radius: var(--radiusMedium);
		border-top-right-radius: var(--radiusMedium);
		color: var(--timeline-cap-color);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeCardTitle);
		font-weight: var(--fontWeightBold);
		grid-column: 2;
		line-height: 1.1;
		margin-top: 1rem;
		padding: 0.8rem 0.55rem;
		text-align: center;
	}

	.timeline-cap p {
		margin: 0;
	}

	@media (width < 900px) {
		.timeline-day {
			display: contents;
		}

		.timeline-cap {
			border-radius: var(--radiusMedium);
			grid-column: auto;
		}
	}
</style>

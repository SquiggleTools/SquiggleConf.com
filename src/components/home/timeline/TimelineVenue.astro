---
import { venues } from "~/components/home/data";
import type { VenueId } from "~/components/home/types";

interface Props {
	venue: VenueId;
}

const { venue } = Astro.props;
const { mapUrl, name } = venues[venue];
const decorated = Astro.slots.has("decoration");
---

<div class="timeline-venue">
	<div
		class:list={[
			"timeline-venue-label",
			decorated && "timeline-venue-decorated",
		]}
	>
		<div class="timeline-venue-stack">
			<a
				class="timeline-location-link"
				href={mapUrl}
				rel="noreferrer"
				target="_blank"
			>
				{name.split(" ").map((line) => <p>{line}</p>)}
			</a>
			<slot name="decoration" />
		</div>
	</div>
	<div class="timeline-venue-slots">
		<slot />
	</div>
</div>

<style>
	.timeline-venue {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	.timeline-venue-slots {
		display: grid;
		grid-column: 2 / -1;
		grid-template-columns: subgrid;
	}

	.timeline-venue-label {
		align-items: flex-end;
		align-self: stretch;
		color: var(--timeline-venue-color);
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: 1.25rem;
		font-weight: var(--fontWeightSemibold);
		justify-content: flex-start;
		line-height: 1.12;
		margin-right: -1px;
		text-align: right;
	}

	.timeline-venue:last-child .timeline-venue-label {
		margin-bottom: 1rem;
	}

	.timeline-venue-label p {
		margin: 0;
	}

	.timeline-location-link {
		color: inherit;
		display: grid;
		justify-items: end;
		text-decoration: none;
	}

	.timeline-location-link:hover,
	.timeline-location-link:focus-visible {
		text-decoration: underline;
	}

	.timeline-venue-stack {
		backdrop-filter: var(--backdropFrosted);
		background: var(--timeline-rail-background);
		border: 1px solid var(--timeline-rail-border-color);
		border-radius: var(--radiusLarge);
		box-shadow: var(--timeline-venue-stack-shadow);
		display: grid;
		justify-items: end;
		padding: 0.85rem 0.9rem 0.8rem 1.45rem;
		position: sticky;
		top: clamp(1rem, 4vw, 4.5rem);
		transform-origin: top right;
		z-index: 2;

		border-right: none;
		border-top-right-radius: 0px;
		border-bottom-right-radius: 0px;
	}

	.timeline-venue-stack::before {
		color: var(--timeline-venue-at-color);
		content: "@";
		font-family: var(--fontFamilyHeading);
		font-size: 1.5rem;
		font-weight: var(--fontWeightBold);
		left: -0.15rem;
		line-height: 1;
		opacity: 0.72;
		position: absolute;
		top: -0.5rem;
		transform: rotate(-10deg);
		text-shadow: 0 0.12rem 0.4rem rgb(from var(--colorBlue5) r g b / 24%);
	}

	.timeline-venue-decorated .timeline-venue-stack {
		margin-bottom: 6rem;
		padding-bottom: 3.75rem;
	}

	@media (width < 900px) {
		.timeline-venue,
		.timeline-venue-slots {
			display: contents;
		}

		.timeline-venue-label {
			display: none;
		}
	}
</style>

---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	/** Two columns lay out side by side on wide screens. */
	columns?: 1 | 2;
}

const { class: className, columns = 1, ...rest } = Astro.props;
---

<div
	class:list={["timeline-list", `timeline-list-columns-${columns}`, className]}
	{...rest}
>
	<slot />
</div>

<style>
	.timeline-list {
		display: grid;
		gap: 0.8rem;
		margin-top: 0.8rem;
		max-width: 44rem;
		position: relative;
		z-index: 1;
	}

	.timeline-list-columns-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	@media (width < 900px) {
		.timeline-list-columns-2 {
			grid-template-columns: 1fr;
		}
	}
</style>

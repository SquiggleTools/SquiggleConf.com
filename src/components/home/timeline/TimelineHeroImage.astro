---
import { Image } from "astro:assets";

interface Props {
	alt: string;
	pinned?: boolean;
	shape: "circle" | "wide";
	src: ImageMetadata;
}

const { alt, pinned, shape, src } = Astro.props;
---

<div
	class:list={[
		"event-hero-image",
		"timeline-image",
		pinned
			? "event-hero-image-pinned timeline-image-zoom"
			: "timeline-image-grow",
		`event-hero-image-${shape}`,
	]}
>
	<Image alt={alt} src={src} loading="eager" />
</div>

<style>
	.event-hero-image-wide {
		height: 8rem;
		width: 14rem;
	}

	.event-hero-image-circle {
		border-radius: 999px;
		height: 8rem;
		width: 8rem;
	}

	.event-hero-image-pinned :global(img) {
		transform-origin: top right;
	}
</style>

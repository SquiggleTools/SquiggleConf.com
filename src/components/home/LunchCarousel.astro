---
import { Image } from "astro:assets";

import type { LunchSpotData } from "~/components/home/types";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	spots: readonly LunchSpotData[];
}

const { spots } = Astro.props;
---

<div
	class="lunch-carousel"
	data-lunch-carousel
	aria-label="Lunch options photo carousel"
>
	<TimelineImage radius="var(--radiusLarge)">
		<div class="lunch-carousel-track" data-lunch-track>
			{
				spots.map((spot, index) => (
					<div
						class="lunch-slide"
						data-lunch-slide
						aria-hidden={index === 0 ? "false" : "true"}
					>
						<div class="lunch-slide-image">
							<Image
								alt={spot.alt}
								src={spot.image}
								loading={index === 0 ? "eager" : "lazy"}
							/>
						</div>
						<div class="lunch-slide-caption">
							<strong>{spot.name}</strong>
						</div>
					</div>
				))
			}
		</div>
	</TimelineImage>
	<div class="lunch-carousel-dots" aria-label="Lunch image navigation">
		{
			spots.map((spot, index) => (
				<button
					type="button"
					class="lunch-carousel-dot"
					data-lunch-dot
					aria-label={`Show ${spot.name}`}
					aria-pressed={index === 0 ? "true" : "false"}
				/>
			))
		}
	</div>
</div>

<style>
	.lunch-carousel {
		display: grid;
		gap: 0.7rem;
		margin: auto 0;
		max-width: 10rem;
		width: 100%;
	}

	.lunch-carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.lunch-slide {
		flex: 0 0 100%;
		position: relative;
		scroll-snap-align: start;
	}

	.lunch-slide-image {
		aspect-ratio: 1 / 1;
		background: linear-gradient(
			180deg,
			rgb(from var(--colorWhite) r g b / 16%),
			rgb(from var(--colorWhite) r g b / 3%)
		);
		user-select: none;
	}

	.lunch-slide-image img {
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.lunch-slide-caption {
		align-items: end;
		background: linear-gradient(
			180deg,
			transparent 0%,
			rgb(from var(--colorBlue5) r g b / 72%) 58%,
			rgb(from var(--colorBlue5) r g b / 88%) 100%
		);
		bottom: 0;
		color: var(--colorWhite);
		display: grid;
		left: 0;
		padding: 2rem 0.9rem 0.8rem;
		position: absolute;
		right: 0;
		text-shadow: 0 0.15rem 0.35rem rgb(from var(--colorBlack) r g b / 28%);
	}

	.lunch-slide-caption strong {
		font-family: var(--fontFamilyHeading);
		font-size: 1.08rem;
		font-weight: var(--fontWeightBold);
		line-height: 1.05;
	}

	.lunch-carousel-dots {
		display: flex;
		gap: 0.45rem;
		justify-content: center;
		padding-bottom: 0.15rem;
	}

	.lunch-carousel-dot {
		appearance: none;
		background: rgb(from var(--colorWhite) r g b / 24%);
		border: 1px solid rgb(from var(--colorBlue1) r g b / 45%);
		border-radius: var(--radiusPill);
		cursor: pointer;
		height: 0.65rem;
		margin: 0;
		padding: 0;
		transition:
			background-color var(--transitionNormal),
			transform var(--transitionNormal),
			width var(--transitionNormal);
		width: 0.65rem;
	}

	.lunch-carousel-dot[aria-pressed="true"] {
		background: rgb(from var(--colorWhite) r g b / 96%);
		transform: scale(1.02);
		width: 1.7rem;
	}

	.lunch-carousel-dot:hover,
	.lunch-carousel-dot:focus-visible {
		background: rgb(from var(--colorWhite) r g b / 72%);
		outline: none;
	}

	.lunch-carousel-dot:focus-visible {
		box-shadow: 0 0 0 0.16rem rgb(from var(--colorWhite) r g b / 28%);
	}

	@media not (--widthLarge) {
		.lunch-carousel {
			max-width: 21rem;
		}

		.lunch-slide-image {
			aspect-ratio: 1.15 / 1;
		}
	}
</style>

<script>
	const reducedMotionQuery = matchMedia("(prefers-reduced-motion: reduce)");

	for (const carousel of document.querySelectorAll<HTMLElement>(
		"[data-lunch-carousel]",
	)) {
		const track = carousel.querySelector<HTMLElement>("[data-lunch-track]")!;
		const dots = [
			...carousel.querySelectorAll<HTMLButtonElement>("[data-lunch-dot]"),
		];
		const slides = [...carousel.querySelectorAll("[data-lunch-slide]")];
		let activeIndex = 0;
		let autoAdvanceTimer: number | undefined;

		const markActive = () => {
			activeIndex = Math.round(track.scrollLeft / track.clientWidth);
			for (const [slideIndex, slide] of slides.entries()) {
				slide.setAttribute("aria-hidden", `${slideIndex !== activeIndex}`);
			}
			for (const [dotIndex, dot] of dots.entries()) {
				dot.setAttribute("aria-pressed", `${dotIndex === activeIndex}`);
			}
		};

		const setSlide = (index: number) => {
			track.scrollTo({
				behavior: reducedMotionQuery.matches ? "instant" : "smooth",
				left: (index % slides.length) * track.clientWidth,
			});
		};

		const stopAutoAdvance = () => window.clearInterval(autoAdvanceTimer);

		const startAutoAdvance = () => {
			stopAutoAdvance();
			if (!reducedMotionQuery.matches && slides.length > 1) {
				autoAdvanceTimer = window.setInterval(
					() => setSlide(activeIndex + 1),
					3400,
				);
			}
		};

		track.addEventListener("scroll", markActive, { passive: true });

		for (const [index, dot] of dots.entries()) {
			dot.addEventListener("click", () => {
				setSlide(index);
				startAutoAdvance();
				if (!dot.matches(":focus-visible")) {
					dot.blur();
				}
			});
		}

		carousel.addEventListener("pointerenter", stopAutoAdvance);
		carousel.addEventListener("pointerleave", startAutoAdvance);
		carousel.addEventListener("focusin", stopAutoAdvance);
		carousel.addEventListener("focusout", (event) => {
			if (
				!(event.relatedTarget instanceof Node) ||
				!carousel.contains(event.relatedTarget)
			) {
				startAutoAdvance();
			}
		});

		startAutoAdvance();
	}
</script>

---
import { Image } from "astro:assets";

import type { LunchSpotData } from "~/components/home/types";

import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	spots: readonly LunchSpotData[];
}

const { spots } = Astro.props;
---

<div
	aria-label="Lunch options photo carousel"
	aria-roledescription="carousel"
	class="lunch-carousel"
	data-lunch-carousel
	role="group"
>
	<div class="lunch-carousel-controls" data-lunch-controls hidden>
		<button
			aria-label="Pause slideshow"
			class="lunch-carousel-pause"
			data-lunch-pause
			type="button"
		>
			<svg aria-hidden="true" data-pause-icon viewBox="0 0 12 12">
				<path d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z" fill="currentColor" />
			</svg>
			<svg aria-hidden="true" data-play-icon viewBox="0 0 12 12">
				<path d="M3 1.5v9l7-4.5z" fill="currentColor" />
			</svg>
		</button>
		<div
			aria-label="Lunch image navigation"
			class="lunch-carousel-dots"
			role="group"
		>
			{spots.map((spot, index) => (
				<button
					aria-current={index === 0 ? "true" : "false"}
					aria-label={`Show ${spot.name}`}
					class="lunch-carousel-dot"
					data-lunch-dot
					type="button"
				/>
			))}
		</div>
	</div>
	<TimelineImage radius="var(--radiusLarge)">
		<div
			aria-label="Lunch spot photos"
			aria-live="polite"
			class="lunch-carousel-track"
			data-lunch-track
			role="group"
		>
			{spots.map((spot, index) => (
				<div
					aria-label={`${index + 1} of ${spots.length}`}
					aria-roledescription="slide"
					class="lunch-slide"
					data-lunch-slide
					role="group"
				>
					<div class="lunch-slide-image">
						<Image
							alt={spot.alt}
							sizes="(min-width: 900px) 15rem, 27.5rem"
							src={spot.image}
							widths={[240, 480]}
						/>
					</div>
					<div class="lunch-slide-caption">
						<strong>{spot.name}</strong>
					</div>
				</div>
			))}
		</div>
	</TimelineImage>
</div>

<style>
	.lunch-carousel {
		display: grid;
		gap: 0.7rem;
		grid-template-columns: minmax(0, 1fr);
		margin: auto 0;
		max-width: 10rem;
		width: 100%;
	}

	.lunch-carousel-track {
		display: flex;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.lunch-carousel
		:global(.timeline-image):has(.lunch-carousel-track:focus-visible) {
		outline: 2px solid var(--colorAccentMedium);
		outline-offset: 2px;
	}

	.lunch-slide {
		flex: 0 0 100%;
		position: relative;
		scroll-snap-align: start;
	}

	.lunch-slide-image {
		aspect-ratio: 1 / 1;
		background: linear-gradient(
			180deg,
			rgb(from var(--colorWhite) r g b / 16%),
			rgb(from var(--colorWhite) r g b / 3%)
		);
		user-select: none;
	}

	.lunch-slide-image img {
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.lunch-slide-caption {
		align-items: end;
		background: linear-gradient(
			180deg,
			transparent 0%,
			rgb(from var(--colorBlue5) r g b / 72%) 58%,
			rgb(from var(--colorBlue5) r g b / 88%) 100%
		);
		bottom: 0;
		color: var(--colorWhite);
		display: grid;
		left: 0;
		padding: 2rem 0.9rem 0.8rem;
		position: absolute;
		right: 0;
		text-shadow: 0 0.15rem 0.35rem rgb(from var(--colorBlue5) r g b / 28%);
	}

	.lunch-slide-caption strong {
		font-family: var(--fontFamilyHeading);
		font-size: 1.08rem;
		font-weight: var(--fontWeightBold);
		line-height: 1.05;
	}

	.lunch-carousel-controls {
		--lunch-dot-gutter: calc((1.5rem - 0.65rem) / 2);

		align-items: center;
		display: flex;
		justify-content: center;
		margin: calc(var(--lunch-dot-gutter) * -1) 0;
		order: 1;
		padding-bottom: 0.15rem;
	}

	.lunch-carousel-controls[hidden] {
		display: none;
	}

	.lunch-carousel-dots {
		display: flex;
	}

	.lunch-carousel-dot,
	.lunch-carousel-pause {
		appearance: none;
		background: none;
		border: none;
		cursor: pointer;
		display: grid;
		height: 1.5rem;
		margin: 0;
		padding: 0 var(--lunch-dot-gutter);
		place-items: center;
	}

	.lunch-carousel-dot::before {
		background: color-mix(
			in srgb,
			rgb(from var(--colorBlue4) r g b / 22%),
			rgb(from var(--colorWhite) r g b / 24%) var(--themeDarkness)
		);
		border: 1px solid
			color-mix(
				in srgb,
				rgb(from var(--colorBlue4) r g b / 60%),
				rgb(from var(--colorBlue1) r g b / 45%) var(--themeDarkness)
			);
		border-radius: var(--radiusPill);
		box-sizing: border-box;
		content: "";
		height: 0.65rem;
		transition:
			background-color var(--transitionNormal),
			transform var(--transitionNormal),
			width var(--transitionNormal);
		width: 0.65rem;
	}

	.lunch-carousel-dot[aria-current="true"]::before {
		background: color-mix(
			in srgb,
			var(--colorBlue3),
			rgb(from var(--colorWhite) r g b / 96%) var(--themeDarkness)
		);
		transform: scale(1.02);
		width: 1.7rem;
	}

	.lunch-carousel-dot:hover::before,
	.lunch-carousel-dot:focus-visible::before {
		background: color-mix(
			in srgb,
			rgb(from var(--colorBlue3) r g b / 72%),
			rgb(from var(--colorWhite) r g b / 72%) var(--themeDarkness)
		);
	}

	.lunch-carousel-dot:focus-visible {
		outline: none;
	}

	.lunch-carousel-dot:focus-visible::before {
		outline: 2px solid var(--colorAccentMedium);
		outline-offset: 2px;
	}

	.lunch-carousel-pause:focus-visible {
		border-radius: var(--radiusSmall);
		outline: 2px solid var(--colorAccentMedium);
		outline-offset: -2px;
	}

	.lunch-carousel-pause {
		min-width: 1.5rem;
		color: color-mix(
			in srgb,
			var(--colorBlue4),
			var(--colorBlue1) var(--themeDarknessText)
		);
	}

	.lunch-carousel-pause[hidden] {
		display: none;
	}

	.lunch-carousel-pause svg {
		height: 0.7rem;
		width: 0.7rem;
	}

	.lunch-carousel-pause [data-play-icon],
	.lunch-carousel-pause[data-paused] [data-pause-icon] {
		display: none;
	}

	.lunch-carousel-pause[data-paused] [data-play-icon] {
		display: block;
	}

	@media (forced-colors: active) {
		.lunch-carousel-dot:is(:hover, :focus-visible)::before {
			border-color: Highlight;
		}
	}

	@media not (--widthLarge) {
		.lunch-carousel {
			max-width: 21rem;
		}

		.lunch-slide-image {
			aspect-ratio: 1.15 / 1;
		}
	}
</style>

<script>
	import { reducedMotionQuery } from "~/utils/motion";

	for (const carousel of document.querySelectorAll<HTMLElement>(
		"[data-lunch-carousel]",
	)) {
		const track = carousel.querySelector<HTMLElement>("[data-lunch-track]");
		const controls = carousel.querySelector<HTMLElement>(
			"[data-lunch-controls]",
		);
		if (!track || !controls) {
			continue;
		}

		const dots = [
			...carousel.querySelectorAll<HTMLButtonElement>("[data-lunch-dot]"),
		];
		const pause =
			carousel.querySelector<HTMLButtonElement>("[data-lunch-pause]");
		const slides = [...carousel.querySelectorAll("[data-lunch-slide]")];
		let activeIndex = 0;
		let autoAdvanceTimer: number | undefined;
		let hovered = false;
		let paused = false;
		let trackWidth = track.clientWidth;
		let visible = false;

		const realign = () => {
			trackWidth = track.clientWidth;
			if (Math.round(track.scrollLeft / trackWidth) !== activeIndex) {
				track.scrollTo({
					behavior: "instant",
					left: activeIndex * trackWidth,
				});
			}
		};

		const markActive = () => {
			if (!track.clientWidth) {
				return;
			}

			if (track.clientWidth === trackWidth) {
				activeIndex = Math.round(track.scrollLeft / trackWidth);
			} else {
				realign();
			}

			for (const [slideIndex, slide] of slides.entries()) {
				slide.setAttribute("aria-hidden", `${slideIndex !== activeIndex}`);
			}
			for (const [dotIndex, dot] of dots.entries()) {
				dot.setAttribute("aria-current", `${dotIndex === activeIndex}`);
			}
		};

		const setSlide = (index: number) => {
			track.scrollTo({
				behavior: reducedMotionQuery.matches ? "instant" : "smooth",
				left: (index % slides.length) * track.clientWidth,
			});
		};

		const canAutoAdvance = () =>
			!reducedMotionQuery.matches && slides.length > 1;

		const updateAutoAdvance = () => {
			window.clearInterval(autoAdvanceTimer);
			if (pause) {
				if (!canAutoAdvance() && document.activeElement === pause) {
					track.focus();
				}
				pause.hidden = !canAutoAdvance();
			}

			const rotating = canAutoAdvance() && visible && !hovered && !paused;
			track.setAttribute("aria-live", rotating ? "off" : "polite");
			if (rotating) {
				autoAdvanceTimer = window.setInterval(
					() => setSlide(activeIndex + 1),
					3400,
				);
			}
		};

		controls.hidden = false;
		track.tabIndex = 0;
		markActive();
		track.addEventListener("scroll", markActive, { passive: true });

		new ResizeObserver(() => {
			if (track.clientWidth && track.clientWidth !== trackWidth) {
				realign();
			}
		}).observe(track);

		for (const [index, dot] of dots.entries()) {
			dot.addEventListener("click", () => {
				setSlide(index);
				updateAutoAdvance();
				if (!dot.matches(":focus-visible")) {
					dot.blur();
				}
			});
		}

		const setPaused = (value: boolean) => {
			paused = value;
			pause?.toggleAttribute("data-paused", paused);
			pause?.setAttribute(
				"aria-label",
				paused ? "Play slideshow" : "Pause slideshow",
			);
			updateAutoAdvance();
		};

		pause?.addEventListener("click", () => {
			if (paused) {
				hovered = false;
			}
			setPaused(!paused);
		});

		carousel.addEventListener("pointerenter", () => {
			hovered = true;
			updateAutoAdvance();
		});
		carousel.addEventListener("pointerleave", () => {
			hovered = false;
			updateAutoAdvance();
		});
		carousel.addEventListener("focusin", (event) => {
			if (
				!paused &&
				event.target instanceof Element &&
				event.target.matches(":focus-visible")
			) {
				setPaused(true);
			}
		});

		new IntersectionObserver((entries) => {
			visible = !!entries.at(-1)?.isIntersecting;
			updateAutoAdvance();
		}).observe(carousel);

		reducedMotionQuery.addEventListener("change", updateAutoAdvance);
	}
</script>

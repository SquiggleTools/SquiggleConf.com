---
import type { PersonCardData } from "~/components/home/types";

import CfpAvatar from "./CfpAvatar.astro";

interface Props {
	class?: string;
	layout?: "row" | "stacked";
	person: PersonCardData;
}

const { class: className, layout = "stacked", person } = Astro.props;
---

<li class:list={["cfp-person", `cfp-person-${layout}`, className]}>
	<CfpAvatar class="cfp-person-avatar" person={person} />
	<div class="cfp-person-copy">
		<p class="cfp-person-name">{person.name}</p>
		<p class="cfp-person-role">{person.qualification}</p>
	</div>
</li>

<style>
	.cfp-person {
		display: grid;
		gap: 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cfp-person-stacked {
		justify-items: center;
		text-align: center;
	}

	.cfp-person-row {
		align-items: center;
		grid-template-columns: auto 1fr;
	}

	.cfp-person-copy {
		display: grid;
		gap: 0.15rem;
	}

	.cfp-person-name {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeSmaller);
		font-weight: var(--fontWeightBold);
		line-height: 1.15;
		margin: 0;
	}

	.cfp-person-role {
		color: var(--colorMuted);
		font-size: var(--fontSizeCaption);
		font-weight: var(--fontWeightLight);
		line-height: 1.25;
		margin: 0;
	}

	.cfp-person:hover :global(.cfp-avatar) {
		scale: 1.06;
	}

	.cfp-person :global(.cfp-avatar) {
		transition: scale var(--transitionNormal) var(--transitionEaseOut);
	}
</style>

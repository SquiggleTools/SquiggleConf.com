---
import TimelineHeading from "../timeline/TimelineHeading.astro";
import TimelineTalksTurtle from "../timeline/TimelineTalksTurtle.astro";
import CfpBubbles from "./CfpBubbles.astro";
import CfpPerson from "./CfpPerson.astro";
import { cfpHosts, cfpLaunchSpeakers } from "./data";
---

<section aria-labelledby="cfp6-heading" class="cfp6">
	<div aria-hidden="true" class="cfp6-rays">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<CfpBubbles class="cfp6-bubbles" count={36} />
	<div aria-hidden="true" class="cfp6-turtle">
		<TimelineTalksTurtle />
	</div>
	<div class="cfp6-inner">
		<TimelineHeading class="cfp6-heading" id="cfp6-heading" level="h2">
			<span class="cfp6-heading-small">CFP Ships</span>
			<span class="cfp6-heading-big">Nov 14th</span>
		</TimelineHeading>
		<div class="cfp6-lineup">
			<div class="cfp6-group cfp6-group-launch">
				<p class="cfp6-label">Launch Speakers</p>
				<ul class="cfp6-people">
					{cfpLaunchSpeakers.map((person) => (
						<CfpPerson person={person} />
					))}
				</ul>
			</div>
			<div class="cfp6-group cfp6-group-hosts">
				<p class="cfp6-label">Event Hosts</p>
				<ul class="cfp6-people">
					{cfpHosts.map((person) => (
						<CfpPerson person={person} />
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.cfp6 {
		--cfp-avatar-size: 6.5rem;

		background: linear-gradient(
			to bottom,
			transparent,
			var(--colorBlueBright1) 30%,
			var(--colorBlue5)
		);
		isolation: isolate;
		overflow: hidden;
		padding: clamp(5rem, 10vw, 8rem) 1rem clamp(3.5rem, 7vw, 5.5rem);
		position: relative;
	}

	.cfp6-rays {
		inset: 0;
		mix-blend-mode: screen;
		pointer-events: none;
		position: absolute;
	}

	.cfp6-rays span {
		animation: cfp6-sway 11s ease-in-out infinite alternate;
		background: linear-gradient(
			to bottom,
			rgb(from var(--colorBlue2) r g b / 22%),
			transparent 85%
		);
		filter: blur(10px);
		height: 130%;
		left: var(--left);
		position: absolute;
		top: -10%;
		transform-origin: top center;
		width: var(--width);
	}

	.cfp6-rays span:nth-child(1) {
		--left: 12%;
		--width: 4rem;

		rotate: 18deg;
	}

	.cfp6-rays span:nth-child(2) {
		--left: 30%;
		--width: 2rem;

		animation-delay: -3s;
		rotate: 10deg;
	}

	.cfp6-rays span:nth-child(3) {
		--left: 50%;
		--width: 6rem;

		animation-delay: -6s;
		rotate: 0deg;
	}

	.cfp6-rays span:nth-child(4) {
		--left: 68%;
		--width: 2.5rem;

		animation-delay: -2s;
		rotate: -9deg;
	}

	.cfp6-rays span:nth-child(5) {
		--left: 84%;
		--width: 4.5rem;

		animation-delay: -8s;
		rotate: -16deg;
	}

	@keyframes cfp6-sway {
		0% {
			opacity: 0.5;
			transform: skewX(-6deg);
		}

		100% {
			opacity: 1;
			transform: skewX(6deg);
		}
	}

	.cfp6-bubbles {
		opacity: 0.6;
	}

	.cfp6-turtle {
		bottom: -1rem;
		pointer-events: none;
		position: absolute;
		right: max(1rem, calc(50% - var(--sizeContentAreaNormal) / 2 - 6rem));
		rotate: -12deg;
		z-index: 0;
	}

	.cfp6-inner {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		justify-items: center;
		margin: 0 auto;
		max-width: var(--sizeContentAreaNormal);
		position: relative;
		z-index: 1;
	}

	.cfp6-heading {
		display: grid;
		justify-items: center;
		line-height: 0.9;
		margin: 0;
		text-align: center;
	}

	.cfp6-heading-small {
		color: var(--colorAccentMedium);
		font-size: clamp(1.5rem, 3.5vw, 2.5rem);
		font-style: italic;
		letter-spacing: 0.04em;
	}

	.cfp6-heading-big {
		font-size: clamp(3.5rem, 11vw, 8rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		text-shadow:
			0 0 2.5rem rgb(from var(--colorBlue2) r g b / 45%),
			0 0.25rem 0 var(--colorBlue3);
	}

	.cfp6-lineup {
		display: grid;
		gap: 2rem;
		grid-template-columns: 3fr 4fr;
		width: 100%;
	}

	.cfp6-group {
		display: grid;
		gap: 1.25rem;
	}

	.cfp6-label {
		align-items: center;
		color: var(--colorMuted);
		display: flex;
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeSmaller);
		font-weight: var(--fontWeightBold);
		gap: 0.75rem;
		letter-spacing: 0.1em;
		margin: 0;
		text-transform: uppercase;
	}

	.cfp6-label::before,
	.cfp6-label::after {
		background: var(--timeline-rail-border-color);
		content: "";
		flex: 1;
		height: 1px;
	}

	.cfp6-people {
		display: grid;
		gap: 1rem;
		grid-auto-columns: 1fr;
		grid-auto-flow: column;
		margin: 0;
		padding: 0;
	}

	.cfp6-people :global(.cfp-person):nth-child(odd) :global(.cfp-avatar) {
		animation: cfp6-bob 5s ease-in-out infinite;
	}

	.cfp6-people :global(.cfp-person):nth-child(even) :global(.cfp-avatar) {
		animation: cfp6-bob 5s ease-in-out infinite -2.5s;
	}

	@keyframes cfp6-bob {
		0%,
		100% {
			translate: 0 0;
		}

		50% {
			translate: 0 -0.4rem;
		}
	}

	@media not (--widthLarge) {
		.cfp6 {
			--cfp-avatar-size: 5rem;
		}

		.cfp6-lineup {
			grid-template-columns: 1fr;
		}

		.cfp6-people {
			grid-auto-flow: row;
			grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
		}
	}
</style>

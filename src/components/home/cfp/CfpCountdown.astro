---
const units = ["days", "hours", "minutes", "seconds"] as const;
---

<div
	aria-label="Time until the CFP opens"
	class="cfp-countdown"
	data-cfp-countdown
	hidden
	role="timer"
>
	{units.map((unit) => (
		<div class="cfp-countdown-unit">
			<span class="cfp-countdown-value" data-cfp-countdown-unit={unit}>
				00
			</span>
			<span class="cfp-countdown-label">{unit}</span>
		</div>
	))}
</div>

<style>
	.cfp-countdown {
		display: grid;
		gap: 0.75rem;
		grid-auto-columns: 1fr;
		grid-auto-flow: column;
		margin-top: 1rem;
		width: fit-content;
	}

	.cfp-countdown[hidden] {
		display: none;
	}

	.cfp-countdown-unit {
		align-items: center;
		background: rgb(from var(--colorBlue5) r g b / 35%);
		border: 1px solid var(--timeline-rail-border-color);
		border-radius: var(--radiusMedium);
		display: grid;
		gap: 0.15rem;
		padding: 0.6rem 0.75rem;
		text-align: center;
	}

	html:not(.dark) .cfp-countdown-unit {
		background: rgb(from var(--colorWhite) r g b / 45%);
	}

	.cfp-countdown-value {
		color: var(--colorHeading);
		font-family: var(--fontFamilyMonospace);
		font-size: var(--fontSizeLarge);
		font-variant-numeric: tabular-nums;
		font-weight: var(--fontWeightSemibold);
		line-height: 1;
	}

	.cfp-countdown-label {
		color: var(--colorMuted);
		font-size: var(--fontSizeCaption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media not (--widthLarge) {
		.cfp-countdown {
			margin-inline: auto;
		}
	}

	@media not (--widthXSmall) {
		.cfp-countdown {
			gap: 0.4rem;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			width: 100%;
		}

		.cfp-countdown-unit {
			padding: 0.5rem 0.2rem;
		}

		.cfp-countdown-label {
			font-size: 0.65rem;
			letter-spacing: 0.02em;
		}
	}
</style>

<script>
	import { cfpOpenDateIso } from "~/data/event";

	const countdown = document.querySelector<HTMLElement>("[data-cfp-countdown]");
	const target = new Date(cfpOpenDateIso).getTime();

	const update = () => {
		if (!countdown) {
			return;
		}

		const remaining = Math.floor((target - Date.now()) / 1000);
		if (remaining <= 0) {
			countdown.hidden = true;
			return;
		}

		const parts = {
			days: Math.floor(remaining / 86400),
			hours: Math.floor(remaining / 3600) % 24,
			minutes: Math.floor(remaining / 60) % 60,
			seconds: remaining % 60,
		};

		for (const [unit, value] of Object.entries(parts)) {
			const element = countdown.querySelector(
				`[data-cfp-countdown-unit="${unit}"]`,
			);
			if (element) {
				element.textContent = `${value}`.padStart(2, "0");
			}
		}

		countdown.hidden = false;
		window.setTimeout(update, 1000 - (Date.now() % 1000));
	};

	update();
</script>

---
import type { TalkCardData } from "~/components/home/types";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props {
	talk: TalkCardData;
}

const { talk } = Astro.props;
---

<article class="talk-card">
	<TimelineImage
		alt={talk.name}
		effect="zoom"
		placeholder={talk.placeholder}
		src={talk.image}
	/>
	<div class="talk-copy">
		<h3>{talk.title}</h3>
		<p class="talk-speaker">{talk.name}</p>
		<p class="talk-role">{talk.qualification}</p>
	</div>
</article>

<style>
	.talk-card {
		align-items: stretch;
		display: grid;
		gap: 0.8rem;
		grid-template-columns: 5rem 1fr;
	}

	.talk-copy {
		display: grid;
		grid-template-rows: 2fr 1fr 1fr;
		min-height: 5.75rem;
	}

	.talk-copy h3 {
		align-self: center;
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeCardTitle);
		font-weight: var(--fontWeightHeavy);
		line-height: 1.25;
		margin: 0;
	}

	.talk-speaker {
		color: var(--colorMuted);
		font-size: clamp(0.92rem, 1.2vw, 1rem);
		font-weight: var(--fontWeightBolder);
	}

	.talk-role {
		color: var(--colorMuted);
		font-size: var(--fontSizeCaption);
		font-weight: 300;
		line-height: 1.25;
	}
</style>

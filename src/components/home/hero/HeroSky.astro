---
import { orbCenter } from "./orb";

const birds = [
	{ duration: 1.4, left: "53%", size: 5, top: 3.75 },
	{ duration: 1.1, left: "6%", size: 1.6, top: 4 },
	{ duration: 1.7, left: "45%", size: 1, top: 1.25 },
	{ duration: 1.3, left: "93%", size: 1.3, top: 14 },
	{ duration: 1.9, left: "3%", size: 0.9, top: 22 },
];

const clouds = [
	{ drift: 60, left: "33%", moonlight: 36, size: 4.5, top: 0.75 },
	{ drift: 45, left: "55%", moonlight: 36, size: 3, top: 0.25 },
	{ drift: 70, left: "88%", moonlight: 100, size: 5, top: 15 },
	{ drift: 55, left: "1%", moonlight: 36, size: 4, top: 9 },
];
---

<div
	aria-hidden="true"
	class="hero-sky"
	data-pause-offscreen
	style={`--orb-center: ${orbCenter}`}
>
	<div class="hero-sky-night">
		<span class="hero-sky-stars hero-sky-stars-near"></span>
		<span class="hero-sky-stars hero-sky-stars-far"></span>
	</div>
	<span class="hero-sky-glow"></span>
	<span class="hero-sky-orb-glow"></span>
	{clouds.map(({ drift, left, moonlight, size, top }, index) => (
		<svg
			class="hero-sky-cloud"
			style={`--drift: ${drift}s; --left: ${left}; --moonlight: ${moonlight}%; --size: ${size}rem; --top: ${top}rem`}
			viewBox="0 0 64 32"
		>
			<linearGradient
				gradientUnits="userSpaceOnUse"
				id={`hero-sky-cloud-fill-${index}`}
				x1="32"
				x2="32"
				y1="4"
				y2="30"
			>
				<stop class="hero-sky-cloud-lit" offset="0" />
				<stop class="hero-sky-cloud-shade" offset="1" />
			</linearGradient>
			<path
				d="M10 30 H54 A8 8 0 0 0 54 14 A10 10 0 0 0 38 8 A12 12 0 0 0 16 12 A10 10 0 0 0 10 30 Z"
				fill={`url(#hero-sky-cloud-fill-${index})`}
			/>
		</svg>
	))}
	{birds.map(({ duration, left, size, top }, index) => (
		<svg
			class="hero-sky-birds"
			style={`--duration: ${duration}s; --left: ${left}; --size: ${size}rem; --top: ${top}rem`}
			viewBox={index ? "0 0 22 12" : "0 0 120 40"}
		>
			{index ? (
				<path class="hero-sky-bird" d="M2 6 Q5 1 8 6 T14 6 T20 6" />
			) : (
				<>
					<path class="hero-sky-bird" d="M4 20 Q8 14 12 20 T20 20 T28 20" />
					<path class="hero-sky-bird" d="M50 8 Q53 3 56 8 T62 8 T68 8" />
					<path class="hero-sky-bird" d="M86 28 Q89 23 92 28 T98 28 T104 28" />
				</>
			)}
		</svg>
	))}
</div>
<button
	aria-label="Dark mode (enable JavaScript to use)"
	class="hero-sky-orb"
	data-pause-offscreen
	style={`--orb-center: ${orbCenter}`}
	type="button"
>
	<span aria-hidden="true" class="hero-sky-orb-body"></span>
</button>

<style>
	.hero-sky {
		background:
			radial-gradient(
				ellipse 60% 95% at 0% 40%,
				color-mix(in srgb, var(--colorFrost1), transparent var(--themeDarkness))
					35%,
				transparent
			),
			linear-gradient(
				180deg,
				var(--colorBlueBright2) 0%,
				color-mix(
						in srgb,
						var(--colorFrost1),
						color-mix(in srgb, var(--colorBlue5) 70%, var(--colorBlue4))
							var(--themeDarkness)
					)
					35%,
				color-mix(
						in srgb,
						var(--colorCream),
						color-mix(in srgb, var(--colorBlue4) 70%, var(--colorSea))
							var(--themeDarkness)
					)
					72%,
				color-mix(
						in srgb,
						color-mix(
							in srgb,
							var(--colorCream) 80%,
							var(--colorTerminalOrange)
						),
						color-mix(in srgb, var(--colorSea) 85%, var(--colorBlue3))
							var(--themeDarkness)
					)
					100%
			);
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		position: absolute;
	}

	.hero-sky-night {
		inset: 0;
		opacity: calc(var(--themeDarkStep) * var(--themeDip));
		position: absolute;
	}

	.hero-sky-stars {
		inset: 0 0 35%;
		mask-image: linear-gradient(to bottom, var(--colorBlue5) 30%, transparent);
		position: absolute;
	}

	.hero-sky-stars-near {
		animation: hero-sky-twinkle 6s ease-in-out infinite alternate;
		background-image:
			radial-gradient(1.5px 1.5px at 8% 14%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 23% 62%, var(--colorBlue1), transparent),
			radial-gradient(
				1.5px 1.5px at 41% 31%,
				var(--colorWhiteIsh),
				transparent
			),
			radial-gradient(1px 1px at 57% 78%, var(--colorBlue1), transparent),
			radial-gradient(2px 2px at 71% 9%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 88% 46%, var(--colorBlue1), transparent),
			radial-gradient(1.5px 1.5px at 94% 83%, var(--colorWhiteIsh), transparent);
		background-size: 380px 260px;
	}

	.hero-sky-stars-far {
		animation: hero-sky-twinkle 9s ease-in-out infinite alternate-reverse;
		background-image:
			radial-gradient(1px 1px at 15% 40%, var(--colorWhiteIsh), transparent),
			radial-gradient(1.5px 1.5px at 33% 85%, var(--colorBlue2), transparent),
			radial-gradient(1px 1px at 52% 12%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 66% 55%, var(--colorWhiteIsh), transparent),
			radial-gradient(1.5px 1.5px at 81% 24%, var(--colorBlue1), transparent);
		background-position: 120px 60px;
		background-size: 530px 340px;
	}

	@keyframes hero-sky-twinkle {
		0% {
			opacity: 0.35;
		}

		100% {
			opacity: 1;
		}
	}

	.hero-sky :global(.hero-sky-shooting-star) {
		background: linear-gradient(
			to right,
			var(--colorWhiteIsh),
			rgb(from var(--colorBlue1) r g b / 0%)
		);
		border-radius: var(--radiusPill);
		height: 1.5px;
		opacity: 0;
		position: absolute;
		width: 7rem;
	}

	.hero-sky-glow {
		animation: hero-sky-breathe 10s ease-in-out infinite alternate;
		background:
			radial-gradient(
				ellipse 45% 47% at 50% 100%,
				color-mix(
					in srgb,
					transparent,
					rgb(from var(--colorTerminalOrange) r g b / 40%) var(--themeDarkness)
				),
				transparent 70%
			),
			radial-gradient(
				ellipse 30% 60% at 18% 100%,
				rgb(from var(--colorBlue2) r g b / 20%),
				transparent 70%
			),
			radial-gradient(
				ellipse 30% 60% at 84% 100%,
				color-mix(
					in srgb,
					transparent,
					rgb(from var(--colorBlue2) r g b / 16%) var(--themeDarkness)
				),
				transparent 70%
			);
		bottom: 3rem;
		height: 26rem;
		left: -10%;
		position: absolute;
		right: -10%;
		transform-origin: bottom center;
	}

	.hero-sky-orb-glow {
		background: radial-gradient(
			circle at 50% 50%,
			color-mix(
				in srgb,
				rgb(from var(--colorSunrise) r g b / 37%),
				rgb(from var(--colorViolet) r g b / 16%) var(--themeDarkness)
			),
			transparent calc(70% - var(--themeDarkness) * 0.14)
		);
		display: none;
		height: 120rem;
		left: var(--orb-center);
		position: absolute;
		top: 8.5rem;
		translate: -50% -50%;
		width: 120rem;
	}

	@keyframes hero-sky-breathe {
		0% {
			opacity: 0.75;
			transform: scaleY(0.92);
		}

		100% {
			opacity: 1;
			transform: scaleY(1.05);
		}
	}

	.hero-sky-cloud-lit {
		stop-color: color-mix(
			in srgb,
			var(--colorWhite),
			color-mix(
					in srgb,
					var(--colorBlue5),
					color-mix(
							in srgb,
							color-mix(in srgb, var(--colorBlue1) 15%, var(--colorBlue4)),
							var(--colorViolet) 14%
						)
						var(--moonlight)
				)
				var(--themeDarkness)
		);
	}

	.hero-sky-cloud-shade {
		stop-color: color-mix(
			in srgb,
			var(--colorWhite),
			color-mix(in srgb, var(--colorBlue5), var(--colorBlue4) var(--moonlight))
				var(--themeDarkness)
		);
	}

	.hero-sky-cloud {
		animation: hero-sky-drift var(--drift) ease-in-out infinite alternate;
		filter: drop-shadow(
			0 0.2rem 0.4rem rgb(from var(--colorBlue4) r g b / 10%)
		);
		left: var(--left);
		opacity: 0.9;
		position: absolute;
		top: var(--top);
		width: var(--size);
	}

	@keyframes hero-sky-drift {
		0% {
			transform: translateX(-1.5rem);
		}

		100% {
			transform: translateX(1.5rem);
		}
	}

	.hero-sky-orb {
		--hero-orb-crescent: color-mix(
			in srgb,
			transparent,
			var(--colorWhiteIsh) var(--themeDarkness)
		);
		--hero-orb-glow: color-mix(
			in srgb,
			rgb(from var(--colorTerminalOrange) r g b / 55%),
			rgb(from var(--colorBlue1) r g b / 45%) var(--themeDarkness)
		);
		--hero-orb-glow-offset: 10rem;

		background: none;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		display: none;
		height: 4rem;
		left: var(--orb-center);
		padding: 0;
		position: absolute;
		top: 6.5rem;
		translate: -50% 0;
		width: 4rem;
		z-index: 2;
	}

	.hero-sky-orb:focus-visible {
		outline: 2px solid var(--colorAccentMedium);
		outline-offset: 0.5rem;
	}

	@media (forced-colors: active) {
		.hero-sky-orb {
			border: 2px solid ButtonText;
		}
	}

	.hero-sky-orb::before,
	.hero-sky-orb::after,
	.hero-sky-orb-body {
		background: color-mix(
			in srgb,
			color-mix(in srgb, var(--colorCream) 50%, var(--colorTerminalOrange)),
			transparent var(--themeDarkness)
		);
		border-radius: 50%;
		box-shadow: inset -1.1rem 0.5rem 0 0 var(--hero-orb-crescent);
		rotate: -20deg;
		transition: scale var(--transitionNormal) var(--transitionEaseOut);
	}

	.hero-sky-orb-body {
		display: block;
		height: 100%;
		width: 100%;
	}

	.hero-sky-orb::before,
	.hero-sky-orb::after {
		animation: hero-sky-orb-glow 7s ease-in-out infinite alternate;
		clip-path: inset(
			calc(var(--hero-orb-glow-offset) - 4rem) -4rem
				calc(-4rem - var(--hero-orb-glow-offset))
		);
		content: "";
		inset: 0;
		position: absolute;
		transform: translateY(calc(-1 * var(--hero-orb-glow-offset)));
		z-index: -1;
	}

	.hero-sky-orb::before {
		animation-direction: alternate-reverse;
		filter: drop-shadow(
			0 var(--hero-orb-glow-offset) 0.75rem var(--hero-orb-glow)
		);
	}

	.hero-sky-orb::after {
		filter: drop-shadow(
			0 var(--hero-orb-glow-offset) 1.5rem var(--hero-orb-glow)
		);
		opacity: 0;
	}

	.hero-sky-orb:hover::before,
	.hero-sky-orb:hover::after,
	.hero-sky-orb:hover .hero-sky-orb-body {
		scale: 1.08;
	}

	@keyframes hero-sky-orb-glow {
		0% {
			opacity: 0;
		}

		100% {
			opacity: 1;
		}
	}

	.hero-sky-birds {
		display: none;
		fill: none;
		left: var(--left);
		position: absolute;
		stroke: color-mix(
			in srgb,
			var(--colorBlue4),
			var(--colorWhiteIsh) var(--themeDarkness)
		);
		stroke-linecap: round;
		stroke-width: 1.4;
		top: var(--top);
		width: var(--size);
	}

	.hero-sky-bird {
		animation: hero-sky-flap var(--duration) ease-in-out infinite alternate;
		transform-box: fill-box;
		transform-origin: center;
	}

	.hero-sky-bird:nth-child(2) {
		animation-delay: -0.5s;
		animation-duration: 1.1s;
	}

	.hero-sky-bird:nth-child(3) {
		animation-delay: -0.9s;
		animation-duration: 1.6s;
	}

	@keyframes hero-sky-flap {
		0% {
			transform: scaleY(1);
		}

		100% {
			transform: scaleY(0.35) translateY(2px);
		}
	}

	@media (--widthSmall) {
		.hero-sky-orb,
		.hero-sky-orb-glow {
			display: block;
		}
	}

	@media (--widthLarge) {
		.hero-sky-orb,
		.hero-sky-orb-glow {
			display: none;
		}

		.hero-sky-birds {
			display: block;
		}
	}

	@media (--widthXLarge) {
		.hero-sky-orb,
		.hero-sky-orb-glow {
			display: block;
		}
	}
</style>

<style is:global>
	html.hero-orb-travel .hero-sky-orb {
		z-index: 0;
	}

	.theme-pin-light {
		--themeDarkness: 0%;
	}

	.theme-pin-dark {
		--themeDarkness: 100%;
	}
</style>

<script>
	import { reducedMotionQuery } from "~/utils/motion";
	import { pauseOffscreen } from "~/utils/pauseOffscreen";
	import {
		changeTheme,
		getOppositeTheme,
		getTheme,
		themeChangeEvent,
		themeTransitionDuration,
	} from "~/utils/theme";

	pauseOffscreen();

	const night = document.querySelector<HTMLElement>(".hero-sky-night");
	const orb = document.querySelector<HTMLButtonElement>(".hero-sky-orb");
	let traveling = false;

	if (orb) {
		const updatePressed = () => {
			orb.setAttribute("aria-pressed", `${getTheme() === "dark"}`);
		};

		orb.setAttribute("aria-label", "Dark mode");
		updatePressed();
		document.addEventListener(themeChangeEvent, updatePressed);
	}

	const travelEasing = "cubic-bezier(0.65, 0, 0.35, 1)";
	const travelSteps = 24;
	const settingShare = 0.6;

	function travelKeyframes(orbBox: DOMRect, horizon: number) {
		const radius = orbBox.width / 2;
		const drop = horizon + radius * 1.1 - (orbBox.top + radius);
		const reach = Math.max(radius * 5, innerWidth * 0.4);

		const frames = (side: number, setting: boolean) =>
			Array.from({ length: travelSteps + 1 }, (_, index) => {
				const progress = setting
					? index / travelSteps
					: 1 - index / travelSteps;
				const angle = (Math.PI / 2) * progress;
				const shift = `translate(${side * reach * Math.sin(angle)}px, ${drop * (1 - Math.cos(angle))}px)`;
				return {
					glow: {
						offset: index / travelSteps,
						opacity: Math.max(0, 1 - progress / 0.9),
						transform: shift,
					},
					orb: {
						offset: index / travelSteps,
						opacity: 1 - progress,
						transform: `${shift} rotate(${side * progress * 90}deg)`,
					},
				};
			});

		const set = frames(1, true);
		const rise = frames(-1, false);

		return {
			rise: {
				glow: rise.map(({ glow }) => glow),
				orb: rise.map(({ orb }) => orb),
			},
			set: {
				glow: set.map(({ glow }) => glow),
				orb: set.map(({ orb }) => orb),
			},
		};
	}

	orb?.addEventListener("click", () => {
		const hero = orb.closest(".hero");

		if (traveling) {
			return;
		}

		if (reducedMotionQuery.matches || !hero) {
			changeTheme();
			return;
		}

		const html = document.documentElement;
		const glow = hero.querySelector<HTMLElement>(".hero-sky-orb-glow");
		const before = getTheme();
		const after = getOppositeTheme();
		const horizon =
			hero.querySelector(".hero-harbor-water")?.getBoundingClientRect().top ??
			hero.getBoundingClientRect().bottom;
		const keyframes = travelKeyframes(orb.getBoundingClientRect(), horizon);
		const setting = {
			duration: themeTransitionDuration * settingShare,
			easing: travelEasing,
			fill: "forwards",
		} as const;
		const rising = {
			duration: themeTransitionDuration,
			easing: travelEasing,
		} as const;

		const incoming = [orb, glow].flatMap((element) => {
			if (!element) {
				return [];
			}

			const copy = element.cloneNode(true) as HTMLElement;
			copy.removeAttribute("aria-label");
			copy.removeAttribute("aria-pressed");
			copy.setAttribute("aria-hidden", "true");
			copy.inert = true;
			copy.classList.add(`theme-pin-${after}`);
			element.after(copy);
			return [copy];
		});
		const [incomingOrb, incomingGlow] = incoming;

		traveling = true;
		html.classList.add("hero-orb-travel");
		orb.classList.add(`theme-pin-${before}`);
		glow?.classList.add(`theme-pin-${before}`);

		changeTheme(after);
		const settingAnimations = [
			orb.animate(keyframes.set.orb, setting),
			glow?.animate(keyframes.set.glow, setting),
		];
		incomingGlow?.animate(keyframes.rise.glow, rising);
		const travel = (incomingOrb ?? orb).animate(keyframes.rise.orb, rising);

		const done = () => {
			for (const animation of settingAnimations) {
				animation?.cancel();
			}
			for (const copy of incoming) {
				copy.remove();
			}
			orb.classList.remove(`theme-pin-${before}`);
			glow?.classList.remove(`theme-pin-${before}`);
			html.classList.remove("hero-orb-travel");
			traveling = false;
		};
		travel.finished.then(done, done);
	});

	const clouds = [...document.querySelectorAll(".hero-sky-cloud")];

	function aimClouds() {
		if (
			!orb ||
			document.documentElement.classList.contains("hero-orb-travel")
		) {
			return;
		}

		const orbBox = orb.getBoundingClientRect();
		const [orbX, orbY] = [
			orbBox.left + orbBox.width / 2,
			orbBox.top + orbBox.height / 2,
		];

		for (const cloud of clouds) {
			const box = cloud.getBoundingClientRect();
			const angle = orbBox.width
				? Math.atan2(
						orbY - (box.top + box.height / 2),
						orbX - (box.left + box.width / 2),
					)
				: -Math.PI / 2;
			const [x, y] = [Math.cos(angle), Math.sin(angle)];
			const reach = Math.abs(x) * 31 + Math.abs(y) * 13;
			const gradient = cloud.querySelector("linearGradient");

			for (const [name, value] of Object.entries({
				x1: 32 + x * reach,
				x2: 32 - x * reach,
				y1: 17 + y * reach,
				y2: 17 - y * reach,
			})) {
				gradient?.setAttribute(name, `${value}`);
			}
		}
	}

	const hero = orb?.closest(".hero");
	if (hero && clouds.length) {
		new ResizeObserver(aimClouds).observe(hero);
	}

	function launchShootingStar(container: HTMLElement) {
		const star = document.createElement("span");
		star.className = "hero-sky-shooting-star";
		star.style.left = `${20 + Math.random() * 70}%`;
		star.style.top = `${Math.random() * 35}%`;
		container.append(star);

		const angle = -15 - Math.random() * 20;
		const animation = star.animate(
			[
				{
					opacity: 0,
					transform: `rotate(${angle}deg) translateX(0) scaleX(0.3)`,
				},
				{ offset: 0.15, opacity: 1 },
				{
					opacity: 0,
					transform: `rotate(${angle}deg) translateX(-16rem) scaleX(1)`,
				},
			],
			{ duration: 800 + Math.random() * 600, easing: "ease-out" },
		);

		animation.addEventListener("finish", () => {
			star.remove();
		});
	}

	function scheduleShootingStar(container: HTMLElement) {
		setTimeout(
			() => {
				if (
					!reducedMotionQuery.matches &&
					!document.hidden &&
					!container.closest("[data-offscreen]") &&
					getTheme() === "dark"
				) {
					launchShootingStar(container);
				}

				scheduleShootingStar(container);
			},
			1500 + Math.random() * 4500,
		);
	}

	if (night) {
		scheduleShootingStar(night);
	}
</script>

---
import { orbCenter } from "./orb";

const birds = [
	{ duration: 1.4, left: "53%", size: 5, top: 3.75 },
	{ duration: 1.1, left: "6%", size: 1.6, top: 4 },
	{ duration: 1.7, left: "45%", size: 1, top: 1.25 },
	{ duration: 1.3, left: "93%", size: 1.3, top: 14 },
	{ duration: 1.9, left: "3%", size: 0.9, top: 22 },
];

const clouds = [
	{ drift: 60, left: "33%", size: 4.5, top: 0.75 },
	{ drift: 45, left: "55%", size: 3, top: 0.25 },
	{ drift: 70, left: "88%", size: 5, top: 15 },
	{ drift: 55, left: "1%", size: 4, top: 9 },
];
---

<div aria-hidden="true" class="hero-sky" style={`--orb-center: ${orbCenter}`}>
	<span class="hero-sky-stars hero-sky-stars-near"></span>
	<span class="hero-sky-stars hero-sky-stars-far"></span>
	<span class="hero-sky-glow"></span>
	{clouds.map(({ drift, left, size, top }) => (
		<svg
			class="hero-sky-cloud"
			style={`--drift: ${drift}s; --left: ${left}; --size: ${size}rem; --top: ${top}rem`}
			viewBox="0 0 64 32"
		>
			<path d="M10 30 H54 A8 8 0 0 0 54 14 A10 10 0 0 0 38 8 A12 12 0 0 0 16 12 A10 10 0 0 0 10 30 Z" />
		</svg>
	))}
	<span class="hero-sky-orb"></span>
	{birds.map(({ duration, left, size, top }, index) => (
		<svg
			class="hero-sky-birds"
			style={`--duration: ${duration}s; --left: ${left}; --size: ${size}rem; --top: ${top}rem`}
			viewBox={index ? "0 0 36 20" : "0 0 120 40"}
		>
			{index ? (
				<path class="hero-sky-bird" d="M2 14 Q10 4 18 14 Q26 4 34 14" />
			) : (
				<>
					<path class="hero-sky-bird" d="M4 20 Q12 10 20 20 Q28 10 36 20" />
					<path class="hero-sky-bird" d="M50 8 Q56 0 62 8 Q68 0 74 8" />
					<path class="hero-sky-bird" d="M86 28 Q92 21 98 28 Q104 21 110 28" />
				</>
			)}
		</svg>
	))}
</div>

<style>
	.hero-sky {
		background: linear-gradient(
			180deg,
			var(--colorBlueBright2) 0%,
			light-dark(
					var(--colorBlueBright1),
					color-mix(in srgb, var(--colorBlue5) 70%, var(--colorBlue4))
				)
				35%,
			light-dark(
					var(--colorCream),
					color-mix(in srgb, var(--colorBlue4) 70%, var(--colorSea))
				)
				72%,
			light-dark(
					color-mix(in srgb, var(--colorCream) 80%, var(--colorTerminalOrange)),
					color-mix(in srgb, var(--colorSea) 85%, var(--colorBlue3))
				)
				100%
		);
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		position: absolute;
	}

	.hero-sky-stars {
		display: none;
		inset: 0 0 35%;
		mask-image: linear-gradient(to bottom, var(--colorBlue5) 30%, transparent);
		position: absolute;
	}

	:global(html.dark) .hero-sky-stars {
		display: block;
	}

	.hero-sky-stars-near {
		animation: hero-sky-twinkle 6s ease-in-out infinite alternate;
		background-image:
			radial-gradient(1.5px 1.5px at 8% 14%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 23% 62%, var(--colorBlue1), transparent),
			radial-gradient(
				1.5px 1.5px at 41% 31%,
				var(--colorWhiteIsh),
				transparent
			),
			radial-gradient(1px 1px at 57% 78%, var(--colorBlue1), transparent),
			radial-gradient(2px 2px at 71% 9%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 88% 46%, var(--colorBlue1), transparent),
			radial-gradient(1.5px 1.5px at 94% 83%, var(--colorWhiteIsh), transparent);
		background-size: 380px 260px;
	}

	.hero-sky-stars-far {
		animation: hero-sky-twinkle 9s ease-in-out infinite alternate-reverse;
		background-image:
			radial-gradient(1px 1px at 15% 40%, var(--colorWhiteIsh), transparent),
			radial-gradient(1.5px 1.5px at 33% 85%, var(--colorBlue2), transparent),
			radial-gradient(1px 1px at 52% 12%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 66% 55%, var(--colorWhiteIsh), transparent),
			radial-gradient(1.5px 1.5px at 81% 24%, var(--colorBlue1), transparent);
		background-position: 120px 60px;
		background-size: 530px 340px;
	}

	@keyframes hero-sky-twinkle {
		0% {
			opacity: 0.35;
		}

		100% {
			opacity: 1;
		}
	}

	.hero-sky :global(.hero-sky-shooting-star) {
		background: linear-gradient(
			to right,
			var(--colorWhiteIsh),
			rgb(from var(--colorBlue1) r g b / 0%)
		);
		border-radius: var(--radiusPill);
		height: 1.5px;
		opacity: 0;
		position: absolute;
		width: 7rem;
	}

	.hero-sky-glow {
		animation: hero-sky-breathe 10s ease-in-out infinite alternate;
		background:
			radial-gradient(
				ellipse 45% 70% at 50% 100%,
				light-dark(
					rgb(from var(--colorTerminalOrange) r g b / 22%),
					rgb(from var(--colorTerminalOrange) r g b / 40%)
				),
				transparent 70%
			),
			radial-gradient(
				ellipse 30% 60% at 18% 100%,
				rgb(from var(--colorBlue2) r g b / 20%),
				transparent 70%
			),
			radial-gradient(
				ellipse 30% 60% at 84% 100%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 70%
			);
		bottom: 3rem;
		height: 26rem;
		left: -10%;
		position: absolute;
		right: -10%;
		transform-origin: bottom center;
	}

	@keyframes hero-sky-breathe {
		0% {
			opacity: 0.75;
			transform: scaleY(0.92);
		}

		100% {
			opacity: 1;
			transform: scaleY(1.05);
		}
	}

	.hero-sky-cloud {
		animation: hero-sky-drift var(--drift) ease-in-out infinite alternate;
		display: none;
		fill: var(--colorWhite);
		filter: drop-shadow(
			0 0.2rem 0.4rem rgb(from var(--colorBlue4) r g b / 10%)
		);
		left: var(--left);
		opacity: 0.9;
		position: absolute;
		top: var(--top);
		width: var(--size);
	}

	:global(html:not(.dark)) .hero-sky-cloud {
		display: block;
	}

	@keyframes hero-sky-drift {
		0% {
			translate: -1.5rem 0;
		}

		100% {
			translate: 1.5rem 0;
		}
	}

	.hero-sky-orb {
		--hero-orb-crescent: light-dark(transparent, var(--colorWhiteIsh));
		--hero-orb-glow: light-dark(
			rgb(from var(--colorTerminalOrange) r g b / 55%),
			rgb(from var(--colorBlue1) r g b / 45%)
		);

		animation: hero-sky-orb-glow 7s ease-in-out infinite alternate;
		background: light-dark(
			color-mix(in srgb, var(--colorCream) 50%, var(--colorTerminalOrange)),
			transparent
		);
		border-radius: 50%;
		box-shadow: inset -1.1rem 0.5rem 0 0 var(--hero-orb-crescent);
		display: none;
		filter: drop-shadow(0 0 0.75rem var(--hero-orb-glow));
		height: 4rem;
		left: var(--orb-center);
		position: absolute;
		rotate: -20deg;
		top: 6.5rem;
		translate: -50% 0;
		width: 4rem;
	}

	@keyframes hero-sky-orb-glow {
		100% {
			filter: drop-shadow(0 0 1.5rem var(--hero-orb-glow));
		}
	}

	.hero-sky-birds {
		display: none;
		fill: none;
		left: var(--left);
		position: absolute;
		stroke: light-dark(var(--colorBlue4), var(--colorBlue1));
		stroke-linecap: round;
		stroke-width: 1.6;
		top: var(--top);
		width: var(--size);
	}

	.hero-sky-bird {
		animation: hero-sky-flap var(--duration) ease-in-out infinite alternate;
		transform-box: fill-box;
		transform-origin: center;
	}

	.hero-sky-bird:nth-child(2) {
		animation-delay: -0.5s;
		animation-duration: 1.1s;
	}

	.hero-sky-bird:nth-child(3) {
		animation-delay: -0.9s;
		animation-duration: 1.6s;
	}

	@keyframes hero-sky-flap {
		0% {
			transform: scaleY(1);
		}

		100% {
			transform: scaleY(0.35) translateY(2px);
		}
	}

	@media (--widthSmall) {
		.hero-sky-orb {
			display: block;
		}
	}

	@media (--widthLarge) {
		.hero-sky-orb {
			display: none;
		}

		.hero-sky-birds {
			display: block;
		}
	}

	@media (--widthXLarge) {
		.hero-sky-orb {
			display: block;
		}
	}
</style>

<script>
	const sky = document.querySelector<HTMLElement>(".hero-sky");
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

	function launchShootingStar(container: HTMLElement) {
		const star = document.createElement("span");
		star.className = "hero-sky-shooting-star";
		star.style.left = `${20 + Math.random() * 70}%`;
		star.style.top = `${Math.random() * 35}%`;
		container.append(star);

		const angle = -15 - Math.random() * 20;
		const animation = star.animate(
			[
				{
					opacity: 0,
					transform: `rotate(${angle}deg) translateX(0) scaleX(0.3)`,
				},
				{ offset: 0.15, opacity: 1 },
				{
					opacity: 0,
					transform: `rotate(${angle}deg) translateX(-16rem) scaleX(1)`,
				},
			],
			{ duration: 800 + Math.random() * 600, easing: "ease-out" },
		);

		animation.addEventListener("finish", () => {
			star.remove();
		});
	}

	function scheduleShootingStar(container: HTMLElement) {
		setTimeout(
			() => {
				if (
					!reducedMotion.matches &&
					!document.hidden &&
					document.documentElement.classList.contains("dark")
				) {
					launchShootingStar(container);
				}

				scheduleShootingStar(container);
			},
			3000 + Math.random() * 9000,
		);
	}

	if (sky) {
		scheduleShootingStar(sky);
	}
</script>

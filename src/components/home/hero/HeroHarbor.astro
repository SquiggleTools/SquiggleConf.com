---
import cityscape from "~/assets/design/cityscape.svg";

const glints = Array.from({ length: 36 }, (_, index) => {
	const seed = Math.sin(index * 7919 + 104729) * 43758.5453;
	const random = seed - Math.floor(seed);
	return {
		delay: random * 5,
		duration: 2.5 + random * 3.5,
		left: (index * 29 + random * 11) % 100,
		top: 12 + ((index * 17) % 70),
		width: 0.6 + random * 1.6,
	};
});
---

<div aria-hidden="true" class="hero-harbor">
	<div class="hero-harbor-inner">
		<div
			class="hero-harbor-reflection"
			style={{ backgroundImage: `url(${cityscape.src})` }}
		></div>
	</div>
	{glints.map(({ delay, duration, left, top, width }) => (
		<span
			class="hero-harbor-glint"
			style={`--delay: -${delay}s; --duration: ${duration}s; --left: ${left}%; --top: ${top}%; --width: ${width}rem`}
		/>
	))}
	<svg class="hero-harbor-boat" viewBox="0 0 60 50">
		<path class="hero-harbor-boat-flag" d="M30 3 L38 6 L30 9 Z"></path>
		<path class="hero-harbor-boat-sail" d="M30 6 L30 38 L10 38 Z"></path>
		<path class="hero-harbor-boat-jib" d="M32 10 L32 38 L50 38 Z"></path>
		<path class="hero-harbor-boat-hull" d="M4 40 L56 40 L48 48 L12 48 Z"></path>
	</svg>
</div>

<style>
	.hero-harbor {
		height: 3rem;
		left: 0;
		overflow: hidden;
		pointer-events: none;
		position: absolute;
		right: 0;
		top: 1.4rem;
	}

	.hero-harbor-inner {
		height: 100%;
		left: 50%;
		position: absolute;
		top: 0;
		width: 0;
	}

	.hero-harbor-reflection {
		animation: hero-harbor-ripple 6s ease-in-out infinite alternate;
		background-position: center -5rem;
		background-repeat: repeat-x;
		background-size: auto 10rem;
		filter: blur(0.6px);
		height: 3rem;
		mask-composite: intersect;
		mask-image:
			repeating-linear-gradient(
				to bottom,
				var(--colorBlue5) 0 2px,
				rgb(from var(--colorBlue5) r g b / 35%) 2px 4px
			),
			linear-gradient(to top, var(--colorBlue5), transparent);
		min-width: 100vw;
		opacity: 0.3;
		scale: 1 -1;
		translate: -48.5% 0;
		width: 150rem;
	}

	:global(html.dark) .hero-harbor-reflection {
		opacity: 0.4;
	}

	@keyframes hero-harbor-ripple {
		0% {
			transform: skewX(-1.5deg) scaleY(1);
		}

		100% {
			transform: skewX(1.5deg) scaleY(0.94);
		}
	}

	.hero-harbor-glint {
		animation: hero-harbor-glint var(--duration) ease-in-out infinite;
		animation-delay: var(--delay);
		background: light-dark(
			var(--colorWhite),
			rgb(from var(--colorCream) r g b / 90%)
		);
		border-radius: var(--radiusPill);
		box-shadow: 0 0 0.4rem
			light-dark(
				rgb(from var(--colorTerminalOrange) r g b / 40%),
				rgb(from var(--colorCream) r g b / 50%)
			);
		height: 2px;
		left: var(--left);
		opacity: 0;
		position: absolute;
		top: var(--top);
		width: var(--width);
	}

	@keyframes hero-harbor-glint {
		0%,
		100% {
			opacity: 0;
			transform: translateX(-0.4rem) scaleX(0.5);
		}

		50% {
			opacity: 0.8;
			transform: translateX(0.4rem) scaleX(1);
		}
	}

	.hero-harbor-boat {
		animation: hero-harbor-sail 80s linear infinite;
		animation-delay: -28s;
		left: 0;
		position: absolute;
		top: 0.1rem;
		translate: 30vw 0;
		width: 2.4rem;
	}

	.hero-harbor-boat-hull {
		fill: light-dark(var(--colorBlue4), var(--colorBlue1));
	}

	.hero-harbor-boat-sail,
	.hero-harbor-boat-jib {
		stroke: light-dark(rgb(from var(--colorBlue4) r g b / 75%), transparent);
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.hero-harbor-boat-sail {
		fill: light-dark(var(--colorWhite), var(--colorCream));
	}

	.hero-harbor-boat-jib {
		fill: light-dark(
			var(--colorBlue1),
			color-mix(in srgb, var(--colorCream) 80%, var(--colorBlue1))
		);
	}

	.hero-harbor-boat-flag {
		fill: var(--colorTerminalOrange);
	}

	@keyframes hero-harbor-sail {
		0% {
			translate: -5vw 0;
		}

		25% {
			translate: 22.5vw 0.15rem;
		}

		50% {
			translate: 50vw 0;
		}

		75% {
			translate: 77.5vw 0.15rem;
		}

		100% {
			translate: 105vw 0;
		}
	}

	@media (--widthMedium) {
		.hero-harbor-reflection {
			translate: -50% 0;
		}
	}
</style>

---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	heading?: string;
}

const { class: className, heading, ...attributes } = Astro.props;
---

<div {...attributes} class:list={["timeline-copy", className]}>
	{heading && <h3 class="timeline-copy-heading">{heading}</h3>}
	<slot />
</div>

<style>
	.timeline-copy {
		display: grid;
		gap: 0.45rem;
		max-width: 46rem;
	}

	.timeline-copy :global(p) {
		color: var(--timeline-entry-copy-color);
		font-size: var(--fontSizeCopySmall);
		line-height: 1.45;
		margin: 0;
		max-width: 62ch;
		transition: color var(--transitionNormal);
	}

	.timeline-copy-heading {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: 1.2rem;
		font-weight: var(--fontWeightBold);
		line-height: 1.05;
		margin: 0 0 0.25rem;
	}
</style>

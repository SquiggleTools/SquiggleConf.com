---
import type {
	CollageLayout,
	CollagePhoto,
	CollageShape,
} from "~/components/home/types";
import PlaceholderMark from "./PlaceholderMark.astro";
import CollagePhotoImage from "./CollagePhotoImage.astro";
import CollageItem from "./CollageItem.astro";

interface Props {
	ariaLabel?: string;
	class?: string;
	decorative?: boolean;
	placeholder?: boolean;
	layout?: CollageLayout;
	photos: readonly CollagePhoto[];
	shape?: CollageShape;
}

const {
	ariaLabel,
	class: className,
	decorative,
	layout = "auto",
	photos,
	shape = "photo",
} = Astro.props;

const resolvedLayout =
	layout === "auto"
		? shape === "avatar"
			? photos.length === 2
				? "avatar-duo"
				: "avatar-trio"
			: photos.length === 2
				? "duo"
				: photos.length === 5
					? "feature-five"
					: "trio"
		: layout;
---

<div
	aria-hidden={!ariaLabel && decorative ? "true" : undefined}
	aria-label={ariaLabel}
	class:list={[
		"collage",
		`collage-${resolvedLayout}`,
		`collage-${shape}`,
		className,
	]}
	role={ariaLabel ? "group" : undefined}
>
	{
		photos.map((photo, index) => (
			<CollageItem
				class:list={[
					"collage-item",
					`collage-item-${index + 1}`,
					photo.placeholder && "collage-item-placeholder",
				]}
			>
				<CollagePhotoImage
					alt={decorative || photo.decorative ? "" : photo.alt}
					src={photo.src}
					objectPosition={photo.objectPosition}
				/>
				{photo.placeholder && <PlaceholderMark />}
			</CollageItem>
		))
	}
</div>

<style>
	.collage {
		--collage-height: 9rem;
		--collage-width: min(100%, 31rem);
		height: var(--collage-height);
		position: relative;
		width: var(--collage-width);
		z-index: 1;
	}

	.collage-item {
		position: absolute;
	}

	.collage-avatar .collage-item {
		border-radius: 999px;
		transition: box-shadow var(--timeline-hover-duration) ease;
		will-change: auto;
	}

	.collage-item.collage-item-placeholder :global(img) {
		filter: blur(2px);
	}

	.collage-duo {
		--collage-height: 5rem;
		--collage-width: 12rem;
	}

	.fun-run-collage {
		justify-self: start;
		left: 17rem;
		position: absolute;
		top: 1rem;
		transform: none;
	}

	.fun-run-collage-mobile {
		display: none;
	}

	.collage-duo .collage-item-1 {
		height: 7rem;
		left: 6rem;
		top: -4rem;
		transform: translate3d(0, 0, 0) rotate(35deg) scale(1);
		width: 5rem;
	}

	.collage-duo .collage-item-2 {
		height: 8rem;
		left: 1rem;
		top: -4rem;
		transform: translate3d(0, 0, 0) rotate(-10deg) scale(1);
		width: 6rem;
	}

	.collage-trio .collage-item-1 {
		height: var(--collage-trio-item-1-height, 6.5rem);
		left: var(--collage-trio-item-1-left, 0.2rem);
		top: var(--collage-trio-item-1-top, 1.15rem);
		transform: rotate(var(--collage-trio-item-1-rotate, -12deg));
		width: var(--collage-trio-item-1-width, 8.9rem);
	}

	.collage-trio .collage-item-2 {
		height: var(--collage-trio-item-2-height, 6.3rem);
		left: var(--collage-trio-item-2-left, 6.1rem);
		top: var(--collage-trio-item-2-top, 0.1rem);
		transform: rotate(var(--collage-trio-item-2-rotate, -2deg));
		width: var(--collage-trio-item-2-width, 8.9rem);
		z-index: var(--collage-trio-item-2-z-index, auto);
	}

	.collage-trio .collage-item-3 {
		height: var(--collage-trio-item-3-height, 6.4rem);
		left: var(--collage-trio-item-3-left, 13rem);
		top: var(--collage-trio-item-3-top, 0.85rem);
		transform: rotate(var(--collage-trio-item-3-rotate, 9deg));
		width: var(--collage-trio-item-3-width, 8.9rem);
	}

	.launch-party-collage {
		margin-bottom: 1rem;
	}

	.cookiesbreak-collage {
		--collage-height: 8rem;
		--collage-trio-item-1-height: 5.7rem;
		--collage-trio-item-1-left: 0.25rem;
		--collage-trio-item-1-rotate: -8deg;
		--collage-trio-item-1-top: 1rem;
		--collage-trio-item-1-width: 7.5rem;
		--collage-trio-item-2-height: 5.8rem;
		--collage-trio-item-2-left: 5.4rem;
		--collage-trio-item-2-rotate: 2deg;
		--collage-trio-item-2-top: 0.2rem;
		--collage-trio-item-2-width: 7.5rem;
		--collage-trio-item-2-z-index: 1;
		--collage-trio-item-3-height: 5rem;
		--collage-trio-item-3-left: 11rem;
		--collage-trio-item-3-rotate: 10deg;
		--collage-trio-item-3-top: 2rem;
		--collage-trio-item-3-width: 6rem;
		--collage-width: 18.6rem;
	}

	.collage-feature-five {
		--collage-height: min(35vw, 16em);
		--collage-width: min(100%, 38rem);
	}

	.afterparty-collage {
		margin: 1.9rem 0 1.1rem;
	}

	.collage-feature-five .collage-item {
		aspect-ratio: var(--collage-feature-photo-aspect, 16 / 9);
		height: auto;
		width: var(--collage-feature-photo-width, 20%);
	}

	.collage-feature-five .collage-item-1 {
		--collage-feature-photo-aspect: 16 / 9;
		--collage-feature-photo-width: 66%;
		left: 0%;
		top: 0%;
		transform: rotate(-6deg);
		z-index: 5;
	}

	.collage-feature-five .collage-item-2 {
		--collage-feature-photo-aspect: 14 / 16;
		--collage-feature-photo-width: 26%;
		left: 65%;
		top: 9%;
		transform: rotate(8deg);
		z-index: 4;
	}

	.collage-feature-five .collage-item-3 {
		--collage-feature-photo-aspect: 16 / 9;
		--collage-feature-photo-width: 33%;
		left: 50%;
		top: -8%;
		transform: rotate(0deg);
		z-index: 2;
	}

	.collage-feature-five .collage-item-4 {
		--collage-feature-photo-aspect: 16 / 9;
		--collage-feature-photo-width: 31%;
		left: 76%;
		top: 8%;
		transform: rotate(19deg);
		z-index: 1;
	}

	.collage-feature-five .collage-item-5 {
		--collage-feature-photo-aspect: 16 / 9;
		--collage-feature-photo-width: 30%;
		left: 47%;
		top: 49%;
		transform: rotate(7deg);
		z-index: 5;
	}

	.collage-avatar-duo {
		--collage-height: 10rem;
		--collage-width: 10rem;
	}

	.collage-avatar-duo .collage-item-1 {
		height: 8rem;
		left: -1rem;
		top: 1rem;
		width: 8rem;
	}

	.collage-avatar-duo .collage-item-2 {
		height: 5rem;
		left: 5rem;
		top: 5rem;
		transform: rotate(6deg);
		width: 5rem;
		z-index: 2;
	}

	.collage-avatar-trio {
		--collage-height: 11rem;
		--collage-width: 11.5rem;
	}

	.collage-avatar-trio .collage-item-1 {
		height: 8rem;
		left: 3rem;
		top: 1.65rem;
		width: 8rem;
		z-index: 1;
	}

	.collage-avatar-trio .collage-item-2 {
		height: 5rem;
		left: 0;
		top: 1rem;
		transform: rotate(-7deg);
		width: 5rem;
		z-index: 2;
	}

	.collage-avatar-trio .collage-item-3 {
		height: 5rem;
		left: 0;
		top: 5rem;
		transform: rotate(7deg);
		width: 5rem;
		z-index: 2;
	}

	@media (width < 900px) {
		.fun-run-collage-desktop {
			display: none;
		}

		.fun-run-collage-mobile {
			--collage-height: 7.6rem;
			--collage-width: 8rem;
			align-self: start;
			display: block;
			justify-self: end;
			left: auto;
			min-height: 7.6rem;
			position: relative;
			right: auto;
		}

		.fun-run-collage-mobile .collage-item-1 {
			height: 5.45rem;
			left: 3.8rem;
			top: 0.3rem;
			width: 3.75rem;
		}

		.fun-run-collage-mobile .collage-item-2 {
			height: 6.1rem;
			left: 0;
			top: 0.7rem;
			width: 4.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.collage,
		.collage-item {
			animation: none;
			transition: none;
		}
	}
</style>

---
import type { HTMLAttributes } from "astro/types";

import type {
	CollageLayout,
	CollagePhoto,
	CollageShape,
} from "~/components/home/types";
import TimelineImage from "./timeline/TimelineImage.astro";

interface Props extends HTMLAttributes<"div"> {
	ariaLabel?: string;
	layout: CollageLayout;
	photos: readonly CollagePhoto[];
	shape?: CollageShape;
}

const {
	ariaLabel,
	class: className,
	layout,
	photos,
	shape = "photo",
	...rest
} = Astro.props;
---

<div
	aria-label={ariaLabel}
	class:list={["collage", `collage-${layout}`, `collage-${shape}`, className]}
	role={ariaLabel ? "group" : undefined}
	{...rest}
>
	{
		photos.map((photo, index) => (
			<div class={`collage-item collage-item-${index + 1}`}>
				<TimelineImage
					alt={photo.decorative ? "" : photo.alt}
					effect={
						shape === "avatar" ? "zoom" : layout === "duo" ? undefined : "grow"
					}
					loading="lazy"
					objectPosition={photo.objectPosition}
					placeholder={photo.placeholder}
					radius={shape === "avatar" ? "var(--radiusPill)" : undefined}
					src={photo.src}
				/>
			</div>
		))
	}
</div>

<style>
	.collage {
		--collage-height: 9rem;
		--collage-width: min(100%, 31rem);
		height: var(--collage-height);
		position: relative;
		width: var(--collage-width);
		z-index: 1;
	}

	.collage-item {
		display: grid;
		position: absolute;
		transition: transform var(--transitionNormal);
	}

	.collage-duo {
		--collage-height: 5rem;
		--collage-width: 12rem;
	}

	.collage-duo .collage-item-1 {
		height: 7rem;
		left: 6rem;
		top: -4rem;
		transform: var(--timeline-collage-duo-1) rotate(35deg);
		width: 5rem;
	}

	.collage-duo .collage-item-2 {
		height: 8rem;
		left: 1rem;
		top: -4rem;
		transform: var(--timeline-collage-duo-2) rotate(-10deg);
		width: 6rem;
	}

	.collage-trio .collage-item {
		height: 6.4rem;
		width: 8.9rem;
	}

	.collage-trio .collage-item-1 {
		height: 6.5rem;
		left: 0.2rem;
		rotate: -12deg;
		top: 1.15rem;
	}

	.collage-trio .collage-item-2 {
		height: 6.3rem;
		left: 6.1rem;
		rotate: -2deg;
		top: 0.1rem;
	}

	.collage-trio .collage-item-3 {
		left: 13rem;
		rotate: 9deg;
		top: 0.85rem;
	}

	.collage-trio-compact {
		--collage-height: 8rem;
		--collage-width: 18.6rem;
	}

	.collage-trio-compact .collage-item-1 {
		height: 5.7rem;
		left: 0.25rem;
		rotate: -8deg;
		top: 1rem;
		width: 7.5rem;
	}

	.collage-trio-compact .collage-item-2 {
		height: 5.8rem;
		left: 5.4rem;
		rotate: 2deg;
		top: 0.2rem;
		width: 7.5rem;
		z-index: 1;
	}

	.collage-trio-compact .collage-item-3 {
		height: 5rem;
		left: 11rem;
		rotate: 10deg;
		top: 2rem;
		width: 6rem;
	}

	.collage-feature-five {
		--collage-height: min(35vw, 16em);
		--collage-width: min(100%, 38rem);
	}

	.collage-feature-five .collage-item {
		aspect-ratio: 16 / 9;
		height: auto;
	}

	.collage-feature-five .collage-item-1 {
		left: 0%;
		rotate: -6deg;
		top: 0%;
		width: 66%;
		z-index: 5;
	}

	.collage-feature-five .collage-item-2 {
		aspect-ratio: 14 / 16;
		left: 65%;
		rotate: 8deg;
		top: 9%;
		width: 26%;
		z-index: 4;
	}

	.collage-feature-five .collage-item-3 {
		left: 50%;
		top: -8%;
		width: 33%;
		z-index: 2;
	}

	.collage-feature-five .collage-item-4 {
		left: 76%;
		rotate: 19deg;
		top: 8%;
		width: 31%;
		z-index: 1;
	}

	.collage-feature-five .collage-item-5 {
		left: 47%;
		rotate: 7deg;
		top: 49%;
		width: 30%;
		z-index: 5;
	}

	.collage-avatar-duo {
		--collage-height: 10rem;
		--collage-width: 10rem;
	}

	.collage-avatar-duo .collage-item-1 {
		height: 8rem;
		left: -1rem;
		top: 1rem;
		width: 8rem;
	}

	.collage-avatar-duo .collage-item-2 {
		height: 5rem;
		left: 5rem;
		rotate: 6deg;
		top: 5rem;
		width: 5rem;
		z-index: 2;
	}

	.collage-avatar-pair {
		--collage-height: 7rem;
		--collage-width: 14.5rem;
	}

	.collage-avatar-pair .collage-item {
		height: 7rem;
		top: 0;
		width: 7rem;
	}

	.collage-avatar-pair .collage-item-1 {
		left: 0;
	}

	.collage-avatar-pair .collage-item-2 {
		left: 7.5rem;
	}

	.collage-avatar-trio {
		--collage-height: 11rem;
		--collage-width: 11.5rem;
	}

	.collage-avatar-trio .collage-item {
		height: 5rem;
		left: 0;
		width: 5rem;
		z-index: 2;
	}

	.collage-avatar-trio .collage-item-1 {
		height: 8rem;
		left: 3rem;
		top: 1.65rem;
		width: 8rem;
		z-index: 1;
	}

	.collage-avatar-trio .collage-item-2 {
		rotate: -7deg;
		top: 1rem;
	}

	.collage-avatar-trio .collage-item-3 {
		rotate: 7deg;
		top: 5rem;
	}
</style>

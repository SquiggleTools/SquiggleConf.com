---
import { Image } from "astro:assets";

import { postcardBack, postcardFront } from "~/components/home/data";
---

<div
	class="postcard-gallery"
	style="--postcard-back-width: 21rem; --postcard-front-scale: 1.5;"
>
	<div class="postcard-stack postcard-stack-flip">
		<div class="postcard-flip-scene">
			<div class="postcard-flip-inner">
				<span class="postcard-face postcard-face-front">
					<span class="postcard postcard-front">
						<Image
							alt="Front of the SquiggleConf postcard"
							src={postcardFront}
							loading="eager"
						/>
					</span>
				</span>
				<span class="postcard-face postcard-face-back">
					<span class="postcard postcard-back">
						<Image
							alt="Back of the SquiggleConf postcard"
							src={postcardBack}
							loading="eager"
						/>
						<span class="postcard-back-message">
							<span class="postcard-back-greeting">Hi Mom,</span>
							<span>
								SquiggleConf was so much fun this year! <br />I learned all
								about abstract syntax trees, AI agent harnesses, and met the
								devs leading the industry!
							</span>
						</span>
						<span class="postcard-back-address">
							<span class="postcard-back-line">New England Aquarium</span>
							<span class="postcard-back-line">Simons Theater</span>
							<span class="postcard-back-line">1 Central Wharf</span>
							<span class="postcard-back-line">Boston, MA 02110</span>
						</span>
					</span>
					<span class="postcard-note postcard-note-back"
						>* yes, you'll really get this postcard</span
					>
				</span>
			</div>
		</div>
	</div>
</div>

<style>
	.postcard {
		aspect-ratio: 6 / 4;
		border-radius: 0.45rem;
		box-shadow:
			0 0.08rem 0 rgba(255, 255, 255, 0.5),
			0 0.35rem 0.75rem rgba(2, 14, 31, 0.14),
			0 1.35rem 2.6rem rgba(2, 14, 31, 0.24);
		display: block;
		overflow: hidden;
		position: relative;
		transition:
			box-shadow var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease;
		width: 100%;
	}

	.postcard :global(img) {
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.postcard-gallery {
		display: flex;
		flex-direction: column;
		gap: 0;
		justify-content: flex-start;
		align-items: center;
		margin: 0 auto 1.15rem;
		width: 100%;
	}

	.postcard-heading {
		color: var(--timeline-heading-color);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.8rem, 2.8vw, 2.45rem);
		font-style: italic;
		font-weight: 700;
		line-height: 1;
		padding-top: 1rem;
		margin: 0 auto;
		max-width: fit-content;
		position: relative;
		text-align: center;
		z-index: 1;
	}

	.postcard-intro {
		color: var(--timeline-copy-color);
		font-size: clamp(1rem, 1.35vw, 1.12rem);
		line-height: 1.6;
		margin: 0.85rem auto 0;
		padding: 0 1rem;
		max-width: 39rem;
		text-align: center;
		text-wrap: pretty;
	}

	.postcard-stack {
		margin: 3em 0 2rem 0;
		display: grid;
		gap: 0.5rem;
		justify-items: center;
		width: min(100%, 100vw - 2rem);
		transition: transform var(--timeline-hover-duration) ease;
	}

	@keyframes postcard-idle-wiggle {
		0%,
		84%,
		100% {
			transform: rotate(-4deg);
		}

		88% {
			transform: rotate(-2.8deg) translateY(-0.04rem);
		}

		92% {
			transform: rotate(-5.1deg) translateY(0.02rem);
		}

		96% {
			transform: rotate(-3.3deg) translateY(-0.03rem);
		}
	}

	.postcard-stack-flip {
		animation: postcard-idle-wiggle 5s ease-in-out infinite;
		padding-bottom: 2.2rem;
		transform: rotate(-4deg);
		width: min(
			100%,
			calc(var(--postcard-back-width, 21rem) * var(--postcard-front-scale, 1.5))
		);
	}

	.postcard-stack-flip:hover,
	.postcard-stack-flip:focus-within {
		animation: none;
	}

	.postcard-flip-scene {
		overflow: visible;
		perspective: 1200px;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
		width: 100%;
	}

	.postcard-stack-flip:hover .postcard-flip-scene,
	.postcard-stack-flip:focus-within .postcard-flip-scene {
		transform: rotate(8deg) translateY(-0.08rem);
	}

	.postcard-flip-inner {
		aspect-ratio: 6 / 4;
		pointer-events: none;
		position: relative;
		transform-style: preserve-3d;
		transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
		width: 100%;
	}

	.postcard-stack-flip:hover .postcard-flip-inner,
	.postcard-stack-flip:focus-within .postcard-flip-inner {
		transform: rotateY(180deg);
	}

	.postcard-stack-flip:hover .postcard,
	.postcard-stack-flip:focus-within .postcard {
		box-shadow:
			0 0.08rem 0 rgba(255, 255, 255, 0.56),
			0 0.45rem 0.95rem rgba(2, 14, 31, 0.16),
			0 1.65rem 3rem rgba(2, 14, 31, 0.28);
	}

	.postcard-face {
		backface-visibility: hidden;
		display: block;
		inset: 0;
		overflow: visible;
		pointer-events: none;
		position: absolute;
		width: 100%;
	}

	.postcard-face-back {
		transform: rotateY(180deg);
	}

	.postcard-face-front,
	.postcard-face-back {
		height: 100%;
	}

	.postcard-face-front .postcard,
	.postcard-face-back .postcard {
		height: 100%;
		pointer-events: none;
		width: 100%;
	}

	.postcard-front {
		background: #f7f2ea;
	}

	.postcard-back {
		background: #fffdf8;
	}

	.postcard-back-message {
		color: #49515f;
		display: grid;
		gap: clamp(0.35rem, 0.8vw, 0.6rem);
		inset: 12% auto auto 7%;
		line-height: 1.5;
		max-width: 40%;
		pointer-events: none;
		position: absolute;
		text-align: left;
		text-wrap: pretty;
	}

	.postcard-back-message span {
		font-family: "Shantell Sans", cursive;
		font-size: 1.2rem;
		font-weight: 400;
	}

	.postcard-back-greeting {
		font-size: clamp(0.8rem, 1.02vw, 1rem);
	}

	.postcard-back-address {
		bottom: 15%;
		color: #49515f;
		display: grid;
		gap: clamp(0.12rem, 0.35vw, 0.2rem);
		left: 55%;
		max-width: 41%;
		pointer-events: none;
		position: absolute;
		text-align: left;
	}

	.postcard-back-line {
		display: inline-block;
		position: relative;
		font-family: "Shantell Sans", cursive;
		font-size: 0.8rem;
		font-weight: 400;
		line-height: 1.1;
		padding-bottom: 0.35rem;
		margin-top: 0.5rem;
	}

	.postcard-back-line::after {
		border-bottom: 1px solid #585858;
		content: " ";
		display: block;
		filter: blur(0.75px);
		left: -5%;
		bottom: 0.3rem;
		height: 2px;
		position: absolute;
		width: 140%;
	}

	.postcard-note {
		color: var(--timeline-muted-color);
		font-size: clamp(0.82rem, 1.15vw, 0.92rem);
		line-height: 1.3;
		margin: 0;
		max-width: min(100%, 20rem);
		padding: 0 0.5rem;
		text-align: center;
		text-wrap: balance;
	}

	.postcard-note-back {
		left: 50%;
		opacity: 0;
		pointer-events: none;
		position: absolute;
		top: calc(100% + 0.55rem);
		transform: translateX(-50%);
		transition: opacity 240ms ease;
		width: min(100%, 20rem);
	}

	.postcard-stack-flip:hover .postcard-note-back,
	.postcard-stack-flip:focus-within .postcard-note-back {
		opacity: 1;
	}

	@media (max-width: 46rem) {
		.postcard-gallery {
			flex-direction: column;
			align-items: center;
		}

		.postcard-stack-flip {
			animation: postcard-idle-wiggle 5s ease-in-out infinite;
			transform: none;
		}

		.postcard-stack-flip:hover,
		.postcard-stack-flip:focus-within {
			animation: none;
		}

		.postcard-stack-flip:hover .postcard-flip-scene,
		.postcard-stack-flip:focus-within .postcard-flip-scene {
			transform: translateY(-0.08rem);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] {
			animation: none;
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-flip-scene {
			transform: translateY(-0.08rem);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-flip-inner {
			transform: rotateY(180deg);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard {
			box-shadow:
				0 0.08rem 0 rgba(255, 255, 255, 0.56),
				0 0.45rem 0.95rem rgba(2, 14, 31, 0.16),
				0 1.65rem 3rem rgba(2, 14, 31, 0.28);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-note-back {
			opacity: 1;
		}
	}
</style>

---
import { Image } from "astro:assets";

import postcardBack from "~/assets/2027/postcard-back.webp";
import postcardFront from "~/assets/2027/postcard-front.webp";
---

<div class="postcard-gallery">
	<div
		aria-label="SquiggleConf postcard"
		class="postcard-flip"
		role="group"
		tabindex="0"
	>
		<div class="postcard-flip-scene">
			<div class="postcard-flip-inner">
				<span class="postcard-face postcard-face-front">
					<span class="postcard postcard-front">
						<Image
							alt="Front of the SquiggleConf postcard"
							src={postcardFront}
							loading="eager"
						/>
					</span>
				</span>
				<span class="postcard-face postcard-face-back">
					<span class="postcard postcard-back">
						<Image
							alt="Back of the SquiggleConf postcard"
							src={postcardBack}
							loading="eager"
						/>
						<span class="postcard-back-message">
							<span>Hi Mom,</span>
							<span>
								SquiggleConf was so much fun this year! <br />I learned all
								about abstract syntax trees, AI agent harnesses, and met the
								devs leading the industry!
							</span>
						</span>
						<span class="postcard-back-address">
							<span class="postcard-back-line">New England Aquarium</span>
							<span class="postcard-back-line">Simons Theater</span>
							<span class="postcard-back-line">1 Central Wharf</span>
							<span class="postcard-back-line">Boston, MA 02110</span>
						</span>
					</span>
					<span class="postcard-note"
						>* yes, you'll really get this postcard</span
					>
				</span>
			</div>
		</div>
	</div>
</div>

<style>
	.postcard {
		aspect-ratio: 6 / 4;
		border-radius: var(--radiusSmall);
		box-shadow:
			0 0.08rem 0 rgb(from var(--colorWhite) r g b / 50%),
			0 0.35rem 0.75rem rgb(from var(--colorBlue5) r g b / 14%),
			0 1.35rem 2.6rem rgb(from var(--colorBlue5) r g b / 24%);
		display: block;
		overflow: hidden;
		position: relative;
		transition: box-shadow var(--transitionNormal);
		width: 100%;
	}

	.postcard img {
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
		user-select: none;
	}

	.postcard-gallery {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 0 auto 1.15rem;
		width: 100%;
	}

	@keyframes postcard-idle-wiggle {
		0%,
		84%,
		100% {
			transform: rotate(-4deg);
		}

		88% {
			transform: rotate(-2.8deg) translateY(-0.04rem);
		}

		92% {
			transform: rotate(-5.1deg) translateY(0.02rem);
		}

		96% {
			transform: rotate(-3.3deg) translateY(-0.03rem);
		}
	}

	.postcard-flip {
		animation: postcard-idle-wiggle 5s ease-in-out infinite;
		display: grid;
		justify-items: center;
		margin: 3em 0 2rem;
		padding-bottom: 2.2rem;
		transform: rotate(-4deg);
		transition: transform var(--transitionNormal);
		width: min(100%, 31.5rem);
	}

	.postcard-flip:is(:hover, :focus-within, [data-mobile-flipped]) {
		animation: none;
	}

	.postcard-flip-scene {
		perspective: 1200px;
		transition: transform var(--transitionMedium) var(--transitionEaseOut);
		width: 100%;
	}

	.postcard-flip:hover .postcard-flip-scene,
	.postcard-flip:focus-within .postcard-flip-scene {
		transform: rotate(8deg) translateY(-0.08rem);
	}

	.postcard-flip-inner {
		aspect-ratio: 6 / 4;
		pointer-events: none;
		position: relative;
		transform-style: preserve-3d;
		transition: transform var(--transitionSlow) var(--transitionEaseOut);
		width: 100%;
	}

	/* data-mobile-flipped is only set on mobile, when scrolled past */
	.postcard-flip[data-mobile-flipped] .postcard-flip-scene {
		transform: translateY(-0.08rem);
	}

	.postcard-flip:is(:hover, :focus-within, [data-mobile-flipped])
		.postcard-flip-inner {
		transform: rotateY(180deg);
	}

	.postcard-flip:is(:hover, :focus-within, [data-mobile-flipped]) .postcard {
		box-shadow:
			0 0.08rem 0 rgb(from var(--colorWhite) r g b / 56%),
			0 0.45rem 0.95rem rgb(from var(--colorBlue5) r g b / 16%),
			0 1.65rem 3rem rgb(from var(--colorBlue5) r g b / 28%);
	}

	.postcard-face {
		backface-visibility: hidden;
		display: block;
		height: 100%;
		inset: 0;
		position: absolute;
		width: 100%;
	}

	.postcard-face-back {
		transform: rotateY(180deg);
	}

	.postcard-face .postcard {
		height: 100%;
	}

	.postcard-front {
		background: var(--colorPostcardFront);
	}

	.postcard-back {
		background: var(--colorPostcardBack);
		color: var(--colorPostcardInk);
		font-family: "Shantell Sans", cursive;
		font-weight: var(--fontWeightRegular);
	}

	.postcard-back-message {
		display: grid;
		font-size: clamp(1rem, 1.7vw, 1.2rem);
		gap: clamp(0.35rem, 0.8vw, 0.6rem);
		inset: 12% auto auto 7%;
		line-height: 1.5;
		max-width: 40%;
		position: absolute;
		text-align: left;
		text-wrap: pretty;
	}

	.postcard-back-address {
		bottom: 15%;
		display: grid;
		gap: clamp(0.12rem, 0.35vw, 0.2rem);
		left: 55%;
		max-width: 41%;
		position: absolute;
		text-align: left;
	}

	.postcard-back-line {
		display: inline-block;
		position: relative;
		font-size: 0.8rem;
		line-height: 1.1;
		padding-bottom: 0.35rem;
		margin-top: 0.5rem;
	}

	.postcard-back-line::after {
		border-bottom: 1px solid var(--colorPostcardLine);
		content: " ";
		display: block;
		filter: blur(0.75px);
		left: -5%;
		bottom: 0.3rem;
		height: 2px;
		position: absolute;
		width: 140%;
	}

	.postcard-note {
		color: var(--colorMuted);
		font-size: var(--fontSizeCaption);
		left: 50%;
		line-height: 1.3;
		margin: 0;
		max-width: min(100%, 20rem);
		opacity: 0;
		padding: 0 0.5rem;
		position: absolute;
		text-align: center;
		text-wrap: balance;
		top: calc(100% + 0.55rem);
		transform: translateX(-50%);
		transition: opacity var(--transitionNormal);
		width: min(100%, 20rem);
	}

	.postcard-flip:is(:hover, :focus-within, [data-mobile-flipped])
		.postcard-note {
		opacity: 1;
	}

	@media not (--widthSmall) {
		.postcard-flip {
			transform: none;
		}

		.postcard-flip:is(:hover, :focus-within) .postcard-flip-scene {
			transform: translateY(-0.08rem);
		}
	}
</style>

<script>
	import { timelineCollapsedQuery } from "~/utils/breakpoints";

	const postcard = document.querySelector<HTMLElement>(".postcard-flip");
	const mobileQuery = matchMedia(timelineCollapsedQuery);

	if (postcard) {
		let centerAboveMiddle = false;

		const updateFlipped = () => {
			postcard.toggleAttribute(
				"data-mobile-flipped",
				mobileQuery.matches && centerAboveMiddle,
			);
		};

		new IntersectionObserver(
			([entry]) => {
				centerAboveMiddle = entry.intersectionRatio >= 0.5;
				updateFlipped();
			},
			{ rootMargin: "100000px 0px -50% 0px", threshold: 0.5 },
		).observe(postcard);

		mobileQuery.addEventListener("change", updateFlipped);
	}
</script>

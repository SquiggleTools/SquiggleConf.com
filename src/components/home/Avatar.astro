---
import { Image } from "astro:assets";
import PlaceholderMark from "./PlaceholderMark.astro";

interface Props {
	alt: string;
	image: ImageMetadata;
	placeholder?: boolean;
}

const { alt, image, placeholder } = Astro.props;
---

<div class="avatar timeline-image timeline-image-zoom">
	<Image
		class={placeholder ? "avatar-placeholder" : undefined}
		alt={alt}
		src={image}
	/>
	{placeholder && <PlaceholderMark />}
</div>

<style>
	.avatar {
		border-radius: 0.45rem;
		position: relative;
	}

	.avatar-placeholder {
		filter: blur(2px);
	}
</style>

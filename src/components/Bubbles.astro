---
interface Props {
	class?: string;
	count?: number;
}

const { class: className, count = 24 } = Astro.props;

const pairs = Math.ceil(count / 2);
const spread = (index: number, step: number) => (index * step) % 1;

const bubbles = Array.from({ length: count }, (_, index) => {
	const pair = Math.floor(index / 2);
	const mirrored = index % 2 === 1;
	const duration = 40 + spread(pair, 0.5698402909) * 20;
	const offset = (pair + 0.2 + spread(pair, 0.6180339887) * 0.6) / pairs;
	const phase = (spread(pair, 0.7548776662) + (mirrored ? 0.04 : 0)) % 1;
	const size = 0.25 + spread(index, 0.4142135623) * 0.6;
	const sway = (spread(index, 0.3819660113) - 0.5) * 3;
	return {
		delay: phase * duration,
		duration,
		left: mirrored ? 100 - offset * 50 : offset * 50,
		size,
		sway: mirrored ? -sway : sway,
	};
});
---

<div
	aria-hidden="true"
	class:list={["bubbles", className]}
	data-pause-offscreen
>
	<div class="bubbles-layer">
		{bubbles.map(({ delay, duration, left, size, sway }) => (
			<span
				class="bubble"
				style={`--delay: -${delay}s; --duration: ${duration}s; --left: ${left}%; --size: ${size}rem; --sway: ${sway}rem`}
			/>
		))}
	</div>
</div>

<style>
	.bubbles {
		inset: 0;
		mask-composite: intersect;
		mask-image:
			linear-gradient(
				to bottom,
				transparent,
				var(--colorBlue5) var(--bubbles-fade, 10rem),
				var(--colorBlue5) calc(100% - 3rem),
				transparent
			),
			var(--bubbles-mask, linear-gradient(var(--colorBlue5), var(--colorBlue5)));
		opacity: max(
			calc(1 - var(--themeDark) * 2),
			calc(var(--themeDark) * 2 - 1)
		);
		overflow: hidden;
		pointer-events: none;
		position: absolute;
	}

	.bubbles-layer {
		container-type: size;
		inset: calc(-0.25 * (100vh + 100%)) 0;
		position: absolute;
	}

	.bubbles-layer[data-parallax-smooth] {
		transition: transform 0.6s var(--transitionEaseOut);
	}

	.bubble {
		animation:
			bubble-rise var(--duration) linear infinite,
			bubble-sway var(--duration) ease-in-out infinite;
		animation-delay: var(--delay);
		background: color-mix(
			in srgb,
			rgb(from var(--colorBlue3) r g b / 12%),
			rgb(from var(--colorWhite) r g b / 18%) calc(var(--themeDarkStep) * 100%)
		);
		border: 1px solid
			color-mix(
				in srgb,
				rgb(from var(--colorBlue3) r g b / 40%),
				rgb(from var(--colorWhite) r g b / 45%)
					calc(var(--themeDarkStep) * 100%)
			);
		border-radius: var(--radiusPill);
		bottom: -1rem;
		box-shadow: inset -0.08rem -0.08rem 0.2rem
			rgb(from var(--colorWhite) r g b / 30%);
		height: var(--size);
		left: var(--left);
		opacity: 0;
		position: absolute;
		width: var(--size);
	}

	@keyframes bubble-rise {
		0% {
			opacity: 0;
			scale: 0.6;
			translate: 0 0;
		}

		15% {
			opacity: 0.8;
		}

		90% {
			opacity: 0.6;
		}

		100% {
			opacity: 0;
			scale: 1.15;
			translate: 0 -110cqh;
		}
	}

	@keyframes bubble-sway {
		0%,
		100% {
			transform: translateX(0);
		}

		50% {
			transform: translateX(var(--sway));
		}
	}
</style>

<script>
	import { reducedMotionQuery } from "~/utils/motion";
	import { pauseOffscreen } from "~/utils/pauseOffscreen";

	pauseOffscreen();

	const fields = [
		...document.querySelectorAll<HTMLElement>(".bubbles"),
	].flatMap((field) => {
		const layer = field.querySelector<HTMLElement>(".bubbles-layer");
		const section = field.parentElement;
		return layer && section ? [{ field, layer, section }] : [];
	});

	if (fields.length) {
		let frame = 0;
		const positioned = new WeakSet<HTMLElement>();

		const update = () => {
			frame = 0;

			if (reducedMotionQuery.matches) {
				for (const { layer } of fields) {
					layer.removeAttribute("data-parallax-smooth");
					layer.style.removeProperty("transform");
					positioned.delete(layer);
				}
				return;
			}

			const drifts = fields
				.filter(({ field }) => {
					const { bottom, top } = field.getBoundingClientRect();
					return bottom > 0 && top < innerHeight;
				})
				.map(({ layer, section }) => {
					const { height, top } = section.getBoundingClientRect();
					return { drift: (innerHeight / 2 - (top + height / 2)) / 4, layer };
				});

			for (const { drift, layer } of drifts) {
				layer.style.transform = `translateY(${drift}px)`;
				if (!positioned.has(layer)) {
					positioned.add(layer);
					requestAnimationFrame(() => {
						layer.toggleAttribute("data-parallax-smooth", true);
					});
				}
			}
		};

		const request = () => {
			frame ||= requestAnimationFrame(update);
		};

		update();
		addEventListener("scroll", request, { passive: true });
		addEventListener("resize", request, { passive: true });
		reducedMotionQuery.addEventListener("change", request);
	}
</script>

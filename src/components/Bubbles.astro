---
interface Props {
	class?: string;
	count?: number;
}

const { class: className, count = 24 } = Astro.props;

const bubbles = Array.from({ length: count }, (_, index) => {
	const seed = Math.sin(index * 9301 + 49297) * 233280;
	const random = seed - Math.floor(seed);
	const duration = 32 + random * 32;
	return {
		delay: ((index * 0.37) % 1) * duration,
		duration,
		left: (index * 37 + random * 23) % 100,
		size: 0.25 + random * 0.6,
		sway: (random - 0.5) * 3,
	};
});
---

<div aria-hidden="true" class:list={["bubbles", className]}>
	<div class="bubbles-layer">
		{bubbles.map(({ delay, duration, left, size, sway }) => (
			<span
				class="bubble"
				style={`--delay: -${delay}s; --duration: ${duration}s; --left: ${left}%; --size: ${size}rem; --sway: ${sway}rem`}
			/>
		))}
	</div>
</div>

<style>
	.bubbles {
		inset: 0;
		mask-composite: intersect;
		mask-image:
			linear-gradient(
				to bottom,
				transparent,
				var(--colorBlue5) var(--bubbles-fade, 10rem),
				var(--colorBlue5) calc(100% - 3rem),
				transparent
			),
			var(--bubbles-mask, linear-gradient(var(--colorBlue5), var(--colorBlue5)));
		opacity: max(
			calc(1 - var(--themeDark) * 2),
			calc(var(--themeDark) * 2 - 1)
		);
		overflow: hidden;
		pointer-events: none;
		position: absolute;
	}

	.bubbles-layer {
		container-type: size;
		inset: calc(-0.25 * (100vh + 100%)) 0;
		position: absolute;
		transform: translateY(var(--bubbles-parallax, 0));
	}

	.bubble {
		animation: bubble-rise var(--duration) ease-in infinite;
		animation-delay: var(--delay);
		background: color-mix(
			in srgb,
			rgb(from var(--colorBlue3) r g b / 12%),
			rgb(from var(--colorWhite) r g b / 18%) calc(var(--themeDarkStep) * 100%)
		);
		border: 1px solid
			color-mix(
				in srgb,
				rgb(from var(--colorBlue3) r g b / 40%),
				rgb(from var(--colorWhite) r g b / 45%)
					calc(var(--themeDarkStep) * 100%)
			);
		border-radius: var(--radiusPill);
		bottom: -1rem;
		box-shadow: inset -0.08rem -0.08rem 0.2rem
			rgb(from var(--colorWhite) r g b / 30%);
		height: var(--size);
		left: var(--left);
		opacity: 0;
		position: absolute;
		width: var(--size);
	}

	@keyframes bubble-rise {
		0% {
			opacity: 0;
			transform: translate3d(0, 0, 0) scale(0.6);
		}

		15% {
			opacity: 0.8;
		}

		50% {
			transform: translate3d(var(--sway), -50cqh, 0) scale(0.9);
		}

		90% {
			opacity: 0.6;
		}

		100% {
			opacity: 0;
			transform: translate3d(0, -110cqh, 0) scale(1.15);
		}
	}
</style>

<script>
	import { reducedMotionQuery } from "~/utils/motion";

	const fields = [...document.querySelectorAll<HTMLElement>(".bubbles")];

	if (fields.length && !reducedMotionQuery.matches) {
		let frame = 0;

		const update = () => {
			frame = 0;

			for (const field of fields) {
				const section = field.parentElement;
				if (!section) {
					continue;
				}

				const { height, top } = section.getBoundingClientRect();
				const drift = (window.innerHeight / 2 - (top + height / 2)) / 2;

				field.style.setProperty("--bubbles-parallax", `${drift}px`);
			}
		};

		const request = () => {
			frame ||= requestAnimationFrame(update);
		};

		update();
		addEventListener("scroll", request, { passive: true });
		addEventListener("resize", request, { passive: true });
	}
</script>

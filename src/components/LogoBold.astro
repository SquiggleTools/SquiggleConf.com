---
import TextSquiggly from "./TextSquiggly.astro";

interface Props {
	class?: string;
}

const { class: className, ...props } = Astro.props;
---

<div class:list={["logo-bold", className]} {...props}>
	<TextSquiggly width="medium">
		<Fragment slot="inside">Squiggle</Fragment>
		<Fragment slot="after">Conf</Fragment>
	</TextSquiggly>
</div>

<style>
	.logo-bold {
		font-family: var(--fontFamilyLogo);
		font-style: initial;
		text-shadow: 0px 1.5px 3px var(--colorTextShadow);
		white-space: nowrap;
		font-size: var(--fontSizeLogoLarger);
		font-weight: 800;
		letter-spacing: -2px;
	}

	:global(html.dark) .logo-bold {
		color: var(--colorWhiteIsh);
	}
</style>

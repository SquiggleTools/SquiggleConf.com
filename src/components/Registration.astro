---
import mantaDown from "~/assets/design/manta-down.svg";
import mantaUp from "~/assets/design/manta-up.svg";
import squiggleThickWide from "~/assets/design/squiggle-thick-wide.svg";
import { links } from "~/data/links";

import Button from "./Button.astro";
import ContentArea from "./ContentArea.astro";
import DecorativeImage from "./DecorativeImage.astro";
import Arrow from "./Arrow.astro";
---

<div class="registration">
	<DecorativeImage class="squiggle-thick-wide" src={squiggleThickWide} />
	<ContentArea
		as="section"
		class="registration-contents"
		aria-label="Registration"
	>
		<DecorativeImage class="manta manta-down" src={mantaDown} />
		<DecorativeImage class="manta manta-up" src={mantaUp} />
		<Button
			as="a"
			class="tickets-link"
			href="/#newsletter"
			target="_blank"
			size="large"
			variant="emphasized"
		>
			Subscribe for conference updates
			<Arrow />
		</Button>
	</ContentArea>
</div>

<style>
	.registration {
		background: var(--colorBlue4);
		color: var(--colorWhiteIsh);
		overflow: hidden;
		position: relative;
	}

	.squiggle-thick-wide {
		height: 100%;
		left: 0;
		top: 0%;
		width: 100%;
	}

	.manta-down {
		height: 6rem;
		right: -12rem;
		top: 0.5rem;
	}

	.manta-up {
		bottom: 2rem;
		height: 7.25rem;
		left: -7.5rem;
	}

	section.registration-contents {
		align-items: center;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 14rem;
		padding: 3.5rem;
		position: relative;
	}

	.tickets-link {
		display: flex;
		gap: 0.5rem;
	}

	@media (width >= 819px) {
		.manta-down {
			right: -7.5%;
		}

		.manta-up {
			left: -7.5%;
		}
	}
</style>

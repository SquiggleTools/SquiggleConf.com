---
import type { ImageMetadata } from "astro";

import { Image, type LocalImageProps } from "astro:assets";

type Props = LocalImageProps;

const imageOnlyProps = new Set([
	"alt",
	"densities",
	"fit",
	"format",
	"layout",
	"position",
	"quality",
	"sizes",
	"src",
	"widths",
]);

const { alt, height, width } = Astro.props;
const src = Astro.props.src as ImageMetadata;
const svgWidth =
	width ??
	(height === undefined
		? undefined
		: Math.round((Number(height) * src.width) / src.height));
const svgProps = {
	decoding: "async" as const,
	loading: "lazy" as const,
	...Object.fromEntries(
		Object.entries(Astro.props).filter(
			([key, value]) => !imageOnlyProps.has(key) && value !== undefined,
		),
	),
};
---

{src.format === "svg" ? (
	<img {...svgProps} alt={alt} src={src.src} width={svgWidth} />
) : (
	<Image {...(Astro.props as LocalImageProps)} />
)}

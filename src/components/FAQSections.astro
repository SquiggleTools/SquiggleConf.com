---
import FAQSection, { type Props as FAQSectionProps } from "./FAQSection.astro";

interface Props {
	level?: FAQSectionProps["level"];
	sections: Omit<FAQSectionProps, "level">[];
}

const { level, sections } = Astro.props;
---

<div class="faq-sections">
	{sections.map(({ pairs, title }) => (
		<FAQSection level={level} pairs={pairs} title={title} />
	))}
</div>

<style>
	.faq-sections {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: 5rem;
		padding-bottom: 3.5rem;
		width: 100%;
	}
</style>

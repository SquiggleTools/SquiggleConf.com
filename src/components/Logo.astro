---
import TextSquiggly from "./TextSquiggly.astro";

interface Props {
	bold?: boolean;
	class?: string;
}

const { bold, class: className, ...props } = Astro.props;
---

<div class:list={["logo", bold && "logo-bold", className]} {...props}>
	<TextSquiggly width="medium">
		<Fragment slot="inside">Squiggle</Fragment>
		<Fragment slot="after">Conf</Fragment>
	</TextSquiggly>
</div>

<style>
	.logo {
		display: flex;
		font-family: var(--fontFamilyLogo);
		font-size: var(--fontSizeLogo);
		font-style: initial;
		font-weight: var(--fontWeightExtraBold);
		user-select: none;
	}

	.logo-bold {
		font-size: var(--fontSizeLogoLarger);
		letter-spacing: -2px;
		text-shadow: 0px 1.5px 3px var(--colorTextShadow);
		white-space: nowrap;
	}
</style>

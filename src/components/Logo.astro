---
import TextSquiggly from "./TextSquiggly.astro";

interface Props {
	class?: string;
	invert?: boolean;
}

const { class: className, invert, ...props } = Astro.props;
---

<div class:list={["logo", invert ? "invert" : "regular", className]} {...props}>
	<TextSquiggly width="medium">
		<Fragment slot="inside">Squiggle</Fragment>
		<Fragment slot="after">Conf</Fragment>
	</TextSquiggly>
</div>

<style>
	.logo {
		color: var(--colorLogoText);
		display: flex;
		font-family: var(--fontFamilyLogo);
		font-size: var(--fontSizeLogo);
		font-style: initial;
		font-weight: 800;
		user-select: none;
	}

	.logo.invert {
		--colorLogoText: var(--accentDark);
	}

	.logo.regular {
		--colorLogoText: var(--colorWhiteIsh);
		text-shadow: 0px 1.5px 1.5px rgba(0, 0, 0, 0.25);
	}
</style>

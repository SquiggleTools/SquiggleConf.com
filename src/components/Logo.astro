---
import TextSquiggly from "./TextSquiggly.astro";

interface Props {
	as?: "div" | "h1";
	bold?: boolean;
	class?: string;
}

const { as: As = "div", bold, class: className, ...props } = Astro.props;
---

<As class:list={["logo", bold && "logo-bold", className]} {...props}>
	<TextSquiggly width="medium">
		<Fragment slot="inside">Squiggle</Fragment>
		<Fragment slot="after">Conf</Fragment>
	</TextSquiggly>
</As>

<style>
	.logo {
		display: flex;
		font-family: var(--fontFamilyLogo);
		font-size: var(--fontSizeDisplay);
		font-style: initial;
		font-weight: var(--fontWeightBold);
		user-select: none;
	}

	.logo-bold {
		font-size: clamp(2.8rem, 7vw, 4.9rem);
		letter-spacing: -2px;
		text-shadow: 0 1.5px 3px var(--colorTextShadow);
		white-space: nowrap;
	}
</style>

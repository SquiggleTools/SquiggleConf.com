---
import Heading from "~/components/Heading.astro";
import TextSquiggly from "~/components/TextSquiggly.astro";

export interface Props {
	heading: string;
	squiggly: "medium" | "none" | "wide";
}

const { heading, squiggly } = Astro.props;
---

<div
	class:list={["hero-contents-standard", `hero-contents-standard-${squiggly}`]}
>
	<Heading level="h1">
		{squiggly === "none" ? (
			heading
		) : (
			<TextSquiggly width={squiggly}>
				<Fragment slot="inside">{heading}</Fragment>
			</TextSquiggly>
		)}
	</Heading>

	<p class="hero-contents-standard-body">
		<slot />
	</p>
</div>

<style>
	.hero-contents-standard {
		align-items: safe center;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: center;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 2.6rem);
		font-weight: var(--fontWeightLight);
		max-width: 100%;
	}

	.hero-contents-standard-medium h1 :global(.text-squiggly .squiggly) {
		bottom: -0.1rem;
	}

	.hero-contents-standard-wide :global(.text-squiggly) {
		padding-bottom: 0.25rem;
	}

	.hero-contents-standard-wide h1 :global(.text-squiggly .squiggly) {
		bottom: -0.2rem;
	}

	.hero-contents-standard-body {
		font-size: var(--fontSizeSmall);
		font-weight: var(--fontWeightExtraLight);
		max-width: 52rem;
		text-wrap: balance;
	}
</style>

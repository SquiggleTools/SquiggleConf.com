---
import Heading from "~/components/Heading.astro";
import TextSquiggly from "~/components/TextSquiggly.astro";

export interface Props {
	eyebrow?: string;
	eyebrowHref?: string;
	heading: string;
	squiggly: "medium" | "none" | "wide";
}

const { eyebrow, eyebrowHref, heading, squiggly } = Astro.props;
---

<div
	class:list={["hero-contents-standard", `hero-contents-standard-${squiggly}`]}
>
	{eyebrow && (
		<p class="hero-contents-standard-eyebrow">
			{eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
		</p>
	)}

	<Heading level="h1">
		{squiggly === "none" ? (
			heading
		) : (
			<TextSquiggly color="blue" width={squiggly}>
				<Fragment slot="inside">{heading}</Fragment>
			</TextSquiggly>
		)}
	</Heading>

	<p class="hero-contents-standard-body">
		<slot />
	</p>
</div>

<style>
	.hero-contents-standard {
		display: flex;
		flex-direction: column;
		padding-top: 1.5rem;
		text-align: start;
	}

	.hero-contents-standard-eyebrow {
		color: color-mix(
			in srgb,
			var(--colorBlue3),
			var(--colorBlue2) var(--themeDarknessText)
		);
		font-family: var(--fontFamilyHeading);
		font-size: var(--fontSizeSmaller);
		font-weight: var(--fontWeightSemibold);
		letter-spacing: 0.12em;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
	}

	.hero-contents-standard-eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.hero-contents-standard-eyebrow a::before {
		content: "← ";
	}

	.hero-contents-standard-eyebrow a:is(:hover, :focus-visible) {
		text-decoration: underline;
	}

	h1 {
		font-family: var(--fontFamilyHeading);
		font-size: clamp(2.5rem, 6.5vw, 4.5rem);
		font-style: italic;
		font-weight: var(--fontWeightBold);
		letter-spacing: -0.02em;
		line-height: 1;
		max-width: 100%;
		text-wrap: balance;
	}

	.hero-contents-standard-medium h1 :global(.text-squiggly .squiggly) {
		bottom: -0.1rem;
	}

	.hero-contents-standard-wide :global(.text-squiggly) {
		padding-bottom: 0.25rem;
	}

	.hero-contents-standard-wide h1 :global(.text-squiggly .squiggly) {
		bottom: -0.45rem;
	}

	.hero-contents-standard-body {
		color: var(--colorForegroundEmphasized);
		font-size: var(--fontSizeMedium);
		font-weight: var(--fontWeightLight);
		line-height: 1.4;
		margin-top: 1.25rem;
		max-width: 38rem;
		text-wrap: balance;
	}
</style>

---
import ContentArea from "~/components/ContentArea.astro";
import HeroCityscape from "./HeroCityscape.astro";

interface Props {
	class?: string;
	tall?: boolean;
	scrollNotice?: boolean;
}

const { class: className, scrollNotice, tall, ...props } = Astro.props;
---

<section class:list={["hero", className, tall ? "tall" : "common"]} {...props}>
	<div class="hero-decorations">
		<div class="hero-decorations-inner">
			<HeroCityscape />
		</div>
	</div>

	<ContentArea class="hero-contents">
		<slot />
	</ContentArea>

	{
		Astro.props.scrollNotice && (
			<div class="hero-scroll-notice">
				Scroll to explore the depths of SquiggleConf
			</div>
		)
	}
</section>

<style>
	.hero {
		background: linear-gradient(180deg, #e9f9ff 0%, #f3fcff 50%, #fffdde 100%);
		z-index: 1;
		color: var(--colorBackground);
		padding-bottom: var(--cityscapeHeightArea);
		position: relative;
	}

	:global(html.dark) .hero {
		background: #04142d;
	}

	.hero.common {
		--cityscapeHeightArea: 10rem;
	}

	.hero.tall {
		--cityscapeHeightArea: 8rem;
	}

	.hero-decorations {
		bottom: -1.5rem;
		pointer-events: none;
		position: absolute;
		height: 100%;
		overflow: hidden;
		width: 100%;
	}

	.hero-decorations-inner {
		bottom: 0;
		left: 50%;
		position: absolute;
		text-align: center;
		width: 0;
	}

	.hero-contents {
		z-index: 1;
		position: relative;
	}

	.hero-scroll-notice {
		color: var(--colorBlue1);
		font-family: var(--fontFamilyHeading);
		font-weight: var(--fontWeightSemibold);
		font-style: italic;
		bottom: 2rem;
		position: absolute;
		text-align: center;
		width: 100%;
	}
</style>

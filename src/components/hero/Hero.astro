---
import ContentArea from "~/components/ContentArea.astro";
import HeroCityscape from "./HeroCityscape.astro";

interface Props {
	class?: string;
	tall?: boolean;
}

const { class: className, tall, ...props } = Astro.props;
---

<section class:list={["hero", className, tall ? "tall" : "common"]} {...props}>
	<div class="hero-decorations">
		<div class="hero-decorations-inner">
			<HeroCityscape />
		</div>
	</div>

	<ContentArea class="hero-contents">
		<slot />
	</ContentArea>
</section>

<style>
	.hero {
		background: linear-gradient(
			180deg,
			var(--colorBlueBright2) 0%,
			light-dark(var(--colorWhite), var(--colorBlue5)) 50%,
			light-dark(var(--colorCream), var(--colorBlue5)) 100%
		);
		z-index: 1;
		color: var(--colorHeading);
		padding-bottom: var(--cityscapeHeightArea);
		position: relative;
	}

	.hero.common {
		--cityscapeHeightArea: 10rem;
	}

	.hero.tall {
		--cityscapeHeightArea: 8rem;
	}

	.hero-decorations {
		bottom: -1.5rem;
		pointer-events: none;
		position: absolute;
		height: 100%;
		overflow: hidden;
		width: 100%;
	}

	.hero-decorations-inner {
		bottom: 0;
		left: 50%;
		position: absolute;
		text-align: center;
		width: 0;
	}

	.hero-contents {
		z-index: 1;
		position: relative;
	}
</style>

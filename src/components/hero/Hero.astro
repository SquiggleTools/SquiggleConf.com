---
import ContentArea from "~/components/ContentArea.astro";

import HeroHarbor from "./HeroHarbor.astro";
import HeroSky from "./HeroSky.astro";

interface Props {
	class?: string;
	tall?: boolean;
	width?: "normal" | "wide";
}

const { class: className, tall, width, ...props } = Astro.props;
---

<section
	class:list={["hero", className, tall ? "hero-tall" : "hero-compact"]}
	{...props}
>
	<HeroSky compact={!tall} />
	<div class="hero-decorations">
		<HeroHarbor compact={!tall} />
	</div>

	<ContentArea class="hero-contents" width={width}>
		<slot />
	</ContentArea>
</section>

<style>
	.hero {
		--hero-orb-display: none;

		background: linear-gradient(
			180deg,
			var(--colorBlueBright2) 0%,
			color-mix(
					in srgb,
					var(--colorWhite),
					var(--colorBlue5) var(--themeDarkness)
				)
				50%,
			color-mix(
					in srgb,
					var(--colorCream),
					var(--colorBlue5) var(--themeDarkness)
				)
				100%
		);
		z-index: 1;
		color: var(--colorHeading);
		overflow-x: clip;
		position: relative;
	}

	.hero-tall {
		--hero-orb-top: 6.5rem;
		--hero-scale: 1;

		padding-bottom: 12rem;
	}

	.hero-compact {
		--hero-orb-top: 6.25rem;
		--hero-scale: 0.7;

		padding: 5rem 0 7.75rem;
	}

	@media (--widthSmall) {
		.hero-tall {
			--hero-orb-display: block;
		}
	}

	@media (--widthLarge) {
		.hero-tall {
			--hero-orb-display: none;
		}

		.hero-compact {
			--hero-orb-display: block;
		}

		.hero-compact .hero-contents {
			max-width: calc(100vw - 13rem);
		}
	}

	@media (--widthXLarge) {
		.hero-tall {
			--hero-orb-display: block;
		}
	}

	.hero-decorations {
		bottom: -1.5rem;
		pointer-events: none;
		position: absolute;
		height: 100%;
		overflow: hidden;
		width: 100%;
	}

	.hero-contents {
		z-index: 1;
		position: relative;
	}
</style>

---
import cityscape from "~/assets/design/cityscape.svg";
---

<link
	as="image"
	fetchpriority="high"
	href={cityscape.src}
	media="(width >= 819px)"
	rel="preload"
/>
<div
	class="hero-cityscape"
	style={{ backgroundImage: `url(${cityscape.src})` }}
></div>

<style>
	.hero-cityscape {
		background-position: center bottom;
		background-repeat: repeat-x;
		background-size: auto 100%;
		height: 10rem;
		pointer-events: none;
		position: relative;
		transform: translateX(-48.5%);
		user-select: none;
		min-width: 100vw;
		width: 150rem;
	}

	@media (--widthMedium) {
		.hero-cityscape {
			transform: translateX(-50%);
		}
	}
</style>

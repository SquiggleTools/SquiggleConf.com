---
import { cfpOpenDate, eventDate, eventDateEve } from "~/data/event";
import { currentYear } from "~/data/years";

import type { DesignMountPoint } from "../types";

interface Props {
	at: DesignMountPoint;
}

const { at } = Astro.props;

const index = [
	{
		href: "#launch-party",
		text: "Launch party at Ned Devine's",
		time: "Thu 6pm",
	},
	{ href: "#fun-run", text: "The fun run", time: "7am" },
	{ href: "#check-in", text: "Check in, grab a coffee", time: "8am" },
	{ href: "#talks-morning", text: "Talks in an IMAX theater", time: "9am" },
	{ href: "#cookies-break", text: "Milk & cookies", time: "10:30am" },
	{ href: "#lunch", text: "Lunch at Quincy Market", time: "12pm" },
	{ href: "#explore-boston", text: "Explore Boston", time: "3:30pm" },
	{
		href: "#live-podcast-recording",
		text: "Syntax + ThePrimeagen, live",
		time: "6pm",
	},
	{ href: "#big-rav", text: "Big Rav takes the stage", time: "9pm" },
];
---

{at === "hero-start" && (
	<div aria-hidden="true" class="d08-masthead">
		<span>Vol. {currentYear}</span>
		<span class="d08-masthead-center">
			All the devtools news that's fit to print
		</span>
		<span>Est. 2024</span>
	</div>
)}

{at === "hero-after-lockup" && (
	<ul aria-label="Key dates" class="d08-dateline">
		<li>
			<span class="d08-dateline-label">Thu, {eventDateEve}</span>
			Launch party
		</li>
		<li>
			<span class="d08-dateline-label">Fri, {eventDate}</span>
			Talks at the Aquarium
		</li>
		<li>
			<a class="d08-dateline-cfp" href="#cfp-opens-heading">
				<span class="d08-dateline-label">Nov 14th 2026</span>
				CFP opens <span aria-hidden="true">→</span>
			</a>
		</li>
	</ul>
)}

{at === "hero-end" && (
	<nav aria-label="In this edition" class="d08-index">
		<p class="d08-index-heading">In this edition</p>
		<ol class="d08-index-list">
			{index.map(({ href, text, time }) => (
				<li>
					<a href={href}>
						<span class="d08-index-text">{text}</span>
						<span aria-hidden="true" class="d08-index-leader" />
						<span class="d08-index-time">{time}</span>
					</a>
				</li>
			))}
		</ol>
		<p class="d08-index-footnote">
			Call for proposals opens {cfpOpenDate} 2026
		</p>
	</nav>
)}

<style>
	.d08-masthead {
		align-items: center;
		border-bottom: 1px solid var(--d08-rule);
		border-top: 3px double var(--d08-rule);
		color: var(--colorMuted);
		display: grid;
		font-family: var(--fontFamilyMonospace);
		font-size: 0.72rem;
		grid-area: mast;
		grid-template-columns: 1fr auto 1fr;
		letter-spacing: 0.12em;
		padding: 0.45rem 0;
		text-transform: uppercase;
	}

	.d08-masthead span:last-child {
		text-align: right;
	}

	.d08-masthead-center {
		font-family: var(--fontFamilyHeading);
		font-size: 0.85rem;
		font-style: italic;
		letter-spacing: 0.04em;
		text-transform: none;
	}

	.d08-dateline {
		border-bottom: 1px solid var(--d08-rule);
		border-top: 3px solid var(--d08-rule-strong);
		display: grid;
		grid-area: date;
		grid-template-columns: repeat(3, 1fr);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.d08-dateline li {
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: 1rem;
		font-weight: var(--fontWeightMedium);
		padding: 0.55rem 1rem;
		text-align: center;
	}

	.d08-dateline li + li {
		border-left: 1px solid var(--d08-rule);
	}

	.d08-dateline-label {
		color: var(--colorAccentMedium);
		font-family: var(--fontFamilyMonospace);
		font-size: 0.75rem;
		font-weight: var(--fontWeightMedium);
		letter-spacing: 0.08em;
		margin-right: 0.5rem;
		text-transform: uppercase;
	}

	.d08-dateline-cfp {
		color: inherit;
		text-decoration: none;
	}

	.d08-dateline-cfp .d08-dateline-label {
		color: var(--colorTerminalOrange);
	}

	.d08-dateline-cfp:hover,
	.d08-dateline-cfp:focus-visible {
		text-decoration: underline wavy var(--colorTerminalOrange) 1.5px;
		text-underline-offset: 0.3em;
	}

	.d08-index {
		align-self: stretch;
		border-left: 1px solid var(--d08-rule);
		display: flex;
		flex-direction: column;
		grid-area: index;
		padding: 1.5rem 0 0 1.75rem;
		text-align: left;
	}

	.d08-index-heading {
		border-bottom: 2px solid var(--d08-rule-strong);
		color: var(--colorHeading);
		font-family: var(--fontFamilyHeading);
		font-size: 0.8rem;
		font-weight: var(--fontWeightBold);
		letter-spacing: 0.14em;
		margin: 0 0 0.35rem;
		padding-bottom: 0.35rem;
		text-transform: uppercase;
	}

	.d08-index-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.d08-index-list a {
		align-items: baseline;
		color: var(--colorCopy);
		display: flex;
		font-size: 0.9rem;
		gap: 0.4rem;
		padding: 0.28rem 0;
		text-decoration: none;
	}

	.d08-index-list a:hover .d08-index-text,
	.d08-index-list a:focus-visible .d08-index-text {
		color: var(--colorHeading);
		text-decoration: underline;
	}

	.d08-index-leader {
		border-bottom: 1px dotted var(--d08-rule-strong);
		flex: 1;
		min-width: 1rem;
		opacity: 0.6;
	}

	.d08-index-time {
		color: var(--colorAccentMedium);
		font-family: var(--fontFamilyMonospace);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	.d08-index-footnote {
		border-top: 1px solid var(--d08-rule);
		color: var(--colorMuted);
		font-family: var(--fontFamilyHeading);
		font-size: 0.85rem;
		font-style: italic;
		margin: auto 0 0;
		padding-top: 0.5rem;
	}

	@media not (--widthLarge) {
		.d08-masthead {
			grid-template-columns: 1fr 1fr;
		}

		.d08-masthead-center {
			display: none;
		}

		.d08-dateline {
			grid-template-columns: 1fr;
		}

		.d08-dateline li {
			align-items: baseline;
			display: flex;
			justify-content: space-between;
			padding: 0.45rem 0.25rem;
			text-align: left;
		}

		.d08-dateline li + li {
			border-left: none;
			border-top: 1px solid var(--d08-rule);
		}

		.d08-dateline-cfp {
			display: contents;
		}

		.d08-dateline-label {
			order: 1;
			white-space: nowrap;
		}

		.d08-dateline [aria-hidden="true"] {
			display: none;
		}

		.d08-index {
			border-left: none;
			border-top: 1px solid var(--d08-rule);
			padding: 1rem 0 0;
		}

		.d08-index-footnote {
			display: none;
		}
	}
</style>

<style is:global>
	html[data-design="8"] {
		--d08-rule: light-dark(
			rgb(from var(--colorBlue5) r g b / 22%),
			rgb(from var(--colorBlue1) r g b / 22%)
		);
		--d08-rule-strong: light-dark(
			rgb(from var(--colorBlue5) r g b / 85%),
			rgb(from var(--colorBlue1) r g b / 70%)
		);
	}

	html[data-design="8"] header {
		padding: 1rem 0 0.75rem;
	}

	html:not(.dark)[data-design="8"] header {
		background: var(--colorCream);
	}

	html[data-design="8"] .hero {
		background:
			repeating-linear-gradient(
				0deg,
				light-dark(
						rgb(from var(--colorBlue5) r g b / 2.5%),
						rgb(from var(--colorWhite) r g b / 1.5%)
					)
					0 1px,
				transparent 1px 4px
			),
			linear-gradient(
				180deg,
				light-dark(var(--colorCream), var(--colorBlue5)) 0%,
				light-dark(var(--colorCream), var(--colorBlue5)) 60%,
				light-dark(var(--colorBlueBright2), var(--colorBlue5)) 100%
			);
	}

	html[data-design="8"] .hero.tall {
		--cityscapeHeightArea: 6.5rem;
	}

	html[data-design="8"] .hero-cityscape {
		height: 8rem;
	}

	html[data-design="8"] .hero-contents {
		display: grid;
		grid-template:
			"mast mast mast" auto
			"logo logo logo" auto
			"date date date" auto
			"lead card index" auto / minmax(0, 1fr) minmax(0, 1.05fr) minmax(
				0,
				0.95fr
			);
	}

	html[data-design="8"] .hero-intro {
		grid-area: logo;
		padding: 0.6rem 0 0.5rem;
	}

	html[data-design="8"] .hero-intro .logo-bold {
		font-size: clamp(3rem, 8.5vw, 6.25rem);
		letter-spacing: -3px;
	}

	html[data-design="8"] .hero-subtitle {
		display: none;
	}

	html[data-design="8"] .top-side-by-side {
		display: contents;
	}

	html[data-design="8"] .top-side-left {
		align-items: flex-start;
		align-self: start;
		grid-area: lead;
		margin: 0;
		padding: 1.5rem 1.75rem 0 0;
		text-align: left;
	}

	html[data-design="8"] .top-heading {
		font-size: clamp(1.9rem, 3vw, 2.6rem);
		line-height: 0.95;
		padding-top: 0;
	}

	html[data-design="8"] .top-heading::before {
		color: var(--colorAccentMedium);
		content: "Cover story";
		display: block;
		font-family: var(--fontFamilyMonospace);
		font-size: 0.72rem;
		font-style: normal;
		font-weight: var(--fontWeightMedium);
		letter-spacing: 0.14em;
		margin-bottom: 0.6rem;
		text-transform: uppercase;
	}

	html[data-design="8"] .top-intro {
		font-size: 0.95rem;
		line-height: 1.55;
		margin: 0.85rem 0 0;
		padding: 0;
		text-align: left;
	}

	html[data-design="8"] .top-intro::first-letter {
		color: var(--colorHeading);
		float: left;
		font-family: var(--fontFamilyHeading);
		font-size: 3.4rem;
		font-style: italic;
		font-weight: var(--fontWeightBold);
		line-height: 0.8;
		margin: 0.3rem 0.45rem 0 0;
	}

	html[data-design="8"] .top-side-by-side .postcard-gallery {
		align-self: start;
		border-left: 1px solid var(--d08-rule);
		grid-area: card;
		height: 100%;
		margin: 0;
		padding: 1.5rem 1.75rem 0;
		zoom: 1;
	}

	html[data-design="8"] .postcard-flip {
		margin: 0.5rem 0 0;
		padding-bottom: 1.5rem;
		width: 100%;
	}

	html[data-design="8"] .timeline-section {
		padding-top: 0.5rem;
	}

	html[data-design="8"] .cfp-opens {
		padding-top: clamp(2.25rem, 4vw, 3rem);
	}

	@media not (--widthLarge) {
		html[data-design="8"] .hero-contents {
			grid-template:
				"mast" auto
				"logo" auto
				"date" auto
				"lead" auto
				"index" auto / minmax(0, 1fr);
		}

		html[data-design="8"] .hero-intro {
			padding: 0.75rem 0 0.5rem;
		}

		html[data-design="8"] .hero-intro .logo-bold {
			font-size: clamp(2.8rem, 13vw, 4.5rem);
			letter-spacing: -2px;
		}

		html[data-design="8"] .top-side-left {
			padding: 1.25rem 0 1rem;
		}

		html[data-design="8"] .top-side-by-side .postcard-gallery {
			display: none;
		}
	}
</style>

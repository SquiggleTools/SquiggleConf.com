---
import { designs } from "./designs";

const activation = designs
	.map(
		({ id }) =>
			`html[data-design="${id}"] .design-mount[data-for="${id}"]{display:contents}`,
	)
	.join("");

const options = [
	{
		description: "The site as it is on main.",
		id: 0,
		intensity: "",
		name: "Current",
	},
	...designs.map(({ id, meta }) => ({
		description: meta?.description ?? "",
		id,
		intensity: meta?.intensity ?? "",
		name: meta?.name ?? `Design ${id}`,
	})),
];
---

<style is:inline set:html={activation} />

<aside aria-label="Design switcher" class="design-switcher">
	<div class="design-switcher-row">
		<button
			aria-label="Previous design"
			class="design-switcher-step"
			data-step="-1"
			type="button"
		>
			‹
		</button>
		<select aria-label="Design" class="design-switcher-select">
			{options.map(({ id, intensity, name }) => (
				<option value={id}>
					{id}. {name}
					{intensity && ` (${intensity})`}
				</option>
			))}
		</select>
		<button
			aria-label="Next design"
			class="design-switcher-step"
			data-step="1"
			type="button"
		>
			›
		</button>
		<button
			aria-label="Toggle light and dark mode"
			class="design-switcher-step design-switcher-theme"
			type="button"
		>
			◐
		</button>
	</div>
	<p class="design-switcher-description"></p>
	<script
		is:inline
		set:html={JSON.stringify(
			options.map(({ description, id }) => ({ description, id })),
		)}
		type="application/json"
	/>
</aside>

<style>
	.design-switcher {
		backdrop-filter: blur(12px);
		background: rgb(4 25 48 / 82%);
		border: 1px solid rgb(56 206 214 / 45%);
		border-radius: 0.75rem;
		bottom: 1rem;
		box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 35%);
		color: #eaeaf7;
		display: grid;
		font-family: var(--fontFamilyBody);
		font-size: 0.8rem;
		gap: 0.35rem;
		max-width: min(22rem, calc(100vw - 2rem));
		padding: 0.5rem;
		position: fixed;
		right: 1rem;
		z-index: 1000;
	}

	.design-switcher-row {
		display: flex;
		gap: 0.35rem;
	}

	.design-switcher-select {
		background: rgb(255 255 255 / 8%);
		border: 1px solid rgb(255 255 255 / 20%);
		border-radius: 0.4rem;
		color: inherit;
		flex: 1;
		font: inherit;
		min-width: 0;
		padding: 0.3rem 0.4rem;
	}

	.design-switcher-select option {
		background: #041930;
	}

	.design-switcher-step {
		background: rgb(255 255 255 / 8%);
		border: 1px solid rgb(255 255 255 / 20%);
		border-radius: 0.4rem;
		color: inherit;
		cursor: pointer;
		font: inherit;
		font-size: 1rem;
		line-height: 1;
		padding: 0.3rem 0.55rem;
	}

	.design-switcher-step:hover {
		background: rgb(56 206 214 / 35%);
	}

	.design-switcher-description {
		color: rgb(234 234 247 / 75%);
		line-height: 1.35;
		margin: 0;
		padding: 0 0.15rem;
	}

	.design-switcher-description:empty,
	.design-switcher:not(:hover, :focus-within) .design-switcher-description {
		display: none;
	}
</style>

<script>
	const switcher = document.querySelector<HTMLElement>(".design-switcher");
	const select = switcher?.querySelector("select");
	const description = switcher?.querySelector(".design-switcher-description");
	const options = JSON.parse(
		switcher?.querySelector("script")?.textContent ?? "[]",
	) as { description: string; id: number }[];
	const ids = options.map(({ id }) => id);

	const current = () =>
		Number(document.documentElement.dataset.design ?? "0") || 0;

	const render = () => {
		if (select) {
			select.value = String(current());
		}

		if (description) {
			description.textContent =
				options.find(({ id }) => id === current())?.description ?? "";
		}
	};

	const apply = (id: number) => {
		const url = new URL(location.href);

		if (id) {
			document.documentElement.dataset.design = String(id);
			url.searchParams.set("design", String(id));
		} else {
			delete document.documentElement.dataset.design;
			url.searchParams.delete("design");
		}

		history.replaceState(null, "", url);
		window.dispatchEvent(new CustomEvent("design-change"));
		render();
	};

	const step = (delta: number) => {
		const index = ids.indexOf(current());
		apply(ids[(index + delta + ids.length) % ids.length] ?? 0);
	};

	select?.addEventListener("change", () => {
		apply(Number(select.value));
	});

	for (const button of switcher?.querySelectorAll<HTMLButtonElement>(
		"[data-step]",
	) ?? []) {
		button.addEventListener("click", () => {
			step(Number(button.dataset.step));
		});
	}

	switcher
		?.querySelector(".design-switcher-theme")
		?.addEventListener("click", () => {
			const dark = document.documentElement.classList.toggle("dark");
			localStorage.setItem("theme", dark ? "dark" : "light");
		});

	document.addEventListener("keydown", (event) => {
		if (
			event.target instanceof HTMLElement &&
			event.target.closest("input, select, textarea")
		) {
			return;
		}

		if (event.key === "[") {
			step(-1);
		} else if (event.key === "]") {
			step(1);
		}
	});

	render();
</script>

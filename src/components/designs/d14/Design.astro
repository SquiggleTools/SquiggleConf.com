---
import cityscape from "~/assets/design/cityscape.svg";

import type { DesignMountPoint } from "../types";

interface Props {
	at: DesignMountPoint;
}

const { at } = Astro.props;

const pathCount = 26;

const glints = Array.from({ length: 44 }, (_, index) => {
	const seed = Math.sin(index * 7919 + 104729) * 43758.5453;
	const random = seed - Math.floor(seed);
	const onPath = index < pathCount;
	const depth = index / pathCount;
	const spread = onPath ? 5 + depth * 9 : 100;
	const left = onPath
		? `calc(var(--d14-path-x) + ${(random - 0.5) * spread}%)`
		: `${(index * 29) % 100}%`;
	return {
		delay: random * 5,
		duration: 2.5 + random * 3.5,
		left,
		top: onPath ? 3 + depth * 88 : 10 + ((index * 17) % 80),
		width: onPath ? 1.5 + random * (2 + depth * 3) : 0.6 + random * 1.2,
	};
});

const cityscapeStyle = `background-image: url(${cityscape.src})`;
---

{at === "hero-after-lockup" && (
	<div aria-hidden="true" class="d14-horizon">
		<div class="d14-sky">
			<span class="d14-stars" />
			<span class="d14-celestial" />
			<svg class="d14-gulls" viewBox="0 0 120 40">
				<path class="d14-gull d14-gull-1" d="M4 20 Q12 10 20 20 Q28 10 36 20" />
				<path class="d14-gull d14-gull-2" d="M50 8 Q56 0 62 8 Q68 0 74 8" />
				<path
					class="d14-gull d14-gull-3"
					d="M86 28 Q92 21 98 28 Q104 21 110 28"
				/>
			</svg>
		</div>
		<div class="d14-skyline" style={cityscapeStyle} />
		<div class="d14-water">
			<div class="d14-reflection" style={cityscapeStyle} />
			<span class="d14-path" />
			{glints.map(({ delay, duration, left, top, width }) => (
				<span
					class="d14-glint"
					style={`--delay: -${delay}s; --duration: ${duration}s; --left: ${left}; --top: ${top}%; --width: ${width}rem`}
				/>
			))}
			<svg class="d14-boat" viewBox="0 0 60 50">
				<path class="d14-boat-flag" d="M30 3 L38 6 L30 9 Z" />
				<path class="d14-boat-sail" d="M30 6 L30 38 L10 38 Z" />
				<path class="d14-boat-sail-alt" d="M32 10 L32 38 L50 38 Z" />
				<path class="d14-boat-hull" d="M4 40 L56 40 L48 48 L12 48 Z" />
			</svg>
		</div>
	</div>
)}

<style>
	.d14-horizon {
		margin: 1rem 0 0 calc(50% - 50vw);
		position: relative;
		width: 100vw;
	}

	.d14-sky {
		background: linear-gradient(
			to top,
			light-dark(
					color-mix(in srgb, var(--colorCream) 70%, var(--colorTerminalOrange)),
					color-mix(in srgb, var(--colorSea) 60%, var(--colorBlue3))
				)
				0,
			light-dark(var(--colorCream), var(--colorBlue4)) 8rem,
			light-dark(var(--colorBlueBright1), var(--colorBlue5)) 17rem,
			light-dark(var(--colorBlueBright2), var(--colorBlue5)) 100%
		);
		bottom: calc(100% - 7.9rem);
		height: 60rem;
		left: 0;
		pointer-events: none;
		position: absolute;
		right: 0;
		transform: translateY(calc(var(--d14-scroll, 0) * 0.15px));
		z-index: -1;
	}

	.d14-stars {
		animation: d14-twinkle 7s ease-in-out infinite alternate;
		background-image:
			radial-gradient(1.5px 1.5px at 6% 22%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 19% 64%, var(--colorBlue1), transparent),
			radial-gradient(
				1.5px 1.5px at 36% 38%,
				var(--colorWhiteIsh),
				transparent
			),
			radial-gradient(1px 1px at 48% 81%, var(--colorBlue1), transparent),
			radial-gradient(2px 2px at 63% 12%, var(--colorWhiteIsh), transparent),
			radial-gradient(1px 1px at 77% 52%, var(--colorBlue2), transparent),
			radial-gradient(1.5px 1.5px at 91% 30%, var(--colorWhiteIsh), transparent);
		background-size: 420px 280px;
		display: none;
		inset: 0 0 25%;
		mask-image: linear-gradient(to bottom, var(--colorBlue5) 50%, transparent);
		position: absolute;
		transform: translateY(calc(var(--d14-scroll, 0) * 0.25px));
	}

	:global(html.dark) .d14-stars {
		display: block;
	}

	@keyframes d14-twinkle {
		0% {
			opacity: 0.45;
		}

		100% {
			opacity: 1;
		}
	}

	.d14-celestial {
		aspect-ratio: 1;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--colorCream) 55%, var(--colorTerminalOrange)) 0
				28%,
			rgb(from var(--colorTerminalOrange) r g b / 30%) 30%,
			transparent 68%
		);
		border-radius: 50%;
		bottom: -3.5rem;
		left: 88%;
		position: absolute;
		translate: -50% 0;
		width: 14rem;
	}

	:global(html.dark) .d14-celestial {
		background: radial-gradient(
			circle,
			var(--colorCream) 0 18%,
			color-mix(in srgb, var(--colorCream) 70%, var(--colorBlue1)) 22%,
			rgb(from var(--colorBlue1) r g b / 22%) 24%,
			rgb(from var(--colorBlue1) r g b / 6%) 45%,
			transparent 68%
		);
		bottom: 6rem;
	}

	.d14-gulls {
		bottom: 12rem;
		fill: none;
		left: 12%;
		position: absolute;
		stroke: light-dark(var(--colorBlue4), var(--colorBlue1));
		stroke-linecap: round;
		stroke-width: 1.6;
		width: 7rem;
	}

	.d14-gull {
		animation: d14-flap 1.4s ease-in-out infinite alternate;
		transform-box: fill-box;
		transform-origin: center;
	}

	.d14-gull-2 {
		animation-delay: -0.5s;
		animation-duration: 1.1s;
	}

	.d14-gull-3 {
		animation-delay: -0.9s;
		animation-duration: 1.6s;
	}

	@keyframes d14-flap {
		0% {
			transform: scaleY(1);
		}

		100% {
			transform: scaleY(0.35) translateY(2px);
		}
	}

	.d14-skyline {
		background-position: center top;
		background-repeat: repeat-x;
		background-size: auto 10rem;
		height: 7.9rem;
		position: relative;
	}

	.d14-water {
		--d14-path-x: 88%;

		background: linear-gradient(
			to bottom,
			light-dark(
				rgb(from var(--colorBlue3) r g b / 35%),
				color-mix(in srgb, var(--colorSea) 75%, var(--colorBlue3))
			),
			transparent
		);
		height: 6rem;
		overflow: hidden;
		position: relative;
	}

	.d14-reflection {
		animation: d14-ripple 6s ease-in-out infinite alternate;
		background-position: center -3.4rem;
		background-repeat: repeat-x;
		background-size: auto 10rem;
		filter: blur(0.6px);
		height: 4.5rem;
		mask-composite: intersect;
		mask-image:
			repeating-linear-gradient(
				to bottom,
				var(--colorBlue5) 0 2px,
				rgb(from var(--colorBlue5) r g b / 35%) 2px 4px
			),
			linear-gradient(to top, var(--colorBlue5), transparent);
		opacity: 0.32;
		transform: scaleY(-1);
		transform-origin: center;
	}

	:global(html.dark) .d14-reflection {
		opacity: 0.38;
	}

	@keyframes d14-ripple {
		0% {
			transform: scaleY(-1) skewX(-1.5deg);
		}

		100% {
			transform: scaleY(-0.94) skewX(1.5deg);
		}
	}

	.d14-path {
		background: radial-gradient(
			ellipse 50% 100% at 50% 0%,
			light-dark(
				rgb(from var(--colorTerminalOrange) r g b / 35%),
				rgb(from var(--colorCream) r g b / 22%)
			),
			transparent 80%
		);
		height: 100%;
		left: var(--d14-path-x);
		position: absolute;
		top: 0;
		translate: -50% 0;
		width: 16rem;
	}

	.d14-glint {
		animation: d14-glint var(--duration) ease-in-out infinite;
		animation-delay: var(--delay);
		background: light-dark(
			var(--colorWhite),
			rgb(from var(--colorCream) r g b / 90%)
		);
		border-radius: var(--radiusPill);
		box-shadow: 0 0 0.4rem
			light-dark(
				rgb(from var(--colorTerminalOrange) r g b / 40%),
				rgb(from var(--colorCream) r g b / 50%)
			);
		height: 3px;
		left: var(--left);
		opacity: 0;
		position: absolute;
		top: var(--top);
		width: var(--width);
	}

	@keyframes d14-glint {
		0%,
		100% {
			opacity: 0;
			transform: translateX(-0.4rem) scaleX(0.5);
		}

		50% {
			opacity: 1;
			transform: translateX(0.4rem) scaleX(1);
		}
	}

	.d14-boat {
		animation: d14-sail 80s linear infinite;
		animation-delay: -28s;
		left: 0;
		position: absolute;
		top: 0.2rem;
		width: 2.6rem;
	}

	.d14-boat-hull {
		fill: light-dark(var(--colorBlue4), var(--colorBlue1));
	}

	.d14-boat-sail {
		fill: var(--colorCream);
	}

	.d14-boat-sail-alt {
		fill: color-mix(in srgb, var(--colorCream) 80%, var(--colorBlue1));
	}

	.d14-boat-flag {
		fill: var(--colorTerminalOrange);
	}

	@keyframes d14-sail {
		0% {
			transform: translateX(-5vw) translateY(0);
		}

		25% {
			transform: translateX(22.5vw) translateY(0.15rem);
		}

		50% {
			transform: translateX(50vw) translateY(0);
		}

		75% {
			transform: translateX(77.5vw) translateY(0.15rem);
		}

		100% {
			transform: translateX(105vw) translateY(0);
		}
	}

	@media not (--widthLarge) {
		.d14-skyline,
		.d14-reflection {
			background-size: auto 8rem;
		}

		.d14-skyline {
			height: 6.35rem;
		}

		.d14-sky {
			bottom: calc(100% - 6.35rem);
		}

		.d14-reflection {
			background-position: center -2.6rem;
			height: 3.75rem;
		}

		.d14-water {
			--d14-path-x: 90%;

			height: 4.5rem;
		}

		.d14-celestial {
			left: 90%;
			width: 6rem;
		}

		:global(html.dark) .d14-celestial {
			bottom: 6.4rem;
		}

		.d14-path {
			width: 8rem;
		}

		.d14-gulls {
			display: none;
		}
	}
</style>

<style is:global>
	html[data-design="14"] header {
		background: transparent;
		position: relative;
		z-index: 2;
	}

	html[data-design="14"] .body-area {
		margin-top: -5.75rem;
	}

	html[data-design="14"] .hero {
		background: linear-gradient(
			to bottom,
			light-dark(var(--colorBlue1), var(--colorBlue4)) 0%,
			light-dark(
					color-mix(in srgb, var(--colorBlue1) 60%, var(--colorWhite)),
					color-mix(in srgb, var(--colorBlue4) 40%, var(--colorSea))
				)
				70%,
			light-dark(var(--colorWhite), var(--colorSea)) 100%
		);
		overflow: clip;
		padding-top: 5.75rem;
	}

	html[data-design="14"] .hero.tall {
		--cityscapeHeightArea: 1.5rem;
	}

	html[data-design="14"] .hero-decorations {
		display: none;
	}

	html[data-design="14"] .hero-intro {
		gap: 0.5rem;
		padding: 0;
	}

	html[data-design="14"] .hero-subtitle {
		margin: 0;
	}

	html[data-design="14"] .top-side-by-side {
		gap: 3rem;
		margin-top: -4.5rem;
		position: relative;
	}

	html[data-design="14"] .top-side-left {
		margin-bottom: 0;
	}

	html[data-design="14"] .top-heading {
		text-shadow: 0 0.15rem 1rem
			light-dark(
				rgb(from var(--colorWhite) r g b / 70%),
				rgb(from var(--colorBlue5) r g b / 60%)
			);
	}

	html[data-design="14"] .top-intro {
		color: var(--colorHeading);
		text-shadow: 0 0.1rem 0.75rem
			light-dark(
				rgb(from var(--colorWhite) r g b / 70%),
				rgb(from var(--colorBlue5) r g b / 70%)
			);
	}

	html[data-design="14"] .top-side-by-side .postcard-gallery {
		animation: d14-float 6s ease-in-out infinite alternate;
		margin-bottom: 0;
		zoom: 0.62;
	}

	html[data-design="14"] .postcard-flip {
		margin: 0;
	}

	@keyframes d14-float {
		0% {
			transform: translateY(0) rotate(0deg);
		}

		100% {
			transform: translateY(-0.6rem) rotate(1deg);
		}
	}

	html[data-design="14"] .deep-sea-surface {
		background: linear-gradient(
				to bottom,
				light-dark(var(--colorWhite), var(--colorSea)),
				light-dark(
					var(--colorBlueBright2),
					color-mix(in srgb, var(--colorSea), var(--colorBlue4))
				),
				light-dark(
					var(--colorBlueBright1),
					color-mix(in srgb, var(--colorBlue4), var(--colorBlue5))
				),
				light-dark(
					color-mix(in srgb, var(--colorBlueBright1), var(--colorBlue2) 20%),
					var(--colorBlue5)
				)
			)
			var(--colorBlueBright2);
	}

	html[data-design="14"] .deep-sea-surface::after {
		mask-image: linear-gradient(
			to bottom,
			transparent,
			var(--colorBlue5) 12rem
		);
	}

	html[data-design="14"] .cfp-opens {
		border-top-color: transparent;
		padding-top: 2.5rem;
	}

	@media not (--widthLarge) {
		html[data-design="14"] .top-side-by-side {
			margin-top: -2.5rem;
		}

		html[data-design="14"] .top-intro {
			font-size: 0.95rem;
			line-height: 1.5;
			padding: 0;
		}

		html[data-design="14"] .top-side-by-side .postcard-gallery {
			zoom: 0.56;
		}

		html[data-design="14"] .postcard-flip {
			margin-top: 0.5rem;
		}
	}
</style>

<script>
	import { onDesign } from "../onDesign";

	onDesign(14, () => {
		const horizon = document.querySelector<HTMLElement>(".d14-horizon");
		if (!horizon) {
			return;
		}

		let frame = 0;
		const update = () => {
			frame = 0;
			horizon.style.setProperty(
				"--d14-scroll",
				String(Math.min(scrollY, innerHeight)),
			);
		};
		const onScroll = () => {
			frame ||= requestAnimationFrame(update);
		};

		update();
		addEventListener("scroll", onScroll, { passive: true });

		return () => {
			removeEventListener("scroll", onScroll);
			cancelAnimationFrame(frame);
			horizon.style.removeProperty("--d14-scroll");
		};
	});
</script>

---
import { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	alt: string;
	class?: string;
	href: string;
	src: ImageMetadata;
}

const { alt, class: className, href, src } = Astro.props;
---

<a class:list={["social-link", className]} href={href} target="_blank">
	<Image alt={alt} class="social-image" fit="contain" src={src} />
</a>

<style>
	.social-link {
		align-items: center;
		display: flex;
		gap: 0.5rem;
		flex-direction: row;
		text-decoration: none;
	}

	.social-image {
		height: 2rem;
		user-select: none;
		width: 2rem;
	}

	html:not(.dark) .social-link {
		filter: hue-rotate(180deg) invert();
		opacity: 0.9;
	}
</style>

---
import { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface IconLink {
	alt: string;
	href: string;
	src: ImageMetadata;
}

interface Props {
	class?: string;
	historical?: boolean;
	links: IconLink[];
}

const { class: className, historical, links, ...rest } = Astro.props;
---

<div
	class:list={["icon-links", historical && "icon-links-historical", className]}
	{...rest}
>
	{
		links.map(({ alt, href, src }) => (
			<a class="icon-link" href={href} rel="noreferrer" target="_blank">
				<Image alt={alt} class="icon-link-image" fit="contain" src={src} />
			</a>
		))
	}
</div>

<style>
	.icon-links {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: var(--iconLinksGap, 0 var(--iconLinkPadding, 0.25rem));
		margin-left: calc(-1 * var(--iconLinkPadding, 0.25rem));
	}

	.icon-link {
		display: flex;
		padding: var(--iconLinkPadding, 0.25rem);
		text-decoration: none;
	}

	.icon-link-image {
		height: var(--iconLinkSize, 1.2rem);
		user-select: none;
		width: var(--iconLinkSize, 1.2rem);
	}

	html:not(.dark) .icon-link-image {
		filter: hue-rotate(180deg) invert();
	}

	.icon-links-historical .icon-link-image {
		filter: brightness(1.5);
		object-fit: cover;
	}

	html:not(.dark) .icon-links-historical .icon-link-image {
		filter: hue-rotate(180deg) invert(0.7);
	}
</style>

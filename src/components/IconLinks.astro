---
import type { SvgComponent } from "astro/types";

interface IconLink {
	alt: string;
	href: string;
	/** Drawn in currentColor, so it follows the surrounding text color. */
	src: SvgComponent;
}

interface Props {
	class?: string;
	links: IconLink[];
}

const { class: className, links, ...rest } = Astro.props;
---

<div class:list={["icon-links", className]} {...rest}>
	{
		links.map(({ alt, href, src: Icon }) => (
			<a
				aria-label={alt}
				class="icon-link"
				href={href}
				rel="noreferrer"
				target="_blank"
			>
				<Icon aria-hidden="true" class="icon-link-image" />
			</a>
		))
	}
</div>

<style>
	.icon-links {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: var(--iconLinksGap, 0 var(--iconLinkPadding, 0.25rem));
		margin-left: calc(-1 * var(--iconLinkPadding, 0.25rem));
	}

	.icon-link {
		display: flex;
		padding: var(--iconLinkPadding, 0.25rem);
		text-decoration: none;
	}

	.icon-link-image {
		height: var(--iconLinkSize, 1.2rem);
		user-select: none;
		width: var(--iconLinkSize, 1.2rem);
	}
</style>

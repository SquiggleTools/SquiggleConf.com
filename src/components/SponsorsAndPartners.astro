---
import { historicalDataByYear } from "~/data/historical/data";
import { links } from "~/data/links";

import BodyText from "./BodyText.astro";
import Button from "./Button.astro";
import Newsletter from "./Newsletter.astro";
import SponsorLogo from "./SponsorLogo.astro";

const pastSponsors = Object.values(historicalDataByYear).flatMap(
	({ sponsors }) => sponsors,
);

const tiers = [
	[
		{ size: "14rem", titles: ["Bloomberg"] },
		{ size: "10rem", titles: ["Mintlify"] },
	],
	[
		{
			size: "8rem",
			titles: [
				"Igalia",
				"Datastax",
				"Inngest",
				"OpenJS Foundation",
				"Prisma",
				"Elastic",
			],
		},
	],
	[{ size: "6rem", titles: ["VoidZero", "Rush Stack", "Nx", "Progress"] }],
].map((groups) =>
	groups.flatMap(({ size, titles }) =>
		titles.map((title) => {
			const sponsor = pastSponsors.find((sponsor) => sponsor.title === title);
			if (!sponsor) {
				throw new Error(`Unknown past sponsor: ${title}`);
			}

			return { ...sponsor, size };
		}),
	),
);
---

<section class="past-sponsors" aria-labelledby="past-sponsors-heading">
	<div class="past-sponsors-shell">
		<div class="past-sponsors-intro">
			<p class="past-sponsors-kicker">Leaders in developer tooling</p>
			<h2 id="past-sponsors-heading">Past Sponsors</h2>
			<BodyText class="past-sponsors-copy">
				These teams are some of the sharpest leaders in developer tools, and
				they helped make SquiggleConf possible.
			</BodyText>
		</div>

		<div class="past-sponsors-panel">
			{
				tiers.map((tier) => (
					<div class="past-sponsors-tier">
						{tier.map((sponsor) => (
							<SponsorLogo
								class="sponsor-logo"
								sponsor={sponsor}
								style={{ "--logo-size": sponsor.size }}
							/>
						))}
					</div>
				))
			}
		</div>

		<div class="past-sponsors-cta">
			<Button
				as="a"
				size="large"
				variant="emphasized"
				href={links.sponsor}
				target="_blank"
			>
				Sponsorship Prospectus
			</Button>
		</div>
	</div>

	<Newsletter />
</section>

<style>
	.past-sponsors {
		--panel-shadow: 0 1.1rem 2.4rem rgb(from var(--colorBlue3) r g b / 14%);
		background:
			radial-gradient(
				circle at 18% 16%,
				rgb(from var(--colorBlue3) r g b / 18%),
				transparent 24%
			),
			radial-gradient(
				circle at 84% 14%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 18%
			),
			radial-gradient(
				circle at 52% 100%,
				rgb(
					from color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 25%) r g
						b / 66%
				),
				transparent 42%
			),
			linear-gradient(
				180deg,
				var(--colorBlueBright2) 0%,
				var(--colorBlueBright1) 28%,
				var(--colorBlue1) 64%,
				color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 10%) 100%
			);
		overflow: clip;
		position: relative;
		width: 100%;
	}

	html.dark .past-sponsors {
		--panel-shadow: 0 1.5rem 3rem rgb(from var(--colorBlue6) r g b / 34%);
		background:
			radial-gradient(
				circle at 20% 18%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 24%
			),
			radial-gradient(
				circle at 82% 12%,
				rgb(from var(--colorBlue2) r g b / 12%),
				transparent 18%
			),
			radial-gradient(
				circle at 50% 100%,
				rgb(from var(--colorBlue3) r g b / 54%),
				transparent 44%
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--colorBlue4), var(--colorBlue5)) 0%,
				var(--colorBlue4) 30%,
				color-mix(in srgb, var(--colorBlue4), var(--colorBlue5)) 62%,
				var(--colorBlue5) 100%
			);
	}

	.past-sponsors::before,
	.past-sponsors::after,
	.past-sponsors-panel::before {
		content: "";
		inset: 0;
		pointer-events: none;
		position: absolute;
	}

	.past-sponsors::before {
		background:
			repeating-linear-gradient(
				114deg,
				light-dark(
						rgb(from var(--colorBlue3) r g b / 6%),
						rgb(from var(--colorBlue1) r g b / 4%)
					)
					0 2px,
				transparent 2px 28px
			),
			radial-gradient(
				circle at 12% 20%,
				light-dark(rgb(from white r g b / 36%), rgb(from white r g b / 13%)) 0
					1px,
				transparent 1px
			),
			radial-gradient(
				circle at 74% 36%,
				light-dark(rgb(from white r g b / 26%), rgb(from white r g b / 10%)) 0
					1.5px,
				transparent 1.5px
			),
			radial-gradient(
				circle at 48% 72%,
				light-dark(rgb(from white r g b / 24%), rgb(from white r g b / 8%)) 0
					1px,
				transparent 1px
			);
		opacity: 0.9;
	}

	.past-sponsors::after {
		background:
			linear-gradient(
				180deg,
				light-dark(
					rgb(from white r g b / 42%),
					rgb(from var(--colorBlue1) r g b / 14%)
				),
				transparent 18%
			),
			linear-gradient(
				0deg,
				light-dark(
					rgb(from var(--colorBlue4) r g b / 14%),
					rgb(from var(--colorBlue6) r g b / 48%)
				),
				transparent 24%
			);
	}

	.past-sponsors-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 0 auto;
		max-width: var(--sizeContentAreaWide);
		padding: clamp(4rem, 8vw, 6rem) clamp(1.25rem, 3vw, 2.5rem)
			clamp(4.5rem, 8vw, 6.5rem);
		position: relative;
		z-index: 1;
	}

	.past-sponsors-intro {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		max-width: 46rem;
	}

	.past-sponsors-kicker {
		background: light-dark(
			rgb(from white r g b / 60%),
			rgb(from var(--colorWhiteIsh) r g b / 9%)
		);
		border: 1px solid
			light-dark(
				rgb(from var(--colorBlue3) r g b / 18%),
				rgb(from var(--colorBlue1) r g b / 20%)
			);
		border-radius: var(--radiusPill);
		box-shadow: inset 0 1px 0
			light-dark(rgb(from white r g b / 70%), rgb(from white r g b / 12%));
		color: light-dark(var(--colorBlue3), var(--colorWhiteIsh));
		font-family: var(--fontFamilyMonospace);
		font-size: 0.78rem;
		font-weight: var(--fontWeightSemibold);
		letter-spacing: 0.16em;
		line-height: 1;
		padding: 0.7rem 1rem;
		text-transform: uppercase;
	}

	.past-sponsors h2 {
		color: light-dark(var(--colorBlue4), white);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(2.4rem, 5.4vw, 4.7rem);
		font-weight: var(--fontWeightBold);
		letter-spacing: -0.03em;
		line-height: 0.92;
		text-wrap: balance;
	}

	.past-sponsors-copy {
		color: light-dark(
			rgb(from var(--colorBlue4) r g b / 78%),
			rgb(from var(--colorWhiteIsh) r g b / 84%)
		);
		max-width: 42rem;
	}

	.past-sponsors-panel {
		backdrop-filter: var(--backdropFrosted);
		background:
			linear-gradient(
				180deg,
				light-dark(
					rgb(from white r g b / 72%),
					rgb(from var(--colorBlue1) r g b / 12%)
				),
				light-dark(
					rgb(from var(--colorBlueBright1) r g b / 58%),
					rgb(from var(--colorBlue1) r g b / 3%)
				)
			),
			light-dark(
				rgb(from var(--colorBlue1) r g b / 52%),
				rgb(from var(--colorBlue6) r g b / 42%)
			);
		border-radius: var(--radiusXLarge);
		box-shadow:
			inset 0 1px 0
				light-dark(rgb(from white r g b / 70%), rgb(from white r g b / 10%)),
			var(--panel-shadow);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		padding: clamp(1.4rem, 3vw, 2rem);
		position: relative;
	}

	.past-sponsors-panel::before {
		background: radial-gradient(
			circle at top left,
			rgb(from var(--colorBlue1) r g b / 18%),
			transparent 28%
		);
	}

	.past-sponsors-tier {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.sponsor-logo {
		align-items: center;
		border-radius: var(--radiusLarge);
		display: flex;
		justify-content: center;
		min-height: 5rem;
		padding: 0.7rem 1rem;
		transition:
			background var(--transitionNormal),
			transform var(--transitionNormal),
			box-shadow var(--transitionNormal);
		user-select: none;
	}

	.sponsor-logo:hover,
	.sponsor-logo:focus-visible {
		background: light-dark(
			rgb(from var(--colorBlue3) r g b / 6%),
			rgb(from var(--colorWhiteIsh) r g b / 8%)
		);
		box-shadow: inset 0 0 0 1px
			light-dark(
				rgb(from var(--colorBlue3) r g b / 14%),
				rgb(from var(--colorBlue1) r g b / 16%)
			);
		transform: translateY(-1px);
	}

	.sponsor-logo :global(img) {
		max-height: var(--logo-size);
		max-width: var(--logo-size);
	}

	.past-sponsors-cta {
		align-items: center;
		display: flex;
		justify-content: center;
	}

	@media (width >= 900px) {
		.past-sponsors-cta {
			justify-content: flex-start;
		}
	}

	@media (width < 700px) {
		.past-sponsors-shell {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.past-sponsors-kicker {
			font-size: 0.7rem;
			padding: 0.62rem 0.9rem;
		}

		.past-sponsors-panel {
			border-radius: var(--radiusLarge);
			padding: 1.1rem 0.9rem;
		}
	}
</style>

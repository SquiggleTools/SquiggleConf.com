---
import { Image } from "astro:assets";

import { historicalDataByYear } from "~/data/historical/data";
import { links } from "~/data/links";

import BodyText from "./BodyText.astro";
import Button from "./Button.astro";
import Newsletter from "./Newsletter.astro";

const pastSponsors = Object.values(historicalDataByYear).flatMap(
	({ sponsors }) => sponsors,
);

const tiers = [
	[
		{ size: "14rem", titles: ["Bloomberg"] },
		{ size: "10rem", titles: ["Mintlify"] },
	],
	[
		{
			size: "8rem",
			titles: [
				"Igalia",
				"Datastax",
				"Inngest",
				"OpenJS Foundation",
				"Prisma",
				"Elastic",
			],
		},
	],
	[{ size: "6rem", titles: ["VoidZero", "Rush Stack", "Nx", "Progress"] }],
].map((groups) =>
	groups.flatMap(({ size, titles }) =>
		titles.map((title) => {
			const sponsor = pastSponsors.find((sponsor) => sponsor.title === title);
			if (!sponsor) {
				throw new Error(`Unknown past sponsor: ${title}`);
			}

			return { ...sponsor, size };
		}),
	),
);
---

<section class="past-sponsors" aria-labelledby="past-sponsors-heading">
	<div class="past-sponsors-shell">
		<div class="past-sponsors-intro">
			<p class="past-sponsors-kicker">Leaders in developer tooling</p>
			<h2 id="past-sponsors-heading">Past Sponsors</h2>
			<BodyText class="past-sponsors-copy">
				These teams are some of the sharpest leaders in developer tools, and
				they helped make SquiggleConf possible.
			</BodyText>
		</div>

		<div class="past-sponsors-panel">
			{
				tiers.map((tier) => (
					<div class="past-sponsors-tier">
						{tier.map((sponsor) => (
							<a
								class="sponsor-logo"
								href={sponsor.href}
								rel="noreferrer"
								style={{ "--logo-size": sponsor.size }}
								target="_blank"
								title={sponsor.title}
							>
								{(["dark", "light"] as const).map((theme) => (
									<Image
										alt=""
										class={`logo-${theme}`}
										src={sponsor.logos[theme]}
										height={128}
									/>
								))}
							</a>
						))}
					</div>
				))
			}
		</div>

		<div class="past-sponsors-cta">
			<Button
				as="a"
				size="large"
				variant="emphasized"
				href={links.sponsor}
				target="_blank"
			>
				Sponsorship Prospectus
			</Button>
		</div>
	</div>

	<Newsletter />
</section>

<style>
	.past-sponsors {
		--texture-stripe: rgb(from var(--colorBlue3) r g b / 6%);
		--texture-dot-1: rgba(255, 255, 255, 0.36);
		--texture-dot-2: rgba(255, 255, 255, 0.26);
		--texture-dot-3: rgba(255, 255, 255, 0.24);
		--overlay-top: rgba(255, 255, 255, 0.42);
		--overlay-bottom: rgba(12, 71, 103, 0.14);
		--highlight: rgba(255, 255, 255, 0.7);
		--kicker-background: rgba(255, 255, 255, 0.6);
		--kicker-border: rgb(from var(--colorBlue3) r g b / 18%);
		--kicker-color: #0a577d;
		--heading-color: var(--colorBlue4);
		--copy-color: rgb(from var(--colorBlue4) r g b / 78%);
		--panel-top: rgba(255, 255, 255, 0.72);
		--panel-bottom: rgba(223, 242, 250, 0.58);
		--panel-base: rgba(184, 224, 240, 0.52);
		--panel-shadow: 0 1.1rem 2.4rem rgba(47, 109, 143, 0.14);
		--logo-hover-background: rgb(from var(--colorBlue3) r g b / 6%);
		--logo-hover-ring: rgb(from var(--colorBlue3) r g b / 14%);
		background:
			radial-gradient(
				circle at 18% 16%,
				rgba(17, 127, 171, 0.18),
				transparent 24%
			),
			radial-gradient(
				circle at 84% 14%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 18%
			),
			radial-gradient(
				circle at 52% 100%,
				rgba(144, 198, 222, 0.66),
				transparent 42%
			),
			linear-gradient(
				180deg,
				var(--colorBlueBright2) 0%,
				#d8eff8 28%,
				#c3e2ef 64%,
				#add4e6 100%
			);
		overflow: clip;
		position: relative;
		width: 100%;
	}

	:global(html.dark) .past-sponsors {
		--texture-stripe: rgba(188, 227, 255, 0.04);
		--texture-dot-1: rgba(255, 255, 255, 0.13);
		--texture-dot-2: rgba(255, 255, 255, 0.1);
		--texture-dot-3: rgba(255, 255, 255, 0.08);
		--overlay-top: rgba(196, 237, 255, 0.14);
		--overlay-bottom: rgba(2, 14, 31, 0.48);
		--highlight: rgba(255, 255, 255, 0.12);
		--kicker-background: rgba(231, 246, 255, 0.09);
		--kicker-border: rgba(188, 227, 255, 0.2);
		--kicker-color: #d8f4ff;
		--heading-color: #f2fbff;
		--copy-color: rgba(221, 240, 255, 0.84);
		--panel-top: rgba(194, 235, 255, 0.12);
		--panel-bottom: rgba(194, 235, 255, 0.03);
		--panel-base: rgb(from var(--colorBlue6) r g b / 42%);
		--panel-highlight: rgba(255, 255, 255, 0.1);
		--panel-shadow: 0 1.5rem 3rem rgba(3, 12, 28, 0.34);
		--logo-hover-background: rgba(218, 242, 255, 0.08);
		--logo-hover-ring: rgba(195, 236, 255, 0.16);
		background:
			radial-gradient(
				circle at 20% 18%,
				rgba(79, 200, 255, 0.16),
				transparent 24%
			),
			radial-gradient(
				circle at 82% 12%,
				rgba(113, 255, 227, 0.12),
				transparent 18%
			),
			radial-gradient(
				circle at 50% 100%,
				rgba(10, 77, 145, 0.54),
				transparent 44%
			),
			linear-gradient(
				180deg,
				#082647 0%,
				#07315b 30%,
				#062448 62%,
				var(--colorBlue5) 100%
			);
	}

	.past-sponsors::before,
	.past-sponsors::after,
	.past-sponsors-panel::before {
		content: "";
		inset: 0;
		pointer-events: none;
		position: absolute;
	}

	.past-sponsors::before {
		background:
			repeating-linear-gradient(
				114deg,
				var(--texture-stripe) 0 2px,
				transparent 2px 28px
			),
			radial-gradient(
				circle at 12% 20%,
				var(--texture-dot-1) 0 1px,
				transparent 1px
			),
			radial-gradient(
				circle at 74% 36%,
				var(--texture-dot-2) 0 1.5px,
				transparent 1.5px
			),
			radial-gradient(
				circle at 48% 72%,
				var(--texture-dot-3) 0 1px,
				transparent 1px
			);
		opacity: 0.9;
	}

	.past-sponsors::after {
		background:
			linear-gradient(180deg, var(--overlay-top), transparent 18%),
			linear-gradient(0deg, var(--overlay-bottom), transparent 24%);
	}

	.past-sponsors-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 0 auto;
		max-width: var(--sizeContentAreaWide);
		padding: clamp(4rem, 8vw, 6rem) clamp(1.25rem, 3vw, 2.5rem)
			clamp(4.5rem, 8vw, 6.5rem);
		position: relative;
		z-index: 1;
	}

	.past-sponsors-intro {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		max-width: 46rem;
	}

	.past-sponsors-kicker {
		background: var(--kicker-background);
		border: 1px solid var(--kicker-border);
		border-radius: var(--radiusPill);
		box-shadow: inset 0 1px 0 var(--highlight);
		color: var(--kicker-color);
		font-family: var(--fontFamilyMonospace);
		font-size: 0.78rem;
		font-weight: var(--fontWeightBolder);
		letter-spacing: 0.16em;
		line-height: 1;
		padding: 0.7rem 1rem;
		text-transform: uppercase;
	}

	.past-sponsors h2 {
		color: var(--heading-color);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(2.4rem, 5.4vw, 4.7rem);
		font-weight: var(--fontWeightHeavy);
		letter-spacing: -0.03em;
		line-height: 0.92;
		text-wrap: balance;
	}

	.past-sponsors-copy {
		color: var(--copy-color);
		max-width: 42rem;
	}

	.past-sponsors-panel {
		backdrop-filter: blur(18px) saturate(135%);
		background:
			linear-gradient(180deg, var(--panel-top), var(--panel-bottom)),
			var(--panel-base);
		border-radius: var(--radiusXLarge);
		box-shadow:
			inset 0 1px 0 var(--panel-highlight, var(--highlight)),
			var(--panel-shadow);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		padding: clamp(1.4rem, 3vw, 2rem);
		position: relative;
	}

	.past-sponsors-panel::before {
		background: radial-gradient(
			circle at top left,
			rgba(133, 220, 255, 0.18),
			transparent 28%
		);
	}

	.past-sponsors-tier {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.sponsor-logo {
		align-items: center;
		border-radius: var(--radiusLarge);
		display: flex;
		justify-content: center;
		min-height: 5rem;
		padding: 0.7rem 1rem;
		transition:
			background var(--transitionNormal) ease,
			transform var(--transitionNormal) ease,
			box-shadow var(--transitionNormal) ease;
		user-select: none;
	}

	.sponsor-logo:hover,
	.sponsor-logo:focus-visible {
		background: var(--logo-hover-background);
		box-shadow: inset 0 0 0 1px var(--logo-hover-ring);
		transform: translateY(-1px);
	}

	.sponsor-logo img {
		max-height: var(--logo-size);
		max-width: var(--logo-size);
	}

	:global(html.dark) .logo-light,
	:global(html:not(.dark)) .logo-dark {
		display: none;
	}

	.past-sponsors-cta {
		align-items: center;
		display: flex;
		justify-content: center;
	}

	@media (width >= 900px) {
		.past-sponsors-cta {
			justify-content: flex-start;
		}
	}

	@media (width < 700px) {
		.past-sponsors-shell {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.past-sponsors-kicker {
			font-size: 0.7rem;
			padding: 0.62rem 0.9rem;
		}

		.past-sponsors-panel {
			border-radius: var(--radiusLarge);
			padding: 1.1rem 0.9rem;
		}
	}
</style>

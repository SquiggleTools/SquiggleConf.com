---
import { historicalDataByYear } from "~/data/historical/data";
import { links } from "~/data/links";

import BodyText from "./BodyText.astro";
import Button from "./Button.astro";
import Newsletter from "./Newsletter.astro";
import SponsorLogo from "./SponsorLogo.astro";

const pastSponsors = Object.values(historicalDataByYear).flatMap(
	({ sponsors }) => sponsors,
);

const tiers = [
	[
		{ size: "3rem", titles: ["Bloomberg"] },
		{ size: "2.5rem", titles: ["Mintlify"] },
	],
	[
		{ size: "2.25rem", titles: ["Igalia"] },
		{ size: "1.125rem", titles: ["Datastax"] },
		{
			size: "2.25rem",
			titles: ["Inngest", "OpenJS Foundation", "Prisma", "Elastic"],
		},
	],
	[
		{ size: "2rem", titles: ["VoidZero", "Rush Stack"] },
		{ size: "5.25rem", titles: ["Nx"] },
		{ size: "2rem", titles: ["Progress"] },
	],
].map((groups) =>
	groups.flatMap(({ size, titles }) =>
		titles.map((title) => {
			const sponsor = pastSponsors.find((sponsor) => sponsor.title === title);
			if (!sponsor) {
				throw new Error(`Unknown past sponsor: ${title}`);
			}

			return { ...sponsor, size };
		}),
	),
);
---

<div class="past-sponsors">
	<span aria-hidden="true" class="past-sponsors-seam"></span>
	<section aria-labelledby="past-sponsors-heading" class="past-sponsors-shell">
		<div class="past-sponsors-intro">
			<h2 id="past-sponsors-heading">Past Sponsors</h2>
			<BodyText class="past-sponsors-copy">
				These teams are some of the sharpest leaders in developer tools, and
				they helped make SquiggleConf possible.
			</BodyText>
		</div>

		<div class="past-sponsors-panel">
			{tiers.map((tier) => (
				<div class="past-sponsors-tier">
					{tier.map((sponsor) => (
						<SponsorLogo
							class="sponsor-logo"
							sponsor={sponsor}
							style={{ "--logo-size": sponsor.size }}
						/>
					))}
				</div>
			))}
		</div>

		<div class="past-sponsors-cta">
			<Button
				as="a"
				href={links.sponsor}
				size="large"
				target="_blank"
				variant="emphasized"
			>
				Sponsorship Prospectus
			</Button>
		</div>
	</section>

	<Newsletter />
</div>

<style>
	.past-sponsors {
		--panel-shadow:
			0 1.1rem 2.4rem
				color-mix(
					in srgb,
					rgb(from var(--colorBlue3) r g b / 14%),
					transparent var(--themeDarkness)
				),
			0 1.5rem 3rem
				color-mix(
					in srgb,
					transparent,
					rgb(from var(--colorBlue5) r g b / 34%) var(--themeDarkness)
				);

		background:
			linear-gradient(
				to top,
				color-mix(
					in srgb,
					var(--colorLagoon),
					transparent var(--themeDarkness)
				),
				transparent 24rem
			),
			radial-gradient(
				circle at calc(18% + var(--themeDarkness) * 0.02)
					calc(16% + var(--themeDarkness) * 0.02),
				color-mix(
					in srgb,
					rgb(from var(--colorBlue3) r g b / 18%),
					rgb(from var(--colorBlue2) r g b / 16%) var(--themeDarkness)
				),
				transparent 24%
			),
			radial-gradient(
				circle at calc(84% - var(--themeDarkness) * 0.02)
					calc(14% - var(--themeDarkness) * 0.02),
				color-mix(
					in srgb,
					rgb(from var(--colorBlue2) r g b / 16%),
					rgb(from var(--colorBlue2) r g b / 12%) var(--themeDarkness)
				),
				transparent 18%
			),
			radial-gradient(
				circle at calc(52% - var(--themeDarkness) * 0.02) 100%,
				color-mix(
					in srgb,
					rgb(
						from color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 25%) r
							g b / 66%
					),
					rgb(from var(--colorBlue3) r g b / 54%) var(--themeDarkness)
				),
				transparent calc(42% + var(--themeDarkness) * 0.02)
			),
			linear-gradient(
				180deg,
				color-mix(
						in srgb,
						var(--colorFrost2),
						color-mix(in srgb, var(--colorBlue4), var(--colorBlue5))
							var(--themeDarkness)
					)
					0%,
				color-mix(
						in srgb,
						var(--colorFrost1),
						var(--colorBlue4) var(--themeDarkness)
					)
					calc(28% + var(--themeDarkness) * 0.02),
				color-mix(
						in srgb,
						var(--colorBlue1),
						color-mix(in srgb, var(--colorBlue4), var(--colorBlue5))
							var(--themeDarkness)
					)
					calc(64% - var(--themeDarkness) * 0.02),
				color-mix(
						in srgb,
						color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 10%),
						var(--colorBlue5) var(--themeDarkness)
					)
					100%
			);
		margin-top: calc(-1 * var(--sizeSeamHeight));
		mask:
			url("../assets/design/seam-wave-below.svg") 0 0 / var(--sizeSeamWidth)
				var(--sizeSeamHeight) repeat-x,
			linear-gradient(var(--colorBlue5), var(--colorBlue5)) 0
				calc(var(--sizeSeamHeight) - 1px) / 100%
				calc(100% - var(--sizeSeamHeight) + 1px) no-repeat;
		overflow: clip;
		position: relative;
		width: 100%;
	}

	.past-sponsors-seam {
		background:
			url("../assets/design/seam-wave-above.svg") 0 calc(1rem - 2px) /
				var(--sizeSeamWidth) var(--sizeSeamHeight) repeat-x,
			linear-gradient(var(--colorBlue5), var(--colorBlue5)) 0 0 / 100%
				calc(1rem - 1px) no-repeat;
		filter: drop-shadow(
			0 calc(0.15rem + 2px) 0.2rem
				color-mix(
					in srgb,
					rgb(from var(--colorBlue3) r g b / 20%),
					rgb(from var(--colorBlue5) r g b / 65%) var(--themeDarkness)
				)
		);
		height: calc(var(--sizeSeamHeight) + 2rem);
		left: 0;
		mask-image: linear-gradient(
			to bottom,
			rgb(from var(--colorBlue5) r g b / 67%)
				calc(1rem + var(--sizeSeamHeight) * 0.125),
			rgb(from var(--colorBlue5) r g b / 33%)
				calc(1rem + var(--sizeSeamHeight) * 0.875)
		);
		pointer-events: none;
		position: absolute;
		right: 0;
		top: -1rem;
	}

	.past-sponsors::before,
	.past-sponsors::after,
	.past-sponsors-panel::before {
		content: "";
		inset: 0;
		pointer-events: none;
		position: absolute;
	}

	.past-sponsors::before {
		background:
			repeating-linear-gradient(
				114deg,
				color-mix(
						in srgb,
						rgb(from var(--colorBlue3) r g b / 6%),
						rgb(from var(--colorBlue1) r g b / 4%) var(--themeDarkness)
					)
					0 2px,
				transparent 2px 28px
			),
			radial-gradient(
				circle at 12% 20%,
				color-mix(
						in srgb,
						rgb(from var(--colorWhite) r g b / 36%),
						rgb(from var(--colorWhite) r g b / 13%) var(--themeDarkness)
					)
					0 1px,
				transparent 1px
			),
			radial-gradient(
				circle at 74% 36%,
				color-mix(
						in srgb,
						rgb(from var(--colorWhite) r g b / 26%),
						rgb(from var(--colorWhite) r g b / 10%) var(--themeDarkness)
					)
					0 1.5px,
				transparent 1.5px
			),
			radial-gradient(
				circle at 48% 72%,
				color-mix(
						in srgb,
						rgb(from var(--colorWhite) r g b / 24%),
						rgb(from var(--colorWhite) r g b / 8%) var(--themeDarkness)
					)
					0 1px,
				transparent 1px
			);
		opacity: 0.9;
	}

	.past-sponsors::after {
		background:
			linear-gradient(
				180deg,
				color-mix(
					in srgb,
					rgb(from var(--colorWhite) r g b / 42%),
					rgb(from var(--colorBlue1) r g b / 14%) var(--themeDarkness)
				),
				transparent 18%
			),
			linear-gradient(
				0deg,
				color-mix(
					in srgb,
					rgb(from var(--colorBlue4) r g b / 14%),
					rgb(from var(--colorBlue5) r g b / 48%) var(--themeDarkness)
				),
				transparent 24%
			);
	}

	.past-sponsors-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 0 auto;
		max-width: var(--sizeContentAreaWide);
		padding: 4.5rem clamp(1.25rem, 3vw, 2.5rem) clamp(4.5rem, 8vw, 6.5rem);
		position: relative;
		z-index: 1;
	}

	.past-sponsors-intro {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		max-width: 46rem;
	}

	.past-sponsors h2 {
		color: color-mix(
			in srgb,
			var(--colorBlue4),
			var(--colorWhite) var(--themeDarkness)
		);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(2.4rem, 5.4vw, 4.7rem);
		font-weight: var(--fontWeightBold);
		letter-spacing: -0.03em;
		line-height: 0.92;
		text-wrap: balance;
	}

	.past-sponsors-copy {
		color: color-mix(
			in srgb,
			rgb(from var(--colorBlue4) r g b / 78%),
			rgb(from var(--colorWhiteIsh) r g b / 84%) var(--themeDarkness)
		);
		max-width: 42rem;
	}

	.past-sponsors-panel {
		backdrop-filter: var(--backdropFrosted);
		background:
			linear-gradient(
				180deg,
				color-mix(
					in srgb,
					rgb(from var(--colorWhite) r g b / 72%),
					rgb(from var(--colorBlue1) r g b / 12%) var(--themeDarkness)
				),
				color-mix(
					in srgb,
					rgb(from var(--colorFrost1) r g b / 58%),
					rgb(from var(--colorBlue1) r g b / 3%) var(--themeDarkness)
				)
			),
			color-mix(
				in srgb,
				rgb(from var(--colorBlue1) r g b / 52%),
				rgb(from var(--colorBlue5) r g b / 42%) var(--themeDarkness)
			);
		border-radius: 2rem;
		box-shadow:
			inset 0 1px 0
				color-mix(
					in srgb,
					rgb(from var(--colorWhite) r g b / 70%),
					rgb(from var(--colorWhite) r g b / 10%) var(--themeDarkness)
				),
			var(--panel-shadow);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		padding: clamp(1.4rem, 3vw, 2rem);
		position: relative;
	}

	.past-sponsors-panel::before {
		background: radial-gradient(
			circle at top left,
			rgb(from var(--colorBlue1) r g b / 18%),
			transparent 28%
		);
	}

	.past-sponsors-tier {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.sponsor-logo {
		align-items: center;
		border-radius: var(--radiusLarge);
		display: flex;
		justify-content: center;
		min-height: 3.5rem;
		padding: 0.7rem 1rem;
		transition:
			background var(--transitionNormal),
			transform var(--transitionNormal),
			box-shadow var(--transitionNormal);
		user-select: none;
	}

	.sponsor-logo:hover,
	.sponsor-logo:focus-visible {
		background: color-mix(
			in srgb,
			rgb(from var(--colorBlue3) r g b / 6%),
			rgb(from var(--colorWhiteIsh) r g b / 8%) var(--themeDarkness)
		);
		box-shadow: inset 0 0 0 1px
			color-mix(
				in srgb,
				rgb(from var(--colorBlue3) r g b / 14%),
				rgb(from var(--colorBlue1) r g b / 16%) var(--themeDarkness)
			);
		transform: translateY(-1px);
	}

	.sponsor-logo :global(img) {
		height: var(--logo-size);
		width: auto;
	}

	.past-sponsors-cta {
		align-items: center;
		display: flex;
		justify-content: center;
	}

	@media (--widthLarge) {
		.past-sponsors-cta {
			justify-content: flex-start;
		}
	}

	@media not (--widthSmall) {
		.past-sponsors-shell {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.past-sponsors-panel {
			border-radius: var(--radiusLarge);
			padding: 1.1rem 0.9rem;
		}
	}
</style>

---
import { historicalDataByYear } from "~/data/historical/data";
import { links } from "~/data/links";

import BodyText from "./BodyText.astro";
import Button from "./Button.astro";
import Newsletter from "./Newsletter.astro";
import ThemedImage from "./ThemedImage.astro";

const pastSponsors = Object.values(historicalDataByYear).flatMap(
	({ sponsors }) => sponsors,
);

const tiers = [
	[
		{ size: "14rem", titles: ["Bloomberg"] },
		{ size: "10rem", titles: ["Mintlify"] },
	],
	[
		{
			size: "8rem",
			titles: [
				"Igalia",
				"Datastax",
				"Inngest",
				"OpenJS Foundation",
				"Prisma",
				"Elastic",
			],
		},
	],
	[{ size: "6rem", titles: ["VoidZero", "Rush Stack", "Nx", "Progress"] }],
].map((groups) =>
	groups.flatMap(({ size, titles }) =>
		titles.map((title) => {
			const sponsor = pastSponsors.find((sponsor) => sponsor.title === title);
			if (!sponsor) {
				throw new Error(`Unknown past sponsor: ${title}`);
			}

			return { ...sponsor, size };
		}),
	),
);
---

<section class="past-sponsors" aria-labelledby="past-sponsors-heading">
	<div class="past-sponsors-shell">
		<div class="past-sponsors-intro">
			<p class="past-sponsors-kicker">Leaders in developer tooling</p>
			<h2 id="past-sponsors-heading">Past Sponsors</h2>
			<BodyText class="past-sponsors-copy">
				These teams are some of the sharpest leaders in developer tools, and
				they helped make SquiggleConf possible.
			</BodyText>
		</div>

		<div class="past-sponsors-panel">
			{
				tiers.map((tier) => (
					<div class="past-sponsors-tier">
						{tier.map((sponsor) => (
							<a
								class="sponsor-logo"
								href={sponsor.href}
								rel="noreferrer"
								style={{ "--logo-size": sponsor.size }}
								target="_blank"
								title={sponsor.title}
							>
								<ThemedImage alt="" height={128} sources={sponsor.logos} />
							</a>
						))}
					</div>
				))
			}
		</div>

		<div class="past-sponsors-cta">
			<Button
				as="a"
				size="large"
				variant="emphasized"
				href={links.sponsor}
				target="_blank"
			>
				Sponsorship Prospectus
			</Button>
		</div>
	</div>

	<Newsletter />
</section>

<style>
	.past-sponsors {
		--texture-stripe: rgb(from var(--colorBlue3) r g b / 6%);
		--texture-dot-1: rgb(from white r g b / 36%);
		--texture-dot-2: rgb(from white r g b / 26%);
		--texture-dot-3: rgb(from white r g b / 24%);
		--overlay-top: rgb(from white r g b / 42%);
		--overlay-bottom: rgb(from var(--colorBlue4) r g b / 14%);
		--highlight: rgb(from white r g b / 70%);
		--kicker-background: rgb(from white r g b / 60%);
		--kicker-border: rgb(from var(--colorBlue3) r g b / 18%);
		--kicker-color: var(--colorBlue3);
		--heading-color: var(--colorBlue4);
		--copy-color: rgb(from var(--colorBlue4) r g b / 78%);
		--panel-top: rgb(from white r g b / 72%);
		--panel-bottom: rgb(from var(--colorBlueBright1) r g b / 58%);
		--panel-base: rgb(from var(--colorBlue1) r g b / 52%);
		--panel-shadow: 0 1.1rem 2.4rem rgb(from var(--colorBlue3) r g b / 14%);
		--logo-hover-background: rgb(from var(--colorBlue3) r g b / 6%);
		--logo-hover-ring: rgb(from var(--colorBlue3) r g b / 14%);
		background:
			radial-gradient(
				circle at 18% 16%,
				rgb(from var(--colorBlue3) r g b / 18%),
				transparent 24%
			),
			radial-gradient(
				circle at 84% 14%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 18%
			),
			radial-gradient(
				circle at 52% 100%,
				rgb(
					from color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 25%) r g
						b / 66%
				),
				transparent 42%
			),
			linear-gradient(
				180deg,
				var(--colorBlueBright2) 0%,
				var(--colorBlueBright1) 28%,
				var(--colorBlue1) 64%,
				color-mix(in srgb, var(--colorBlue1), var(--colorBlue3) 10%) 100%
			);
		overflow: clip;
		position: relative;
		width: 100%;
	}

	:global(html.dark) .past-sponsors {
		--texture-stripe: rgb(from var(--colorBlue1) r g b / 4%);
		--texture-dot-1: rgb(from white r g b / 13%);
		--texture-dot-2: rgb(from white r g b / 10%);
		--texture-dot-3: rgb(from white r g b / 8%);
		--overlay-top: rgb(from var(--colorBlue1) r g b / 14%);
		--overlay-bottom: rgb(from var(--colorBlue6) r g b / 48%);
		--highlight: rgb(from white r g b / 12%);
		--kicker-background: rgb(from var(--colorWhiteIsh) r g b / 9%);
		--kicker-border: rgb(from var(--colorBlue1) r g b / 20%);
		--kicker-color: var(--colorWhiteIsh);
		--heading-color: white;
		--copy-color: rgb(from var(--colorWhiteIsh) r g b / 84%);
		--panel-top: rgb(from var(--colorBlue1) r g b / 12%);
		--panel-bottom: rgb(from var(--colorBlue1) r g b / 3%);
		--panel-base: rgb(from var(--colorBlue6) r g b / 42%);
		--panel-highlight: rgb(from white r g b / 10%);
		--panel-shadow: 0 1.5rem 3rem rgb(from var(--colorBlue6) r g b / 34%);
		--logo-hover-background: rgb(from var(--colorWhiteIsh) r g b / 8%);
		--logo-hover-ring: rgb(from var(--colorBlue1) r g b / 16%);
		background:
			radial-gradient(
				circle at 20% 18%,
				rgb(from var(--colorBlue2) r g b / 16%),
				transparent 24%
			),
			radial-gradient(
				circle at 82% 12%,
				rgb(from var(--colorBlue2) r g b / 12%),
				transparent 18%
			),
			radial-gradient(
				circle at 50% 100%,
				rgb(from var(--colorBlue3) r g b / 54%),
				transparent 44%
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--colorBlue4), var(--colorBlue5)) 0%,
				var(--colorBlue4) 30%,
				color-mix(in srgb, var(--colorBlue4), var(--colorBlue5)) 62%,
				var(--colorBlue5) 100%
			);
	}

	.past-sponsors::before,
	.past-sponsors::after,
	.past-sponsors-panel::before {
		content: "";
		inset: 0;
		pointer-events: none;
		position: absolute;
	}

	.past-sponsors::before {
		background:
			repeating-linear-gradient(
				114deg,
				var(--texture-stripe) 0 2px,
				transparent 2px 28px
			),
			radial-gradient(
				circle at 12% 20%,
				var(--texture-dot-1) 0 1px,
				transparent 1px
			),
			radial-gradient(
				circle at 74% 36%,
				var(--texture-dot-2) 0 1.5px,
				transparent 1.5px
			),
			radial-gradient(
				circle at 48% 72%,
				var(--texture-dot-3) 0 1px,
				transparent 1px
			);
		opacity: 0.9;
	}

	.past-sponsors::after {
		background:
			linear-gradient(180deg, var(--overlay-top), transparent 18%),
			linear-gradient(0deg, var(--overlay-bottom), transparent 24%);
	}

	.past-sponsors-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 0 auto;
		max-width: var(--sizeContentAreaWide);
		padding: clamp(4rem, 8vw, 6rem) clamp(1.25rem, 3vw, 2.5rem)
			clamp(4.5rem, 8vw, 6.5rem);
		position: relative;
		z-index: 1;
	}

	.past-sponsors-intro {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		max-width: 46rem;
	}

	.past-sponsors-kicker {
		background: var(--kicker-background);
		border: 1px solid var(--kicker-border);
		border-radius: var(--radiusPill);
		box-shadow: inset 0 1px 0 var(--highlight);
		color: var(--kicker-color);
		font-family: var(--fontFamilyMonospace);
		font-size: 0.78rem;
		font-weight: var(--fontWeightBolder);
		letter-spacing: 0.16em;
		line-height: 1;
		padding: 0.7rem 1rem;
		text-transform: uppercase;
	}

	.past-sponsors h2 {
		color: var(--heading-color);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(2.4rem, 5.4vw, 4.7rem);
		font-weight: var(--fontWeightHeavy);
		letter-spacing: -0.03em;
		line-height: 0.92;
		text-wrap: balance;
	}

	.past-sponsors-copy {
		color: var(--copy-color);
		max-width: 42rem;
	}

	.past-sponsors-panel {
		backdrop-filter: var(--backdropFrosted);
		background:
			linear-gradient(180deg, var(--panel-top), var(--panel-bottom)),
			var(--panel-base);
		border-radius: var(--radiusXLarge);
		box-shadow:
			inset 0 1px 0 var(--panel-highlight, var(--highlight)),
			var(--panel-shadow);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		padding: clamp(1.4rem, 3vw, 2rem);
		position: relative;
	}

	.past-sponsors-panel::before {
		background: radial-gradient(
			circle at top left,
			rgb(from var(--colorBlue1) r g b / 18%),
			transparent 28%
		);
	}

	.past-sponsors-tier {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.sponsor-logo {
		align-items: center;
		border-radius: var(--radiusLarge);
		display: flex;
		justify-content: center;
		min-height: 5rem;
		padding: 0.7rem 1rem;
		transition:
			background var(--transitionNormal),
			transform var(--transitionNormal),
			box-shadow var(--transitionNormal);
		user-select: none;
	}

	.sponsor-logo:hover,
	.sponsor-logo:focus-visible {
		background: var(--logo-hover-background);
		box-shadow: inset 0 0 0 1px var(--logo-hover-ring);
		transform: translateY(-1px);
	}

	.sponsor-logo img {
		max-height: var(--logo-size);
		max-width: var(--logo-size);
	}

	.past-sponsors-cta {
		align-items: center;
		display: flex;
		justify-content: center;
	}

	@media (width >= 900px) {
		.past-sponsors-cta {
			justify-content: flex-start;
		}
	}

	@media (width < 700px) {
		.past-sponsors-shell {
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.past-sponsors-kicker {
			font-size: 0.7rem;
			padding: 0.62rem 0.9rem;
		}

		.past-sponsors-panel {
			border-radius: var(--radiusLarge);
			padding: 1.1rem 0.9rem;
		}
	}
</style>

---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	class?: string;
	size?: "large" | "normal";
	variant: "emphasized" | "ghost" | "light";
}>;

const {
	as: As,
	class: className,
	size = "normal",
	variant,
	...rest
} = Astro.props;
---

<As
	class:list={[
		"button",
		`button-size-${size}`,
		`button-variant-${variant}`,
		className,
	]}
	{...rest}
>
	<slot />
</As>

<style>
	.button {
		--colorButtonBackgroundHover: var(--colorBlue1);
		--colorButtonBorderHover: transparent;
		--colorButtonColorHover: var(--colorBlue5);

		background: var(--colorButtonBackground);
		color: var(--colorButtonColor);
		align-items: center;
		border: 2px solid transparent;
		border-radius: var(--radiusPill);
		cursor: pointer;
		display: inline-flex;
		font-family: var(--fontFamilyHeading);
		font-weight: var(--fontWeightSemiLight);
		text-align: center;
		text-decoration: none;
		user-select: none;
	}

	.button[disabled] {
		cursor: not-allowed;
		opacity: 0.8;
	}

	.button-size-normal {
		padding: 0.65rem 1.25rem;
	}

	.button-size-large {
		font-size: var(--fontSizeMedium);
		padding: 0.85rem 2rem 0.75rem;
	}

	.button-variant-emphasized {
		--colorButtonBackground: var(--colorAccentMedium);
		--colorButtonColor: light-dark(var(--colorWhiteIsh), var(--colorBlue5));
	}

	.button-variant-light {
		--colorButtonBackground: var(--colorWhiteIsh);
		--colorButtonBackgroundHover: var(--colorBlue2);
		--colorButtonBorderHover: var(--colorBlue1);

		color: var(--colorBlue5);
		font-weight: var(--fontWeightMedium);
	}

	.button:active {
		--colorButtonBackground: light-dark(var(--colorBlue2), var(--colorBlue4));
		--colorButtonColor: var(--colorBlue4);
	}

	html.dark .button:active {
		--colorButtonColor: inherit;
	}

	.button:focus:not(:active, [disabled]),
	.button:hover:not(:active, [disabled]) {
		background: var(--colorButtonBackgroundHover);
		color: var(--colorButtonColorHover);
		border: 2px solid var(--colorButtonBorderHover);
	}

	/* A translucent outline that takes its text color from its surroundings. */
	.button-variant-ghost {
		--colorButtonBackground: light-dark(
			rgb(from var(--colorWhite) r g b / 8%),
			transparent
		);
		--colorButtonBackgroundHover: light-dark(
			rgb(from var(--colorBlue5) r g b / 14%),
			rgb(from var(--colorBlue2) r g b / 78%)
		);
		--colorButtonBorder: light-dark(
			rgb(from var(--colorBlue5) r g b / 22%),
			rgb(from var(--colorBlue1) r g b / 34%)
		);
		--colorButtonBorderHover: light-dark(
			rgb(from var(--colorBlue5) r g b / 30%),
			rgb(from var(--colorBlue1) r g b / 46%)
		);
		--colorButtonColor: currentcolor;
		--colorButtonColorHover: currentcolor;
		--shadowButton:
			inset 0 1px 0 rgb(from var(--colorWhite) r g b / 16%),
			0 0.1rem 0.1rem rgb(from var(--colorBlue5) r g b / 12%),
			0 0 0 1px rgb(from var(--colorBlue5) r g b / 8%);
		--shadowButtonHover:
			inset 0 1px 0
				light-dark(
					rgb(from var(--colorWhite) r g b / 22%),
					rgb(from var(--colorWhite) r g b / 18%)
				),
			0 0.25rem 0.5rem
				light-dark(
					rgb(from var(--colorBlue5) r g b / 16%),
					rgb(from var(--colorBlue2) r g b / 22%)
				);

		border-color: var(--colorButtonBorder);
		border-radius: var(--radiusLarge);
		box-shadow: var(--shadowButton);
		font-weight: var(--fontWeightMedium);
		text-wrap: nowrap;
		transition:
			background var(--transitionFast),
			border-color var(--transitionFast),
			box-shadow var(--transitionFast),
			transform var(--transitionFast);
	}

	html.dark .button-variant-ghost {
		--shadowButton:
			inset 0 1px 0 rgb(from var(--colorWhite) r g b / 16%),
			0 0.25rem 1rem rgb(from var(--colorBlue2) r g b / 18%),
			0 0 0 1px rgb(from var(--colorBlue1) r g b / 18%);
	}

	.button-variant-ghost:hover,
	.button-variant-ghost:focus-visible {
		box-shadow:
			var(--shadowButtonHover),
			0 0 0 1px var(--colorButtonBorderHover);
		transform: translateY(-1px);
	}
</style>

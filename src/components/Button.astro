---
import { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	class?: string;
	size?: "normal" | "large";
	variant: "accent" | "emphasized" | "ghost" | "light" | "terminal";
}>;

const {
	as: As,
	class: className,
	size = "normal",
	variant,
	...rest
} = Astro.props;
---

<As
	class:list={[
		"button",
		`button-size-${size}`,
		`button-variant-${variant}`,
		className,
	]}
	{...rest}
>
	<slot />
</As>

<style>
	.button {
		--colorButtonBackgroundHover: var(--colorBlue1);
		--colorButtonBorderHover: transparent;
		--colorButtonColorHover: var(--colorBlue5);
		background: var(--colorButtonBackground);
		color: var(--colorButtonColor);
		align-items: center;
		border: 2px solid transparent;
		cursor: pointer;
		display: inline-flex;
		font-family: var(--fontFamilyHeading);
		font-weight: var(--fontWeightSemibold);
		text-align: center;
		text-decoration: none;
		user-select: none;
	}

	.button[disabled] {
		cursor: not-allowed;
		opacity: 0.8;
	}

	.button-size-normal {
		border-radius: var(--radiusPill);
		padding: 0.65rem 1.25rem;
	}

	.button-size-large {
		border-radius: var(--radiusPill);
		font-size: var(--fontSizeMedium);
		padding: 0.85rem 2rem 0.75rem;
	}

	.button-variant-accent {
		--colorButtonBackground: var(--colorBlue3);
		--colorButtonColor: var(--colorWhiteIsh);
	}

	.button-variant-emphasized {
		--colorButtonBackground: var(--colorAccentMedium);
		--colorButtonColor: var(--colorForegroundAccent);
	}

	.button-variant-light {
		--colorButtonBackground: var(--colorWhiteIsh);
		--colorButtonBackgroundHover: var(--colorBlue2);
		--colorButtonBorderHover: var(--colorBlue1);
		color: var(--colorBlue5);
		font-weight: var(--fontWeightBold);
	}

	.button:active {
		--colorButtonBackground: var(--colorAccentSecond);
		--colorButtonColor: var(--colorForeground);
	}

	:global(html.dark) .button:active {
		--colorButtonColor: inherit;
	}

	.button:focus:not(:active, [disabled]),
	.button:hover:not(:active, [disabled]) {
		background: var(--colorButtonBackgroundHover);
		color: var(--colorButtonColorHover);
		border: 2px solid var(--colorButtonBorderHover);
	}

	/* terminal.shop's orange, as frosted glass. */
	.button-variant-terminal {
		--colorTerminalOrange: #ff5e00;
		--colorButtonColor: var(--colorHeading);
		--colorButtonBackground: linear-gradient(
			140deg,
			rgb(from var(--colorTerminalOrange) r g b / 34%) 0%,
			rgb(from var(--colorTerminalOrange) r g b / 28%) 38%,
			rgb(from var(--colorTerminalOrange) r g b / 22%) 68%,
			rgb(from var(--colorTerminalOrange) r g b / 30%) 100%
		);
		--colorButtonBackgroundHover: linear-gradient(
			140deg,
			rgb(from var(--colorTerminalOrange) r g b / 56%) 0%,
			rgb(from var(--colorTerminalOrange) r g b / 48%) 38%,
			rgb(from var(--colorTerminalOrange) r g b / 42%) 68%,
			rgb(from var(--colorTerminalOrange) r g b / 52%) 100%
		);
		--colorButtonBorderHover: var(--colorTerminalOrange);
		--colorButtonColorHover: var(--colorButtonColor);
		backdrop-filter: var(--backdropFrosted);
		border: 1px solid var(--colorTerminalOrange);
		border-radius: var(--radiusLarge);
		box-shadow:
			inset 0 1px 0 rgb(from white r g b / 20%),
			0 1rem 2rem rgb(from var(--colorTerminalOrange) r g b / 16%),
			0 0 0 1px rgb(from var(--colorTerminalOrange) r g b / 12%);
		gap: 0.7rem;
		padding: 0.75rem 1.1rem 0.75rem 0.9rem;
		transition:
			background var(--transitionNormal),
			box-shadow var(--transitionNormal),
			transform var(--transitionNormal);
	}

	.button-variant-terminal:focus:not(:active, [disabled]),
	.button-variant-terminal:hover:not(:active, [disabled]) {
		border-width: 1px;
		box-shadow:
			inset 0 1px 0 rgb(from white r g b / 22%),
			0 1rem 2rem rgb(from var(--colorTerminalOrange) r g b / 22%),
			0 0 0 1px rgb(from var(--colorTerminalOrange) r g b / 18%);
		transform: translateY(-1px);
	}

	/* A translucent outline that takes its text color from its surroundings. */
	.button-variant-ghost {
		--colorButtonBackground: rgb(from white r g b / 8%);
		--colorButtonBackgroundHover: rgb(from var(--colorBlue5) r g b / 14%);
		--colorButtonBorder: rgb(from var(--colorBlue5) r g b / 22%);
		--colorButtonBorderHover: rgb(from var(--colorBlue5) r g b / 30%);
		--colorButtonColor: currentColor;
		--colorButtonColorHover: currentColor;
		--shadowButton:
			inset 0 1px 0 rgb(from white r g b / 16%),
			0 0.1rem 0.1rem rgb(from var(--colorBlue5) r g b / 12%),
			0 0 0 1px rgb(from var(--colorBlue5) r g b / 8%);
		--shadowButtonHover:
			inset 0 1px 0 rgb(from white r g b / 22%),
			0 0.25rem 0.5rem rgb(from var(--colorBlue5) r g b / 16%);
		border-color: var(--colorButtonBorder);
		border-radius: var(--radiusLarge);
		box-shadow: var(--shadowButton);
		font-weight: var(--fontWeightBold);
		text-wrap: nowrap;
		transition:
			background var(--transitionBackground),
			border-color var(--transitionFast),
			box-shadow var(--transitionFast),
			transform var(--transitionFast);
	}

	:global(html.dark) .button-variant-ghost {
		--colorButtonBackground: transparent;
		--colorButtonBackgroundHover: rgb(from var(--colorBlue2) r g b / 78%);
		--colorButtonBorder: rgb(from var(--colorBlue1) r g b / 34%);
		--colorButtonBorderHover: rgb(from var(--colorBlue1) r g b / 46%);
		--shadowButton:
			inset 0 1px 0 rgb(from white r g b / 16%),
			0 0.25rem 1rem rgb(from var(--colorBlue2) r g b / 18%),
			0 0 0 1px rgb(from var(--colorBlue1) r g b / 18%);
		--shadowButtonHover:
			inset 0 1px 0 rgb(from white r g b / 18%),
			0 0.25rem 0.5rem rgb(from var(--colorBlue2) r g b / 22%);
	}

	.button-variant-ghost:hover,
	.button-variant-ghost:focus-visible {
		box-shadow:
			var(--shadowButtonHover),
			0 0 0 1px var(--colorButtonBorderHover);
		transform: translateY(-1px);
	}
</style>

---
import BodyText from "~/components/BodyText.astro";
import { Article, articles } from "~/data/articles";
import Heading from "./Heading.astro";
import ContentArea from "./ContentArea.astro";

const entries = Object.entries<Article>(articles);
---

<ContentArea class="articles-list">
	<ul>
		{
			entries.map(([slug, article]) => (
				<li>
					<a href={`/articles/${slug}`}>
						<Heading level="h2">{article.listTitle ?? article.title}</Heading>
					</a>
					<BodyText>{article.description}</BodyText>
				</li>
			))
		}
	</ul>
</ContentArea>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		list-style-type: none;
		padding: 5rem 0;
	}

	h2 {
		font-size: var(--fontSizeMedium);
		margin-bottom: 0.5rem;
	}
</style>

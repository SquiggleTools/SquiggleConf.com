---
interface Props {
	class?: string;
	historical?: boolean;
}

const { class: className, historical, ...rest } = Astro.props;
---

<p
	class:list={[className, "body-text", historical && "body-text-historical"]}
	{...rest}
>
	<slot />
</p>

<style>
	.body-text {
		font-size: var(--fontSizeSmall);
		font-weight: var(--fontWeightLight);
	}

	.body-text-historical {
		color: var(--colorCopy);
		font-family: var(--fontFamilyBody);
		font-size: var(--fontSizeMedium);
		font-weight: var(--fontWeightLight);
		line-height: var(--lineHeightBody);
		max-width: var(--sizeContentAreaThin);
		padding: 0 var(--widthBodyPadding);
		text-align: center;
		transition: var(--transitionNormal) line-height;
	}
</style>

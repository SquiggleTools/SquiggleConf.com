---
import CommonContent from "~/components/CommonContent.astro";
import { cfpCloseDate, cfpOpenDate } from "~/data/event";
import { currentYear } from "~/data/years";
import ArticleLayout from "~/layouts/ArticleLayout.astro";

const opens = `${cfpOpenDate}, ${currentYear - 1}`;
const closes = `${cfpCloseDate}, ${currentYear}`;
---

<ArticleLayout
	article={{
		description:
			"Advice and general information for submitting talks to SquiggleConf",
		title: "Call for Proposals",
	}}
	squiggly="wide"
>
	<CommonContent heading="Coming Soon">
		<p>
			The SquiggleConf {currentYear} CFP opens {opens} and closes {closes}. We
			look forward to seeing your submissions!
		</p>
		<p>
			In the meantime, the <a href="/articles/speaker-guide">speaker guide</a>{" "}
			covers what to expect as a SquiggleConf speaker.
		</p>
	</CommonContent>
</ArticleLayout>

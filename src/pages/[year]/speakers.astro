---
import type { InferGetStaticPropsType } from "astro";

import Speaker from "~/components/historical/Speaker.astro";
import SafeMarkdown from "~/components/SafeMarkdown.astro";
import { getStaticPathsHistorical } from "~/data/historical/data";
import PageLayout from "~/layouts/PageLayout.astro";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const getStaticPaths = getStaticPathsHistorical;

const { data: historicalData, year } = Astro.props;
---

<PageLayout
	description={`Speakers at SquiggleConf ${year}: a Boston conference focused on excellent web dev tooling.`}
	title="Speakers"
	year={year}
>
	<ul class="speakers-list">
		{Object.values(historicalData.peopleBySlug)
			.toSorted((a, b) => a.name.localeCompare(b.name))
			.map((person) => (
				<Speaker
					speaker={person}
					talks={Object.values(historicalData.sessionsBySlug).filter((talk) =>
						talk.people.includes(person),
					)}
					year={year}
				>
					<div class="bio" slot="center">
						<SafeMarkdown of={person.biography} />
					</div>
				</Speaker>
			))}
	</ul>
</PageLayout>

<style>
	.speakers-list {
		display: flex;
		flex-flow: column wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 2rem;
		padding: 0 var(--widthBodyPadding);
	}

	.bio {
		line-height: 1.25;
		padding-top: 0.5rem;
		transition: var(--transitionNormal) line-height;
	}

	@media (--widthXLarge) {
		.speakers-list {
			width: var(--sizeContentAreaThin);
		}
	}
</style>

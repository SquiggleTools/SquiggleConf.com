---
import type { InferGetStaticPropsType } from "astro";

import Session from "~/components/historical/Session.astro";
import { getStaticPathsHistorical } from "~/data/historical/data";
import PageLayout from "~/layouts/PageLayout.astro";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const getStaticPaths = getStaticPathsHistorical;

export const prerender = true;

const { data: historicalData, year } = Astro.props;
---

<PageLayout
	description="Sessions at SquiggleConf: a Boston conference focused on excellent web dev tooling."
	title="Sessions"
	year={year}
>
	<ul class="talks-list">
		{
			Object.values(historicalData.sessionsBySlug)
				.toSorted((a, b) => a.title.localeCompare(b.title))
				.map((session) => <Session session={session} year={year} />)
		}
	</ul>
</PageLayout>

<style>
	.talks-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		list-style: none;
		padding: 0 var(--widthBodyPadding);
	}
</style>

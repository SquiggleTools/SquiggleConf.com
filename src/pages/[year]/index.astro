---
import type { InferGetStaticPropsType } from "astro";

import SpeakersContent from "~/components/historical/SpeakersContent.astro";
import Sponsors from "~/components/historical/Sponsors.astro";
import { getStaticPathsHistorical } from "~/data/historical/data";
import PageLayout from "~/layouts/PageLayout.astro";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const getStaticPaths = getStaticPathsHistorical;

export const prerender = true;

const { data: historicalData, year } = Astro.props;
const description = `${historicalData.date} · Boston New England Aquarium`;
---

<PageLayout description={description} year={year}>
	<div class="index-contents">
		<SpeakersContent
			talks={Object.values(historicalData.sessionsBySlug)}
			year={year}
		/>
		<Sponsors sponsors={historicalData.sponsors} />
	</div>
</PageLayout>

<style>
	.index-contents {
		align-items: center;
		display: flex;
		gap: 7rem;
		flex-direction: column;
	}
</style>

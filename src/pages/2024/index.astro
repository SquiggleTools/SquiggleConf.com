---
import SpeakersContent from "~/components/2024/SpeakersContent.astro";
import Sponsors from "~/components/2024/Sponsors.astro";
import PageLayoutHistorical from "~/layouts/PageLayoutHistorical.astro";
import "~/styles/2024.css";

const description = "October 3-4, 2024 · Boston New England Aquarium";
---

<PageLayoutHistorical description={description}>
	<div class="index-contents">
		<SpeakersContent />
		<Sponsors />
	</div>
</PageLayoutHistorical>

<style>
	.index-contents {
		align-items: center;
		display: flex;
		gap: 7rem;
		flex-direction: column;
	}

	.newsletter {
		max-width: fit-content;
	}
</style>

---
import Button from "~/components/Button.astro";
import ContentArea from "~/components/ContentArea.astro";
import Hero from "~/components/hero/Hero.astro";
import HeroContentsStandard from "~/components/hero/HeroContentsStandard.astro";
import PageLayout from "~/layouts/PageLayout.astro";
---

<PageLayout
	description="That page could not be found."
	noIndex
	title="Page Not Found"
>
	<Hero slot="hero" width="thin">
		<HeroContentsStandard
			eyebrow="Error 404"
			heading="Page Not Found"
			squiggly="none"
		>
			You've drifted into uncharted waters. <br /> Consider navigating to the
			surface.
		</HeroContentsStandard>
	</Hero>
	<ContentArea class="not-found-actions" width="thin">
		<Button as="a" href="/" size="large" variant="emphasized">
			Back to the homepage
		</Button>
	</ContentArea>
</PageLayout>

<style>
	.not-found-actions {
		display: flex;
		padding-block: clamp(3rem, 7vh, 25rem);
	}
</style>

	.syntax-avatar {
		border-radius: 999px;
		height: 5rem;
		position: absolute;
		width: 5rem;
		z-index: 2;
	}

	.syntax-avatar :global(picture) {
		display: block;
		height: 100%;
		width: 100%;
	}

	.syntax-avatar :global(img) {
		border-radius: inherit;
		display: block;
		height: 100%;

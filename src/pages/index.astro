	.timeline-content::before {
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 1rem;
		box-shadow: none;
		content: "";
		inset: 0.35rem -0.8rem 0.45rem 0.85rem;
		opacity: 0.22;
		pointer-events: none;
		position: absolute;
		transform: scale(0.985);
		z-index: 0;
		transition:
			opacity var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease,
			border-color var(--timeline-hover-duration) ease,
			box-shadow var(--timeline-hover-duration) ease;
	}

	.timeline-content::after {
		background: radial-gradient(
			circle 25rem at var(--timeline-card-pointer-x)
				var(--timeline-card-pointer-y),
			color-mix(in srgb, var(--colorBlue2) 92%, white 8%) 0,
			color-mix(in srgb, var(--colorBlue2) 52%, transparent) 28%,
			transparent 60%
		);
		border-radius: 1rem;
		content: "";
		inset: 0.35rem -0.8rem 0.45rem 0.85rem;
		opacity: 0;
		padding: 3px;
		pointer-events: none;
		position: absolute;
		z-index: 0;
		transition: opacity var(--timeline-hover-duration) ease;
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
	}

	.timeline-content:hover,
	.timeline-content:focus-within {
		transform: translateX(0.3rem);
	}

	.timeline-content:hover::before,
	.timeline-content:focus-within::before {
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.13),
			rgba(255, 255, 255, 0.03)
		);

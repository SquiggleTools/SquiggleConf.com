---
import "@fontsource/shantell-sans";

import { Image } from "astro:assets";

import tanner from "~/assets/2027/tanner.webp";
import Hero from "~/components/hero/Hero.astro";
import ryanDahl from "~/assets/avatars/ryan-dahl.webp";
import wesBos from "~/assets/avatars/wes-bos.webp";
import thePrimeagen from "~/assets/avatars/the-primeagen.webp";
import scottTolinski from "~/assets/avatars/scott-tolinski.webp";
import {
	bigRav,
	dillonMulroy,
	exploreChoices,
	funrun1,
	funrun2,
	harbor,
	harborwalk,
	lunchSpots,
	milkcookies1,
	milkcookies2,
	milkcookies3,
	networking,
	simonsTheater,
	talkBlocks,
	timelineMCs,
	urbanwild1,
	urbanwild2,
	urbanwild3,
	urbanwild4,
	urbanwild5,
	urbanwildLogo,
	venues,
} from "~/components/home/data";
import Collage from "~/components/home/Collage.astro";
import CollagePhotoImage from "~/components/home/CollagePhotoImage.astro";
import CollageItem from "~/components/home/CollageItem.astro";
import ExploreChoices from "~/components/home/ExploreChoices.astro";
import HomeHeroLockup from "~/components/home/HomeHeroLockup.astro";
import HostList from "~/components/home/HostList.astro";
import LunchCarousel from "~/components/home/LunchCarousel.astro";
import PostcardGallery from "~/components/home/PostcardGallery.astro";
import PrivatePreviewHeader from "~/components/home/PrivatePreviewHeader.astro";
import TalkList from "~/components/home/TalkList.astro";
import TerminalShopButton from "~/components/home/TerminalShopButton.astro";
import TimelineCopy from "~/components/home/TimelineCopy.astro";
import TimelineEntry from "~/components/home/timeline/TimelineEntry.astro";
import TimelineFishLayer from "~/components/home/timeline/TimelineFishLayer.astro";
import DeepSeaSurface from "~/components/DeepSeaSurface.astro";
import Registration from "~/components/Registration.astro";
import SponsorsAndPartners from "~/components/SponsorsAndPartners.astro";
import TimelineTalksTurtle from "~/components/TimelineTalksTurtle.astro";
import PageLayout from "~/layouts/PageLayout.astro";
---

<PrivatePreviewHeader />
<PageLayout
	description="A Boston conference for excellent web dev tooling."
	hideHeaderLogo
>
	<Hero tall>
		<HomeHeroLockup />
	</Hero>
	<DeepSeaSurface>
		<section class="timeline-section" aria-label="Timeline preview">
			<TimelineFishLayer />
			<div class="top-side-by-side">
				<div class="top-side-left">
					<h2 class="top-heading">the devtools conference</h2>
					<p class="top-intro">
						SquiggleConf is a conference focused on software developer tools: AI
						tools, linters, code editors, performance and security tools,
						debuggers, and more. We mix heavy talks with fun events.<br />Think
						of it like your devtools fieldtrip.
					</p>
				</div>
				<PostcardGallery />
			</div>
			<div class="timeline-grid">
				<div class="timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Thursday</p>
					<p>May 6th</p>
				</div>
				<div class="timeline-grid-intro">
					<h3>SquiggleConf 2027</h3>
					<p>Boston, Massachusetts</p>
				</div>

				<div class="timeline-venue timeline-venue-last">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.nedDevines.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Ned</p>
							<p>Devine's</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-bottom">
					<p class="timeline-time">6pm</p>
				</div>

				<TimelineEntry
					entryId="launch"
					heading="Launch Party!"
					mobileLocation="Ned Devine's"
					mobileLocationHref={venues.nedDevines.mapUrl}
					time="6-9pm"
					timeMode="range"
				>
					<Collage
						ariaLabel="Launch party collage"
						class="launch-party-collage"
						layout="trio"
						photos={[
							{ alt: "Boston harbor near the venue", src: harbor },
							{ alt: "People networking at SquiggleConf", src: networking },
							{
								alt: "Speakers gathered together at the event",
								src: harborwalk,
							},
						]}
					/>
					<TimelineCopy>
						<div class="event-body">
							<CollageItem>
								<CollagePhotoImage
									class="launch-party-host"
									src={tanner}
									alt="Tanner Linsley portrait"
								/>
							</CollageItem>
							<TimelineCopy>
								<p>
									Kick off the weekend with snacks, drinks, and an easy room
									full of tool-loving people. It is the place to settle in, say
									hi, and start the conference with a little momentum.
								</p>
								<p class="fireside-host">hosted by Tanner Linsley</p>
							</TimelineCopy>
						</div>
					</TimelineCopy>
				</TimelineEntry>

				<div class="timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Friday</p>
					<p>May 7th</p>
				</div>
				<div class="timeline-cell-empty" aria-hidden="true"></div>

				<div class="timeline-venue timeline-cell-span-seven">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>New</p>
							<p>England</p>
							<p>Aquarium</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">7am</p>
				</div>

				<TimelineEntry
					entryId="fun-run"
					heading="Fun Run"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="7-7:30am"
					timeMode="range"
					variant="funRun"
				>
					<Collage
						ariaLabel="Fun run collage"
						class="fun-run-collage fun-run-collage-desktop"
						layout="duo"
						photos={[
							{
								alt: "Fun Run route by the waterfront",
								objectPosition: "10% 10%",
								src: funrun1,
							},
							{
								alt: "Runners gathering before the Fun Run",
								objectPosition: "38% 50%",
								src: funrun2,
							},
						]}
					/>
					<div class="fun-run-body">
						<TimelineCopy>
							<p>
								Optional for some, best way to start the day for others! It's an
								casual yet eventful 5k through the Boston shoreline.
							</p>
						</TimelineCopy>
						<Collage
							class="fun-run-collage fun-run-collage-mobile"
							decorative
							layout="duo"
							photos={[
								{
									alt: "",
									decorative: true,
									objectPosition: "10% 10%",
									src: funrun1,
								},
								{
									alt: "",
									decorative: true,
									objectPosition: "38% 50%",
									src: funrun2,
								},
							]}
						/>
					</div>
				</TimelineEntry>

				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">8am</p>
				</div>

				<TimelineEntry
					entryId="check-in"
					heading="Check In"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="8am"
				>
					<TimelineCopy>
						<p>
							Pick up your badge, settle in, and grab a terminal.shop coffee
							before the first sessions start.
						</p>
						<TerminalShopButton />
					</TimelineCopy>
				</TimelineEntry>

				<TimelineEntry
					entryId="simons-imax-theater"
					heading="Talks in an IMAX Theater"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="8am"
					variant="mcs"
				>
					<div class="event-body">
						<div
							class="event-hero-image event-hero-image-wide event-hero-image-pinned"
						>
							<Image
								alt="Presenter on stage inside the Simons IMAX Theater"
								src={simonsTheater}
								loading="eager"
							/>
						</div>
						<TimelineCopy>
							<p>
								The talks take place in an IMAX theater. That means super
								comfortable seats, great visibility, and a 60ft high screen.
							</p>
							<p>Also, a penguin exhibit next door.</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">9am</p>
				</div>

				<TimelineEntry
					entryId="mcs"
					heading="Meet your MCs!"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="9am"
					variant="mcs"
				>
					<HostList ariaLabel="Conference MCs" hosts={timelineMCs} />
				</TimelineEntry>

				<TimelineEntry
					entryId="talks-morning"
					heading="Talks"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="9am"
					variant="talks"
				>
					<TalkList ariaLabel="Speaker talks" talks={talkBlocks.morning} />
				</TimelineEntry>

				<div class="timeline-rail">
					<p class="timeline-time">10:30am</p>
				</div>

				<TimelineEntry
					entryId="cookies-break"
					heading="Milk & Cookies Break"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="10:30am"
					variant="break"
				>
					<div class="break-body">
						<Collage
							ariaLabel="Milk and Cookies break collage"
							class="cookiesbreak-collage"
							layout="trio"
							photos={[
								{ alt: "Milk and cookies spread", src: milkcookies3 },
								{ alt: "Cookies at the break", src: milkcookies1 },
								{
									alt: "Milk and cookies break crowd",
									objectPosition: "10% 0%",
									src: milkcookies2,
								},
							]}
						/>
						<TimelineCopy class="break-copy">
							<p>A SguiggleConf classic!</p><p>
								Catch up with people you just met, and trade notes on the
								morning’s talks.
							</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<div class="timeline-rail">
					<p class="timeline-time">11am</p>
				</div>

				<TimelineEntry
					entryId="talks-late"
					heading="Talks"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="11am"
					variant="talks"
				>
					<TalkList
						ariaLabel="Late morning talks"
						short
						talks={talkBlocks.lateMorning}
					/>
				</TimelineEntry>

				<div class="timeline-venue">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.quincyMarket.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Quincy</p>
							<p>Market</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">12pm</p>
				</div>

				<TimelineEntry
					entryId="lunch"
					heading="Lunch"
					mobileLocation="Quincy Market"
					mobileLocationHref={venues.quincyMarket.mapUrl}
					time="12pm"
					variant="lunch"
				>
					<div class="lunch-body">
						<LunchCarousel spots={lunchSpots} />
						<TimelineCopy class="lunch-copy">
							<p>
								Head out together into
								<a href="https://faneuilhallmarketplace.com/dining">
									Faneuil Hall Marketplace</a
								> at Quincy Market, keep conversations moving, and treat the middle
								of the day like your devtools field trip lunch break.
							</p>
							<ul class="lunch-links">
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/boston-and-maine-fish-company"
									>
										Boston &amp; Maine Fish Company
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/regina-pizzeria"
									>
										Regina Pizzeria
									</a>
								</li>
								<li>
									<a href="https://faneuilhallmarketplace.com/go/wicked-lobsta">
										Wicked Lobsta
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/the-berry-twist"
									>
										The Berry Twist
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/green-organic-bowl"
									>
										Green Organic Bowl
									</a>
								</li>
							</ul>
							<p>
								Fast options, easy wandering, and enough variety that everyone
								can grab something good before heading back for the afternoon
								block.
							</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<div
					class="timeline-venue timeline-venue-aquarium-afternoon timeline-cell-span-two"
				>
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>New</p>
							<p>England</p>
							<p>Aquarium</p>
						</a>
						<div
							class="timeline-venue-decoration timeline-venue-decoration-turtle"
							aria-hidden="true"
						>
							<TimelineTalksTurtle />
						</div>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">2pm</p>
				</div>

				<TimelineEntry
					entryId="talks-afternoon"
					heading="Talks"
					mobileLocation="New England Aquarium"
					mobileLocationHref={venues.aquarium.mapUrl}
					time="2pm"
					variant="talksAfternoon"
				>
					<TalkList ariaLabel="Afternoon talks" talks={talkBlocks.afternoon} />
				</TimelineEntry>

				<div class="timeline-rail">
					<p class="timeline-time">3:30pm</p>
				</div>

				<TimelineEntry
					entryId="explore-boston"
					heading="Explore Boston"
					mobileLocation="Boston"
					subtitle="choose your own adventure"
					time="3:30pm"
					variant="explore"
				>
					<ExploreChoices choices={exploreChoices} />
				</TimelineEntry>

				<div class="timeline-venue timeline-cell-span-five timeline-venue-last">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.urbanWild.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Urban</p>
							<p>Wild</p>
							<p>Boston</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">6pm</p>
				</div>

				<TimelineEntry
					entryId="arrive-urban-wild"
					heading="Arrive at Urban Wild"
					mobileLocation="Urban Wild Boston"
					mobileLocationHref={venues.urbanWild.mapUrl}
					time="6pm"
					variant="podcast"
				>
					<div class="event-body">
						<div
							class="event-hero-image event-hero-image-wide event-hero-image-pinned"
						>
							<Image
								alt="Urban Wild Boston logo"
								src={urbanwildLogo}
								loading="eager"
							/>
						</div>
						<TimelineCopy>
							<p>
								The rest of the night takes place at Urban Wild Boston. Also the
								last clue of the Scavenger Hunt may or may not be here.......
							</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<TimelineEntry
					entryId="podcast-live"
					heading="Live Podcast Recording"
					mobileLocation="Urban Wild Boston"
					mobileLocationHref={venues.urbanWild.mapUrl}
					time="6pm"
					variant="podcast"
				>
					<div class="event-body">
						<Collage
							ariaLabel="Podcast recording live guests"
							layout="avatar-trio"
							photos={[
								{
									alt: "ThePrimeagen portrait",
									src: thePrimeagen,
								},
								{
									alt: "Wes Bos portrait",
									src: wesBos,
								},
								{
									alt: "Scott Tolinski portrait",
									src: scottTolinski,
								},
							]}
							shape="avatar"
						/>
						<TimelineCopy>
							<h3 class="fireside-topic">
								How to Find Time to Learn After Work
							</h3>
							<p>
								Join Wes and Scott in a live podcast recording of Syntax.fm
								featuring ThePrimeagen.
							</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<div class="timeline-rail">
					<p class="timeline-time">7pm</p>
				</div>

				<TimelineEntry
					entryId="fireside-chat"
					heading="Fireside Chat"
					mobileLocation="Urban Wild Boston"
					mobileLocationHref={venues.urbanWild.mapUrl}
					time="7pm"
					variant="fireside"
				>
					<div class="event-body">
						<Collage
							ariaLabel="Fireside chat guests"
							layout="avatar-duo"
							photos={[
								{
									alt: "Ryan Dahl portrait",
									src: ryanDahl,
								},
								{ alt: "Dillon Mulroy portrait", src: dillonMulroy },
							]}
							shape="avatar"
						/>
						<TimelineCopy>
							<h3 class="fireside-topic">
								The Fight to Free the JavaScript Trademark
							</h3>
							<p>
								Node.js and Deno creator Ryan Dahl takes the stage to break down
								Deno's ongoing legal crusade against Oracle to free the
								"JavaScript" trademark.
							</p>
							<p class="fireside-host">hosted by Dillon Mulroy</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>

				<div class="timeline-rail timeline-bottom timeline-cell-span-two">
					<p class="timeline-time">7:30pm</p>
				</div>

				<TimelineEntry
					entryId="after-party"
					heading="After Party"
					mobileLocation="Urban Wild Boston"
					mobileLocationHref={venues.urbanWild.mapUrl}
					time="7:30-9pm"
					timeMode="range"
				>
					<Collage
						ariaLabel="After party collage"
						class="afterparty-collage"
						layout="feature-five"
						photos={[
							{ alt: "", decorative: true, src: urbanwild1 },
							{ alt: "", decorative: true, src: urbanwild2 },
							{ alt: "", decorative: true, src: urbanwild3 },
							{ alt: "", decorative: true, src: urbanwild4 },
							{ alt: "", decorative: true, src: urbanwild5 },
						]}
					/>
					<TimelineCopy>
						<p>
							After the podcast and fireside chat, we'll switch into party mode
							at Urban Wild: video arcade bowling, lots of light bites and
							refreshments, and most of all - a chance to hang with everyone you
							just met at the conference!
						</p>
					</TimelineCopy>
				</TimelineEntry>

				<TimelineEntry
					entryId="big-rav"
					heading="Big Rav"
					mobileLocation="Urban Wild Boston"
					mobileLocationHref={venues.urbanWild.mapUrl}
					time="9pm"
				>
					<div class="event-body">
						<div class="event-hero-image event-hero-image-circle">
							<Image alt="Big Rav band portrait" src={bigRav} loading="eager" />
						</div>
						<TimelineCopy>
							<p>
								<a href="https://bigrav.band"><strong>Big Rav</strong></a> is a Boston-based
								alternative, indie, and punk rock band that combines pop-punk vocals
								with classic rock and prog-rock influences.
								<span class="fireside-host">
									featuring SquiggleConf's own Maddy Montaquila on vocals.
								</span>
							</p>
						</TimelineCopy>
					</div>
				</TimelineEntry>
			</div>
		</section>
		<Registration />
	</DeepSeaSurface>
	<SponsorsAndPartners />
</PageLayout>

<style>
	.timeline-section {
		--timeline-heading-color: var(--colorBlue5);
		--timeline-heading-hover-color: var(--colorBlue5);
		--timeline-copy-color: rgba(4, 25, 48, 0.84);
		--timeline-copy-hover-color: rgba(4, 25, 48, 0.92);
		--timeline-muted-color: rgba(6, 48, 82, 0.76);
		--timeline-muted-hover-color: rgba(6, 48, 82, 0.86);
		--timeline-link-color: var(--colorBlue4);
		--timeline-rail-background: rgba(255, 255, 255, 0.42);
		--timeline-rail-border-color: rgba(6, 48, 82, 0.18);
		--timeline-cap-background: rgba(216, 243, 255, 0.62);
		--timeline-cap-color: var(--colorBlue5);
		--timeline-time-color: var(--colorBlue5);
		--timeline-time-shadow: 0 1px 0 rgba(255, 255, 255, 0.46);
		--timeline-venue-color: rgba(4, 25, 48, 0.9);
		--timeline-venue-at-color: rgba(17, 109, 154, 0.68);
		--timeline-venue-stack-background: rgba(255, 255, 255, 0.48);
		--timeline-venue-stack-border-color: rgba(6, 48, 82, 0.18);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem rgba(4, 25, 48, 0.1);
		--timeline-image-border-color: rgba(4, 25, 48, 0.18);
		--timeline-image-border-width: 2px;
		--timeline-hover-duration: 220ms;
		isolation: isolate;
		padding: 2rem clamp(0.15rem, 0.5vw, 1rem) clamp(3rem, 7vw, 5rem);
		position: relative;
	}

	:global(html.dark) .timeline-section {
		--timeline-heading-color: #eef6ff;
		--timeline-heading-hover-color: white;
		--timeline-copy-color: rgba(233, 244, 255, 0.84);
		--timeline-copy-hover-color: rgba(255, 255, 255, 0.9);
		--timeline-muted-color: rgba(198, 225, 244, 0.82);
		--timeline-muted-hover-color: rgba(255, 255, 255, 0.88);
		--timeline-link-color: #f7fbff;
		--timeline-rail-background: var(--colorBlueBright1);
		--timeline-rail-border-color: var(--colorBlue3);
		--timeline-cap-background: color-mix(
			in srgb,
			var(--colorBlue2) 60%,
			transparent
		);
		--timeline-cap-color: color-mix(
			in srgb,
			var(--colorBackground) 85%,
			transparent
		);
		--timeline-time-color: var(--colorBackground);
		--timeline-time-shadow: 0 1px 0 rgba(255, 255, 255, 0.22);

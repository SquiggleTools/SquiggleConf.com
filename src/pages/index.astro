---
import "@fontsource/shantell-sans";

import { Image } from "astro:assets";

import Hero from "~/components/hero/Hero.astro";
import {
	bigRav,
	dillonMulroy,
	exploreChoices,
	funrun1,
	funrun2,
	harbor,
	harborwalk,
	lunchSpots,
	milkcookies1,
	milkcookies2,
	milkcookies3,
	networking,
	postcardBack,
	postcardFront,
	ryanDahl,
	scottTolinski,
	simonsTheater,
	talkBlocks,
	thePrimeagen,
	timelineFish,
	timelineMCs,
	urbanwild1,
	urbanwild2,
	urbanwild3,
	urbanwild4,
	urbanwild5,
	urbanwildLogo,
	venues,
	wesBos,
} from "~/components/home/data";
import Collage from "~/components/home/Collage.astro";
import ExploreChoices from "~/components/home/ExploreChoices.astro";
import HomeHeroLockup from "~/components/home/HomeHeroLockup.astro";
import HomePreviewBanner from "~/components/home/HomePreviewBanner.astro";
import HostList from "~/components/home/HostList.astro";
import LunchCarousel from "~/components/home/LunchCarousel.astro";
import TalkList from "~/components/home/TalkList.astro";
import TerminalShopButton from "~/components/home/TerminalShopButton.astro";
import TimelineCopy from "~/components/home/TimelineCopy.astro";
import Registration from "~/components/Registration.astro";
import DeepSeaSurface from "~/components/DeepSeaSurface.astro";
import SponsorsAndPartners from "~/components/SponsorsAndPartners.astro";
import TimelineTalksTurtle from "~/components/TimelineTalksTurtle.astro";
import PageLayout from "~/layouts/PageLayout.astro";
---

<PageLayout
	description="A Boston conference for excellent web dev tooling."
	hideHeaderLinks={["about", "shop"]}
	hideHeaderLogo
>
	<HomePreviewBanner slot="pageTop" />
	<Hero tall>
		<HomeHeroLockup />
	</Hero>
	<DeepSeaSurface>
		<section class="timeline-section" aria-label="Timeline preview">
			<div class="timeline-fish-layer" aria-hidden="true">
				<div class="timeline-fish-shell timeline-fish-shell-1">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish[0].src}
							width={timelineFish[0].width}
							height={timelineFish[0].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-2">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish[1].src}
							width={timelineFish[1].width}
							height={timelineFish[1].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-3">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish[2].src}
							width={timelineFish[2].width}
							height={timelineFish[2].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-4">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish[3].src}
							width={timelineFish[3].width}
							height={timelineFish[3].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-5">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish[4].src}
							width={timelineFish[4].width}
							height={timelineFish[4].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
			<h2 class="postcard-heading">the devtools conference</h2>
			<p class="postcard-intro">
				SquiggleConf is a conference focused on software developer tools: AI
				tools, linters, code editors, performance and security tools, debuggers,
				and more. We mix heavy talks with fun events.<br />Think of it like your
				devtools fieldtrip.
			</p>
			<div
				class="postcard-gallery"
				style="--postcard-back-width: 21rem; --postcard-front-scale: 1.5;"
			>
				<div class="postcard-stack postcard-stack-flip">
					<div class="postcard-flip-scene">
						<div class="postcard-flip-inner">
							<span class="postcard-face postcard-face-front">
								<span class="postcard postcard-front">
									<Image
										alt="Front of the SquiggleConf postcard"
										src={postcardFront}
										loading="eager"
									/>
								</span>
							</span>
							<span class="postcard-face postcard-face-back">
								<span class="postcard postcard-back">
									<Image
										alt="Back of the SquiggleConf postcard"
										src={postcardBack}
										loading="eager"
									/>
									<span class="postcard-back-message">
										<span class="postcard-back-greeting">Hi Mom,</span>
										<span>
											SquiggleConf was so much fun this year! <br />I learned
											all about abstract syntax trees, AI agent harnesses, and
											met the devs leading the industry!
										</span>
									</span>
									<span class="postcard-back-address">
										<span>New England Aquarium</span>
										<span>Simons Theater</span>
										<span>1 Central Wharf</span>
										<span>Boston, MA 02110</span>
									</span>
								</span>
								<span class="postcard-note postcard-note-back"
									>* yes, you'll really get this postcard</span
								>
							</span>
						</div>
					</div>
				</div>
			</div>
			<div class="timeline-grid">
				<div class="timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Thursday</p>
					<p>May 6th</p>
				</div>
				<div class="timeline-grid-intro">
					<h3>SquiggleConf 2027</h3>
					<p>Boston, Massachusetts</p>
				</div>

				<div class="timeline-venue timeline-venue-last">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.nedDevines.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Ned</p>
							<p>Devine's</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-bottom">
					<p class="timeline-time">6pm</p>
				</div>

				<div class="timeline-content" data-timeline-entry="launch">
					<div class="timeline-heading-line">
						<h2>Launch Party!</h2>
						<p class="timeline-subtitle timeline-inline-time">6-9pm</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.nedDevines.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							Ned Devine's
						</a>
					</div>
					<Collage
						ariaLabel="Launch party collage"
						class="launchparty-collage"
						layout="trio"
						photos={[
							{ alt: "People networking at SquiggleConf", src: networking },
							{ alt: "Boston harbor near the venue", src: harbor },
							{
								alt: "Speakers gathered together at the event",
								src: harborwalk,
							},
						]}
					/>
					<TimelineCopy>
						<p>
							Kick off the weekend with snacks, drinks, and an easy room full of
							tool-loving people. It is the place to settle in, say hi, and
							start the conference with a little momentum.
						</p>
					</TimelineCopy>
				</div>

				<div class="timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Friday</p>
					<p>May 7th</p>
				</div>
				<div class="timeline-cell-empty" aria-hidden="true"></div>

				<div class="timeline-venue timeline-cell-span-seven">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>New</p>
							<p>England</p>
							<p>Aquarium</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">7am</p>
				</div>

				<div
					class="timeline-content timeline-content-funrun"
					data-timeline-entry="fun-run"
				>
					<div class="timeline-title-row">
						<div class="timeline-title-copy">
							<div class="timeline-heading-line">
								<h2>Fun Run</h2>
								<p class="timeline-subtitle timeline-inline-time">7-7:30am</p>
							</div>
							<div class="timeline-mobile-meta">
								<a
									class="timeline-mobile-location timeline-location-link"
									href={venues.aquarium.mapUrl}
									rel="noreferrer"
									target="_blank"
								>
									New England Aquarium
								</a>
							</div>
						</div>
						<Collage
							ariaLabel="Fun run collage"
							class="funrun-collage funrun-collage-desktop"
							layout="duo"
							photos={[
								{
									alt: "Fun Run route by the waterfront",
									objectPosition: "10% 10%",
									src: funrun1,
								},
								{
									alt: "Runners gathering before the Fun Run",
									objectPosition: "38% 50%",
									src: funrun2,
								},
							]}
						/>
					</div>
					<div class="funrun-body">
						<TimelineCopy>
							<p>
								Optional for some, best way to start the day for others! It's an
								casual yet eventful 5k through the Boston shoreline.
							</p>
						</TimelineCopy>
						<Collage
							class="funrun-collage funrun-collage-mobile"
							decorative
							layout="duo"
							photos={[
								{
									alt: "",
									decorative: true,
									objectPosition: "10% 10%",
									src: funrun1,
								},
								{
									alt: "",
									decorative: true,
									objectPosition: "38% 50%",
									src: funrun2,
								},
							]}
						/>
					</div>
				</div>

				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">8am</p>
				</div>

				<div class="timeline-content" data-timeline-entry="check-in">
					<div class="timeline-heading-line">
						<h2>Check In</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							8am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<TimelineCopy>
						<p>
							Pick up your badge, settle in, and grab a terminal.shop coffee
							before the first sessions start.
						</p>
						<TerminalShopButton />
					</TimelineCopy>
				</div>

				<div
					class="timeline-content timeline-content-mcs"
					data-timeline-entry="simons-imax-theater"
				>
					<div class="timeline-heading-line">
						<h2>Talks in an IMAX Theater</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							8am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="event-body">
						<div
							class="event-hero-image event-hero-image-wide event-hero-image-pinned"
						>
							<Image
								alt="Presenter on stage inside the Simons IMAX Theater"
								src={simonsTheater}
								loading="eager"
							/>
						</div>
						<TimelineCopy>
							<p>
								The talks take place in an IMAX theater. That means super
								comfortable seats, great visibility, and a 60ft high screen.
							</p>
							<p>Also, a penguin exhibit next door.</p>
						</TimelineCopy>
					</div>
				</div>

				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">9am</p>
				</div>

				<div
					class="timeline-content timeline-content-mcs"
					data-timeline-entry="mcs"
				>
					<div class="timeline-heading-line">
						<h2>Meet your MCs!</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							9am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<HostList ariaLabel="Conference MCs" hosts={timelineMCs} />
				</div>

				<div
					class="timeline-content timeline-content-talks"
					data-timeline-entry="talks-morning"
				>
					<div class="timeline-heading-line">
						<h2>Talks</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							9am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<TalkList ariaLabel="Speaker talks" talks={talkBlocks.morning} />
				</div>

				<div class="timeline-rail">
					<p class="timeline-time">10:30am</p>
				</div>

				<div
					class="timeline-content timeline-content-break"
					data-timeline-entry="cookies-break"
				>
					<div class="timeline-heading-line">
						<h2>Milk &amp; Cookies Break</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							10:30am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="break-body">
						<Collage
							ariaLabel="Milk and Cookies break collage"
							class="cookiesbreak-collage"
							layout="trio"
							photos={[
								{ alt: "Milk and cookies spread", src: milkcookies3 },
								{ alt: "Cookies at the break", src: milkcookies1 },
								{
									alt: "Milk and cookies break crowd",
									objectPosition: "10% 0%",
									src: milkcookies2,
								},
							]}
						/>
						<TimelineCopy class="break-copy">
							<p>A SguiggleConf classic!</p><p>
								Catch up with people you just met, and trade notes on the
								morning’s talks.
							</p>
						</TimelineCopy>
					</div>
				</div>

				<div class="timeline-rail">
					<p class="timeline-time">11am</p>
				</div>

				<div
					class="timeline-content timeline-content-talks"
					data-timeline-entry="talks-late"
				>
					<div class="timeline-heading-line">
						<h2>Talks</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							11am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<TalkList
						ariaLabel="Late morning talks"
						short
						talks={talkBlocks.lateMorning}
					/>
				</div>

				<div class="timeline-venue">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.quincyMarket.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Quincy</p>
							<p>Market</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">12pm</p>
				</div>

				<div
					class="timeline-content timeline-content-lunch"
					data-timeline-entry="lunch"
				>
					<div class="timeline-heading-line">
						<h2>Lunch</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							12pm
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.quincyMarket.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							Quincy Market
						</a>
					</div>
					<div class="lunch-body">
						<LunchCarousel spots={lunchSpots} />
						<TimelineCopy class="lunch-copy">
							<p>
								Head out together into
								<a href="https://faneuilhallmarketplace.com/dining">
									Faneuil Hall Marketplace</a
								> at Quincy Market, keep conversations moving, and treat the middle
								of the day like your devtools field trip lunch break.
							</p>
							<ul class="lunch-links">
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/boston-and-maine-fish-company"
									>
										Boston &amp; Maine Fish Company
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/regina-pizzeria"
									>
										Regina Pizzeria
									</a>
								</li>
								<li>
									<a href="https://faneuilhallmarketplace.com/go/wicked-lobsta">
										Wicked Lobsta
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/the-berry-twist"
									>
										The Berry Twist
									</a>
								</li>
								<li>
									<a
										href="https://faneuilhallmarketplace.com/go/green-organic-bowl"
									>
										Green Organic Bowl
									</a>
								</li>
							</ul>
							<p>
								Fast options, easy wandering, and enough variety that everyone
								can grab something good before heading back for the afternoon
								block.
							</p>
						</TimelineCopy>
					</div>
				</div>

				<div
					class="timeline-venue timeline-venue-aquarium-afternoon timeline-cell-span-two"
				>
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>New</p>
							<p>England</p>
							<p>Aquarium</p>
						</a>
						<div
							class="timeline-venue-decoration timeline-venue-decoration-turtle"
							aria-hidden="true"
						>
							<TimelineTalksTurtle />
						</div>
					</div>
				</div>
				<div class="timeline-rail">
					<p class="timeline-time">2pm</p>
				</div>

				<div
					class="timeline-content timeline-content-talks timeline-content-talks-afternoon"
					data-timeline-entry="talks-afternoon"
				>
					<div class="timeline-heading-line">
						<h2>Talks</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							2pm
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.aquarium.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<TalkList ariaLabel="Afternoon talks" talks={talkBlocks.afternoon} />
				</div>

				<div class="timeline-rail">
					<p class="timeline-time">3:30pm</p>
				</div>

				<div
					class="timeline-content timeline-content-explore"
					data-timeline-entry="explore-boston"
				>
					<div class="timeline-heading-line">
						<h2>Explore Boston</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							3:30pm
						</p>
					</div>
					<p class="timeline-subtitle">choose your own adventure</p>
					<div class="timeline-mobile-meta">
						<p class="timeline-mobile-location">Boston</p>
					</div>
					<ExploreChoices choices={exploreChoices} />
				</div>

				<div class="timeline-venue timeline-cell-span-five timeline-venue-last">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={venues.urbanWild.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							<p>Urban</p>
							<p>Wild</p>
							<p>Boston</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-cell-span-two">
					<p class="timeline-time">6pm</p>
				</div>

				<div
					class="timeline-content timeline-content-syntax"
					data-timeline-entry="arrive-urban-wild"
				>
					<div class="timeline-heading-line">
						<h2>Arrive at Urban Wild</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							6pm
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={venues.urbanWild.mapUrl}
							rel="noreferrer"
							target="_blank"
						>
							Urban Wild Boston
						</a>
					</div>
					<div class="event-body">
						<div

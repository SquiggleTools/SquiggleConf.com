---
import "@fontsource/shantell-sans";

import bigRav from "~/assets/2027/bigrav.webp";
import harborwalk from "~/assets/2027/boston-harborwalk.webp";
import funrun1 from "~/assets/2027/fun-run-1.webp";
import funrun2 from "~/assets/2027/fun-run-2.webp";
import milkcookies1 from "~/assets/2027/milkcookies-1.webp";
import milkcookies2 from "~/assets/2027/milkcookies-2.webp";
import milkcookies3 from "~/assets/2027/milkcookies-3.webp";
import placeholder9 from "~/assets/2027/placeholder-9.webp";
import simonsTheater from "~/assets/2027/simons-theater.webp";
import urbanwild1 from "~/assets/2027/urbanwild-1.webp";
import urbanwild2 from "~/assets/2027/urbanwild-2.webp";
import urbanwild3 from "~/assets/2027/urbanwild-3.webp";
import urbanwild4 from "~/assets/2027/urbanwild-4.webp";
import urbanwild5 from "~/assets/2027/urbanwild-5.webp";
import urbanwildLogo from "~/assets/2027/urbanwild-logo.webp";
import dillonMulroy from "~/assets/avatars/dillon-mulroy.webp";
import scottTolinski from "~/assets/avatars/scott-tolinski.webp";
import thePrimeagen from "~/assets/avatars/theprimeagen.webp";
import wesBos from "~/assets/avatars/wes-bos.webp";
import syntax from "~/assets/logos/syntax.svg";
import networking from "~/assets/stills/attendees-networking.png";
import harbor from "~/assets/stills/boston-harbor.png";
import Hero from "~/components/hero/Hero.astro";
import {
	exploreChoices,
	lunchSpots,
	talkBlocks,
	timelineMCs,
} from "~/components/home/data";
import Collage from "~/components/home/Collage.astro";
import ExploreChoiceCard from "~/components/home/ExploreChoiceCard.astro";
import HomeHeroLockup from "~/components/home/HomeHeroLockup.astro";
import LunchCarousel from "~/components/home/LunchCarousel.astro";
import PersonCard from "~/components/home/PersonCard.astro";
import PostcardGallery from "~/components/home/PostcardGallery.astro";
import TerminalShopButton from "~/components/home/TerminalShopButton.astro";
import TimelineCopy from "~/components/home/timeline/TimelineCopy.astro";
import TimelineLink from "~/components/home/timeline/TimelineLink.astro";
import TimelineLinkList from "~/components/home/timeline/TimelineLinkList.astro";
import TimelineDayCap from "~/components/home/timeline/TimelineDayCap.astro";
import TimelineEntry from "~/components/home/timeline/TimelineEntry.astro";
import TimelineFishLayer from "~/components/home/timeline/TimelineFishLayer.astro";
import TimelineGrid from "~/components/home/timeline/TimelineGrid.astro";
import TimelineHeading from "~/components/home/timeline/TimelineHeading.astro";
import TimelineImage from "~/components/home/timeline/TimelineImage.astro";
import TimelineList from "~/components/home/timeline/TimelineList.astro";
import TimelineMedia from "~/components/home/timeline/TimelineMedia.astro";
import TimelineRail from "~/components/home/timeline/TimelineRail.astro";
import TimelineSection from "~/components/home/timeline/TimelineSection.astro";
import TimelineTalksTurtle from "~/components/home/timeline/TimelineTalksTurtle.astro";
import TimelineVenue from "~/components/home/timeline/TimelineVenue.astro";
import DeepSeaSurface from "~/components/DeepSeaSurface.astro";
import { eventDate, eventLocation } from "~/data/event";
import Registration from "~/components/Registration.astro";
import SponsorsAndPartners from "~/components/SponsorsAndPartners.astro";
import PageLayout from "~/layouts/PageLayout.astro";
---

<PageLayout description="SquiggleConf: The devtools conference." hideHeaderLogo>
	<Hero tall>
		<HomeHeroLockup />
	</Hero>
	<DeepSeaSurface>
		<TimelineSection>
			<TimelineFishLayer swimUntil="talks-morning" />
			<div class="top-side-by-side">
				<div class="top-side-left">
					<TimelineHeading class="top-heading" level="h2">
						the devtools conference
					</TimelineHeading>
					<p class="top-intro">
						SquiggleConf is a conference focused on software developer tools: AI
						tools, linters, code editors, performance and security tools,
						debuggers, and more. We mix heavy talks with fun events.<br />Think
						of it like your devtools fieldtrip.
					</p>
				</div>
				<PostcardGallery />
			</div>
			<TimelineGrid>
				<TimelineDayCap date="May 6th" day="Thursday">
					<div class="timeline-grid-intro">
						<TimelineHeading class="timeline-grid-intro-heading" level="h3">
							SquiggleConf 2027
						</TimelineHeading>
						<p>{eventLocation}</p>
					</div>
				</TimelineDayCap>

				<TimelineVenue last venue="nedDevines" />
				<TimelineRail bottom time="6pm" />

				<TimelineEntry
					entryId="launch-party"
					heading="Launch Party!"
					venue="nedDevines"
					time="6-9pm"
					timeMode="range"
				>
					<Collage
						ariaLabel="Launch party collage"
						class="launch-party-collage"
						layout="trio"
						photos={[
							{ alt: "Boston harbor near the venue", src: harbor },
							{ alt: "People networking at SquiggleConf", src: networking },
							{
								alt: "Speakers gathered together at the event",
								src: harborwalk,
							},
						]}
					/>
					<TimelineCopy>
						<p>
							Kick off the weekend with snacks, drinks, and an easy room full of
							tool-loving people. It is the place to settle in, say hi, and
							start the conference with a little momentum.
						</p>
					</TimelineCopy>
				</TimelineEntry>

				<TimelineDayCap date={eventDate} day="Friday" />

				<TimelineVenue span={7} venue="aquarium" />
				<TimelineRail time="7am" />

				<TimelineEntry
					entryId="fun-run"
					heading="Fun Run"
					venue="aquarium"
					time="7-7:30am"
					timeMode="range"
					variant="fun-run"
				>
					<div class="fun-run-body">
						<TimelineCopy class="fun-run-copy">
							<p>
								Optional for some, best way to start the day for others! This
								SquiggleConf tradition is a casual yet eventful 5k through the
								Boston shoreline.
							</p>
						</TimelineCopy>
						<div class="fun-run-collage">
							<Collage
								ariaLabel="Fun run collage"
								layout="duo"
								photos={[
									{
										alt: "Fun Run route by the waterfront",
										objectPosition: "10% 10%",
										src: funrun1,
									},
									{
										alt: "Runners gathering before the Fun Run",
										objectPosition: "38% 50%",
										src: funrun2,
									},
								]}
							/>
						</div>
					</div>
				</TimelineEntry>

				<TimelineRail span={2} time="8am" />

				<TimelineEntry
					entryId="check-in"
					heading="Check In"
					venue="aquarium"
					time="8am"
				>
					<TimelineCopy>
						<p>
							Pick up your badge, settle in, and grab a terminal.shop coffee
							before the first sessions start.
						</p>
						<TerminalShopButton />
					</TimelineCopy>
				</TimelineEntry>

				<TimelineEntry
					entryId="simons-imax-theater"
					heading="Talks in an IMAX Theater"
					venue="aquarium"
					time="8am"
				>
					<TimelineMedia>
						<TimelineImage
							alt="Presenter on stage inside the Simons IMAX Theater"
							class="event-image-wide"
							effect="zoom"
							loading="eager"
							src={simonsTheater}
							zoomOrigin="top right"
						/>
						<TimelineCopy>
							<p>
								The talks take place in an IMAX theater. That means super
								comfortable seats, great visibility, and a 60ft high screen.
							</p>
							<p>Also, a penguin exhibit next door.</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineRail span={2} time="9am" />

				<TimelineEntry
					entryId="meet-your-mcs"
					heading="Meet your MCs!"
					venue="aquarium"
					time="9am"
				>
					<TimelineList aria-label="Conference MCs" columns={2}>
						{timelineMCs.map((host) => <PersonCard person={host} />)}
					</TimelineList>
				</TimelineEntry>

				<TimelineEntry
					entryId="talks-morning"
					heading="Talks"
					venue="aquarium"
					time="9am"
				>
					<TimelineList aria-label="Speaker talks">
						{talkBlocks.morning.map((talk) => <PersonCard person={talk} />)}
					</TimelineList>
				</TimelineEntry>

				<TimelineRail time="10:30am" />

				<TimelineEntry
					entryId="cookies-break"
					heading="Milk & Cookies Break"
					venue="aquarium"
					time="10:30am"
					variant="break"
				>
					<TimelineMedia>
						<Collage
							ariaLabel="Milk and Cookies break collage"
							layout="trio-compact"
							photos={[
								{ alt: "Milk and cookies spread", src: milkcookies3 },
								{ alt: "Cookies at the break", src: milkcookies1 },
								{
									alt: "Milk and cookies break crowd",
									objectPosition: "10% 0%",
									src: milkcookies2,
								},
							]}
						/>
						<TimelineCopy class="break-copy">
							<p>A SquiggleConf classic!</p><p>
								Catch up with people you just met, and trade notes on the
								morning’s talks.
							</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineRail time="11am" />

				<TimelineEntry
					entryId="talks-late"
					heading="Talks"
					venue="aquarium"
					time="11am"
				>
					<TimelineList aria-label="Late morning talks">
						{talkBlocks.lateMorning.map((talk) => <PersonCard person={talk} />)}
					</TimelineList>
				</TimelineEntry>

				<TimelineVenue venue="quincyMarket" />
				<TimelineRail time="12pm" />

				<TimelineEntry
					entryId="lunch"
					heading="Lunch"
					venue="quincyMarket"
					time="12pm"
				>
					<TimelineMedia mediaWidth="10rem">
						<LunchCarousel spots={lunchSpots} />
						<TimelineCopy class="lunch-copy">
							<p>
								Head out together into
								<TimelineLink href="https://faneuilhallmarketplace.com/dining">
									Faneuil Hall Marketplace</TimelineLink
								> at Quincy Market, keep conversations moving, and treat the middle
								of the day like your devtools field trip lunch break.
							</p>
							<TimelineLinkList
								links={lunchSpots.map(({ name, url }) => ({
									href: url,
									text: name,
								}))}
							/>
							<p>
								Fast options, easy wandering, and enough variety that everyone
								can grab something good before heading back for the afternoon
								block.
							</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineVenue span={2} venue="aquarium">
					<div
						class="timeline-venue-decoration timeline-venue-decoration-turtle"
						aria-hidden="true"
					>
						<TimelineTalksTurtle />
					</div>
				</TimelineVenue>
				<TimelineRail time="2pm" />

				<TimelineEntry
					entryId="talks-afternoon"
					heading="Talks"
					venue="aquarium"
					time="2pm"
				>
					<TimelineList aria-label="Afternoon talks">
						{talkBlocks.afternoon.map((talk) => <PersonCard person={talk} />)}
					</TimelineList>
				</TimelineEntry>

				<TimelineRail time="3:30pm" />

				<TimelineEntry
					entryId="explore-boston"
					heading="Explore Boston"
					location="Boston"
					subtitle="choose your own adventure"
					time="3:30pm"
				>
					<TimelineList aria-label="Explore Boston options">
						{
							exploreChoices.map((choice) => (
								<ExploreChoiceCard choice={choice} />
							))
						}
					</TimelineList>
				</TimelineEntry>

				<TimelineVenue last span={5} venue="urbanWild" />
				<TimelineRail span={2} time="6pm" />

				<TimelineEntry
					entryId="arrive-urban-wild"
					heading="Arrive at Urban Wild"
					venue="urbanWild"
					time="6pm"
				>
					<TimelineMedia>
						<TimelineImage
							alt="Urban Wild Boston logo"
							class="event-image-wide"
							effect="zoom"
							loading="eager"
							src={urbanwildLogo}
							zoomOrigin="top right"
						/>
						<TimelineCopy>
							<p>
								The rest of the night takes place at Urban Wild Boston. Also the
								last clue of the Scavenger Hunt may or may not be here.......
							</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineEntry
					entryId="live-podcast-recording"
					heading="Live Podcast Recording"
					venue="urbanWild"
					time="6pm"
				>
					<TimelineMedia>
						<Collage
							ariaLabel="Podcast recording live guests"
							layout="avatar-pair"
							photos={[
								{ alt: "Syntax logo", src: syntax },
								{ alt: "ThePrimeagen portrait", src: thePrimeagen },
							]}
							shape="avatar"
						/>
						<TimelineCopy heading="Developer Life and Work in 2027">
							<p>
								Join Syntax.fm and ThePrimeagen in a live podcast recording
								discussing the ins and outs of how to succeed and be happy in
								today's tech industry.
							</p>
							<div class="podcast-hosts">
								<TimelineImage
									alt="Wes Bos portrait"
									class="podcast-host-image"
									radius="var(--radiusPill)"
									src={wesBos}
								/>
								<TimelineImage
									alt="Scott Tolinski portrait"
									class="podcast-host-image"
									radius="var(--radiusPill)"
									src={scottTolinski}
								/>
								<p class="fireside-host">
									Hosted by Wes Bos and Scott Tolinski
								</p>
							</div>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineRail time="7pm" />

				<TimelineEntry
					entryId="fireside-chat"
					heading="Fireside Chat"
					venue="urbanWild"
					time="7pm"
				>
					<TimelineMedia>
						<Collage
							ariaLabel="Fireside chat guests"
							layout="avatar-duo"
							photos={[
								{
									alt: "Placeholder portrait",
									placeholder: true,
									src: placeholder9,
								},
								{ alt: "Dillon Mulroy portrait", src: dillonMulroy },
							]}
							shape="avatar"
						/>
						<TimelineCopy class="fireside-copy" heading="Topic To Be Announced">
							<p>
								Join us for a fireside chat with a notable JavaScript-y friend
								about a pressing issue in the technical space.
							</p>
							<p class="fireside-host">hosted by Dillon Mulroy</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>

				<TimelineRail bottom span={2} time="7:30pm" />

				<TimelineEntry
					entryId="after-party"
					heading="After Party"
					venue="urbanWild"
					time="7:30-9pm"
					timeMode="range"
				>
					<Collage
						ariaLabel="After party collage"
						class="afterparty-collage"
						layout="feature-five"
						photos={[
							{ alt: "", decorative: true, src: urbanwild1 },
							{ alt: "", decorative: true, src: urbanwild2 },
							{ alt: "", decorative: true, src: urbanwild3 },
							{ alt: "", decorative: true, src: urbanwild4 },
							{ alt: "", decorative: true, src: urbanwild5 },
						]}
					/>
					<TimelineCopy>
						<p>
							After the podcast and fireside chat, we'll switch into party mode
							at Urban Wild: video arcade bowling, lots of light bites and
							refreshments, and most of all - a chance to hang with everyone you
							just met at the conference!
						</p>
					</TimelineCopy>
				</TimelineEntry>

				<TimelineEntry
					entryId="big-rav"
					heading="Big Rav"
					venue="urbanWild"
					time="9pm"
				>
					<TimelineMedia>
						<TimelineImage
							alt="Big Rav band portrait"
							class="event-image-circle"
							effect="grow"
							loading="eager"
							radius="var(--radiusPill)"
							src={bigRav}
						/>
						<TimelineCopy>
							<p>
								<TimelineLink href="https://bigrav.band"
									><strong>Big Rav</strong></TimelineLink
								> is a Boston-based alternative, indie, and punk rock band that combines
								pop-punk vocals with classic rock and prog-rock influences.
								<span class="fireside-host">
									featuring SquiggleConf's own Maddy Montaquila on vocals.
								</span>
							</p>
						</TimelineCopy>
					</TimelineMedia>
				</TimelineEntry>
			</TimelineGrid>
		</TimelineSection>
		<Registration />
	</DeepSeaSurface>
	<SponsorsAndPartners />
</PageLayout>

<style>
	.top-heading {
		font-size: var(--fontSizeDisplay);
		font-style: italic;
		line-height: 1;
		padding-top: 1rem;
		position: relative;
		z-index: 1;
	}

	.top-intro {
		color: var(--colorCopy);
		font-size: clamp(1rem, 1.35vw, 1.12rem);
		line-height: 1.6;
		padding: 0 0 0 2rem;
		margin: 1rem auto 0;
		max-width: 39rem;
		text-wrap: pretty;
	}

	.top-side-by-side {
		max-width: var(--sizeContentAreaNormal);
		margin: auto;
		gap: 5rem;
		align-items: center;
		display: flex;
		flex-direction: row;
		text-align: right;
	}

	.top-side-left {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		width: 100%;
		margin-bottom: 2.5rem;
	}

	.timeline-grid-intro {
		align-content: center;
		display: grid;
		gap: 0.25rem;
		margin: 0;
		min-height: 0;
		margin-top: 1rem;
		padding-left: 2rem;
	}

	.timeline-grid-intro p {
		margin: 0;
	}

	.timeline-grid-intro-heading {
		font-size: clamp(1.55rem, 2.7vw, 2.1rem);
		line-height: 0.98;
	}

	.timeline-grid-intro p {
		color: var(--colorMuted);
		font-size: var(--fontSizeCopySmall);
		line-height: 1.2;
	}

	.timeline-venue-decoration {
		pointer-events: none;
		position: absolute;
		z-index: 1;
	}

	.timeline-venue-decoration-turtle {
		top: 6rem;
		right: 0;
		transform: rotate(4deg) scale(0.94);
		transform-origin: bottom right;
	}

	.break-copy {
		align-content: start;
	}

	.lunch-copy {
		align-content: start;
		padding-top: 0.2rem;
	}

	.launch-party-collage {
		margin-bottom: 1rem;
	}

	.afterparty-collage {
		margin: 1.9rem 0 1.1rem;
	}

	.fun-run-collage {
		left: 17rem;
		position: absolute;
		top: 1rem;
	}

	.fun-run-body > .fun-run-copy {
		max-width: 50%;
		position: relative;
	}

	.fireside-copy {
		align-content: center;
		align-self: center;
	}

	.event-image-wide {
		height: 8rem;
		width: 14rem;
	}

	.event-image-circle {
		height: 8rem;
		width: 8rem;
	}

	.fireside-host {
		font-style: italic;
	}

	.podcast-hosts {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}

	.podcast-host-image {
		height: 2.75rem;
		width: 2.75rem;
	}

	.podcast-hosts .fireside-host {
		margin: 0 0 0 0.5rem;
	}

	@media (width < 900px) {
		.top-side-by-side {
			flex-direction: column;
			gap: 0;
		}

		.top-heading {
			margin: auto;
		}

		.top-side-left {
			margin-bottom: 0;
			text-align: center;
		}

		.timeline-grid-intro {
			margin-top: 0;
			order: -1;
			padding: 0 0.15rem 0.2rem;
		}

		.lunch-copy {
			padding-top: 0;
		}

		.fun-run-body {
			align-items: start;
			column-gap: 0.9rem;
			display: grid;
			grid-template-columns: minmax(0, 1fr) 8rem;
		}

		.fun-run-body > .fun-run-copy {
			margin-top: 0.15rem;
			max-width: none;
		}

		.fun-run-collage {
			justify-self: end;
			left: auto;
			padding-top: 4rem;
			position: relative;
			top: 0;
			zoom: 0.75;
		}

		.timeline-venue-decoration-turtle {
			transform: scale(0.82) rotate(4deg);
			transform-origin: bottom right;
		}
	}
</style>

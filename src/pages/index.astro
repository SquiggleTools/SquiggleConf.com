		--timeline-cap-background: rgba(3, 51, 98, 0.48);
		--timeline-cap-color: #f7fbff;
		--timeline-time-color: #eef6ff;
		--timeline-time-shadow: 0 1px 0 rgba(4, 25, 48, 0.16);
		--timeline-venue-color: rgba(238, 246, 255, 0.9);
		--timeline-venue-at-color: rgba(238, 246, 255, 0.72);
		--timeline-venue-stack-background: rgba(255, 255, 255, 0.04);
		--timeline-venue-stack-border-color: rgba(232, 245, 255, 0.26);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem rgba(4, 25, 48, 0.12);
		--timeline-image-border-color: rgba(4, 25, 48, 0.18);
		--timeline-image-border-width: 2px;
		--timeline-hover-duration: 220ms;
		isolation: isolate;
		padding: 2rem 1rem clamp(3rem, 7vw, 5rem);
		position: relative;
	}

	:global(html.dark) .timeline-section {
		--timeline-rail-background: var(--colorBlueBright1);
		--timeline-rail-border-color: var(--colorBlue3);
		--timeline-cap-background: color-mix(
			in srgb,
			var(--colorBlue2) 60%,
			transparent
		);
		--timeline-cap-color: color-mix(
			in srgb,
			var(--colorBackground) 85%,
			transparent
		);
		--timeline-time-color: var(--colorBackground);
		--timeline-time-shadow: 0 1px 0 rgba(255, 255, 255, 0.22);
		--timeline-venue-color: var(--timeline-heading-color);
		--timeline-venue-at-color: rgba(125, 207, 226, 0.7);
		--timeline-venue-stack-background: rgba(5, 23, 43, 0.72);
		--timeline-venue-stack-border-color: rgba(125, 207, 226, 0.22);
		--timeline-venue-stack-shadow: 0 0.65rem 1.2rem rgba(4, 25, 48, 0.18);
	}

	.timeline-section::before {
		content: "";
		inset: 0;
		opacity: 1;
		pointer-events: none;
		position: absolute;
		transition: opacity var(--timeline-hover-duration) ease;
		z-index: 0;
	}

	.timeline-heading {
		display: grid;
		gap: 1.2rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		justify-items: center;
		margin: 0 auto;
		max-width: min(100%, 42rem);
		padding: 0.2rem 0;
		padding-top: clamp(1.5rem, 4vw, 3rem);
		position: relative;
		text-align: center;
		z-index: 1;
	}

	.timeline-section-heading {
		color: #eef6ff;
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.8rem, 4vw, 3.25rem);
		font-weight: var(--fontWeightSemibold);
		letter-spacing: 0.01em;
		line-height: 0.95;
		margin: 0 auto;
		max-width: fit-content;
		position: relative;
		text-align: center;
		text-wrap: balance;
		z-index: 1;
	}

	.timeline-section-heading-postcard {
		margin-bottom: 0.9rem;
		margin-top: clamp(0.3rem, 1vw, 0.75rem);
	}

	.timeline-section-heading-grid {
		margin-bottom: 1.35rem;
		margin-top: clamp(1.75rem, 4vw, 2.75rem);
	}

	.postcard {
		aspect-ratio: 6 / 4;
		border-radius: 0.45rem;
		box-shadow:
			0 0.08rem 0 rgba(255, 255, 255, 0.5),
			0 0.35rem 0.75rem rgba(2, 14, 31, 0.14),
			0 1.35rem 2.6rem rgba(2, 14, 31, 0.24);
		display: block;
		overflow: hidden;
		position: relative;
		transition:
			box-shadow var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease;
		width: 100%;
	}

	.postcard :global(img) {
		display: block;
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.postcard-gallery {
		display: flex;
		flex-direction: column;
		gap: 0;
		justify-content: flex-start;
		align-items: center;
		margin: 0 auto 1.15rem;
		width: 100%;
	}

	.postcard-heading {
		color: #eef6ff;
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.8rem, 2.8vw, 2.45rem);
		font-style: italic;
		font-weight: 700;
		line-height: 1;
		padding-top: 1rem;
		margin: 0 auto;
		max-width: fit-content;
		position: relative;
		text-align: center;
		z-index: 1;
	}

	.postcard-intro {
		color: color-mix(in srgb, #eef6ff 88%, white 12%);
		font-size: clamp(1rem, 1.35vw, 1.12rem);
		line-height: 1.6;
		margin: 0.85rem auto 0;
		padding: 0 1rem;
		max-width: 35rem;
		text-align: center;
		text-wrap: pretty;
	}

	.postcard-stack {
		margin: 3em 0 2rem 0;
		display: grid;
		gap: 0.5rem;
		justify-items: center;
		width: min(100%, 100vw - 2rem);
		transition: transform var(--timeline-hover-duration) ease;
	}

	@keyframes postcard-idle-wiggle {
		0%,
		84%,
		100% {
			transform: rotate(-4deg);
		}

		88% {
			transform: rotate(-2.8deg) translateY(-0.04rem);
		}

		92% {
			transform: rotate(-5.1deg) translateY(0.02rem);
		}

		96% {
			transform: rotate(-3.3deg) translateY(-0.03rem);
		}
	}

	.postcard-stack-flip {
		animation: postcard-idle-wiggle 5s ease-in-out infinite;
		padding-bottom: 2.2rem;
		transform: rotate(-4deg);
		width: min(
			100%,
			calc(var(--postcard-back-width, 21rem) * var(--postcard-front-scale, 1.5))
		);
	}

	.postcard-stack-flip:hover,
	.postcard-stack-flip:focus-within {
		animation: none;
	}

	.postcard-flip-scene {
		overflow: visible;
		perspective: 1200px;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
		width: 100%;
	}

	.postcard-stack-flip:hover .postcard-flip-scene,
	.postcard-stack-flip:focus-within .postcard-flip-scene {
		transform: rotate(8deg) translateY(-0.08rem);
	}

	.postcard-flip-inner {
		aspect-ratio: 6 / 4;
		pointer-events: none;
		position: relative;
		transform-style: preserve-3d;
		transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
		width: 100%;
	}

	.postcard-stack-flip:hover .postcard-flip-inner,
	.postcard-stack-flip:focus-within .postcard-flip-inner {
		transform: rotateY(180deg);
	}

	.postcard-stack-flip:hover .postcard,
	.postcard-stack-flip:focus-within .postcard {
		box-shadow:
			0 0.08rem 0 rgba(255, 255, 255, 0.56),
			0 0.45rem 0.95rem rgba(2, 14, 31, 0.16),
			0 1.65rem 3rem rgba(2, 14, 31, 0.28);
	}

	.postcard-face {
		backface-visibility: hidden;
		display: block;
		inset: 0;
		overflow: visible;
		pointer-events: none;
		position: absolute;
		width: 100%;
	}

	.postcard-face-back {
		transform: rotateY(180deg);
	}

	.postcard-face-front,
	.postcard-face-back {
		height: 100%;
	}

	.postcard-face-front .postcard,
	.postcard-face-back .postcard {
		height: 100%;
		pointer-events: none;
		width: 100%;
	}

	.postcard-front {
		background: #f7f2ea;
	}

	.postcard-back {
		background: #fffdf8;
	}

	.postcard-back-message {
		color: #49515f;
		display: grid;
		gap: clamp(0.35rem, 0.8vw, 0.6rem);
		inset: 12% auto auto 7%;
		line-height: 1.5;
		max-width: 40%;
		pointer-events: none;
		position: absolute;
		text-align: left;
		text-wrap: pretty;
	}

	.postcard-back-message span {
		font-family: "Shantell Sans", cursive;
		font-size: 1.2rem;
		font-weight: 400;
	}

	.postcard-back-greeting {
		font-size: clamp(0.8rem, 1.02vw, 1rem);
	}

	.postcard-back-address {
		bottom: 15%;
		color: #49515f;
		display: grid;
		gap: clamp(0.12rem, 0.35vw, 0.2rem);
		left: 55%;
		max-width: 41%;
		pointer-events: none;
		position: absolute;
		text-align: left;
	}

	.postcard-back-address span {
		font-family: "Shantell Sans", cursive;
		font-size: 0.8rem;
		font-weight: 400;
		line-height: 1.7;
	}

	.postcard-note {
		color: rgba(223, 239, 255, 0.78);
		font-size: clamp(0.82rem, 1.15vw, 0.92rem);
		line-height: 1.3;
		margin: 0;
		max-width: min(100%, 20rem);
		padding: 0 0.5rem;
		text-align: center;
		text-wrap: balance;
	}

	.postcard-note-back {
		left: 50%;
		opacity: 0;
		pointer-events: none;
		position: absolute;
		top: calc(100% + 0.55rem);
		transform: translateX(-50%);
		transition: opacity 240ms ease;
		width: min(100%, 20rem);
	}

	.postcard-stack-flip:hover .postcard-note-back,
	.postcard-stack-flip:focus-within .postcard-note-back {
		opacity: 1;
	}

	@keyframes timeline-card-outline-flash {
		0% {
			opacity: 0;
			transform: scale(0.992);
		}

		22% {
			opacity: 0.48;
		}

		68% {
			opacity: 0.22;
		}

		100% {
			opacity: 0;
			transform: scale(1.004);
		}
	}

	@media (max-width: 46rem) {
		.postcard-gallery {
			flex-direction: column;
			align-items: center;
		}

		.postcard-stack-flip {
			animation: postcard-idle-wiggle 5s ease-in-out infinite;
			transform: none;
		}

		.postcard-stack-flip:hover,
		.postcard-stack-flip:focus-within {
			animation: none;
		}

		.postcard-stack-flip:hover .postcard-flip-scene,
		.postcard-stack-flip:focus-within .postcard-flip-scene {
			transform: translateY(-0.08rem);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] {
			animation: none;
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-flip-scene {
			transform: translateY(-0.08rem);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-flip-inner {
			transform: rotateY(180deg);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard {
			box-shadow:
				0 0.08rem 0 rgba(255, 255, 255, 0.56),
				0 0.45rem 0.95rem rgba(2, 14, 31, 0.16),
				0 1.65rem 3rem rgba(2, 14, 31, 0.28);
		}

		.postcard-stack-flip[data-mobile-flipped="true"] .postcard-note-back {
			opacity: 1;
		}
	}

	.timeline-fish-layer {
		inset: clamp(0.65rem, 2vw, 1.65rem) 0 auto;
		pointer-events: none;
		position: absolute;
		z-index: 1;
		top: 50px;
	}

	.timeline-fish-shell {
		top: 10px;
		left: 0;
		opacity: 0;
		filter: drop-shadow(0 0.7rem 1.3rem rgba(6, 17, 33, 0.18));
		pointer-events: none;
		position: absolute;
		transform: translate3d(-3rem, 0, 0);
		transform-origin: center;
		user-select: none;
		will-change: opacity, transform;
	}

	.timeline-fish-body {
		animation: timeline-fish-swim 2480ms cubic-bezier(0.45, 0.05, 0.55, 0.95)
			infinite;
		transform-origin: var(--fish-origin-x, 26%) 50%;
		will-change: transform;
	}

	.timeline-fish-image {
		display: block;
		height: 100%;
		max-width: none;
		width: auto;
	}

	.timeline-fish-shell-1 {
		--fish-base-opacity: 0.96;
		--fish-origin-x: 24%;
		height: clamp(0.42rem, 0.68vw, 0.6rem);
		left: 0.05rem;
		top: 0.03rem;
	}

	.timeline-fish-shell-2 {
		--fish-base-opacity: 0.84;
		--fish-origin-x: 28%;
		height: clamp(0.38rem, 0.6vw, 0.5rem);
		left: 0.05rem;
		top: 0.4rem;
	}

	.timeline-fish-shell-3 {
		--fish-base-opacity: 0.88;
		--fish-origin-x: 25%;
		height: clamp(0.4rem, 0.63vw, 0.53rem);
		left: 0.05rem;
		top: 0.65rem;
	}

	.timeline-fish-shell-4 {
		--fish-base-opacity: 0.78;
		--fish-origin-x: 23%;
		height: clamp(0.5rem, 0.79vw, 0.69rem);
		left: 0.08rem;
		top: 0.19rem;
	}

	.timeline-fish-shell-5 {
		--fish-base-opacity: 0.82;
		--fish-origin-x: 27%;
		height: clamp(0.52rem, 0.8vw, 0.72rem);
		left: 0;
		top: 0.55rem;
	}

	.timeline-fish-shell-2 .timeline-fish-body,
	.timeline-fish-shell-5 .timeline-fish-body {
		animation-delay: -1.1s;
		animation-duration: 2760ms;
		animation-name: timeline-fish-swim-wide;
	}

	.timeline-fish-shell-3 .timeline-fish-body {
		animation-delay: -0.65s;
		animation-duration: 2310ms;
	}

	.timeline-fish-shell-4 .timeline-fish-body {
		animation-delay: -1.45s;
		animation-duration: 2920ms;
		animation-direction: reverse;
	}

	@keyframes timeline-fish-swim {
		0% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}

		18% {
			transform: translate3d(0.2rem, -0.08rem, 0) rotate(1deg) skewY(2deg)
				scaleX(1.035) scaleY(0.98);
		}

		37% {
			transform: translate3d(0, 0, 0) rotate(6deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		62% {
			transform: translate3d(-0.14rem, 0.09rem, 0) rotate(0deg) skewY(-2deg)
				scaleX(1.03) scaleY(0.982);
		}

		82% {
			transform: translate3d(0.14rem, -0.05rem, 0) rotate(-6deg) skewY(1.5deg)
				scaleX(0.99) scaleY(1.02);
		}

		100% {
			transform: rotate(-5deg) skewY(-2deg) scaleX(0.985) scaleY(1.02);
		}
	}

	@keyframes timeline-fish-swim-wide {
		0% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}

		22% {
			transform: translate3d(0.24rem, -0.11rem, 0) rotate(2deg) skewY(3deg)
				scaleX(1.045) scaleY(0.975);
		}

		48% {
			transform: translate3d(0, 0, 0) rotate(8deg) skewY(0deg) scaleX(0.995)
				scaleY(1.01);
		}

		72% {
			transform: translate3d(-0.18rem, 0.12rem, 0) rotate(-1deg) skewY(-2.5deg)
				scaleX(1.04) scaleY(0.975);
		}

		100% {
			transform: rotate(-6deg) skewY(-2.5deg) scaleX(0.98) scaleY(1.025);
		}
	}

	.timeline-grid {
		display: grid;
		grid-template-rows: auto 1fr;
		grid-template-columns: 15% 10% 75%;
		margin: 0 auto;
		max-width: min(100%, var(--sizeContentAreaWide));
		padding-top: 1rem;
		position: relative;
		padding-right: 1rem;
		z-index: 1;
	}

	.timeline-cell-empty {
		min-height: 0;
	}

	.timeline-grid-intro {
		align-content: center;
		display: grid;
		gap: 0.25rem;
		margin: 0;
		min-height: 0;
		margin-top: 1rem;
		padding-left: 2rem;
	}

	.timeline-grid-intro h3,
	.timeline-grid-intro p {
		margin: 0;
	}

	.timeline-grid-intro h3 {
		color: #eef6ff;
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.55rem, 2.7vw, 2.1rem);
		font-weight: 700;
		line-height: 0.98;
	}

	.timeline-grid-intro p {
		color: rgba(223, 239, 255, 0.78);
		font-size: clamp(0.92rem, 1.3vw, 1rem);
		line-height: 1.2;
	}

	.timeline-venue {
		align-items: flex-end;
		color: var(--timeline-venue-color);
		display: flex;
		flex-direction: column;
		font-family: var(--fontFamilyHeading);
		font-size: 1.25rem;
		font-weight: 600;
		justify-content: flex-start;
		line-height: 1.12;
		margin-right: -1px;
		text-align: right;
		transition:
			color var(--timeline-hover-duration) ease,
			opacity var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease;
	}

	.timeline-venue-last {
		margin-bottom: 1rem;
	}

	.timeline-venue p {
		margin: 0;
	}

	.timeline-location-link {
		color: inherit;
		text-decoration: none;
	}

	.timeline-location-link:hover,
	.timeline-location-link:focus-visible {
		text-decoration: underline;
	}

	.timeline-location-link-stack {
		display: grid;
		justify-items: end;
	}

	.timeline-venue-stack {
		display: grid;
		justify-items: end;
		position: relative;
	}

	.timeline-venue .timeline-venue-stack::before {
		color: var(--timeline-venue-at-color);
		content: "@";
		font-family: var(--fontFamilyHeading);
		font-size: 1.5rem;
		font-weight: 700;
		left: -0.15rem;
		line-height: 1;
		opacity: 0.72;
		position: absolute;
		top: -0.5rem;
		transform: rotate(-10deg);
		text-shadow: 0 0.12rem 0.4rem rgba(4, 25, 48, 0.24);
	}

	.timeline-venue {
		align-self: stretch;
	}

	.timeline-venue .timeline-venue-stack {
		backdrop-filter: blur(14px) saturate(140%);
		background: var(--timeline-rail-background);
		border: 1px solid var(--timeline-rail-border-color);
		border-radius: 0.9rem;
		box-shadow: var(--timeline-venue-stack-shadow);
		padding: 0.85rem 0.9rem 0.8rem 1.45rem;
		position: sticky;
		top: clamp(1rem, 4vw, 4.5rem);
		transform-origin: top right;
		z-index: 2;

		border-right: none;
		border-top-right-radius: 0px;
		border-bottom-right-radius: 0px;
	}

	:root[data-timeline-scrolling="true"]
		.timeline-venue
		.timeline-venue-stack {
		animation-play-state: running;
	}

	.timeline-venue-aquarium-afternoon .timeline-venue-stack {
		margin-bottom: var(--timeline-venue-stop-offset, 6rem);
		padding-bottom: 3.75rem;
	}

	.timeline-cell-span-two {
		grid-row: span 2;
	}

	.timeline-cell-span-five {
		grid-row: span 5;
	}

	.timeline-cell-span-seven {
		grid-row: span 7;
	}

	.timeline-rail {
		background: var(--timeline-rail-background);
		border: 1px solid var(--timeline-rail-border-color);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		position: relative;
	}

	.timeline-cap {
		background: var(--timeline-cap-background);
		color: var(--timeline-cap-color);

		border: 1px solid var(--timeline-rail-border-color);
		font-family: var(--fontFamilyHeading);
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.1;
		grid-column: 2;
		padding: 0.8rem 0.55rem;
		text-align: center;
	}

	.timeline-cap p,
	.timeline-time {
		margin: 0;
	}

	.timeline-time {
		color: var(--timeline-time-color);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.3rem, 2vw, 1.6rem);
		font-weight: 700;
		margin-top: 1rem;
		padding-top: 1.15rem;
		text-shadow: var(--timeline-time-shadow);
		text-align: center;
	}

	.timeline-content {
		--timeline-card-pointer-x: 50%;
		--timeline-card-pointer-y: 50%;
		isolation: isolate;
		margin: 1rem 0;
		padding: 1.5rem 0.5rem 1.5rem 2rem;
		position: relative;
		transition: transform var(--timeline-hover-duration) ease;
	}

	.timeline-content > * {
		position: relative;
		z-index: 1;
	}

	.timeline-content::before {
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 1rem;
		box-shadow: none;
		content: "";
		inset: 0.35rem -0.8rem 0.45rem 0.85rem;
		opacity: 0.22;
		pointer-events: none;
		position: absolute;
		transform: scale(0.985);
		z-index: 0;
		transition:
			opacity var(--timeline-hover-duration) ease,
			transform var(--timeline-hover-duration) ease,
			border-color var(--timeline-hover-duration) ease,
			box-shadow var(--timeline-hover-duration) ease;
	}

	.timeline-content::after {
		background: radial-gradient(
			circle 25rem at var(--timeline-card-pointer-x)
				var(--timeline-card-pointer-y),
			color-mix(in srgb, var(--colorBlue2) 92%, white 8%) 0,
			color-mix(in srgb, var(--colorBlue2) 52%, transparent) 28%,
			transparent 60%

---
import { Image } from "astro:assets";

import AboutUs from "~/components/AboutUs.astro";
import ExplainersList from "~/components/explainers/ExplainersList.astro";
import Hero from "~/components/hero/Hero.astro";
import Newsletter from "~/components/Newsletter.astro";
import Registration from "~/components/Registration.astro";
import Logo from "~/components/Logo.astro";
import SponsorsAndPartners from "~/components/SponsorsAndPartners.astro";
import { sessionsBySlug } from "~/data/sessions";
import timelineFish1 from "~/assets/design/timeline-fish-1.svg";
import timelineFish2 from "~/assets/design/timeline-fish-2.svg";
import timelineFish3 from "~/assets/design/timeline-fish-3.svg";
import timelineFish4 from "~/assets/design/timeline-fish-4.svg";
import timelineFish5 from "~/assets/design/timeline-fish-5.svg";
import group from "~/assets/stills/speakers-event-group.png";
import harbor from "~/assets/stills/boston-harbor.png";
import networking from "~/assets/stills/attendees-networking.png";
import signage from "~/assets/stills/signage-outside-venue.png";
import duck1 from "~/assets/2027/duck-1.jpg";
import duck2 from "~/assets/2027/duck-2.jpg";
import duck3 from "~/assets/2027/duck-3.jpg";
import funrun1 from "~/assets/2027/funrun-1.jpg";
import funrun2 from "~/assets/2027/funrun-2.jpg";
import milkcookies1 from "~/assets/2027/milkcookies-1.jpg";
import milkcookies2 from "~/assets/2027/milkcookies-2.png";
import milkcookies3 from "~/assets/2027/milkcookies-3.jpg";
import rest1 from "~/assets/2027/rest-1.jpg";
import dillonMulroy from "~/assets/avatars/dillon-mulroy.webp";
import robbyRussell from "~/assets/avatars/robby-russell.jpg";
import PageLayout from "~/layouts/PageLayout.astro";

const talksSessions = [
	"a-world-class-local-dev-loop-with-aspire",
	"aot-compiling-typescript-to-wasm-and-native",
	"catch-accessibility-issues-at-the-source-with-storybook",
].map((slug) => {
	const session = sessionsBySlug[slug];
	const speaker = session.speakers[0];

	return {
		image: speaker.image,
		name: speaker.name,
		qualification: session.qualification ?? speaker.qualification,
		title: session.title,
	};
});

const lateTalksSessions = [
	"make-tools-that-people-love",
	"rolldown-how-vite-bundles-at-the-speed-of-rust",
].map((slug) => {
	const session = sessionsBySlug[slug];
	const speaker = session.speakers[0];

	return {
		image: speaker.image,
		name: speaker.name,
		qualification: session.qualification ?? speaker.qualification,
		title: session.title,
	};
});

const afternoonTalksSessions = [
	"effect-type-safe-errors-and-dependency-injection",
	"source-maps-how-does-the-magic-work",
	"cross-browser-devtools-with-webextensions",
].map((slug) => {
	const session = sessionsBySlug[slug];
	const speaker = session.speakers[0];

	return {
		image: speaker.image,
		name: speaker.name,
		qualification: session.qualification ?? speaker.qualification,
		title: session.title,
	};
});
---

<PageLayout
	description="A Boston conference for excellent web dev tooling."
	hideHeaderLinks={["about", "shop"]}
	hideHeaderLogo
>
	<Hero tall>
		<div class="hero-intro">
			<Logo class="hero-logo" />
			<p class="hero-subtitle">May 7th · Boston, Massachusetts</p>
		</div>
	</Hero>
	<section class="timeline-section" aria-label="Timeline preview">
		<div class="timeline-fish-layer" aria-hidden="true">
			<div class="timeline-fish-shell timeline-fish-shell-1">
				<div class="timeline-fish-body">
					<img
						class="timeline-fish-image"
						src={timelineFish1.src}
						width={timelineFish1.width}
						height={timelineFish1.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="timeline-fish-shell timeline-fish-shell-2">
				<div class="timeline-fish-body">
					<img
						class="timeline-fish-image"
						src={timelineFish2.src}
						width={timelineFish2.width}
						height={timelineFish2.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="timeline-fish-shell timeline-fish-shell-3">
				<div class="timeline-fish-body">
					<img
						class="timeline-fish-image"
						src={timelineFish3.src}
						width={timelineFish3.width}
						height={timelineFish3.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="timeline-fish-shell timeline-fish-shell-4">
				<div class="timeline-fish-body">
					<img
						class="timeline-fish-image"
						src={timelineFish4.src}
						width={timelineFish4.width}
						height={timelineFish4.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<div class="timeline-fish-shell timeline-fish-shell-5">
				<div class="timeline-fish-body">
					<img
						class="timeline-fish-image"
						src={timelineFish5.src}
						width={timelineFish5.width}
						height={timelineFish5.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
		<h2 class="timeline-heading">your devtools fieldtrip</h2>
		<div class="timeline-grid">
			<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>
			<div class="timeline-cap">
				<p>Thursday</p>
				<p>May 6th</p>
			</div>
			<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>

			<div class="timeline-venue">
				<p>@ Ned</p>
				<p>Devine's</p>
			</div>
			<div class="timeline-rail">
				<p class="timeline-time">6pm</p>
			</div>

			<div class="timeline-content" data-timeline-entry="launch">
				<h2>Launch Party!</h2>
				<p class="timeline-subtitle">6-9pm</p>
				<div class="timeline-collage" aria-label="Launch party collage">
					<div class="launchparty-photo launchparty-photo-1">
						<Image alt="People networking at SquiggleConf" src={networking} />
					</div>
					<div class="launchparty-photo launchparty-photo-2">
						<Image alt="Boston harbor near the venue" src={harbor} />
					</div>
					<div class="launchparty-photo launchparty-photo-3">
						<Image alt="Speakers gathered together at the event" src={group} />
					</div>
					<div class="launchparty-photo launchparty-photo-4">
						<Image alt="Conference signage at the venue" src={signage} />
					</div>
				</div>
				<div class="timeline-copy">
					<p>
						Kick off the weekend with snacks, drinks, and an easy room full of
						tool-loving people. It is the place to settle in, say hi, and start
						the conference with a little momentum.
					</p>
				</div>
			</div>

			<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>
			<div class="timeline-cap">
				<p>Friday</p>
				<p>May 7th</p>
			</div>
			<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>

			<div class="timeline-venue timeline-venue-aquarium">
				<p>@ New</p>
				<p>England</p>
				<p>Aquarium</p>
			</div>
			<div class="timeline-rail timeline-rail-short">
				<p class="timeline-time">7am</p>
			</div>

			<div
				class="timeline-content timeline-content-run"
				data-timeline-entry="fun-run"
			>
				<div class="timeline-title-row">
					<div class="timeline-title-copy">
						<h2>Fun Run</h2>
						<p class="timeline-subtitle">7-7:30am</p>
					</div>
					<div class="timeline-mini-collage" aria-label="Fun run collage">
						<div class="funrun-photo funrun-photo-1">
							<Image alt="Fun Run route by the waterfront" src={funrun1} />
						</div>
						<div class="funrun-photo funrun-photo-2">
							<Image alt="Runners gathering before the Fun Run" src={funrun2} />
						</div>
					</div>
				</div>
				<div class="timeline-copy">
					<p>
						A quick waterfront loop to wake everybody up before the day begins.
					</p>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-checkin">
				<p class="timeline-time">8am</p>
			</div>

			<div
				class="timeline-content timeline-content-checkin"
				data-timeline-entry="check-in"
			>
				<h2>Check In</h2>
				<div class="timeline-copy">
					<p>
						Pick up your badge, settle in, and grab a coffee before the first
						sessions start.
					</p>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-talks">
				<p class="timeline-time">9am</p>
			</div>

			<div
				class="timeline-content timeline-content-talks"
				data-timeline-entry="talks-morning"
			>
				<h2>Talks</h2>
				<div class="talks-list" aria-label="Speaker talks">
					{
						talksSessions.map((talk) => (
							<article class="talk-card">
								<div class="talk-avatar">
									<Image alt={talk.name} src={talk.image} />
								</div>
								<div class="talk-copy">
									<h3>{talk.title}</h3>
									<p class="talk-speaker">{talk.name}</p>
									<p class="talk-role">{talk.qualification}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-break">
				<p class="timeline-time">10:30am</p>
			</div>

			<div
				class="timeline-content timeline-content-break"
				data-timeline-entry="cookies-break"
			>
				<h2>Milk &amp; Cookies Break</h2>
				<div class="break-body">
					<div
						class="break-collage"
						aria-label="Milk and Cookies break collage"
					>
						<div class="break-photo break-photo-1">
							<Image alt="Milk and cookies spread" src={milkcookies3} />
						</div>
						<div class="break-photo break-photo-2">
							<Image alt="Cookies at the break" src={milkcookies1} />
						</div>
						<div class="break-photo break-photo-3">
							<Image alt="Milk and cookies break crowd" src={milkcookies2} />
						</div>
					</div>
					<div class="break-copy timeline-copy">
						<p>
							Pause for a reset, catch up with people you just met, and trade
							notes on the morning’s talks.
						</p>
						<p>
							The break keeps the middle of the day loose and social before
							everyone heads back into the next block.
						</p>
					</div>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-talks timeline-rail-talks-late">
				<p class="timeline-time">11am</p>
			</div>

			<div
				class="timeline-content timeline-content-talks timeline-content-talks-late"
				data-timeline-entry="talks-late"
			>
				<h2>Talks</h2>
				<div
					class="talks-list talks-list-short"
					aria-label="Late morning talks"
				>
					{
						lateTalksSessions.map((talk) => (
							<article class="talk-card">
								<div class="talk-avatar">
									<Image alt={talk.name} src={talk.image} />
								</div>
								<div class="talk-copy">
									<h3>{talk.title}</h3>
									<p class="talk-speaker">{talk.name}</p>
									<p class="talk-role">{talk.qualification}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>

			<div class="timeline-venue timeline-venue-lunch">
				<p>@ Faneuil</p>
				<p>Hall</p>
				<p>Market</p>
			</div>
			<div class="timeline-rail timeline-rail-lunch">
				<p class="timeline-time">12pm</p>
			</div>

			<div
				class="timeline-content timeline-content-lunch"
				data-timeline-entry="lunch"
			>
				<h2>Lunch</h2>
				<div class="lunch-body">
					<div class="lunch-collage" aria-label="Lunch collage">
						<div class="lunch-photo lunch-photo-1">
							<Image alt="Boston harbor near the venue" src={harbor} />
						</div>
						<div class="lunch-photo lunch-photo-2">
							<Image alt="People networking at SquiggleConf" src={networking} />
						</div>
						<div class="lunch-photo lunch-photo-3">
							<Image alt="Conference signage at the venue" src={signage} />
						</div>
						<div class="lunch-photo lunch-photo-4">
							<Image
								alt="Speakers gathered together at the event"
								src={group}
							/>
						</div>
						<div class="lunch-photo lunch-photo-5">
							<Image alt="People networking at SquiggleConf" src={networking} />
						</div>
					</div>
					<div class="lunch-copy timeline-copy">
						<p>
							Head out together for lunch in the market, keep conversations
							moving, and let the middle of the day feel like a field trip.
						</p>
						<ul class="lunch-links">
							<li>
								<a
									href="https://faneuilhallmarketplace.com/go/boston-and-maine-fish-company"
								>
									Boston &amp; Maine Fish Company
								</a>
							</li>
							<li>
								<a href="https://faneuilhallmarketplace.com/go/boston-chowda">
									Boston Chowda
								</a>
							</li>
							<li>
								<a href="https://faneuilhallmarketplace.com/go/prime-shoppe">
									Prime Shoppe
								</a>
							</li>
							<li>
								<a
									href="https://faneuilhallmarketplace.com/go/steves-greek-cuisine"
								>
									Steve's Greek Cuisine
								</a>
							</li>
						</ul>
						<p>
							It should stay busy, walkable, and social before everyone regroups
							for the afternoon talks.
						</p>
					</div>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-aquarium">
				<p>@ New</p>
				<p>England</p>
				<p>Aquarium</p>
			</div>
			<div
				class="timeline-rail timeline-rail-talks timeline-rail-talks-afternoon"
			>
				<p class="timeline-time">2pm</p>
			</div>

			<div
				class="timeline-content timeline-content-talks timeline-content-talks-afternoon"
				data-timeline-entry="talks-afternoon"
			>
				<h2>Talks</h2>
				<div class="talks-list" aria-label="Afternoon talks">
					{
						afternoonTalksSessions.map((talk) => (
							<article class="talk-card">
								<div class="talk-avatar">
									<Image alt={talk.name} src={talk.image} />
								</div>
								<div class="talk-copy">
									<h3>{talk.title}</h3>
									<p class="talk-speaker">{talk.name}</p>
									<p class="talk-role">{talk.qualification}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-explore">
				<p class="timeline-time">3:30pm</p>
			</div>

			<div
				class="timeline-content timeline-content-explore"
				data-timeline-entry="explore-boston"
			>
				<h2>Explore Boston</h2>
				<p class="timeline-subtitle">choose your own adventure</p>
				<div class="explore-options" aria-label="Explore Boston options">
					<article class="explore-card">
						<div class="explore-choice" aria-hidden="true">
							<span class="explore-radio"
								><span class="explore-radio-dot"></span></span
							>
						</div>
						<div class="explore-card-body">
							<div class="explore-photo">
								<Image alt="Duck boat on the water" src={duck1} />
							</div>
							<div class="explore-copy">
								<h3>Duck Boat Tour</h3>
								<p>
									See more of the city in one shot with a classic Boston ride
									that keeps the afternoon easy and social.
								</p>
							</div>
						</div>
					</article>
					<article class="explore-card">
						<div class="explore-choice" aria-hidden="true">
							<span class="explore-radio"
								><span class="explore-radio-dot"></span></span
							>
						</div>
						<div class="explore-card-body">
							<div class="explore-photo">
								<Image alt="Scavenger hunt clue card" src={duck2} />
							</div>
							<div class="explore-copy">
								<h3>Scavenger Hunt</h3>
								<p>
									A loose city walk with clues, checkpoints, and small teams
									moving through the neighborhood together.
								</p>
							</div>
						</div>
					</article>
					<article class="explore-card">
						<div class="explore-choice" aria-hidden="true">
							<span class="explore-radio"
								><span class="explore-radio-dot"></span></span
							>
						</div>
						<div class="explore-card-body">
							<div class="explore-photo">
								<Image alt="Quiet place to rest up" src={rest1} />
							</div>
							<div class="explore-copy">
								<h3>Rest Up</h3>
								<p>
									Take a quiet block to recharge, reset, and come back ready for
									the evening without over-scheduling the day.
								</p>
							</div>
						</div>
					</article>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-urban">
				<p>@ Urban</p>
				<p>Wild</p>
			</div>
			<div class="timeline-rail timeline-rail-syntax">
				<p class="timeline-time">5:30pm</p>
			</div>

			<div
				class="timeline-content timeline-content-syntax"
				data-timeline-entry="syntax-live"
			>
				<h2>Syntax.fm Live</h2>
				<div class="event-body">
					<div class="event-hero-image event-hero-image-wide">
						<img
							alt="Syntax.fm live YouTube thumbnail"
							src="https://i.ytimg.com/vi/PXO0iopa5QI/hqdefault.jpg"
							loading="lazy"
						/>
					</div>
					<div class="timeline-copy">
						<p>
							Wes and Scott are bringing Syntax.fm live to Urban Wild, and
							they’re going to interview someone cool in front of the whole
							room.
						</p>
					</div>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-fireside">
				<p class="timeline-time">6:30pm</p>
			</div>

			<div
				class="timeline-content timeline-content-fireside"
				data-timeline-entry="fireside-chat"
			>
				<h2>Fireside Chat: The Fight for the JavaScript Trademark</h2>
				<div class="event-body">
					<div
						class="fireside-avatars"
						aria-label="Placeholder avatars for fireside chat guests"
					>
						<div class="fireside-avatar fireside-avatar-1">
							<Image
								alt="Placeholder avatar for Ryan Dahl"
								src={robbyRussell}
							/>
						</div>
						<div class="fireside-avatar fireside-avatar-2">
							<Image
								alt="Placeholder avatar for Dillon Mulroy"
								src={dillonMulroy}
							/>
						</div>
					</div>
					<div class="timeline-copy">
						<p>
							A focused conversation about the long fight over the JavaScript
							trademark, with placeholder guest art for now until the final
							assets are ready.
						</p>
					</div>
				</div>
			</div>

			<div class="timeline-venue timeline-venue-empty" aria-hidden="true"></div>
			<div class="timeline-rail timeline-rail-afterparty">
				<p class="timeline-time">7pm</p>
			</div>

			<div
				class="timeline-content timeline-content-afterparty"
				data-timeline-entry="after-party"
			>
				<h2>After Party</h2>
				<p class="timeline-subtitle">7-9pm</p>
				<div class="afterparty-collage" aria-label="After party collage">
					<div class="afterparty-photo afterparty-photo-1">
						<Image alt="People networking at SquiggleConf" src={networking} />
					</div>
					<div class="afterparty-photo afterparty-photo-2">
						<Image alt="Boston harbor near the venue" src={harbor} />
					</div>
					<div class="afterparty-photo afterparty-photo-3">
						<Image alt="Speakers gathered together at the event" src={group} />
					</div>
					<div class="afterparty-photo afterparty-photo-4">
						<Image alt="Conference signage at the venue" src={signage} />
					</div>
					<div class="afterparty-photo afterparty-photo-5">
						<Image alt="People networking at SquiggleConf" src={networking} />
					</div>
				</div>
				<div class="timeline-copy">
					<p>
						Urban Wild Boston is the kind of place that makes an after party
						easy: lots of room, good energy, and enough atmosphere to keep
						people hanging around after the talks are done.
					</p>
				</div>
			</div>
		</div>
	</section>
	<ExplainersList />
	<AboutUs />
	<Registration />
	<SponsorsAndPartners />
	<Newsletter />
</PageLayout>

<style>
	.hero-intro {
		align-items: center;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		justify-content: center;
		padding: 3.5rem 0;
		text-align: center;
	}

	.hero-logo {
		font-size: clamp(3.5rem, 11vw, 7.5rem);
		line-height: 0.95;
	}

	.hero-subtitle {
		color: var(--colorBackground);
		font-family: var(--fontFamilyHeading);
		font-size: clamp(1.25rem, 3vw, 2rem);
		font-style: italic;
		font-weight: var(--fontWeightMedium);
		letter-spacing: 0.05em;
		margin: 0 0 0.75rem;
	}

	.timeline-section {
		--timeline-hover-duration: 220ms;
		background:
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 0.045) 0%,
				rgba(255, 255, 255, 0.018) 22%,

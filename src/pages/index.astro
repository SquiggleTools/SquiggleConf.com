			display: grid;
			grid-template-columns: minmax(0, 1fr) 8rem;
		}

		.funrun-collage-mobile {
			align-self: start;
			display: block;
			justify-self: end;
			left: auto;
			min-height: 7.6rem;
			position: relative;
			right: auto;
			top: -1rem;
			width: 8rem;
		}

		.funrun-collage-mobile .timeline-copy {
			color: red;
		}

		.funrun-collage-mobile .funrun-photo-1 {
			height: 5.45rem;
			left: 3.8rem;
			top: 0.3rem;
			width: 3.75rem;
		}

		.funrun-collage-mobile .funrun-photo-2 {
			height: 6.1rem;
			left: 0;
			top: 0.7rem;
			width: 4.35rem;
		}

		.timeline-content[data-timeline-entry="simons-imax-theater"] .event-body {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.timeline-content[data-timeline-entry="simons-imax-theater"]
			.event-hero-image-wide {
			justify-self: start;
			max-width: 100%;
			width: min(100%, 14rem);
		}

		.timeline-hosts-list {
			grid-template-columns: 1fr;
		}

		.timeline-venue-decoration-turtle {
			transform: scale(0.82) rotate(4deg);
			transform-origin: bottom right;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline-section::before,
		.timeline-heading,
		.postcard-stack-flip,
		.postcard-flip-inner,
		.timeline-venue,
		.timeline-venue-stack,
		.timeline-venue-decoration,
		.timeline-content,
		.timeline-content::before,
		.timeline-content::after,
		.timeline-content h2,
		.timeline-subtitle,
		.timeline-copy p,
		.timeline-fish-body {
			transition: none;
			animation: none;
		}
	}
</style>

<script>
	// @ts-nocheck
	const timelineCards = Array.from(
		document.querySelectorAll(".timeline-content"),
	).filter((element) => element instanceof HTMLElement);
	const timelineSection = document.querySelector(".timeline-section");
	const timelineFish = Array.from(
		document.querySelectorAll(".timeline-fish-shell"),
	).filter((element) => element instanceof HTMLElement);
	const morningTalksEntry = document.querySelector(
		'[data-timeline-entry="talks-morning"]',
	);
	const postcardStack = document.querySelector(".postcard-stack-flip");
	const reducedMotionQuery = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	);
	const mobileTimelineQuery = window.matchMedia("(max-width: 899px)");
	const lunchCarousels = Array.from(
		document.querySelectorAll("[data-lunch-carousel]"),
	).filter((element) => element instanceof HTMLElement);
	const timelineCardHeaders = timelineCards.map((card) => {
		const heading = card.querySelector(".timeline-title-copy h2, h2");

		return {
			card,
			heading: heading instanceof HTMLElement ? heading : card,
		};
	});

	if (
		timelineSection instanceof HTMLElement &&
		timelineFish.length > 0 &&
		morningTalksEntry instanceof HTMLElement
	) {
		let frameRequested = false;
		let scrollIdleTimer = 0;
		const scrollingAttribute = "data-timeline-scrolling";
		const fishConfigs = [
			{
				baseRotate: -8,
				bobAmplitude: 6,
				bobFrequency: 1.12,
				driftY: -6,
				end: 1.1,
				exitOffset: 26,
				finAmplitude: 4,
				opacity: 1,
				phase: 0.2,
				rotateAmplitude: 5,
				scale: 0.48,
				start: -0.18,
			},
			{
				baseRotate: 4,
				bobAmplitude: 9,
				bobFrequency: 1.5,
				driftY: 5,
				end: 1.16,
				exitOffset: 22,
				finAmplitude: 5,
				opacity: 1,
				phase: 1.1,
				rotateAmplitude: 7,
				scale: 0.41,
				start: -0.08,
			},
			{
				baseRotate: -3,
				bobAmplitude: 10,
				bobFrequency: 1.35,
				driftY: -2,
				end: 1.22,
				exitOffset: 20,
				finAmplitude: 6,
				opacity: 1,
				phase: 2.2,
				rotateAmplitude: 5,
				scale: 0.43,
				start: -0.02,
			},
			{
				baseRotate: 7,
				bobAmplitude: 8,
				bobFrequency: 0.95,
				driftY: 7,
				end: 1.12,
				exitOffset: 24,
				finAmplitude: 4,
				opacity: 1,
				phase: 0.8,
				rotateAmplitude: 6,
				scale: 0.46,
				start: -0.22,
			},
			{
				baseRotate: 2,
				bobAmplitude: 11,
				bobFrequency: 1.25,
				driftY: -8,
				end: 1.28,
				exitOffset: 18,
				finAmplitude: 6,
				opacity: 1,
				phase: 2.75,
				rotateAmplitude: 8,
				scale: 0.44,
				start: -0.14,
			},
		];

		const getPageTop = (element) =>
			element.getBoundingClientRect().top + window.scrollY;

		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		const easeInOutSine = (value) => 0.5 - Math.cos(value * Math.PI) / 2;

		const updateTimelineFish = () => {
			frameRequested = false;
			const viewportTravel = timelineSection.offsetWidth;

			if (reducedMotionQuery.matches) {
				for (const [index, fish] of timelineFish.entries()) {
					const config = fishConfigs[index];
					const visibleX = 1.8 + index * 8.25;
					fish.style.opacity = "1";
					fish.style.transform = `translate3d(${visibleX}rem, 0, 0) rotate(${config.baseRotate}deg) scale(${config.scale})`;
				}

				return;
			}

			const start = getPageTop(timelineSection) - window.innerHeight * 0.34;
			const end =
				getPageTop(morningTalksEntry) +
				morningTalksEntry.offsetHeight +
				window.innerHeight * 0.75;
			const scrollAnchor = window.scrollY + window.innerHeight * 0.28;
			const rawProgress = (scrollAnchor - start) / Math.max(end - start, 1);
			const clampedProgress = clamp(rawProgress, 0, 1);

			for (const [index, fish] of timelineFish.entries()) {
				const config = fishConfigs[index];
				const entryOffset = fish.offsetWidth + 10;
				const exitOffset = fish.offsetWidth + config.exitOffset;
				const localProgress = clamp(
					(clampedProgress - config.start) / (config.end - config.start),
					0,
					1,
				);
				const easedProgress = easeInOutSine(localProgress);
				const bodyWave = Math.sin(
					localProgress * Math.PI * 2 * config.bobFrequency + config.phase,
				);
				const finWave = Math.sin(
					localProgress * Math.PI * 4.2 + config.phase * 1.7,
				);
				const translateX =
					-entryOffset +
					easedProgress * (viewportTravel + entryOffset + exitOffset);
				const translateY =
					bodyWave * config.bobAmplitude +
					finWave * config.finAmplitude +
					easedProgress * config.driftY;
				const rotate =
					config.baseRotate +
					bodyWave * config.rotateAmplitude +
					finWave * (config.rotateAmplitude * 0.4);

				fish.style.opacity = "1";
				fish.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) rotate(${rotate}deg) scale(${config.scale})`;
			}
		};

		const requestTimelineFishUpdate = () => {
			if (frameRequested) {
				return;
			}

			frameRequested = true;
			window.requestAnimationFrame(updateTimelineFish);
		};

		const setTimelineScrolling = () => {
			if (reducedMotionQuery.matches) {
				document.documentElement.removeAttribute(scrollingAttribute);
				return;
			}

			document.documentElement.setAttribute(scrollingAttribute, "true");
			window.clearTimeout(scrollIdleTimer);
			scrollIdleTimer = window.setTimeout(() => {
				document.documentElement.removeAttribute(scrollingAttribute);
			}, 140);
		};

		const handleTimelineScroll = () => {
			setTimelineScrolling();
			requestTimelineFishUpdate();
		};

		updateTimelineFish();
		window.addEventListener("scroll", handleTimelineScroll, {
			passive: true,
		});
		window.addEventListener("resize", requestTimelineFishUpdate);
		if (typeof reducedMotionQuery.addEventListener === "function") {
			reducedMotionQuery.addEventListener("change", () => {
				if (reducedMotionQuery.matches) {
					window.clearTimeout(scrollIdleTimer);
					document.documentElement.removeAttribute(scrollingAttribute);
				}

				requestTimelineFishUpdate();
			});
		}
	}

	for (const carousel of lunchCarousels) {
		const dots = Array.from(
			carousel.querySelectorAll("[data-lunch-dot]"),
		).filter((element) => element instanceof HTMLButtonElement);
		const slides = Array.from(
			carousel.querySelectorAll("[data-lunch-slide]"),
		).filter((element) => element instanceof HTMLElement);
		let activeIndex = 0;
		let autoAdvanceTimer = 0;

		const setLunchSlide = (index) => {
			activeIndex = ((index % slides.length) + slides.length) % slides.length;
			carousel.style.setProperty("--lunch-carousel-index", `${activeIndex}`);

			for (const [slideIndex, slide] of slides.entries()) {
				slide.setAttribute(
					"aria-hidden",
					slideIndex === activeIndex ? "false" : "true",
				);
			}

			for (const [dotIndex, dot] of dots.entries()) {
				dot.setAttribute(
					"aria-pressed",
					dotIndex === activeIndex ? "true" : "false",
				);
			}
		};

		const stopLunchAutoAdvance = () => {
			window.clearInterval(autoAdvanceTimer);
			autoAdvanceTimer = 0;
		};

		const startLunchAutoAdvance = () => {
			if (reducedMotionQuery.matches || slides.length < 2) {
				return;
			}

			stopLunchAutoAdvance();
			autoAdvanceTimer = window.setInterval(() => {
				setLunchSlide(activeIndex + 1);
			}, 3400);
		};

		for (const dot of dots) {
			dot.addEventListener("click", () => {
				const nextIndex = Number(dot.dataset.lunchIndex ?? activeIndex);
				setLunchSlide(nextIndex);
				startLunchAutoAdvance();

				if (!dot.matches(":focus-visible")) {
					dot.blur();
				}
			});
		}

		carousel.addEventListener("pointerenter", stopLunchAutoAdvance);
		carousel.addEventListener("pointerleave", startLunchAutoAdvance);
		carousel.addEventListener("focusin", stopLunchAutoAdvance);
		carousel.addEventListener("focusout", () => {
			const activeElement = document.activeElement;

			if (
				!(activeElement instanceof Node) ||
				!carousel.contains(activeElement)
			) {
				startLunchAutoAdvance();
			}
		});

		setLunchSlide(0);
		startLunchAutoAdvance();
	}

	{
		let mobileActivationFrameRequested = false;

		const clearMobileTimelineState = () => {
			for (const card of timelineCards) {
				card.removeAttribute("data-mobile-active");
			}

			if (postcardStack instanceof HTMLElement) {
				postcardStack.removeAttribute("data-mobile-flipped");
			}
		};

		const updateMobileTimelineState = () => {
			mobileActivationFrameRequested = false;

			if (!mobileTimelineQuery.matches) {
				clearMobileTimelineState();
				return;
			}

			const viewportThreshold = window.innerHeight * 0.5;
			let activeCard = null;

			for (const { card, heading } of timelineCardHeaders) {
				if (heading.getBoundingClientRect().top <= viewportThreshold) {
					activeCard = card;
				}
			}

			for (const card of timelineCards) {
				if (card === activeCard) {
					card.setAttribute("data-mobile-active", "true");
				} else {
					card.removeAttribute("data-mobile-active");
				}
			}

			if (postcardStack instanceof HTMLElement) {
				const postcardRect = postcardStack.getBoundingClientRect();
				const postcardMidpoint = postcardRect.top + postcardRect.height * 0.5;

				if (postcardMidpoint <= viewportThreshold) {
					postcardStack.setAttribute("data-mobile-flipped", "true");
				} else {
					postcardStack.removeAttribute("data-mobile-flipped");
				}
			}
		};

		const requestMobileTimelineStateUpdate = () => {
			if (mobileActivationFrameRequested) {
				return;
			}

			mobileActivationFrameRequested = true;
			window.requestAnimationFrame(updateMobileTimelineState);
		};

		requestMobileTimelineStateUpdate();
		window.addEventListener("scroll", requestMobileTimelineStateUpdate, {
			passive: true,
		});
		window.addEventListener("resize", requestMobileTimelineStateUpdate);

		if (typeof mobileTimelineQuery.addEventListener === "function") {
			mobileTimelineQuery.addEventListener(
				"change",
				requestMobileTimelineStateUpdate,
			);
		}
	}

	for (const card of timelineCards) {
		card.addEventListener("pointermove", (event) => {
			if (mobileTimelineQuery.matches) {
				return;
			}

			const rect = card.getBoundingClientRect();
			const x = ((event.clientX - rect.left) / rect.width) * 100;
			const y = ((event.clientY - rect.top) / rect.height) * 100;

			card.style.setProperty(
				"--timeline-card-pointer-x",
				`${Math.min(Math.max(x, 0), 100).toFixed(2)}%`,
			);
			card.style.setProperty(
				"--timeline-card-pointer-y",
				`${Math.min(Math.max(y, 0), 100).toFixed(2)}%`,
			);
		});

		card.addEventListener("pointerleave", () => {
			card.style.setProperty("--timeline-card-pointer-x", "50%");
			card.style.setProperty("--timeline-card-pointer-y", "50%");
		});
	}
</script>

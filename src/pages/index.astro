---
import "@fontsource/shantell-sans";

import { Image } from "astro:assets";

import Hero from "~/components/hero/Hero.astro";
import Registration from "~/components/Registration.astro";
import DeepSeaSurface from "~/components/DeepSeaSurface.astro";
import SponsorsAndPartners from "~/components/SponsorsAndPartners.astro";
import TimelineTalksTurtle from "~/components/TimelineTalksTurtle.astro";
import { speakersBySlug } from "~/data/speakers";
import timelineFish1 from "~/assets/design/timeline-fish-1.svg";
import timelineFish2 from "~/assets/design/timeline-fish-2.svg";
import timelineFish3 from "~/assets/design/timeline-fish-3.svg";
import timelineFish4 from "~/assets/design/timeline-fish-4.svg";
import timelineFish5 from "~/assets/design/timeline-fish-5.svg";
import harborwalk from "~/assets/2027/boston-harborwalk.jpg";
import harbor from "~/assets/stills/boston-harbor.png";
import networking from "~/assets/stills/attendees-networking.png";
import simonsTheater from "~/assets/2027/simons-theater.jpg";
import terminalShop from "~/assets/2027/terminal.shop.svg";
import duck1 from "~/assets/2027/duck-1.jpg";
import duck2 from "~/assets/2027/duck-2.jpg";
import bigRav from "~/assets/2027/bigrav.png";
import lunchBerryTwist from "~/assets/2027/lunch-berry-twist.jpg";
import lunchBostonChowda from "~/assets/2027/lunch-boston-chowda.jpg";
import lunchRegina from "~/assets/2027/lunch-regina.jpg";
import lunchSalad from "~/assets/2027/lunch-salad.jpg";
import lunchWickedLobsta from "~/assets/2027/lunch-wicked-lobsta.jpg";
import maddyPortrait from "~/assets/2027/maddy.jpeg";
import placeholder1 from "~/assets/2027/placeholder-1.png";
import placeholder2 from "~/assets/2027/placeholder-2.png";
import placeholder3 from "~/assets/2027/placeholder-3.png";
import placeholder4 from "~/assets/2027/placeholder-4.png";
import placeholder5 from "~/assets/2027/placeholder-5.png";
import placeholder6 from "~/assets/2027/placeholder-6.png";
import placeholder7 from "~/assets/2027/placeholder-7.png";
import tannerPortrait from "~/assets/2027/tanner.jpeg";
import postcardBack from "~/assets/2027/postcard-back.png";
import postcardFront from "~/assets/2027/postcard-front.png";
import funrun1 from "~/assets/2027/funrun-1.jpg";
import funrun2 from "~/assets/2027/funrun-2.jpg";
import milkcookies1 from "~/assets/2027/milkcookies-1.jpg";
import milkcookies2 from "~/assets/2027/milkcookies-2.png";
import milkcookies3 from "~/assets/2027/milkcookies-3.jpg";
import rest1 from "~/assets/2027/rest-1.jpg";
import ryanDahl from "~/assets/2027/ryandahl.png";
import scottTolinski from "~/assets/2027/scotttolinski.jpeg";
import squiggleConfLogoRaw from "~/assets/2027/SquiggleConf-Logo.svg?raw";
import thePrimeagen from "~/assets/2027/theprimagen.jpeg";
import urbanwildLogo from "~/assets/2027/urbanwild-logo.png";
import urbanwild1 from "~/assets/2027/urbanwild-1.webp";
import urbanwild2 from "~/assets/2027/urbanwild-2.webp";
import urbanwild3 from "~/assets/2027/urbanwild-3.webp";
import urbanwild4 from "~/assets/2027/urbanwild-4.webp";
import urbanwild5 from "~/assets/2027/urbanwild-5.webp";
import wesBos from "~/assets/2027/wesbos.jpeg";
import dillonMulroy from "~/assets/avatars/dillon-mulroy.webp";
import PageLayout from "~/layouts/PageLayout.astro";

const locationLinks = {
	aquarium: "https://maps.app.goo.gl/FodmfsLGZYALV1Hh9",
	nedDevines: "https://maps.app.goo.gl/rD3zWzuJ1U9VuSdN9",
	quincyMarket: "https://maps.app.goo.gl/mQyHoaGZgip8pfux5",
	urbanWild: "https://maps.app.goo.gl/ADbjjYdyB3AVstH67",
};

const talksSessions = [
	{
		image: tannerPortrait,
		name: "Tanner Linsley",
		qualification: "creator of all things TanStack",
		title: "TanStack AI: Our Biggest Lessons Learned",
	},
	{
		image: placeholder1,
		isPlaceholder: true,
		name: "Your Name Here",
		qualification: "maintainer of a package in your lockfile",
		title: "The Package You've Never Heard Of That Runs Half the Internet",
	},
	{
		image: placeholder2,
		isPlaceholder: true,
		name: "Speaker Loading...",
		qualification: "accidentally became a language designer",
		title: "One Small Syntax Change, One Giant Migration Guide",
	},
];

const lateTalksSessions = [
	{
		image: placeholder3,
		isPlaceholder: true,
		name: "Placeholder McPlaceholderface",
		qualification: "TypeScript whisperer",
		title: "Why Is This Type Slow?",
	},
	{
		image: placeholder7,
		isPlaceholder: true,
		name: "Your Favorite Developer",
		qualification: "local development maximalist",
		title: "The 42-Second Dev Loop",
	},
];

const afternoonTalksSessions = [
	{
		image: placeholder5,
		isPlaceholder: true,
		name: "Mysterious Industry Person",
		qualification: "compiler engineer and standards enjoyer",
		title: "The Runtime Is Lying To You",
	},
	{
		image: placeholder6,
		isPlaceholder: true,
		name: "Anonymous Core Team Member",
		qualification: "spends their days reading specification prose",
		title: "The Feature Everyone Uses Incorrectly",
	},
	{
		image: placeholder4,
		isPlaceholder: true,
		name: "Future Squiggle Speaker",
		qualification: "creator of an unreasonable amount of tooling",
		title: "Making Developers 3% Faster at Enormous Personal Cost",
	},
];

const timelineMCs = (["tj-devries", "maddy-montaquila"] as const).map(
	(slug) => {
		const speaker = speakersBySlug[slug];

		return {
			image: slug === "maddy-montaquila" ? maddyPortrait : speaker.image,
			name: speaker.name,
			qualification: speaker.qualification,
		};
	},
);

const lunchSpots = [
	{
		alt: "Boston & Maine Fish Company seafood plate",
		image: lunchBostonChowda,
		name: "Boston & Maine Fish Company",
		url: "https://faneuilhallmarketplace.com/go/boston-and-maine-fish-company",
	},
	{
		alt: "Regina Pizzeria pizza slices",
		image: lunchRegina,
		name: "Regina Pizzeria",
		url: "https://faneuilhallmarketplace.com/go/regina-pizzeria",
	},
	{
		alt: "Wicked Lobsta lobster roll",
		image: lunchWickedLobsta,
		name: "Wicked Lobsta",
		url: "https://faneuilhallmarketplace.com/go/wicked-lobsta",
	},
	{
		alt: "The Berry Twist dessert cup",
		image: lunchBerryTwist,
		name: "The Berry Twist",
		url: "https://faneuilhallmarketplace.com/go/the-berry-twist",
	},
	{
		alt: "Green Organic Bowl salad",
		image: lunchSalad,
		name: "Green Organic Bowl",
		url: "https://faneuilhallmarketplace.com/go/green-organic-bowl",
	},
];

const squiggleConfLogoSvg = squiggleConfLogoRaw.replace(
	'fill="white"',
	'fill="var(--hero-logo-fill, white)"',
);
---

<PageLayout
	description="A Boston conference for excellent web dev tooling."
	hideHeaderLinks={["about", "shop"]}
	hideHeaderLogo
>
	<div
		slot="pageTop"
		class="private-preview-banner"
		aria-label="Private preview notice"
	>
		Private Preview - Names are non-confirmed examples. Please do not share!
	</div>
	<Hero tall>
		<div class="hero-intro">
			<div
				class="hero-logo"
				aria-label="SquiggleConf"
				role="img"
				set:html={squiggleConfLogoSvg}
			/>
			<p class="hero-subtitle">May 7th · Boston, Massachusetts</p>
		</div>
	</Hero>
	<DeepSeaSurface>
		<section class="timeline-section" aria-label="Timeline preview">
			<div class="timeline-fish-layer" aria-hidden="true">
				<div class="timeline-fish-shell timeline-fish-shell-1">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish1.src}
							width={timelineFish1.width}
							height={timelineFish1.height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-2">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish2.src}
							width={timelineFish2.width}
							height={timelineFish2.height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-3">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish3.src}
							width={timelineFish3.width}
							height={timelineFish3.height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-4">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish4.src}
							width={timelineFish4.width}
							height={timelineFish4.height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
				<div class="timeline-fish-shell timeline-fish-shell-5">
					<div class="timeline-fish-body">
						<img
							class="timeline-fish-image"
							src={timelineFish5.src}
							width={timelineFish5.width}
							height={timelineFish5.height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
			<h2 class="postcard-heading">the devtools conference</h2>
			<p class="postcard-intro">
				SquiggleConf is a conference focused on software developer tools: AI
				tools, linters, code editors, performance and security tools, debuggers,
				and more. We mix heavy talks with fun events.<br />Think of it like your
				devtools fieldtrip.
			</p>
			<div
				class="postcard-gallery"
				style="--postcard-back-width: 21rem; --postcard-front-scale: 1.5;"
			>
				<div class="postcard-stack postcard-stack-flip">
					<div class="postcard-flip-scene">
						<div class="postcard-flip-inner">
							<span class="postcard-face postcard-face-front">
								<span class="postcard postcard-front">
									<Image
										alt="Front of the SquiggleConf postcard"
										src={postcardFront}
										loading="eager"
									/>
								</span>
							</span>
							<span class="postcard-face postcard-face-back">
								<span class="postcard postcard-back">
									<Image
										alt="Back of the SquiggleConf postcard"
										src={postcardBack}
										loading="eager"
									/>
									<span class="postcard-back-message">
										<span class="postcard-back-greeting">Hi Mom,</span>
										<span>
											SquiggleConf was so much fun this year! <br />I learned
											all about abstract syntax trees, AI agent harnesses, and
											met the devs leading the industry!
										</span>
									</span>
									<span class="postcard-back-address">
										<span>New England Aquarium</span>
										<span>Simons Theater</span>
										<span>1 Central Wharf</span>
										<span>Boston, MA 02110</span>
									</span>
								</span>
								<span class="postcard-note postcard-note-back"
									>* yes, you'll really get this postcard</span
								>
							</span>
						</div>
					</div>
				</div>
			</div>
			<div class="timeline-grid">
				<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Thursday</p>
					<p>May 6th</p>
				</div>
				<div class="timeline-grid-intro">
					<h3>SquiggleConf 2027</h3>
					<p>Boston, Massachusetts</p>
				</div>

				<div class="timeline-venue timeline-venue-last">
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={locationLinks.nedDevines}
							rel="noreferrer"
							target="_blank"
						>
							<p>Ned</p>
							<p>Devine's</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-bottom">
					<p class="timeline-time">6pm</p>
				</div>

				<div class="timeline-content" data-timeline-entry="launch">
					<div class="timeline-heading-line">
						<h2>Launch Party!</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-range"
						>
							6-9pm
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={locationLinks.nedDevines}
							rel="noreferrer"
							target="_blank"
						>
							Ned Devine's
						</a>
					</div>
					<div class="launchparty-collage" aria-label="Launch party collage">
						<div class="launchparty-photo launchparty-photo-1">
							<Image
								alt="People networking at SquiggleConf"
								src={networking}
								loading="eager"
							/>
						</div>
						<div class="launchparty-photo launchparty-photo-2">
							<Image
								alt="Boston harbor near the venue"
								src={harbor}
								loading="eager"
							/>
						</div>
						<div class="launchparty-photo launchparty-photo-3">
							<Image
								alt="Speakers gathered together at the event"
								src={harborwalk}
								loading="eager"
							/>
						</div>
					</div>
					<div class="timeline-copy">
						<p>
							Kick off the weekend with snacks, drinks, and an easy room full of
							tool-loving people. It is the place to settle in, say hi, and
							start the conference with a little momentum.
						</p>
					</div>
				</div>

				<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>
				<div class="timeline-cap timeline-top">
					<p>Friday</p>
					<p>May 7th</p>
				</div>
				<div class="timeline-cell timeline-cell-empty" aria-hidden="true"></div>

				<div
					class="timeline-venue timeline-venue-aquarium timeline-venue-aquarium-morning timeline-cell-span-seven"
				>
					<div class="timeline-venue-stack">
						<a
							class="timeline-location-link timeline-location-link-stack"
							href={locationLinks.aquarium}
							rel="noreferrer"
							target="_blank"
						>
							<p>New</p>
							<p>England</p>
							<p>Aquarium</p>
						</a>
					</div>
				</div>
				<div class="timeline-rail timeline-rail-short">
					<p class="timeline-time">7am</p>
				</div>

				<div
					class="timeline-content timeline-content-funrun"
					data-timeline-entry="fun-run"
				>
					<div class="timeline-title-row">
						<div class="timeline-title-copy">
							<div class="timeline-heading-line">
								<h2>Fun Run</h2>
								<p
									class="timeline-subtitle timeline-inline-time timeline-inline-time-range"
								>
									7-7:30am
								</p>
							</div>
							<div class="timeline-mobile-meta">
								<a
									class="timeline-mobile-location timeline-location-link"
									href={locationLinks.aquarium}
									rel="noreferrer"
									target="_blank"
								>
									New England Aquarium
								</a>
							</div>
						</div>
						<div
							class="funrun-collage funrun-collage-desktop"
							aria-label="Fun run collage"
						>
							<div class="funrun-photo funrun-photo-1">
								<Image
									alt="Fun Run route by the waterfront"
									src={funrun1}
									loading="eager"
								/>
							</div>
							<div class="funrun-photo funrun-photo-2">
								<Image
									alt="Runners gathering before the Fun Run"
									src={funrun2}
									loading="eager"
								/>
							</div>
						</div>
					</div>
					<div class="funrun-body">
						<div class="timeline-copy">
							<p>
								Optional for some, best way to start the day for others! It's an
								casual yet eventful 5k through the Boston shoreline.
							</p>
						</div>
						<div
							class="funrun-collage funrun-collage-mobile"
							aria-hidden="true"
						>
							<div class="funrun-photo funrun-photo-1">
								<Image
									alt=""
									aria-hidden="true"
									src={funrun1}
									loading="eager"
								/>
							</div>
							<div class="funrun-photo funrun-photo-2">
								<Image
									alt=""
									aria-hidden="true"
									src={funrun2}
									loading="eager"
								/>
							</div>
						</div>
					</div>
				</div>

				<div class="timeline-rail timeline-rail-checkin timeline-cell-span-two">
					<p class="timeline-time">8am</p>
				</div>

				<div
					class="timeline-content timeline-content-checkin"
					data-timeline-entry="check-in"
				>
					<div class="timeline-heading-line">
						<h2>Check In</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							8am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={locationLinks.aquarium}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="timeline-copy">
						<p>
							Pick up your badge, settle in, and grab a terminal.shop coffee
							before the first sessions start.
						</p>
						<a
							class="timeline-checkin-button"
							href="https://terminal.shop"
							rel="noreferrer"
							target="_blank"
						>
							<Image
								alt=""
								aria-hidden="true"
								class="timeline-checkin-button-icon"
								src={terminalShop}
							/>
							<span>terminal.shop coffee</span>
						</a>
					</div>
				</div>

				<div
					class="timeline-content timeline-content-mcs"
					data-timeline-entry="simons-imax-theater"
				>
					<div class="timeline-heading-line">
						<h2>Talks in an IMAX Theater</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							8am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={locationLinks.aquarium}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="event-body">
						<div
							class="event-hero-image event-hero-image-wide event-hero-image-pinned"
						>
							<Image
								alt="Presenter on stage inside the Simons IMAX Theater"
								src={simonsTheater}
								loading="eager"
							/>
						</div>
						<div class="timeline-copy">
							<p>
								The talks take place in an IMAX theater. That means super
								comfortable seats, great visibility, and a 60ft high screen.
							</p>
							<p>Also, a penguin exhibit next door.</p>
						</div>
					</div>
				</div>

				<div class="timeline-rail timeline-rail-talks timeline-cell-span-two">
					<p class="timeline-time">9am</p>
				</div>

				<div
					class="timeline-content timeline-content-mcs"
					data-timeline-entry="mcs"
				>
					<div class="timeline-heading-line">
						<h2>Meet your MCs!</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							9am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={locationLinks.aquarium}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="timeline-hosts-list" aria-label="Conference MCs">
						{
							timelineMCs.map((host) => (
								<article class="timeline-host-card">
									<div class="talk-avatar timeline-host-avatar">
										<Image alt={host.name} src={host.image} loading="eager" />
									</div>
									<div class="timeline-host-copy">
										<h3>{host.name}</h3>
										<p class="timeline-host-role">{host.qualification}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>

				<div
					class="timeline-content timeline-content-talks"
					data-timeline-entry="talks-morning"
				>
					<div class="timeline-heading-line">
						<h2>Talks</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
							9am
						</p>
					</div>
					<div class="timeline-mobile-meta">
						<a
							class="timeline-mobile-location timeline-location-link"
							href={locationLinks.aquarium}
							rel="noreferrer"
							target="_blank"
						>
							New England Aquarium
						</a>
					</div>
					<div class="talks-list" aria-label="Speaker talks">
						{
							talksSessions.map((talk) => (
								<article class="talk-card">
									<div
										class:list={[
											"talk-avatar",
											talk.isPlaceholder && "talk-avatar-placeholder",
										]}
									>
										<Image alt={talk.name} src={talk.image} />
										{talk.isPlaceholder && (
											<span
												class="talk-avatar-placeholder-mark"
												aria-hidden="true"
											>
												?
											</span>
										)}
									</div>
									<div class="talk-copy">
										<h3>{talk.title}</h3>
										<p class="talk-speaker">{talk.name}</p>
										<p class="talk-role">{talk.qualification}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>

				<div class="timeline-rail timeline-rail-break">
					<p class="timeline-time">10:30am</p>
				</div>

				<div
					class="timeline-content timeline-content-break"
					data-timeline-entry="cookies-break"
				>
					<div class="timeline-heading-line">
						<h2>Milk &amp; Cookies Break</h2>
						<p
							class="timeline-subtitle timeline-inline-time timeline-inline-time-point"
						>
